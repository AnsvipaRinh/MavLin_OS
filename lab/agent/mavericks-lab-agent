# --- Serve mode ---


def serve():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError as e:
            resp = {"ok": False, "error": f"invalid JSON: {e}"}
            print(json.dumps(resp), flush=True)
            continue
        job_id = req.get("id") or str(uuid.uuid4())
        cmd = req.get("cmd", "")
        args = req.get("args", {})
        cached = journal_find_job(job_id)
        if cached:
            resp = {
                "id": job_id,
                "ok": True,
                "result": cached["data"].get("result"),
                "replayed": True,
            }
            print(json.dumps(resp), flush=True)
            continue
        handler = COMMANDS.get(cmd)
        if not handler:
            resp = {"id": job_id, "ok": False, "error": f"unknown command: {cmd}"}
            print(json.dumps(resp), flush=True)
            continue
        try:
            result = handler(args)
            if "error" in result:
                resp = {"id": job_id, "ok": False, "error": result["error"]}
            else:
                resp = {"id": job_id, "ok": True, "result": result}
        except Exception as e:
            resp = {
                "id": job_id,
                "ok": False,
                "error": f"{type(e).__name__}: {e}",
            }
        journal_append(
            "job_result",
            {
                "job_id": job_id,
                "cmd": cmd,
                "result": result if "error" not in result else None,
                "error": resp.get("error"),
            },
        )
        print(json.dumps(resp), flush=True)


# --- Boot mode ---


def boot():
    state = load_state()
    boot_backend = get_boot_backend()
    boot_state = boot_backend.get_boot_state()
    current_slot = boot_state["current_slot"]
    boot_id = str(uuid.uuid4())
    state["boot_id"] = boot_id

    slot_changed = (
        state["active_slot"] is not None
        and current_slot != state["active_slot"]
    )

    if state["state"] in ("UNKNOWN", "ROLLBACK") or slot_changed:
        state["previous_slot"] = state["active_slot"]
        state["active_slot"] = current_slot
        meta_path = slot_dir(current_slot) / "image.json"
        if meta_path.exists():
            try:
                meta = json.loads(meta_path.read_text())
                state["deployment_id"] = meta.get("deployment_id")
            except json.JSONDecodeError:
                pass
        save_state(state)
        journal_append(
            "boot", {"boot_id": boot_id, "slot": current_slot, "reason": "fresh_boot"}
        )
        for target in ("BOOTING", "NETWORK_READY", "AGENT_READY", "HEALTH_CHECK"):
            state, err = transition_state(state, target)
            if err:
                break
    elif state["state"] == "BOOTING":
        journal_append(
            "boot", {"boot_id": boot_id, "slot": current_slot, "reason": "resume"}
        )
        if state["state"] == "BOOTING":
            state, _ = transition_state(state, "NETWORK_READY")
        if state["state"] == "NETWORK_READY":
            state, _ = transition_state(state, "AGENT_READY")
        if state["state"] == "AGENT_READY":
            state, _ = transition_state(state, "HEALTH_CHECK")
    else:
        journal_append(
            "boot", {"boot_id": boot_id, "slot": current_slot, "reason": "verify"}
        )

    if state["state"] == "HEALTH_CHECK":
        passed, checks = run_health_checks()
        state["last_health_check"] = time.strftime(
            "%Y-%m-%dT%H:%M:%SZ", time.gmtime()
        )
        if passed:
            state["attempt"] = 0
            save_state(state)
            state, _ = transition_state(state, "HEALTHY")
            journal_append("health_check", {"result": "pass", "checks": checks})
        else:
            state["attempt"] = state.get("attempt", 0) + 1
            save_state(state)
            state, _ = transition_state(state, "FAIL")
            journal_append(
                "health_check",
                {
                    "result": "fail",
                    "checks": checks,
                    "attempt": state["attempt"],
                },
            )
            if state["attempt"] < state.get("max_attempts", 3):
                prev = state.get("previous_slot") or (
                    "B" if current_slot == "A" else "A"
                )
                boot_backend.select_boot(prev)
                state["next_slot"] = prev
                save_state(state)
                state, _ = transition_state(state, "ROLLBACK")
                boot_backend.reboot()
            else:
                journal_append(
                    "boot_loop_protection",
                    {"attempt": state["attempt"], "action": "halt"},
                )


# --- Identity mode ---


def identity_mode():
    fp, ok = generate_identity()
    if ok:
        pub = identity_pub_path().read_text() if identity_pub_path().exists() else ""
        return {
            "fingerprint": fp,
            "public_key": pub,
            "path": str(identity_path()),
        }
    return {
        "error": "failed to generate identity (openssl/ssh-keygen unavailable)"
    }


# --- Main ---


def main():
    import argparse

    parser = argparse.ArgumentParser(description="mavericks-lab-agent")
    parser.add_argument(
        "mode",
        nargs="?",
        default="serve",
        choices=["serve", "boot", "identity"],
    )
    args = parser.parse_args()
    if args.mode == "serve":
        serve()
    elif args.mode == "boot":
        boot()
    elif args.mode == "identity":
        result = identity_mode()
        print(json.dumps(result))


if __name__ == "__main__":
    main()
