index 1234567..abcdefg 100644
--- a/configs/plank/dock.theme
+++ b/configs/plank/dock.theme
@@ -10,6 +10,18 @@
 
 [DockTheme]
 
+# Mavericks-style reflection
+ReflectionHeight=16
+ReflectionOpacity=0.15
+ReflectionFadeStart=0.3
+ReflectionFadeEnd=1.0
+
+# Subtle gradient for reflection
+ReflectionGradientStart=#ffffff
+ReflectionGradientEnd=#cccccc
+
 [IconTheme]
 IconSize=48
 IconZoom=1.4
@@ -25,3 +37,12 @@
 
 [HoverEffect]
 Enabled=true
 GlowColor=#ffffff
 GlowOpacity=0.2
+
+# Mavericks glass effect
+GlassOpacity=0.85
+GlassBlurRadius=8
+GlassBorderColor=#ffffff
+GlassBorderOpacity=0.3
