+++ b/configs/gtk-3.0/gtk.css
@@ -150,6 +150,20 @@
 }
 
 /* Dock integration */
+.dock-item {
+    -gtk-icon-effect: reflection;
+    -gtk-reflection-height: 16px;
+    -gtk-reflection-opacity: 0.15;
+}
+
+.dock-item:hover {
+    -gtk-icon-effect: reflection;
+    -gtk-reflection-height: 20px;
+    -gtk-reflection-opacity: 0.25;
+    transition: all 0.2s ease-out;
+}
