diff --git a/packages/linux-macbook101/applespi.patch b/packages/linux-macbook101/applespi.patch
new file mode 100644
--- /dev/null
+++ b/packages/linux-macbook101/applespi.patch
@@ -0,0 +1,45 @@
+--- a/drivers/spi/spi-apple.c
++++ b/drivers/spi/spi-apple.c
+@@ -120,7 +120,12 @@ static int applespi_transfer(struct spi_device *spi, struct spi_message *msg)
+ }
+
+ static int applespi_setup(struct spi_device *spi)
+ {
+-       if (spi->max_speed_hz > 24000000)
++       /* MacBook10,1 requires lower SPI clock for stability */
++       if (spi->max_speed_hz > 12000000)
+               return -EINVAL;
+
++       /* Increase timeout for fanless thermal throttling */
++       spi->controller->timeout = msecs_to_jiffies(5000);
++       spi->controller->busy_wait = true;
++
        return 0;
+ }
+
+ static int applespi_probe(struct spi_device *spi)
