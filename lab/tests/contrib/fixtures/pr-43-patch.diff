diff --git a/scripts/apply-hardware-selection.sh b/scripts/apply-hardware-selection.sh
index 3333333..4444444 100755
--- a/scripts/apply-hardware-selection.sh
+++ b/scripts/apply-hardware-selection.sh
@@ -50,6 +50,12 @@ if echo "$LSPCI_OUTPUT" | grep -q "14e4:43ba"; then
     else
         echo "→ Using brcmfmac (revision 01/02)"
         WIFI_DRIVER="brcmfmac"
     fi
+else
+    # Fallback for unknown revisions
+    echo "Unknown Broadcom revision, defaulting to brcmfmac"
+    WIFI_DRIVER="brcmfmac"
+    # Log for debugging
+    logger -t mavericks-setup "Unknown BCM revision, using brcmfmac"
 fi
 
