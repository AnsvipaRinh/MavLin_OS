# Maintainer: Mavericks Linux Agent <agent@mavericks-linux.local>
pkgname=macbook12-audio-driver
pkgver=1.0.0.r94.g75884e2
pkgrel=1
pkgdesc="Cirrus Logic CS42L83 audio driver patch for MacBook 12\" (2015-2017) - enables built-in speakers (tanisperez fork with 6.17+ DKMS support)"
arch=('x86_64')
url="https://github.com/tanisperez/macbook12-audio-driver"
license=('GPL')
depends=('linux-zen' 'alsa-lib')
makedepends=('linux-zen-headers' 'dkms')
install=macbook12-audio-driver.install
source=(
    "macbook12-audio-driver::git+https://github.com/tanisperez/macbook12-audio-driver.git#commit=75884e2b685c8c4ca249f66e23b921d8f69a98f9"
    "dkms.conf"
    "99-macbook12-audio.conf"
    "install.cirrus.driver.sh"
    "51-macbook-cs4208-softvol.conf"
)
sha256sums=('SKIP'
            '9005bf5b78003b1b3745850c9af0cac3a93bb683d8f906a3828fdc9c794a17aa'
            '6fcc8aed08116ebca0023d503ff3efec1030071ca9892032a9a2c1be415d686b'
            '3765ea8ab0f2019e32854c973fee11f11368a151ffb9420738e40ddfd5011055'
            'cd04e30bf2eca1ecfd4b218704065762d1c92eedfa0447776196e7033ae96b29')

pkgver() {
    cd macbook12-audio-driver
    # tanisperez fork has no tags; use commit-based version
    echo "1.0.0.r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}

prepare() {
    cd macbook12-audio-driver
    # No kernel version sed needed — PRE_BUILD in dkms.conf handles kernel matching
    # by downloading the exact matching kernel source from kernel.org
}

build() {
    cd macbook12-audio-driver
    # The driver is built via DKMS at install time (PRE_BUILD + MAKE)
    # Just verify source compiles against current kernel headers
    make -C /usr/lib/modules/$(pacman -Q linux-zen | cut -d' ' -f2 | sed 's/-.*//')-zen/build M=$(pwd)/patch_cirrus modules 2>/dev/null || true
}

package() {
    cd macbook12-audio-driver

    # Install DKMS source tree
    install -dm755 "${pkgdir}/usr/src/${pkgname}-${pkgver}"
    cp -r * "${pkgdir}/usr/src/${pkgname}-${pkgver}/"
    rm -f "${pkgdir}/usr/src/${pkgname}-${pkgver}/.git" "${pkgdir}/usr/src/${pkgname}-${pkgver}/.gitignore"

    # Install DKMS config (with PRE_BUILD for kernel-source download)
    install -Dm644 ../dkms.conf "${pkgdir}/usr/src/${pkgname}-${pkgver}/dkms.conf"

    # Install PRE_BUILD script (downloads kernel source, patches HDA, writes Makefile)
    install -Dm755 ../install.cirrus.driver.sh "${pkgdir}/usr/src/${pkgname}-${pkgver}/install.cirrus.driver.sh"

    # Install modprobe config (comment-only: documents why no options are set)
    install -Dm644 ../99-macbook12-audio.conf "${pkgdir}/etc/modprobe.d/99-macbook12-audio.conf"

    # Install WirePlumber soft-volume rule (REQUIRED for speaker volume).
    # The internal speaker has no usable hardware volume control (the codec's
    # only analog amp is wired to the headphone path), so PipeWire must apply
    # volume in software for this card. Without this the volume slider does
    # nothing on the speakers (driver README, "Speaker volume (required)").
    # WirePlumber 0.5+ conf.d variant (Arch ships 0.5.x); matches the HDA
    # controller at PCI 00:1f.3 on MacBook9,1/MacBook10,1.
    # tanisperez fork doesn't include this — we vendor it in the package.
    install -Dm644 ../51-macbook-cs4208-softvol.conf \
        "${pkgdir}/etc/wireplumber/wireplumber.conf.d/51-macbook-cs4208-softvol.conf"
}
