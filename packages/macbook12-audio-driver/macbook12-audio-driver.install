post_install() {
    echo ":: Adding macbook12-audio-driver to DKMS..."
    dkms add -m macbook12-audio-driver -v ${PKGVER}
    echo ":: Building for current kernel..."
    dkms install -m macbook12-audio-driver -v ${PKGVER}
    echo ":: Regenerating initramfs..."
    mkinitcpio -P
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ":: Removing macbook12-audio-driver from DKMS..."
    dkms remove -m macbook12-audio-driver -v ${PKGVER} --all
    echo ":: Regenerating initramfs..."
    mkinitcpio -P
}