post_install() {
    # Update icon cache
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true

    # Update desktop database
    update-desktop-database -q 2>/dev/null || true

    # Set up Epiphany Mavericks profile for current user
    if [ -n "$SUDO_USER" ]; then
        sudo -u "$SUDO_USER" /usr/bin/epiphany-mavericks-setup 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q 2>/dev/null || true
}