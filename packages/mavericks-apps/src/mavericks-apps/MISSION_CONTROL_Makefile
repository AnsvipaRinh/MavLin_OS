# Mission Control Helpers Installation Makefile
# Installs all MC CLI helpers to /usr/local/bin

PREFIX ?= /usr/local
BINDIR = $(PREFIX)/bin

HELPERS = \
	mv-mc-window-spaces \
	mv-mc-thumbnail \
	mv-mc-grid \
	mv-mc-activate-window \
	mv-mc-overview \
	mv-mc-gui \
	mv-workspace-count

# Required dependencies
DEPS_PYTHON = python3-gi gir1.2-gtk-3.0 python3-ewmh python3-xlib
DEPS_TOOLS = imagemagick wmctrl xdotool

.PHONY: all install uninstall check deps

all: check

check: deps
	@echo "Checking Mission Control helpers..."
	@for helper in $(HELPERS); do \
		if [ ! -f "bin/$$helper" ]; then \
			echo "ERROR: bin/$$helper not found"; \
			exit 1; \
		fi; \
	done
	@echo "All helpers present."

deps:
	@echo "Checking Mission Control dependencies..."
	@echo ""
	@echo "Python/GTK dependencies:"
	@for dep in $(DEPS_PYTHON); do \
		if dpkg -l | grep -q "^ii.*$$dep"; then \
			echo "  ✅ $$dep"; \
		else \
			echo "  ❌ $$dep (MISSING)"; \
			MISSING_PYTHON="$$MISSING_PYTHON $$dep"; \
		fi; \
	done
	@echo ""
	@echo "Tool dependencies:"
	@for dep in $(DEPS_TOOLS); do \
		if command -v $$dep > /dev/null 2>&1 || dpkg -l | grep -q "^ii.*$$dep"; then \
			echo "  ✅ $$dep"; \
		else \
			echo "  ❌ $$dep (MISSING)"; \
			MISSING_TOOLS="$$MISSING_TOOLS $$dep"; \
		fi; \
	done
	@echo ""
	@if [ -n "$$MISSING_PYTHON$$MISSING_TOOLS" ]; then \
		echo "⚠️  Missing dependencies detected!"; \
		echo ""; \
		echo "To install missing dependencies, run:"; \
		echo "  sudo apt install$$MISSING_PYTHON$$MISSING_TOOLS"; \
		echo ""; \
		echo "Or install all at once:"; \
		echo "  sudo apt install python3-gi gir1.2-gtk-3.0 python3-ewmh python3-xlib imagemagick wmctrl xdotool"; \
		echo ""; \
		exit 1; \
	else \
		echo "✅ All dependencies satisfied."; \
	fi
	@echo ""

install: check
	@echo "Installing Mission Control helpers to $(BINDIR)..."
	@install -d $(DESTDIR)$(BINDIR)
	@for helper in $(HELPERS); do \
		echo "  Installing $$helper..."; \
		install -m 755 "bin/$$helper" "$(DESTDIR)$(BINDIR)/$$helper"; \
	done
	@echo "Installation complete."
	@echo ""
	@echo "Mission Control helpers installed:"
	@for helper in $(HELPERS); do \
		echo "  - $$helper"; \
	done
	@echo ""
	@echo "Quick start:"
	@echo "  mv-mc-gui              # Full GUI overlay (or press F3)"
	@echo "  mv-mc-overview --list  # CLI window list"
	@echo "  mv-workspace-count get # Current Space count"
	@echo ""

uninstall:
	@echo "Removing Mission Control helpers from $(BINDIR)..."
	@for helper in $(HELPERS); do \
		echo "  Removing $$helper..."; \
		rm -f "$(DESTDIR)$(BINDIR)/$$helper"; \
	done
	@echo "Uninstall complete."
