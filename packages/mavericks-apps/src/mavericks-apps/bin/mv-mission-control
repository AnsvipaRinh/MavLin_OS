#!/usr/bin/env python3
"""mv-mission-control — Window overview for rofi script mode.

The normal invocation is the existing rofi script-mode backend.  The
--native entry point uses skippy-xd directly when available and falls back
to that backend when the optional native dependency is unavailable or fails.
"""
import sys
import subprocess
import re
import shutil


def get_windows():
    """Get all windows using wmctrl."""
    try:
        result = subprocess.run(
            ["wmctrl", "-l", "-x"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if result.returncode != 0:
            return None, f"wmctrl failed: {result.stderr.strip()}"
        lines = result.stdout.strip().split("\n") if result.stdout.strip() else []
        windows = []
        for line in lines:
            parts = line.split(None, 4)
            if len(parts) >= 5:
                win_id = parts[0]
                desktop = parts[1]
                win_class = parts[2]
                host = parts[3]
                title = parts[4]
                if title.startswith("xfce4-panel") or title.startswith("Plank") or win_class == "xfce4-panel":
                    continue
                windows.append({
                    "id": win_id,
                    "desktop": desktop,
                    "class": win_class,
                    "title": title
                })
        return windows, None
    except FileNotFoundError:
        return None, "wmctrl not installed. Install 'wmctrl' package for window overview."
    except subprocess.TimeoutExpired:
        return None, "wmctrl timed out"
    except Exception as e:
        return None, f"Error getting windows: {e}"


def get_active_workspace():
    """Get current workspace number."""
    try:
        result = subprocess.run(
            ["wmctrl", "-d"],
            capture_output=True,
            text=True,
            timeout=2
        )
        for line in result.stdout.strip().split("\n"):
            if "*" in line:
                return int(line.split()[0])
    except Exception:
        pass
    return 0


def get_active_window_id():
    """Get currently active window ID using xprop."""
    try:
        result = subprocess.run(
            ["xprop", "-root", "_NET_ACTIVE_WINDOW"],
            capture_output=True,
            text=True,
            timeout=2
        )
        match = re.search(r"0x[0-9a-f]+", result.stdout)
        if match:
            return match.group(0)
    except Exception:
        pass
    return None


def get_workspace_count():
    """Get total number of workspaces."""
    try:
        result = subprocess.run(
            ["wmctrl", "-d"],
            capture_output=True,
            text=True,
            timeout=2
        )
        count = 0
        for line in result.stdout.strip().split("\n"):
            if line.strip():
                parts = line.split()
                if parts and parts[0].isdigit():
                    count = max(count, int(parts[0]) + 1)
        return max(count, 1)
    except Exception:
        return 1


def get_window_icon(win_class):
    """Map window class to icon."""
    icon_map = {
        "thunar": "folder",
        "firefox": "web-browser",
        "code": "text-editor",
        "terminal": "utilities-terminal",
        "xfce4-terminal": "utilities-terminal",
        "gedit": "text-editor",
        "mousepad": "text-editor",
        "galculator": "accessories-calculator",
        "pavucontrol": "audio-volume-high",
        "gnome-disks": "drive-harddisk",
        "rofi": "system-run",
        "skippy-xd": "preferences-system-windows",
        "gedit": "text-editor",
        "mousepad": "text-editor",
        "geany": "text-editor",
        "code-oss": "text-editor",
        "code-url-handler": "text-editor",
        "discord": "discord",
        "spotify": "spotify-client",
        "telegram": "telegram",
        "signal": "signal",
        "slack": "slack",
        "chrome": "web-browser",
        "chromium": "web-browser",
        "brave": "web-browser",
        "vivaldi": "web-browser",
        "thunderbird": "mail-client",
        "evolution": "mail-client",
        "libreoffice": "libreoffice-main",
        "soffice": "libreoffice-main",
        "gimp": "gimp",
        "inkscape": "inkscape",
        "blender": "blender",
        "virtualbox": "virtualbox",
        "vmware": "vmware",
        "qemu": "qemu",
        "docker": "docker",
        "container": "docker",
        "kvm": "qemu",
        "steam": "steam",
        "lutris": "lutris",
        "heroic": "heroic-games-launcher",
        "bottles": "bottles",
        "wine": "wine",
        "proton": "steam",
        "gnome-terminal": "utilities-terminal",
        "konsole": "utilities-terminal",
        "alacritty": "utilities-terminal",
        "kitty": "utilities-terminal",
        "wezterm": "utilities-terminal",
        "foot": "utilities-terminal",
        "tilix": "utilities-terminal",
        "terminator": "utilities-terminal",
        "guake": "utilities-terminal",
        "yakuake": "utilities-system",
        "xfce4-terminal": "utilities-terminal",
        "mate-terminal": "utilities-terminal",
        "gnome-terminal-server": "utilities-terminal",
    }
    cls = win_class.lower()
    for key, icon in icon_map.items():
        if key in cls:
            return icon
    return "application-x-executable"


def activate_window(win_id):
    """Activate (focus) a window."""
    try:
        subprocess.run(["wmctrl", "-i", "-a", win_id], timeout=2)
        return True
    except Exception:
        return False


def close_window(win_id):
    """Close a window gracefully."""
    try:
        subprocess.run(["wmctrl", "-i", "-c", win_id], timeout=2)
        return True
    except Exception:
        return False


def minimize_window(win_id):
    """Minimize a window."""
    try:
        subprocess.run(["wmctrl", "-i", "-r", win_id, "-b", "add,hidden"], timeout=2)
        return True
    except Exception:
        return False


def run_native_expose():
    """Run daemon-free skippy-xd expose across all virtual desktops."""
    skippy = shutil.which("skippy-xd")
    if not skippy:
        return False
    try:
        result = subprocess.run(
            [skippy, "--desktop", "-1"],
            timeout=30
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--native":
        if run_native_expose():
            return 0
        # Optional native backend failed or is unavailable: continue into
        # the existing rofi/wmctrl implementation instead of hard-failing.
        sys.argv = [sys.argv[0]]

    # Handle window actions from rofi
    if len(sys.argv) > 1:
        if sys.argv[1] == "--list":
            windows, err = get_windows()
            if err:
                print(f"Error: {err}", file=sys.stderr)
                return 1
            for w in windows or []:
                print(f"{w['id']}  Desk {w['desktop']}  {w['class']}  {w['title']}")
            return 0
        elif sys.argv[1] == "--activate" and len(sys.argv) > 2:
            return 0 if activate_window(sys.argv[2]) else 1
        elif sys.argv[1] == "--close" and len(sys.argv) > 2:
            return 0 if close_window(sys.argv[2]) else 1
        elif sys.argv[1] == "--minimize" and len(sys.argv) > 2:
            return 0 if minimize_window(sys.argv[2]) else 1

    windows, err = get_windows()
    if err:
        print(f"Error\0icon\x1fdialog-error\0info\x1f{err}")
        return 0
    if not windows:
        print("No windows\0icon\x1fdialog-information\0info\x1fNo windows found")
        return 0

    active_ws = get_active_workspace()
    active_win = get_active_window_id()
    ws_count = get_workspace_count()

    by_desktop = {}
    for w in windows:
        desk = w["desktop"]
        if desk not in by_desktop:
            by_desktop[desk] = []
        by_desktop[desk].append(w)

    desks = sorted(by_desktop.keys())
    if active_ws in desks:
        desks.remove(active_ws)
        desks.insert(0, active_ws)

    for i in range(ws_count):
        if str(i) not in by_desktop:
            by_desktop[str(i)] = []
            if str(i) not in desks:
                desks.append(str(i))

    for desk in desks:
        ws_label = f"Desktop {desk}"
        if desk == str(active_ws):
            ws_label += " ●"
            print(f"{ws_label}\0class\x1factive")
        else:
            print(ws_label)
        if not by_desktop[desk]:
            print("(empty)\0icon\x1fworkspace\0info\x1fWorkspace {desk} is empty".format(desk=desk))
        for w in by_desktop[desk]:
            icon = get_window_icon(w["class"])
            is_active = w["id"].lower() == (active_win or "").lower()
            title = w["title"]
            if is_active:
                title = "▸ " + title
            info = f"Workspace {w['desktop']} — {w['class']}"
            if is_active:
                info += " (active)"
            print(f"{title}\0icon\x1f{icon}\0info\x1f{info}\0meta\x1f{w['id']}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
