def activate_window(win_id):
    """Activate (focus) a window."""
    try:
        subprocess.run(["wmctrl", "-i", "-a", win_id], timeout=2)
        return True
    except Exception:
        return False


def close_window(win_id):
    """Close a window gracefully."""
    try:
        subprocess.run(["wmctrl", "-i", "-c", win_id], timeout=2)
        return True
    except Exception:
        return False


def minimize_window(win_id):
    """Minimize a window."""
    try:
        subprocess.run(["wmctrl", "-i", "-r", win_id, "-b", "add,hidden"], timeout=2)
        return True
    except Exception:
        return False


def run_native_expose():
    """Run daemon-free skippy-xd expose across all virtual desktops."""
    skippy = shutil.which("skippy-xd")
    if not skippy:
        return False
    try:
        result = subprocess.run(
            [skippy, "--expose", "--desktop", "-1"],
            timeout=30
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False
)