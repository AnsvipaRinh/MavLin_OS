#!/usr/bin/env python3
"""mv-mission-control — Window overview for rofi script mode.
Lists all open windows across workspaces, allows selection and window actions.
Features:
- Lists all windows across all workspaces
- Shows window title, class, workspace
- Click/Enter to activate window
- Right-click/context for window actions (Close, Minimize)
- Escape to cancel
- Groups by workspace with active workspace first
- Shows active window indicator
- Shows empty workspaces
- Graceful handling when wmctrl unavailable
"""
import sys
import subprocess
import re
import shutil


def get_windows():
    """Get all windows using wmctrl."""
    try:
        result = subprocess.run(
            ["wmctrl", "-l", "-x"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if result.returncode != 0:
            return None, f"wmctrl failed: {result.stderr.strip()}"
        lines = result.stdout.strip().split("\n") if result.stdout.strip() else []
        windows = []
        for line in lines:
            parts = line.split(None, 4)
            if len(parts) >= 5:
                win_id = parts[0]
                desktop = parts[1]
                win_class = parts[2]
                host = parts[3]
                title = parts[4]
                # Skip special windows
                if title.startswith("xfce4-panel") or title.startswith("Plank") or win_class == "xfce4-panel":
                    continue
                windows.append({
                    "id": win_id,
                    "desktop": desktop,
                    "class": win_class,
                    "title": title
                })
        return windows, None
    except FileNotFoundError:
        return None, "wmctrl not installed. Install 'wmctrl' package for window overview."
    except subprocess.TimeoutExpired:
        return None, "wmctrl timed out"
    except Exception as e:
        return None, f"Error getting windows: {e}"


def get_active_workspace():
    """Get current workspace number."""
    try:
        result = subprocess.run(
            ["wmctrl", "-d"],
            capture_output=True,
            text=True,
            timeout=2
        )
        for line in result.stdout.strip().split("\n"):
            if "*" in line:
                return int(line.split()[0])
    except Exception:
        pass
    return 0


def get_active_window_id():
    """Get currently active window ID using xprop."""
    try:
        result = subprocess.run(
            ["xprop", "-root", "_NET_ACTIVE_WINDOW"],
            capture_output=True,
            text=True,
            timeout=2
        )
        match = re.search(r"0x[0-9a-f]+", result.stdout)
        if match:
            return match.group(0)
    except Exception:
        pass
    return None


def get_workspace_count():
    """Get total number of workspaces."""
    try:
        result = subprocess.run(
            ["wmctrl", "-d"],
            capture_output=True,
            text=True,
            timeout=2
        )
        count = 0
        for line in result.stdout.strip().split("\n"):
            if line.strip():
                parts = line.split()
                if parts and parts[0].isdigit():
                    count = max(count, int(parts[0]) + 1)
        return max(count, 1)
    except Exception:
        return 1


