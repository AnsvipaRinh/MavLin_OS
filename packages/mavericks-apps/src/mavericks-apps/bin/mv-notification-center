import sys
#!/usr/bin/env python3
"""mv-notification-center — Mavericks-style Notification Center.

History viewer for notifications logged by mv-notify-send.
Groups by app, supports clear actions, DND status, keyboard navigation.
No persistent daemon; reads JSON log on demand. License: GPL-2.0-or-later.
"""
import json, os, sys, time
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

STORE_FILE = os.path.expanduser("~/.local/share/mavericks/notifications.json")

def load_notifications():
    try:
        with open(STORE_FILE) as f:
            data = json.load(f)
            if isinstance(data, list):
                return data
    except (OSError, ValueError):
        pass
    return []

def get_dnd_status():
    """Check if Do Not Disturb is enabled via xfconf."""
    try:
        import subprocess
        result = subprocess.run(
            ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb"],
            capture_output=True, text=True, timeout=2
        )
        return result.stdout.strip() == "true"
    except Exception:
        return False

def set_dnd_status(enabled):
    """Toggle Do Not Disturb via xfconf."""
    try:
        import subprocess
        subprocess.run(
            ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb",
             "-s", "true" if enabled else "false"],
            check=False, timeout=2
        )
    except Exception:
        pass

def format_time(timestamp):
    """Format timestamp as relative time (Mavericks style)."""
    now = int(time.time())
    diff = now - timestamp
    if diff < 60:
        return "Just now"
    elif diff < 3600:
        return f"{diff // 60} min ago"
    elif diff < 86400:
        return f"{diff // 3600} hours ago"
    else:
        return time.strftime("%b %d, %Y", time.localtime(timestamp))

def get_urgency_color(urgency):
    colors = {"low": "#888888", "normal": "#333333", "critical": "#cc0000"}
    return colors.get(urgency, "#333333")

class NotificationCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Notification Center", type=Gtk.WindowType.TOPLEVEL)
        self.set_default_size(420, 600)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)

        # Header bar
        hb = Gtk.HeaderBar(title="Notification Center", show_close_button=True)
        hb.set_subtitle("Notifications")
        self.set_titlebar(hb)

        # DND toggle
        self.dnd_switch = Gtk.Switch()
        self.dnd_switch.set_active(get_dnd_status())
        self.dnd_switch.connect("notify::active", self.on_dnd_toggle)
        dnd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        dnd_box.pack_start(Gtk.Label(label="Do Not Disturb"), False, False, 0)
        dnd_box.pack_start(self.dnd_switch, False, False, 0)
        hb.pack_end(dnd_box)

        # Clear all button
        clear_btn = Gtk.Button(label="Clear All")
        clear_btn.connect("clicked", self.on_clear_all)
        clear_btn.get_style_context().add_class("destructive-action")
        hb.pack_end(clear_btn)

        # Main scrolled window
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scrolled)

        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.main_box.set_border_width(0)
        scrolled.add(self.main_box)

        # Key events
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)

        self.refresh()

    def refresh(self):
        # Clear existing
        for child in self.main_box.get_children():
            self.main_box.remove(child)

        notifications = load_notifications()
        if not notifications:
            self.show_empty_state()
            return

        # Group by app
        grouped = {}
        for n in reversed(notifications):  # Newest first
            app = n.get("app_name", "System")
            grouped.setdefault(app, []).append(n)

        for app_name, items in grouped.items():
            self.add_app_section(app_name, items)

        self.show_all()

    def show_empty_state(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_border_width(32)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)

        icon = Gtk.Image.new_from_icon_name("mail-read", Gtk.IconSize.DIALOG)
        icon.get_style_context().add_class("dim-label")
        box.pack_start(icon, False, False, 0)

        label = Gtk.Label(label="No Notifications")
        label.get_style_context().add_class("title")
        box.pack_start(label, False, False, 0)

        sub = Gtk.Label(label="Notifications will appear here")
        sub.get_style_context().add_class("dim-label")
        box.pack_start(sub, False, False, 0)

        self.main_box.pack_start(box, True, True, 0)

    def add_app_section(self, app_name, items):
        # Section frame
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        frame.add(section)

        # Section header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.set_border_width(12)
        header.set_size_request(-1, 40)

        label = Gtk.Label()
        label.set_markup(f"<b>{GLib.markup_escape_text(app_name)}</b>")
        label.set_xalign(0)
        header.pack_start(label, True, True, 0)

        # Clear app button
        clear_btn = Gtk.Button(label="Clear")
        clear_btn.set_size_request(60, -1)
        clear_btn.connect("clicked", lambda _: self.clear_app(app_name))
        clear_btn.get_style_context().add_class("destructive-action")
        header.pack_end(clear_btn, False, False, 0)

        section.pack_start(header, False, False, 0)

        # Separator
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        section.pack_start(sep, False, False, 0)

        # Notifications list
        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        for item in items:
            listbox.add(self.create_notification_row(item, app_name))
        section.pack_start(listbox, False, False, 0)

        self.main_box.pack_start(frame, False, False, 0)

    def create_notification_row(self, item, app_name):
        row = Gtk.ListBoxRow()
        row.set_activatable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_border_width(12)

        # App icon or urgency indicator
        icon_name = item.get("icon") or "dialog-information"
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        box.pack_start(icon, False, False, 0)

        # Content
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        content.set_hexpand(True)

        # Summary + time
        summary_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        summary = Gtk.Label()
        summary_text = item.get("summary", "")
        summary.set_markup(f"<b>{GLib.markup_escape_text(summary_text)}</b>")
        summary.set_xalign(0)
        summary.set_ellipsize(3)
        summary_box.pack_start(summary, True, True, 0)

        time_lbl = Gtk.Label(label=format_time(item.get("timestamp", 0)))
        time_lbl.get_style_context().add_class("dim-label")
        time_lbl.set_xalign(1)
        summary_box.pack_start(time_lbl, False, False, 0)

        content.pack_start(summary_box, False, False, 0)

        # Body
        body_text = item.get("body", "")
        if body_text:
            body = Gtk.Label(label=body_text)
            body.set_xalign(0)
            body.set_line_wrap(True)
            body.set_max_width_chars(50)
            body.get_style_context().add_class("dim-label")
            content.pack_start(body, False, False, 0)

        box.pack_start(content, True, True, 0)

        row.add(box)
        return row

    def clear_app(self, app_name):
        """Clear all notifications for a specific app."""
        data = load_notifications()
        filtered = [n for n in data if n.get("app_name", "System") != app_name]
        self.save_filtered(filtered)
        self.refresh()

    def on_clear_all(self, _):
        self.save_filtered([])
        self.refresh()

    def save_filtered(self, data):
        os.makedirs(os.path.dirname(STORE_FILE), exist_ok=True)
        tmp = STORE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, STORE_FILE)

    def on_dnd_toggle(self, switch, _):
        set_dnd_status(switch.get_active())

    def on_key_press(self, widget, event):
        if event.keyval == 65307:  # Escape
            Gtk.main_quit()
            return True
        return False

    def on_focus_out(self, widget, event):
        Gtk.main_quit()
        return True

def main():
    w = NotificationCenter()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()
    return 0

if __name__ == "__main__":
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    sys.exit(run_application(
        "com.mavlinos.NotificationCenter", "Notification Center", NotificationCenter, sys.argv))
