#!/usr/bin/env python3
"""mv-notification-center — Mavericks-style Notification Center.

History viewer for notifications logged by mv-notify-send.
Groups by app, supports clear actions, DND status, keyboard navigation.
No persistent daemon; reads JSON log on demand. License: GPL-2.0-or-later.
"""
import fcntl, json, os, re, subprocess, sys, time
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

STORE_FILE = os.path.expanduser("~/.local/share/mavericks/notifications.json")
LOCK_FILE = os.path.expanduser("~/.local/share/mavericks/notifications.lock")

def load_notifications():
    try:
        with open(STORE_FILE) as f:
            data = json.load(f)
            if isinstance(data, list):
                return data
    except (OSError, ValueError):
        pass
    return []

def get_dnd_status():
    """Read Do Not Disturb from xfconf, creating the property only if absent."""
    try:
        import subprocess
        result = subprocess.run(
            ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb"],
            capture_output=True, text=True, timeout=2
        )
        if result.returncode == 0:
            return result.stdout.strip() == "true"
        subprocess.run(
            ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb",
             "--create", "--type", "bool", "--set", "false"],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
        )
    except Exception:
        pass
    return False

def set_dnd_status(enabled):
    """Set Do Not Disturb, creating the xfconf property when necessary."""
    try:
        import subprocess
        value = "true" if enabled else "false"
        result = subprocess.run(
            ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb", "-s", value],
            capture_output=True, text=True, timeout=2
        )
        if result.returncode != 0:
            subprocess.run(
                ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb",
                 "--create", "--type", "bool", "--set", value],
                check=False, timeout=2
            )
    except Exception:
        pass

def format_time(timestamp):
    """Format timestamp as relative time (Mavericks style)."""
    now = int(time.time())
    diff = now - timestamp
    if diff < 60:
        return "Just now"
    elif diff < 3600:
        return f"{diff // 60} min ago"
    elif diff < 86400:
        return f"{diff // 3600} hours ago"
    else:
        return time.strftime("%b %d, %Y", time.localtime(timestamp))

def get_urgency_color(urgency):
    colors = {"low": "#888888", "normal": "#333333", "critical": "#cc0000"}
    return colors.get(urgency, "#333333")

def _entry_ts(entry):
    """Timestamp used for ordering history entries (missing/bad -> 0)."""
    try:
        return int(entry.get("timestamp", 0) or 0)
    except (TypeError, ValueError):
        return 0

def _walk_widgets(widget):
    """Yield widget and all of its descendants (depth-first)."""
    yield widget
    if isinstance(widget, Gtk.Container):
        for child in widget.get_children():
            yield from _walk_widgets(child)

def _draw_urgency_dot(area, cr, rgba):
    """Render the urgency accent dot as a rounded filled capsule."""
    w = area.get_allocated_width()
    h = area.get_allocated_height()
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, rgba.alpha)
    cr.arc(w / 2.0, h / 2.0, max(2.0, min(w, h) / 2.0), 0, 2 * 3.141592653589793)
    cr.fill()
    return False

class NotificationCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Notification Center", type=Gtk.WindowType.TOPLEVEL)
        self.set_default_size(420, 600)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.connect("realize", self.position_panel)

        # Header bar
        hb = Gtk.HeaderBar(title="Notification Center", show_close_button=True)
        hb.set_subtitle("Notifications")
        self.set_titlebar(hb)

        # DND toggle
        self.dnd_switch = Gtk.Switch()
        self.dnd_switch.set_active(get_dnd_status())
        self.dnd_switch.connect("notify::active", self.on_dnd_toggle)
        dnd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        dnd_box.pack_start(Gtk.Label(label="Do Not Disturb"), False, False, 0)
        dnd_box.pack_start(self.dnd_switch, False, False, 0)
        hb.pack_end(dnd_box)

        # Clear all button
        clear_btn = Gtk.Button(label="Clear All")
        clear_btn.connect("clicked", self.on_clear_all)
        clear_btn.get_style_context().add_class("destructive-action")
        hb.pack_end(clear_btn)

        # Main scrolled window
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scrolled)

        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.main_box.set_border_width(0)
        scrolled.add(self.main_box)

        # Key events
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-in-event", self.on_focus_in)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("map", lambda *_: setattr(self, "_shown_at", time.monotonic()))

        self.refresh()

    def position_panel(self, _window):
        """Place Notification Center at the right edge of the active monitor."""
        window = self.get_window()
        if window is None:
            return
        screen = self.get_screen()
        monitor = screen.get_monitor_at_window(window)
        workarea = screen.get_monitor_workarea(monitor)
        width = min(420, max(320, workarea.width // 4))
        self.set_default_size(width, workarea.height)
        self.resize(width, workarea.height)
        self.move(workarea.x + workarea.width - width, workarea.y)

    def refresh(self):
        # Clear existing
        for child in self.main_box.get_children():
            self.main_box.remove(child)

        notifications = load_notifications()
        if not notifications:
            self.show_empty_state()
            return

        # Group by app, newest first within each app, and order the app
        # sections by their own newest entry.
        # mv-notify-send appends chronologically under a lock, so reversing
        # the log used to be enough; ordering by the recorded timestamp makes
        # it hold even if the log was restored, hand-edited, or written across
        # a backwards clock step.
        grouped = {}
        for n in notifications:
            app = n.get("app_name", "System")
            grouped.setdefault(app, []).append(n)

        ordered = sorted(grouped.items(),
                         key=lambda kv: max(_entry_ts(n) for n in kv[1]),
                         reverse=True)
        for app_name, items in ordered:
            self.add_app_section(app_name, sorted(items, key=_entry_ts, reverse=True))

        self.show_all()

    def show_empty_state(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_border_width(32)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)

        icon = Gtk.Image.new_from_icon_name("mail-read", Gtk.IconSize.DIALOG)
        icon.get_style_context().add_class("dim-label")
        box.pack_start(icon, False, False, 0)

        label = Gtk.Label(label="No Notifications")
        label.get_style_context().add_class("title")
        box.pack_start(label, False, False, 0)

        sub = Gtk.Label(label="Notifications will appear here")
        sub.get_style_context().add_class("dim-label")
        box.pack_start(sub, False, False, 0)

        self.main_box.pack_start(box, True, True, 0)

    def add_app_section(self, app_name, items):
        # Section frame
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        frame.add(section)

        # Section header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.set_border_width(12)
        header.set_size_request(-1, 40)

        label = Gtk.Label()
        label.set_markup(f"<b>{GLib.markup_escape_text(app_name)}</b>")
        label.set_xalign(0)
        header.pack_start(label, True, True, 0)

        # Clear app button
        clear_btn = Gtk.Button(label="Clear")
        clear_btn.set_size_request(60, -1)
        clear_btn.connect("clicked", lambda _: self.clear_app(app_name))
        clear_btn.get_style_context().add_class("destructive-action")
        header.pack_end(clear_btn, False, False, 0)

        section.pack_start(header, False, False, 0)

        # Separator
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        section.pack_start(sep, False, False, 0)

        # Notifications list
        # SelectionMode.SINGLE is what makes the panel keyboard-operable:
        # with NONE (the previous value) the rows could not receive a cursor,
        # so arrow keys moved nothing and Enter never activated an entry —
        # the only dismissal paths were the close button and Escape.
        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        for item in items:
            listbox.add(self.create_notification_row(item, app_name))
        listbox.connect("row-activated", self.on_row_activated)
        section.pack_start(listbox, False, False, 0)

        self.main_box.pack_start(frame, False, False, 0)

    def create_notification_row(self, item, app_name):
        row = Gtk.ListBoxRow()
        row.set_activatable(True)
        row.connect("activate", self.on_row_activated, item)
        # The entry rides along with the widget so keyboard activation
        # (ListBox "row-activated", which passes only the row) can find it.
        # PyGObject rejects set_data/get_data, so use a plain attribute.
        row._mav_entry = item

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_border_width(12)

        # Urgency marker: normal notifications carry no dot (Mavericks shows
        # the bare row), while critical/low get a colour-coded accent so a
        # critical entry is distinguishable without reading the text.
        urgency = item.get("urgency", "normal")
        if urgency in ("critical", "low"):
            dot = Gtk.DrawingArea()
            dot.set_size_request(8, 8)
            dot.set_valign(Gtk.Align.START)
            color = get_urgency_color(urgency)
            rgba = Gdk.RGBA()
            rgba.parse(color)
            dot.connect("draw", _draw_urgency_dot, rgba)
            box.pack_start(dot, False, False, 0)

        # App icon or urgency indicator
        icon_name = item.get("icon") or "dialog-information"
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        icon.set_valign(Gtk.Align.START)
        box.pack_start(icon, False, False, 0)

        # Content
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        content.set_hexpand(True)

        # Summary + time
        summary_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        summary = Gtk.Label()
        summary_text = item.get("summary", "")
        summary.set_markup(f"<b>{GLib.markup_escape_text(summary_text)}</b>")
        summary.set_xalign(0)
        summary.set_ellipsize(3)
        summary_box.pack_start(summary, True, True, 0)

        time_lbl = Gtk.Label(label=format_time(item.get("timestamp", 0)))
        time_lbl.get_style_context().add_class("dim-label")
        time_lbl.set_xalign(1)
        time_lbl.set_valign(Gtk.Align.CENTER)
        summary_box.pack_end(time_lbl, False, False, 0)

        content.pack_start(summary_box, False, False, 0)

        # Body
        body_text = item.get("body", "")
        if body_text:
            body = Gtk.Label(label=body_text)
            body.set_xalign(0)
            body.set_line_wrap(True)
            body.set_max_width_chars(50)
            body.get_style_context().add_class("dim-label")
            content.pack_start(body, False, False, 0)

        box.pack_start(content, True, True, 0)

        # Per-notification dismiss (Mavericks: ✕ per entry). Removes exactly
        # this entry by id — the history log already carries one, so this
        # needs no second daemon and no extra bookkeeping.
        dismiss = Gtk.Button()
        dismiss.set_relief(Gtk.ReliefStyle.NONE)
        dismiss.set_focus_on_click(False)
        dismiss.set_valign(Gtk.Align.START)
        dismiss.add(Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.MENU))
        dismiss.get_style_context().add_class("dismiss-notification")
        dismiss.set_tooltip_text("Dismiss this notification")
        dismiss.connect("clicked", self.on_dismiss_clicked, item)
        box.pack_end(dismiss, False, False, 0)

        row.add(box)
        return row

    def on_dismiss_clicked(self, _button, item):
        self.dismiss_entry(item.get("id"))

    def on_row_activated(self, widget, row=None, item=None):
        """Open an actionable notification target when the entry contains one.

        Bound both to ListBoxRow "activate" (with the entry) and to ListBox
        "row-activated" (which only passes the row), so pointer activation and
        keyboard Enter share one code path.
        """
        if item is None:
            item = self._item_for_row(row) if row is not None else None
        if item is None:
            return False
        return self.open_notification_target(item)

    def _item_for_row(self, row):
        """Recover the log entry backing a ListBoxRow.

        GtkListBox "row-activated" only passes the row, so the entry travels
        with the widget as an attribute. Matching on label text instead would
        collide on duplicate summaries.
        """
        if row is None:
            return None
        return getattr(row, "_mav_entry", None)

    def open_notification_target(self, item):
        """Open an actionable notification target when the entry contains one."""
        hints = item.get("hints") or {}
        candidates = []
        for key in ("x-mavlinos-url", "url", "x-url", "desktop-entry"):
            value = hints.get(key)
            if value:
                candidates.append(value)
        body = item.get("body", "")
        candidates.extend(re.findall(r"https?://[^\s<>]+", body))
        for target in candidates:
            if target.startswith(("http://", "https://")):
                try:
                    subprocess.Popen(
                        ["xdg-open", target],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                except OSError:
                    pass
                return True

        desktop_id = hints.get("desktop-entry", "")
        if desktop_id and re.fullmatch(r"[A-Za-z0-9._-]+", desktop_id):
            try:
                subprocess.Popen(
                    ["gtk-launch", desktop_id],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except OSError:
                pass
            return True
        return False

    def clear_app(self, app_name):
        """Clear all notifications for a specific app."""
        def keep(item):
            return item.get("app_name", "System") != app_name
        self.mutate_history(keep)
        self.refresh()

    def dismiss_entry(self, entry_id):
        """Remove exactly one notification from history, by its log id."""
        if not entry_id:
            return
        def keep(item):
            return item.get("id") != entry_id
        self.mutate_history(keep)
        self.refresh()

    def on_clear_all(self, _):
        self.mutate_history(lambda _item: False)
        self.refresh()

    def mutate_history(self, keep):
        """Atomically read, filter, and replace notification history."""
        os.makedirs(os.path.dirname(STORE_FILE), exist_ok=True)
        with open(LOCK_FILE, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = load_notifications()
            filtered = [item for item in data if keep(item)]
            tmp = STORE_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(filtered, f, ensure_ascii=False)
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp, 0o600)
            os.replace(tmp, STORE_FILE)
        os.chmod(STORE_FILE, 0o600)

    def on_dnd_toggle(self, switch, _):
        set_dnd_status(switch.get_active())

    # Keys that should act on the notification cursor. Delete/BackSpace
    # dismiss the selected entry — the keyboard equivalent of the row ✕.
    _NAV_KEYVALS = (Gdk.KEY_Down, Gdk.KEY_Up, Gdk.KEY_Delete, Gdk.KEY_BackSpace)
    _DISMISS_KEYVALS = (Gdk.KEY_Delete, Gdk.KEY_BackSpace)

    def on_key_press(self, widget, event):
        if event.keyval == 65307:  # Escape
            self.destroy()
            return True
        if event.keyval not in self._NAV_KEYVALS:
            return False
        selected = self._selected_row()
        if selected is None:
            # No cursor yet: the first navigation key seeds the top entry so
            # Down/Up/Delete work immediately, without a preceding click.
            return self._focus_first_row()
        if event.keyval in self._DISMISS_KEYVALS:
            item = self._item_for_row(selected)
            self.dismiss_entry(item.get("id") if item else None)
            return True
        # Already on a row: leave Up/Down to GtkListBox's own cursor movement.
        return False

    def _selected_row(self):
        for listbox in self._iter_listboxes():
            row = listbox.get_selected_row()
            if row is not None:
                return row
        return None

    def _iter_listboxes(self):
        return [n for n in _walk_widgets(self.main_box)
                if isinstance(n, Gtk.ListBox)]

    def _focus_first_row(self):
        for listbox in self._iter_listboxes():
            row = listbox.get_row_at_index(0)
            if row is not None:
                listbox.select_row(row)
                row.grab_focus()
                return True
        return False

    @staticmethod
    def _has_wm():
        """True when a window manager owns focus (EWMH _NET_SUPPORTING_WM_CHECK)."""
        try:
            root = Gdk.get_default_root_window()
            atom = Gdk.atom_intern("_NET_SUPPORTING_WM_CHECK", False)
            res = root.property_get(atom)
            return bool(res and res[0] and res[1])
        except Exception:
            return False

    def on_focus_in(self, widget, event):
        self._ever_focused = True
        return False

    def on_focus_out(self, widget, event):
        # Close on click-away — but only under a real window manager.
        # Without one (Xvfb smoke, CI, bare startx-less session) the X
        # server and GTK synthesize focus-in/out pairs on a stationary
        # panel: measured ~50% of launches, at 0.0–1.3 s after map, with
        # the pointer never moving. Those are not click-aways, and
        # treating them as such destroyed the panel at random. Without a
        # WM there is no trustworthy focus model, so focus-out is ignored
        # and Escape / the close button remain the dismissal paths.
        if not NotificationCenter._has_wm():
            return True
        if not getattr(self, "_ever_focused", False):
            return True
        if time.monotonic() - getattr(self, "_shown_at", time.monotonic()) < 0.8:
            return True
        self.destroy()
        return True

def main():
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    return run_application(
        "com.mavlinos.NotificationCenter", "Notification Center",
        NotificationCenter, sys.argv)

if __name__ == "__main__":
    sys.exit(main())
