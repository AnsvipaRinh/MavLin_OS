#!/usr/bin/env python3
"""Mavericks-style workspace count management.

Usage:
  mv-workspace-count          # Show current count
  mv-workspace-count get      # Show current count
  mv-workspace-count set N    # Set workspace count (1-16)
  mv-workspace-count add      # Add one workspace
  mv-workspace-count remove   # Remove one workspace (if > 1)

Mavericks limits: 1-16 workspaces (Spaces)
"""
import sys
import subprocess
import os

MIN_SPACES = 1
MAX_SPACES = 16
XFCE_WORKSPACES_FILE = os.path.expanduser("~/.config/xfce4/xfconf/xfce4-panel.xml")


def get_current_count():
    """Get current workspace count via wmctrl."""
    try:
        result = subprocess.run(
            ["wmctrl", "-d"],
            capture_output=True,
            text=True,
            check=True
        )
        return len([l for l in result.stdout.splitlines() if l.strip()])
    except (subprocess.CalledProcessError, FileNotFoundError):
        return 4  # Default


def set_count(count):
    """Set workspace count via xfconf-query."""
    if count < MIN_SPACES or count > MAX_SPACES:
        print(f"Error: Workspace count must be between {MIN_SPACES} and {MAX_SPACES}", file=sys.stderr)
        sys.exit(1)
    
    try:
        subprocess.run(
            ["xfconf-query", "-c", "xfce4-desktop", "-p", "/general/workspace_count", "-t", "int", "-s", str(count)],
            check=True,
            capture_output=True
        )
        print(f"Set workspace count to {count}")
    except subprocess.CalledProcessError as e:
        print(f"Error setting workspace count: {e}", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print("Error: xfconf-query not found", file=sys.stderr)
        sys.exit(1)


def add_workspace():
    """Add one workspace."""
    current = get_current_count()
    if current >= MAX_SPACES:
        print(f"Already at maximum workspaces ({MAX_SPACES})")
        sys.exit(0)
    set_count(current + 1)


def remove_workspace():
    """Remove one workspace (if > 1)."""
    current = get_current_count()
    if current <= MIN_SPACES:
        print(f"Already at minimum workspaces ({MIN_SPACES})")
        sys.exit(0)
    set_count(current - 1)


def main():
    if len(sys.argv) == 1 or (len(sys.argv) == 2 and sys.argv[1] == "get"):
        count = get_current_count()
        print(count)
        return
    
    if len(sys.argv) == 2:
        action = sys.argv[1]
        if action == "add":
            add_workspace()
        elif action == "remove":
            remove_workspace()
        else:
            print(f"Unknown action: {action}", file=sys.stderr)
            print(__doc__, file=sys.stderr)
            sys.exit(1)
    elif len(sys.argv) == 3 and sys.argv[1] == "set":
        try:
            count = int(sys.argv[2])
        except ValueError:
            print(f"Error: Invalid count: {sys.argv[2]}", file=sys.stderr)
            sys.exit(1)
        set_count(count)
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
