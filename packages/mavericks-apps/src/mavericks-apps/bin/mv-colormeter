#!/usr/bin/env python3
"""mv-colormeter — Mavericks-like Digital Color Meter.
Screen sampling via Gdk root-window reads (X11), aperture averaging
(1×1 … 25×25), pixel loupe, format switching (sRGB 8-bit / sRGB % /
Hex / HSV / Display P3), copy-to-clipboard, session palette with
.GPL export, keyboard control. On-demand process — a 100 ms timer runs
only while the window is open and only under X11; under Wayland the
window shows an explicit unavailable state instead of fake black
samples. Optional handoff to gcolor3 when installed.
"""
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

LOUPE_SIZE = 11
TICK_MS = 200

APERTURES = (
    ("1×1", 1), ("3×3", 3), ("5×5", 5), ("10×10", 10), ("25×25", 25),
)

FORMATS = (
    "sRGB 8-bit", "sRGB %", "Hex (sRGB)", "HSV (sRGB)", "Display P3",
)

WAYLAND_MSG = (
    "Live pixel sampling is unavailable under Wayland. "
    "Run under X11 (the Xfce default) to sample the screen.")

# Linear sRGB (D65) -> CIE XYZ -> linear Display P3 matrices.
# Reference: IEC 61966-2-1 (sRGB) and DCI-P3 primaries, D65 white point,
# as published in CSS Color 4 / ICC working-space conversion literature.
M_SRGB_TO_XYZ = (
    (0.4124564, 0.3575761, 0.1804375),
    (0.2126729, 0.7151522, 0.0721750),
    (0.0193339, 0.1191920, 0.9503041),
)
M_XYZ_TO_P3 = (
    (2.4934969, -0.9313836, -0.4027108),
    (-0.8294890, 1.7626641, 0.0236247),
    (0.0358458, -0.0761723, 0.9568845),
)


def _mat_vec(m, v):
    return [sum(m[row][col] * v[col] for col in range(3)) for row in range(3)]


def _srgb_decode(c):
    c = c / 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _srgb_encode(linear):
    if linear <= 0.0031308:
        c = 12.92 * linear
    else:
        c = 1.055 * (linear ** (1.0 / 2.4)) - 0.055
    return max(0, min(255, round(c * 255.0)))


def srgb_to_display_p3(r, g, b):
    """8-bit sRGB -> 8-bit Display P3 (D65). White/black are exact."""
    lin = [_srgb_decode(c) for c in (r, g, b)]
    xyz = _mat_vec(M_SRGB_TO_XYZ, lin)
    p3 = _mat_vec(M_XYZ_TO_P3, xyz)
    return tuple(_srgb_encode(c) for c in p3)


def rgb_to_hsv(r, g, b):
    """(0-255)^3 -> (hue deg 0-360, sat %, val %)."""
    rf, gf, bf = r / 255.0, g / 255.0, b / 255.0
    mx, mn = max(rf, gf, bf), min(rf, gf, bf)
    d = mx - mn
    if d == 0:
        h = 0.0
    elif mx == rf:
        h = (60.0 * ((gf - bf) / d) + 360.0) % 360.0
    elif mx == gf:
        h = 60.0 * ((bf - rf) / d) + 120.0
    else:
        h = 60.0 * ((rf - gf) / d) + 240.0
    s = 0.0 if mx == 0 else d / mx
    return (h, s * 100.0, mx * 100.0)


def format_color(r, g, b, fmt):
    if fmt == "sRGB 8-bit":
        return "%d, %d, %d" % (r, g, b)
    if fmt == "sRGB %":
        return "%d%%, %d%%, %d%%" % tuple(round(c / 255.0 * 100) for c in (r, g, b))
    if fmt == "Hex (sRGB)":
        return "#%02X%02X%02X" % (r, g, b)
    if fmt == "HSV (sRGB)":
        h, s, v = rgb_to_hsv(r, g, b)
        return "%d°, %d%%, %d%%" % (round(h), round(s), round(v))
    if fmt == "Display P3":
        return "%d, %d, %d" % srgb_to_display_p3(r, g, b)
    return "%d, %d, %d" % (r, g, b)


def parse_aperture(text):
    """'3×3' -> 3; anything else -> None."""
    if not text or "×" not in text:
        return None
    parts = text.split("×")
    if len(parts) != 2:
        return None
    try:
        w, h = int(parts[0]), int(parts[1])
    except ValueError:
        return None
    return w if w == h and w > 0 else None


def average_region(pixbuf, cx, cy, size):
    """Average a size×size block centered at (cx, cy), clamped to the
    pixbuf bounds. Returns (r, g, b) ints."""
    w, h = pixbuf.get_width(), pixbuf.get_height()
    pixels = pixbuf.get_pixels()
    rowstride = pixbuf.get_rowstride()
    nch = pixbuf.get_n_channels()
    if size > w or size > h or size < 1:
        size = max(1, min(size, w, h))
    half = size // 2
    x0 = max(0, min(int(cx) - half, w - size))
    y0 = max(0, min(int(cy) - half, h - size))
    rs = gs = bs = 0
    for row in range(y0, y0 + size):
        base = row * rowstride
        for col in range(x0, x0 + size):
            off = base + col * nch
            rs += pixels[off]
            gs += pixels[off + 1]
            bs += pixels[off + 2]
    n = size * size
    return (rs // n, gs // n, bs // n)


def detect_backend(display):
    name = type(display).__name__.lower()
    if "x11" in name:
        return "x11"
    if "wayland" in name:
        return "wayland"
    return "unknown"


def get_pointer_pos(display):
    """(x, y) pointer position or None. Seat API first (non-deprecated),
    Gdk.Display.get_pointer() as fallback."""
    try:
        seat = display.get_default_seat()
        device = seat.get_pointer()
        if device is not None and hasattr(device, "get_position"):
            pos = device.get_position()
            if pos is not None and len(pos) >= 3:
                return int(pos[1]), int(pos[2])
    except Exception:
        pass
    try:
        pos = display.get_pointer()
        if pos is not None and len(pos) >= 3:
            return int(pos[1]), int(pos[2])
    except Exception:
        pass
    return None


def sample_screen(display, x, y, aperture, loupe_size=LOUPE_SIZE):
    """Sample the screen at (x, y). Returns dict with keys
    avg ((r,g,b)|None), loupe (GdkPixbuf.Pixbuf|None), error (str|None)."""
    try:
        screen = display.get_default_screen()
        root = screen.get_root_window()
        w, h = root.get_width(), root.get_height()
        if w <= 0 or h <= 0:
            return {"avg": None, "loupe": None,
                    "error": "Screen geometry is unavailable."}
        x = max(0, min(int(x), w - 1))
        y = max(0, min(int(y), h - 1))
        size = max(1, min(aperture, w, h))
        half = size // 2
        bx = max(0, min(x - half, w - size))
        by = max(0, min(y - half, h - size))
        block = Gdk.pixbuf_get_from_window(root, bx, by, size, size)
        if block is None:
            return {"avg": None, "loupe": None,
                    "error": "Screen capture failed."}
        avg = average_region(block, size // 2, size // 2, size)
        loupe = None
        if loupe_size > 1:
            lsize = max(1, min(loupe_size, w, h))
            lhalf = lsize // 2
            lx = max(0, min(x - lhalf, w - lsize))
            ly = max(0, min(y - lhalf, h - lsize))
            lp = Gdk.pixbuf_get_from_window(root, lx, ly, lsize, lsize)
            if lp is not None:
                loupe = {"pixbuf": lp, "center": (x - lx, y - ly)}
        return {"avg": avg, "loupe": loupe, "error": None}
    except Exception as exc:
        return {"avg": None, "loupe": None,
                "error": "Sampling failed: %s" % exc}


def palettes_dir():
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return os.path.join(xdg, "mavericks", "palettes")
    return os.path.join(os.path.expanduser("~"), ".local", "share",
                        "mavericks", "palettes")


def write_gpl(path, name, colors):
    """Write a GIMP palette (.gpl). Returns error string or None."""
    try:
        parent = os.path.dirname(os.path.abspath(path))
        os.makedirs(parent, exist_ok=True)
        lines = ["GIMP Palette", "Name: %s" % name,
                 "Columns: %d" % max(1, min(16, len(colors))), "#"]
        lines += ["%d %d %d" % tuple(c) for c in colors]
        with open(path, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        return None
    except OSError as exc:
        return "Save failed: %s" % exc


def read_gpl(path):
    """Parse a .gpl file. Returns (name, colors) or None."""
    try:
        name = ""
        colors = []
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.lower().startswith("name:"):
                    name = line.split(":", 1)[1].strip()
                    continue
                if line.lower().startswith("columns:"):
                    continue
                parts = line.split()
                if len(parts) == 3:
                    try:
                        colors.append(tuple(int(p) for p in parts))
                    except ValueError:
                        continue
        if not colors:
            return None
        return (name or "Palette", colors)
    except OSError:
        return None


def draw_swatch(cr, rgba, w, h):
    cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1.0)
    cr.rectangle(0, 0, w, h)
    cr.fill()
    cr.set_source_rgba(0, 0, 0, 0.25)
    cr.set_line_width(1)
    cr.rectangle(0.5, 0.5, w - 1, h - 1)
    cr.stroke()


def draw_loupe(cr, loupe, w, h):
    """Draw the magnified neighborhood; outline the sampled center cell."""
    cr.set_source_rgb(0.996, 0.988, 0.973)
    cr.paint()
    if loupe is None:
        return
    pix = loupe["pixbuf"]
    pw, ph = pix.get_width(), pix.get_height()
    if pw < 1 or ph < 1:
        return
    pixels = pix.get_pixels()
    rowstride = pix.get_rowstride()
    nch = pix.get_n_channels()
    cell = min(w / pw, h / ph)
    ox = (w - cell * pw) / 2.0
    oy = (h - cell * ph) / 2.0
    for row in range(ph):
        base = row * rowstride
        for col in range(pw):
            off = base + col * nch
            cr.set_source_rgb(pixels[off] / 255.0,
                              pixels[off + 1] / 255.0,
                              pixels[off + 2] / 255.0)
            cr.rectangle(ox + col * cell, oy + row * cell, cell, cell)
            cr.fill()
    cx, cy = loupe["center"]
    if 0 <= cx < pw and 0 <= cy < ph:
        cr.set_source_rgba(0, 0, 0, 0.65)
        cr.set_line_width(2)
        cr.rectangle(ox + cx * cell, oy + cy * cell, cell, cell)
        cr.stroke()


class ColorMeterWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Digital Color Meter")
        self.set_default_size(400, 620)

        self.display = Gdk.Display.get_default()
        self.backend = detect_backend(self.display)
        self.current_color = Gdk.RGBA(0.9, 0.9, 0.9, 1.0)
        self.loupe = None
        self.locked = False
        self.locked_pos = None
        self.format_idx = 0
        self.palette = []

        self.apply_css()

        self.set_decorated(True)
        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        hb.get_style_context().add_class("mavericks-mv-colormeter-toolbar")
        title_label = Gtk.Label(label="Digital Color Meter")
        hb.pack_start(title_label, True, True, 8)
self.set_titlebar(hb)

        self.copy_btn = Gtk.Button.new_from_icon_name(
            "edit-copy", Gtk.IconSize.SMALL_TOOLBAR)
        self.copy_btn.set_tooltip_text("Copy Color (Ctrl+C)")
        self.copy_btn.connect("clicked", self.on_copy)
        hb.pack_start(self.copy_btn)

        self.add_btn = Gtk.Button.new_from_icon_name(
            "list-add", Gtk.IconSize.SMALL_TOOLBAR)
        self.add_btn.set_tooltip_text("Add to Palette (Ctrl+P)")
        self.add_btn.connect("clicked", self.on_add_palette)
        hb.pack_start(self.add_btn)

        self.save_btn = Gtk.Button.new_from_icon_name(
            "document-save", Gtk.IconSize.SMALL_TOOLBAR)
        self.save_btn.set_tooltip_text("Save Palette (.gpl) (Ctrl+S)")
        self.save_btn.connect("clicked", self.on_save_palette)
        hb.pack_start(self.save_btn)

        if shutil.which("gcolor3"):
            self.picker_btn = Gtk.Button.new_from_icon_name(
                "applications-graphics", Gtk.IconSize.SMALL_TOOLBAR)
            self.picker_btn.set_tooltip_text("Open in gcolor3 (Ctrl+O)")
            self.picker_btn.connect("clicked", self.on_open_picker)
            hb.pack_end(self.picker_btn)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_border_width(14)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.pack_start(hb, False, False, 0)
        root.pack_start(vbox, True, True, 0)
        self.add(root)

        self.swatch_area = Gtk.DrawingArea()
        self.swatch_area.set_size_request(-1, 90)
        self.swatch_area.get_style_context().add_class("colormeter-swatch")
        self.swatch_area.connect("draw", self.on_draw_swatch)
        vbox.pack_start(self.swatch_area, False, False, 0)

        self.loupe_area = Gtk.DrawingArea()
        self.loupe_area.set_size_request(-1, 132)
        self.loupe_area.get_style_context().add_class("colormeter-loupe")
        self.loupe_area.connect("draw", self.on_draw_loupe)
        vbox.pack_start(self.loupe_area, False, False, 0)

        self.value_label = Gtk.Label(label="RGB: —")
        self.value_label.get_style_context().add_class("colormeter-value")
        self.value_label.set_halign(Gtk.Align.START)
        vbox.pack_start(self.value_label, False, False, 0)

        self.hex_label = Gtk.Label(label="#——————")
        self.hex_label.get_style_context().add_class("colormeter-hex")
        self.hex_label.set_halign(Gtk.Align.START)
        vbox.pack_start(self.hex_label, False, False, 0)

        grid = Gtk.Grid(column_spacing=10, row_spacing=8)
        grid.set_margin_top(6)
        grid.attach(Gtk.Label(label="Aperture:", xalign=1), 0, 0, 1, 1)
        self.aperture = Gtk.ComboBoxText()
        for label, _size in APERTURES:
            self.aperture.append_text(label)
        self.aperture.set_active(0)
        self.aperture.connect("changed", self.on_aperture_changed)
        grid.attach(self.aperture, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Format:", xalign=1), 0, 1, 1, 1)
        self.format_combo = Gtk.ComboBoxText()
        for fmt in FORMATS:
            self.format_combo.append_text(fmt)
        self.format_combo.set_active(0)
        self.format_combo.connect("changed", self.on_format_changed)
        grid.attach(self.format_combo, 1, 1, 1, 1)

        self.lock_btn = Gtk.CheckButton(label="Lock Position")
        self.lock_btn.connect("toggled", self.on_lock_toggled)
        grid.attach(self.lock_btn, 0, 2, 2, 1)
        vbox.pack_start(grid, False, False, 0)

        self.palette_label = Gtk.Label(label="Palette (session):")
        self.palette_label.get_style_context().add_class("colormeter-hint")
        self.palette_label.set_halign(Gtk.Align.START)
        vbox.pack_start(self.palette_label, False, False, 0)

        self.swatches = Gtk.FlowBox()
        self.swatches.set_homogeneous(True)
        self.swatches.set_max_children_per_line(8)
        self.swatches.set_selection_mode(Gtk.SelectionMode.NONE)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_size_request(-1, 108)
        sw.add(self.swatches)
        vbox.pack_start(sw, False, False, 0)

        self.hint_label = Gtk.Label(
            label="Click a swatch to reload its color. "
                  "When locked, arrow keys move the aperture "
                  "(Shift = 8 px).")
        self.hint_label.get_style_context().add_class("colormeter-hint")
        self.hint_label.set_halign(Gtk.Align.START)
        self.hint_label.set_line_wrap(True)
        vbox.pack_start(self.hint_label, False, False, 0)

        self.status_bar = Gtk.InfoBar()
        self.status_bar.set_no_show_all(True)
        self.status_label = Gtk.Label(label="")
        self.status_bar.get_content_area().add(self.status_label)
        vbox.pack_start(self.status_bar, False, False, 0)

        self.connect("key-press-event", self.on_key_press)

        if self.backend == "wayland":
            self.show_message(WAYLAND_MSG, Gtk.MessageType.WARNING)
        elif self.backend == "unknown":
            self.show_message("Unknown display backend — live sampling "
                              "disabled.", Gtk.MessageType.WARNING)

        self.refresh_readouts()
        self.refresh_swatches()
        self.show_all()

        if self.backend == "x11":
            GLib.timeout_add(TICK_MS, self.tick)

    def apply_css(self):
        css = b"""
        .colormeter-window {
            background: #f5f0e8;
            background-image: linear-gradient(180deg, #f5f0e8 0%, #e8ddd0 100%);
        }
        .colormeter-value {
            font-family: "SF Mono", "Menlo", monospace;
            font-size: 11pt;
            color: #333;
        }
        .colormeter-hex {
            font-family: "SF Mono", "Menlo", monospace;
            font-size: 9pt;
            color: #77695c;
        }
        .colormeter-loupe {
            background: #fffdf8;
            border: 1px solid #d4c8b8;
            border-radius: 4px;
        }
        .colormeter-swatch {
            border: 1px solid #d4c8b8;
            border-radius: 4px;
        }
        .colormeter-hint {
            font-size: 9pt;
            color: #77695c;
        }
        """
        provider = Gtk.CssProvider()
        try:
            try:
                provider.load_from_data(css)
            except Exception:
                # cosmetic only: a bad rule must not kill the window
                pass
        except GLib.Error as exc:
            print("mv-colormeter: CSS load failed, using default theme: %s"
                  % exc.message, file=sys.stderr)
            return
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def show_message(self, text, mtype):
        self.status_bar.set_message_type(mtype)
        self.status_label.set_label(text)
        self.status_bar.show()

    def clear_status(self):
        self.status_bar.hide()

    def current_rgb(self):
        return (round(self.current_color.red * 255),
                round(self.current_color.green * 255),
                round(self.current_color.blue * 255))

    def aperture_size(self):
        return parse_aperture(self.aperture.get_active_text()) or 1

    def refresh_readouts(self):
        r, g, b = self.current_rgb()
        self.value_label.set_text(
            "%s: %s" % (FORMATS[self.format_idx],
                        format_color(r, g, b, FORMATS[self.format_idx])))
        self.hex_label.set_text("Hex: #%02X%02X%02X" % (r, g, b))

    def on_draw_swatch(self, area, cr):
        draw_swatch(cr, self.current_color,
                    area.get_allocated_width(), area.get_allocated_height())

    def on_draw_loupe(self, area, cr):
        draw_loupe(cr, self.loupe,
                   area.get_allocated_width(), area.get_allocated_height())

    def on_aperture_changed(self, combo):
        if self.locked and self.locked_pos is not None:
            self.tick()

    def on_format_changed(self, combo):
        self.format_idx = combo.get_active()
        self.refresh_readouts()

    def on_lock_toggled(self, btn):
        self.locked = btn.get_active()
        if self.locked:
            pos = self.locked_pos or get_pointer_pos(self.display)
            if pos is not None:
                self.locked_pos = pos
        else:
            self.locked_pos = None

    def on_key_press(self, widget, event):
        mod = event.state & Gtk.accelerator_get_default_mod_mask()
        if self.locked and event.keyval in (
                Gdk.KEY_Up, Gdk.KEY_Down,
                Gdk.KEY_Left, Gdk.KEY_Right):
            if mod & ~Gdk.ModifierType.SHIFT_MASK:
                return False
            step = 8 if event.state & Gdk.ModifierType.SHIFT_MASK else 1
            self.nudge(event.keyval, step)
            return True
        if mod == 0:
            if event.keyval == Gdk.KEY_Escape:
                self.destroy()
                return True
        if mod == Gdk.ModifierType.CONTROL_MASK:
            if event.keyval == Gdk.KEY_c:
                self.on_copy(None)
                return True
            if event.keyval == Gdk.KEY_p:
                self.on_add_palette(None)
                return True
            if event.keyval == Gdk.KEY_s:
                self.on_save_palette(None)
                return True
            if event.keyval == Gdk.KEY_o:
                self.on_open_picker(None)
                return True
            if Gdk.KEY_1 <= event.keyval <= Gdk.KEY_5:
                idx = event.keyval - Gdk.KEY_1
                if idx < len(FORMATS):
                    self.format_combo.set_active(idx)
                    return True
        return False

    def nudge(self, keyval, step):
        if self.locked_pos is None:
            return
        x, y = self.locked_pos
        if keyval == Gdk.KEY_Left:
            x -= step
        elif keyval == Gdk.KEY_Right:
            x += step
        elif keyval == Gdk.KEY_Up:
            y -= step
        elif keyval == Gdk.KEY_Down:
            y += step
        self.locked_pos = (max(0, x), max(0, y))
        self.tick()

    def tick(self):
        if self.backend != "x11":
            return True
        if self.locked and self.locked_pos is not None:
            x, y = self.locked_pos
        else:
            pos = get_pointer_pos(self.display)
            if pos is None:
                return True
            x, y = pos
            if self.locked and self.locked_pos is None:
                self.locked_pos = (x, y)
        res = sample_screen(self.display, x, y, self.aperture_size())
        if res["error"]:
            self.show_message(res["error"], Gtk.MessageType.ERROR)
            return True
        if res["avg"] is None:
            return True
        r, g, b = res["avg"]
        self.current_color = Gdk.RGBA(r / 255.0, g / 255.0, b / 255.0, 1.0)
        self.loupe = res["loupe"]
        self.refresh_readouts()
        self.swatch_area.queue_draw()
        self.loupe_area.queue_draw()
        return True

    def on_copy(self, button):
        r, g, b = self.current_rgb()
        text = format_color(r, g, b, FORMATS[self.format_idx])
        try:
            clipboard = Gtk.Clipboard.get_default(self.display)
            clipboard.set_text(text, -1)
            self.show_message("Copied %s" % text, Gtk.MessageType.INFO)
        except Exception as exc:
            self.show_message("Copy failed: %s" % exc, Gtk.MessageType.ERROR)

    def on_add_palette(self, button):
        color = self.current_rgb()
        if color in self.palette:
            self.show_message("Color %s is already in the palette."
                              % (format_color(*color, "Hex (sRGB)"),),
                              Gtk.MessageType.INFO)
            return
        self.palette.append(color)
        self.refresh_swatches()
        self.show_message(
            "Added %s — palette has %d colors."
            % (format_color(*color, "Hex (sRGB)"), len(self.palette)),
            Gtk.MessageType.INFO)

    def on_swatch_activate(self, widget, color):
        self.current_color = Gdk.RGBA(color[0] / 255.0, color[1] / 255.0,
                                     color[2] / 255.0, 1.0)
        self.refresh_readouts()
        self.swatch_area.queue_draw()
        self.loupe_area.queue_draw()

    def on_swatch_remove(self, color):
        if color in self.palette:
            self.palette.remove(color)
            self.refresh_swatches()

    def refresh_swatches(self):
        for child in self.swatches.get_children():
            self.swatches.remove(child)
        for color in self.palette:
            self.swatches.add(self.build_swatch(color))
        self.palette_label.set_text(
            "Palette (session): %d colors" % len(self.palette))

    def build_swatch(self, color):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        row.set_border_width(4)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        event = Gtk.EventBox()
        event.add(box)
        da = Gtk.DrawingArea()
        da.set_size_request(44, 30)
        rgba = Gdk.RGBA(color[0] / 255.0, color[1] / 255.0,
                        color[2] / 255.0, 1.0)

        def on_draw(area, cr, rgba=rgba):
            draw_swatch(cr, rgba, area.get_allocated_width(),
                        area.get_allocated_height())

        da.connect("draw", on_draw)
        box.pack_start(da, False, False, 0)
        lbl = Gtk.Label(label="%02X%02X%02X" % color)
        lbl.get_style_context().add_class("colormeter-swatch-label")
        box.pack_start(lbl, False, False, 0)
        event.connect("button-press-event",
                      lambda w, e, c=color: self.on_swatch_activate(w, c))
        row.pack_start(event, False, False, 0)
        remove = Gtk.Button(label="×")
        remove.set_relief(Gtk.ReliefStyle.NONE)
        remove.set_tooltip_text("Remove from palette")
        remove.connect("clicked", lambda b, c=color: self.on_swatch_remove(c))
        row.pack_start(remove, False, False, 0)
        return row

    def on_save_palette(self, button):
        if not self.palette:
            self.show_message("Palette is empty — add colors with Ctrl+P.",
                              Gtk.MessageType.WARNING)
            return
        dlg = Gtk.FileChooserDialog(
            title="Save Palette…", parent=self,
            action=Gtk.FileChooserAction.SAVE)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("Save", Gtk.ResponseType.OK)
        dlg.set_current_name("palette.gpl")
        dlg.set_do_overwrite_confirmation(True)
        filt = Gtk.FileFilter()
        filt.set_name("GIMP palette (*.gpl)")
        filt.add_pattern("*.gpl")
        dlg.add_filter(filt)
        response = dlg.run()
        path = dlg.get_filename() if response == Gtk.ResponseType.OK else None
        dlg.destroy()
        if not path:
            return
        if not path.endswith(".gpl"):
            path += ".gpl"
        err = write_gpl(path, "Mavericks Palette", self.palette)
        if err:
            self.show_message(err, Gtk.MessageType.ERROR)
        else:
            self.show_message("Saved %d colors to %s"
                              % (len(self.palette), path), Gtk.MessageType.INFO)

    def on_open_picker(self, button):
        if not shutil.which("gcolor3"):
            self.show_message(
                "gcolor3 is not installed. Install it with: "
                "sudo pacman -S gcolor3", Gtk.MessageType.ERROR)
            return
        try:
            subprocess.Popen(["gcolor3"])
        except OSError as exc:
            self.show_message("Could not launch gcolor3: %s" % exc,
                              Gtk.MessageType.ERROR)

    def handle_argv(self, args):
        for arg in args or []:
            text = arg.strip().lstrip("#")
            if len(text) == 6:
                try:
                    r, g, b = (int(text[i:i + 2], 16) for i in (0, 2, 4))
                except ValueError:
                    continue
                self.current_color = Gdk.RGBA(r / 255.0, g / 255.0,
                                             b / 255.0, 1.0)
                self.refresh_readouts()
                self.swatch_area.queue_draw()
                return


def main():
    w = ColorMeterWindow()
    # Use global-menu lifecycle via run_application
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    sys.exit(run_application(
        "com.mavlinos.colormeter", "Digital Color Meter", ColorMeterWindow, sys.argv))


if __name__ == "__main__":
    main()
