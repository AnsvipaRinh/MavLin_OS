#!/usr/bin/env python3
"""mv-colormeter — Mavericks-like Digital Color Meter wrapper for gcolor3.
Adds Mavericks visual theme and integration.
"""
import os
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

class ColorMeterWrapper(Gtk.Window):
    def __init__(self):
        super().__init__(title="Digital Color Meter")
        self.set_default_size(380, 280)
        
        self.apply_css()
        
        hb = Gtk.HeaderBar(title="Digital Color Meter", show_close_button=True)
        self.set_titlebar(hb)
        
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        vbox.set_border_width(16)
        self.add(vbox)
        
        self.color_area = Gtk.DrawingArea()
        self.color_area.set_size_request(200, 120)
        self.color_area.connect("draw", self.on_draw)
        vbox.pack_start(self.color_area, False, False, 0)
        
        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        grid.set_margin_top(12)
        
        self.rgb_label = Gtk.Label(label="RGB: 255, 255, 255")
        self.rgb_label.get_style_context().add_class("colormeter-value")
        grid.attach(Gtk.Label(label="RGB:", xalign=1), 0, 0, 1, 1)
        grid.attach(self.rgb_label, 1, 0, 1, 1)
        
        self.hex_label = Gtk.Label(label="Hex: #FFFFFF")
        self.hex_label.get_style_context().add_class("colormeter-value")
        grid.attach(Gtk.Label(label="Hex:", xalign=1), 0, 1, 1, 1)
        grid.attach(self.hex_label, 1, 1, 1, 1)
        
        self.hsv_label = Gtk.Label(label="HSV: 0°, 0%, 100%")
        self.hsv_label.get_style_context().add_class("colormeter-value")
        grid.attach(Gtk.Label(label="HSV:", xalign=1), 0, 2, 1, 1)
        grid.attach(self.hsv_label, 1, 2, 1, 1)
        
        vbox.pack_start(grid, False, False, 0)
        
        ap_grid = Gtk.Grid(column_spacing=8, row_spacing=8, margin_top=16)
        ap_grid.attach(Gtk.Label(label="Aperture:", xalign=1), 0, 0, 1, 1)
        self.aperture = Gtk.ComboBoxText()
        for size in ["1×1", "3×3", "5×5", "10×10", "25×25"]:
            self.aperture.append_text(size)
        self.aperture.set_active(0)
        ap_grid.attach(self.aperture, 1, 0, 1, 1)
        vbox.pack_start(ap_grid, False, False, 0)
        
        self.lock_btn = Gtk.CheckButton(label="Lock Position")
        self.lock_btn.set_active(True)
        vbox.pack_start(self.lock_btn, False, False, 0)
        
        self.apply_css()
        
        self.current_color = Gdk.RGBA(1, 1, 1, 1)
        GLib.timeout_add(100, self.update_color)
        
        self.show_all()

    def apply_css(self):
        css = b"""
        .colormeter-window {
            background: #f5f0e8;
            background-image: linear-gradient(135deg, #f5f0e8 0%, #e8ddd0 100%);
        }
        .colormeter-value {
            font-family: "SF Mono", "Menlo", monospace;
            font-size: 11pt;
            color: #333;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def on_draw(self, area, cr):
        cr.set_source_rgba(self.current_color.red, self.current_color.green, self.current_color.blue, self.current_color.alpha)
        cr.rectangle(0, 0, 200, 120)
        cr.fill()
        cr.set_source_rgba(0, 0, 0, 0.2)
        cr.set_line_width(1)
        cr.rectangle(0, 0, 200, 120)
        cr.stroke()

    def update_color(self):
        display = Gdk.Display.get_default()
        screen = display.get_default_screen()
        x, y = display.get_pointer()[:2]
        try:
            pixbuf = Gdk.pixbuf_get_from_window(screen.get_root_window(), x, y, 1, 1)
            if pixbuf:
                r, g, b = pixbuf.get_pixels()[0], pixbuf.get_pixels()[1], pixbuf.get_pixels()[2]
                self.current_color = Gdk.RGBA(r/255.0, g/255.0, b/255.0, 1.0)
                self.color_area.queue_draw()
                self.rgb_label.set_text(f"RGB: {r}, {g}, {b}")
                self.hex_label.set_text(f"Hex: #{r:02X}{g:02X}{b:02X}")
        except Exception:
            pass
        return True

import os
import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

if __name__ == "__main__":
    w = ColorMeterWrapper()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()