#!/usr/bin/env python3
"""mv-reminders — Reminders (Mavericks-like). Lists + tasks + due dates +
priorities + notifications. Local JSON storage
(~/.local/share/mv-reminders/tasks.json). No daemon, no Electron, no
network. Due-date nudges via user systemd TIMER (hourly, oneshot
notify-send, exits).
Mavericks visual: leather list sidebar, paper task list, custom
checkboxes, priority badges, overdue/due-today highlighting.
License: GPL-2.0-or-later."""
import json, os, subprocess, sys, time, uuid
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, Pango

STORE = os.path.expanduser("~/.local/share/mv-reminders/tasks.json")
PRIORITIES = ["", "Low", "Medium", "High"]


def now():
    return int(time.time())


def today_str():
    return time.strftime("%Y-%m-%d")


def make_task(title="New task", due="", prio=""):
    return {"id": uuid.uuid4().hex[:8], "title": title,
            "done": False, "due": due, "prio": prio}


def due_state(task):
    """overdue | today | future | none — done tasks are never overdue."""
    if task.get("done") or not task.get("due"):
        return "none"
    today = today_str()
    if task["due"] < today:
        return "overdue"
    if task["due"] == today:
        return "today"
    return "future"


def matches(task, query):
    """Case-insensitive title search used by the search filter."""
    if not query:
        return True
    return query.lower() in task.get("title", "").lower()


def _backup_path(path):
    return path + ".bak"


def _quarantine_path(path):
    return "%s.corrupt-%d" % (path, now())


def load_store(path=None, on_warn=None):
    path = path or STORE

    def warn(msg):
        if on_warn:
            on_warn(msg)

    if not os.path.exists(path):
        return _normalize({"lists": {"Reminders": []}})
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        bak = _backup_path(path)
        if os.path.exists(bak):
            try:
                with open(bak) as f:
                    data = json.load(f)
                warn("Reminders store was unreadable (%s); restored from backup." % e)
                return _normalize(data)
            except (OSError, ValueError):
                pass
        if os.path.exists(path):
            try:
                os.replace(path, _quarantine_path(path))
            except OSError:
                pass
        warn("Reminders store was unreadable (%s); the corrupt file was "
             "quarantined and a fresh store was started." % e)
        data = {"lists": {"Reminders": []}}
    return _normalize(data)


def _normalize(data):
    if not isinstance(data, dict):
        return {"lists": {"Reminders": []}, "geometry": {}}
    if not isinstance(data.get("lists"), dict):
        data["lists"] = {"Reminders": []}
    data.setdefault("geometry", {})
    for name in list(data["lists"]):
        if not isinstance(data["lists"][name], list):
            del data["lists"][name]
            continue
        for t in data["lists"][name]:
            if isinstance(t, dict):
                t.setdefault("id", uuid.uuid4().hex[:8])
                t.setdefault("title", "")
                t.setdefault("done", False)
                t.setdefault("due", "")
                t.setdefault("prio", "")
    return data


def save_store(path=None, data=None):
    path = path or STORE
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        try:
            os.replace(path, _backup_path(path))
        except OSError:
            pass
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def check_due():
    """Called by systemd timer: notify once per due/overdue task per day."""
    data = load_store()
    today = today_str()
    changed = False
    for lname, tasks in data["lists"].items():
        for t in tasks:
            if (not t.get("done") and t.get("due") and t["due"] <= today
                    and t.get("notified") != today):
                subprocess.run(["notify-send", "Reminder — %s" % lname,
                                t["title"]])
                t["notified"] = today
                changed = True
    if changed:
        save_store(data=data)


class Reminders(Gtk.Window):
    def __init__(self):
        super().__init__(title="Reminders")
        self.store_warnings = []
        self.data = load_store(STORE, self.store_warnings.append)
        g = self.data.get("geometry", {})
        if g.get("w") and g.get("h"):
            self.set_default_size(g["w"], g["h"])
            self.move(g.get("x", 100), g.get("y", 100))
        else:
            self.set_default_size(800, 520)
        self.apply_mavericks_css()

        hb = Gtk.HeaderBar(title="Reminders", show_close_button=True)
        self.set_titlebar(hb)
        for label, cb in [("+ List", self.add_list), ("+ Task", self.add_task)]:
            b = Gtk.Button(label=label)
            b.get_style_context().add_class("mavericks-toolbar-btn")
            b.connect("clicked", cb)
            hb.pack_end(b)
        self.search = Gtk.SearchEntry(placeholder_text="Search")
        # "changed" (not "search-changed"): fires on programmatic
        # set_text too — same fix as mv-notes
        self.search.connect("changed", self.on_search)
        hb.pack_start(self.search)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        # === LIST SIDEBAR (Leather texture) ===
        self.lstore = Gtk.ListStore(str, bool)  # name, is_selected
        ltv = Gtk.TreeView(model=self.lstore, headers_visible=False)
        renderer = Gtk.CellRendererText()
        renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
        col = Gtk.TreeViewColumn("", renderer, text=0)
        col.set_cell_data_func(renderer, self.render_list_cell)
        ltv.append_column(col)
        ltv.get_selection().connect("changed", self.on_list)
        ltv.connect("button-press-event", self.on_list_button)
        sw1 = Gtk.ScrolledWindow()
        sw1.set_size_request(180, -1)
        sw1.get_style_context().add_class("reminders-list-sidebar")
        sw1.add(ltv)
        paned.add1(sw1)
        self.ltv = ltv

        # === TASK LIST (Paper texture) ===
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        tb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        tb.set_border_width(6)
        clear_b = Gtk.Button(label="Clear Completed")
        clear_b.get_style_context().add_class("mavericks-toolbar-btn")
        clear_b.connect("clicked", self.clear_completed)
        tb.pack_start(clear_b, False, False, 0)
        right.pack_start(tb, False, False, 0)

        self.tstore = Gtk.ListStore(bool, str, str, str, str, bool)
        # done, title, due, prio, id, overdue
        ttv = Gtk.TreeView(model=self.tstore)

        # Done column with custom checkbox
        tog = Gtk.CellRendererToggle()
        tog.set_property("activatable", True)
        tog.connect("toggled", self.on_toggle)
        ttv.append_column(Gtk.TreeViewColumn("", tog, active=0))

        # Task title with priority badge
        title_renderer = Gtk.CellRendererText()
        title_renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
        title_col = Gtk.TreeViewColumn("Task", title_renderer, text=1)
        title_col.set_cell_data_func(title_renderer, self.render_task_cell)
        ttv.append_column(title_col)

        # Due date
        due_renderer = Gtk.CellRendererText()
        due_col = Gtk.TreeViewColumn("Due", due_renderer, text=2)
        due_col.set_cell_data_func(due_renderer, self.render_due_cell)
        ttv.append_column(due_col)

        # Priority
        prio_renderer = Gtk.CellRendererText()
        prio_col = Gtk.TreeViewColumn("Priority", prio_renderer, text=3)
        prio_col.set_cell_data_func(prio_renderer, self.render_priority_cell)
        ttv.append_column(prio_col)

        ttv.connect("row-activated", self.on_edit_title)
        ttv.connect("button-press-event", self.on_task_button)
        self.task_sw = Gtk.ScrolledWindow()
        self.task_sw.get_style_context().add_class("reminders-task-sidebar")
        self.task_sw.add(ttv)
        right.pack_start(self.task_sw, True, True, 0)
        paned.add2(right)
        self.ttv = ttv

        self.empty_label = Gtk.Label(label="")
        self.empty_label.get_style_context().add_class("reminders-empty")
        self.empty_label.set_no_show_all(True)

        self.cur = "Reminders"
        self.query = ""
        self.refresh()
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", self.on_destroy)
        self.show_all()
        self._warn_if_needed()

    def apply_mavericks_css(self):
        css = b"""
        .reminders-list-sidebar {
            background: #e8dcc8;
            background-image: linear-gradient(135deg, #e8dcc8 0%, #d4c4a8 100%);
            border-right: 1px solid #c4b898;
        }
        .reminders-list-sidebar > viewport { background: transparent; }
        .reminders-task-sidebar {
            background: #f5f0e8;
            background-image: linear-gradient(180deg, #f5f0e8 0%, #e8ddd0 100%);
        }
        .reminders-task-sidebar > viewport { background: transparent; }
        .mavericks-toolbar-btn {
            border-radius: 4px;
            padding: 6px 12px;
            margin: 2px;
            background-image: linear-gradient(to bottom, #f0ebe0 0%, #e0d8c8 100%);
            border: 1px solid #d0c8b8;
            color: #333;
            text-shadow: 0 1px 0 rgba(255,255,255,0.5);
        }
        .mavericks-toolbar-btn:hover {
            background-image: linear-gradient(to bottom, #e8e0d0 0%, #d8d0c0 100%);
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }
        .mavericks-toolbar-btn:active {
            background-image: linear-gradient(to bottom, #d8d0c0 0%, #c8c0b0 100%);
        }
        .reminder-row {
            padding: 8px 12px;
            border-radius: 6px;
            margin: 2px 8px;
            border-bottom: 1px solid #e8ddd0;
        }
        .reminder-row:hover {
            background: rgba(0,122,255,0.1);
        }
        .reminder-row:selected {
            background: #007aff;
            color: white;
        }
        .priority-high {
            background: #ff3b30;
            color: white;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 9pt;
        }
        .priority-medium {
            background: #ff9500;
            color: white;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 9pt;
        }
        .priority-low {
            background: #34c759;
            color: white;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 9pt;
        }
        .due-today {
            background: #fff8e1;
            border-radius: 4px;
            padding: 2px 6px;
            font-weight: bold;
        }
        .due-overdue {
            background: #ffe8e8;
            color: #ff3b30;
            border-radius: 4px;
            padding: 2px 6px;
            font-weight: bold;
        }
        .due-soon {
            background: #fff8e1;
            border-radius: 4px;
            padding: 2px 6px;
        }
        .completed-task {
            color: #888;
        }
        .completed-task text {
            text-decoration: line-through;
        }
        .reminders-empty {
            color: #998877;
            font-style: italic;
            font-size: 11pt;
            padding: 40px;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def render_list_cell(self, column, cell, model, iter_, data):
        name = model[iter_][0]
        selected = model[iter_][1]
        cell.set_property("text", name)
        cell.set_property("xalign", 0.0)
        cell.set_property("ypad", 8)
        cell.set_property("xpad", 12)
        cell.set_property("weight", Pango.Weight.BOLD if selected
                         else Pango.Weight.NORMAL)

    def render_task_cell(self, column, cell, model, iter_, data):
        title = model[iter_][1]
        done = model[iter_][0]
        cell.set_property("text", title)
        cell.set_property("xalign", 0.0)
        cell.set_property("xpad", 12)
        cell.set_property("ypad", 8)
        if done:
            cell.set_property("strikethrough", True)
            cell.set_property("foreground", "#888")

    def render_due_cell(self, column, cell, model, iter_, data):
        due = model[iter_][2]
        overdue = model[iter_][5]
        cell.set_property("text", due if due else "—")
        cell.set_property("xalign", 0.5)
        cell.set_property("xpad", 8)
        cell.set_property("ypad", 4)

        # Cell renderers have no style context in GTK3 — style via props
        if overdue:
            cell.set_property("foreground", "#ff3b30")
            cell.set_property("background", "#ffe8e8")
            cell.set_property("weight", Pango.Weight.BOLD)
        elif due:
            today = today_str()
            if due == today:
                cell.set_property("background", "#fff8e1")
                cell.set_property("weight", Pango.Weight.BOLD)
            elif due < today:
                cell.set_property("foreground", "#ff3b30")
                cell.set_property("background", "#ffe8e8")
                cell.set_property("weight", Pango.Weight.BOLD)

    def render_priority_cell(self, column, cell, model, iter_, data):
        prio = model[iter_][3]
        cell.set_property("xalign", 0.5)
        if prio:
            cell.set_property("text", prio)
            cell.set_property("foreground", "white")
            cell.set_property("weight", Pango.Weight.BOLD)
            cell.set_property("background", {
                "High": "#ff3b30", "Medium": "#ff9500",
                "Low": "#34c759"}.get(prio, "#888888"))
        else:
            cell.set_property("text", "—")

    def refresh(self):
        if not self.data["lists"]:
            self.data["lists"] = {"Reminders": []}
        if self.cur not in self.data["lists"]:
            self.cur = next(iter(self.data["lists"]))
        self.lstore.clear()
        for name in self.data["lists"]:
            self.lstore.append([name, name == self.cur])
        self.tstore.clear()
        tasks = [t for t in self.data["lists"].get(self.cur, [])
                 if matches(t, self.query)]
        for t in tasks:
            self.tstore.append([
                t.get("done", False),
                t["title"],
                t.get("due", ""),
                t.get("prio", ""),
                t["id"],
                due_state(t) == "overdue"
            ])
        if tasks:
            self.task_sw.show()
            self.empty_label.hide()
        else:
            self.task_sw.hide()
            if self.data["lists"].get(self.cur):
                self.empty_label.set_text("No tasks match your search")
            else:
                self.empty_label.set_text("No tasks in this list")
            self.empty_label.show()

    def on_list(self, sel):
        _m, it = sel.get_selected()
        if it:
            self.cur = self.lstore[it][0]
            self.refresh()

    def on_search(self, _e):
        self.query = self.search.get_text().strip()
        self.refresh()

    def on_toggle(self, _r, path):
        tid = self.tstore[path][4]
        for t in self.data["lists"].get(self.cur, []):
            if t["id"] == tid:
                t["done"] = not t.get("done", False)
        save_store(STORE, self.data)
        self.refresh()

    def on_edit_title(self, _tv, path, _col):
        self.edit_task(self.tstore[path][4])

    def edit_task(self, tid):
        task = None
        for t in self.data["lists"].get(self.cur, []):
            if t["id"] == tid:
                task = t
        if task is None:
            return
        d = Gtk.Dialog(title="Edit Task", transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                      "OK", Gtk.ResponseType.OK)
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, margin=12)
        title_e = Gtk.Entry()
        due_e = Gtk.Entry(placeholder_text="Due YYYY-MM-DD (optional)")
        prio = Gtk.ComboBoxText()
        for p in PRIORITIES:
            prio.append_text(p)
        title_e.set_text(task["title"])
        due_e.set_text(task.get("due", ""))
        pr = task.get("prio", "")
        prio.set_active(PRIORITIES.index(pr) if pr in PRIORITIES else 0)
        for i, (lab, w) in enumerate([("Title", title_e), ("Due", due_e),
                                      ("Priority", prio)]):
            grid.attach(Gtk.Label(label=lab, xalign=0), 0, i, 1, 1)
            grid.attach(w, 1, i, 1, 1)
        d.get_content_area().pack_start(grid, True, True, 0)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            task["title"] = title_e.get_text().strip() or task["title"]
            task["due"] = due_e.get_text().strip()
            task["prio"] = prio.get_active_text() or ""
            save_store(STORE, self.data)
            self.refresh()
        d.destroy()

    def add_list(self, _b):
        n = 1
        while "List %d" % n in self.data["lists"]:
            n += 1
        d = Gtk.Dialog(title="New List", transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                      "OK", Gtk.ResponseType.OK)
        e = Gtk.Entry()
        e.set_text("List %d" % n)
        d.get_content_area().pack_start(e, True, True, 8)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            name = e.get_text().strip() or ("List %d" % n)
            self.data["lists"].setdefault(name, [])
            self.cur = name
            save_store(STORE, self.data)
            self.refresh()
        d.destroy()

    def add_task(self, _b):
        t = make_task()
        self.data["lists"].setdefault(self.cur, []).append(t)
        save_store(STORE, self.data)
        self.refresh()
        self.edit_task(t["id"])

    def delete_task(self, tid):
        tasks = self.data["lists"].get(self.cur, [])
        task = next((t for t in tasks if t["id"] == tid), None)
        if task is None:
            return
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                             message_type=Gtk.MessageType.WARNING,
                             buttons=Gtk.ButtonsType.NONE,
                             text="Delete task?")
        d.format_secondary_text('"%s" will be permanently removed '
                                "from the list." % task["title"])
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                      "Delete", Gtk.ResponseType.OK)
        if d.run() == Gtk.ResponseType.OK:
            self.data["lists"][self.cur] = [t for t in tasks
                                           if t["id"] != tid]
            save_store(STORE, self.data)
            self.refresh()
        d.destroy()

    def clear_completed(self, _b):
        tasks = self.data["lists"].get(self.cur, [])
        done = [t for t in tasks if t.get("done")]
        if not done:
            return
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                             message_type=Gtk.MessageType.WARNING,
                             buttons=Gtk.ButtonsType.NONE,
                             text="Clear completed tasks?")
        d.format_secondary_text('%d completed task(s) will be removed '
                                'from "%s".' % (len(done), self.cur))
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                      "Clear", Gtk.ResponseType.OK)
        if d.run() == Gtk.ResponseType.OK:
            self.data["lists"][self.cur] = [t for t in tasks
                                           if not t.get("done")]
            save_store(STORE, self.data)
            self.refresh()
        d.destroy()

    def rename_list(self, _it):
        d = Gtk.Dialog(title="Rename List", transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                      "OK", Gtk.ResponseType.OK)
        e = Gtk.Entry()
        e.set_text(self.cur)
        d.get_content_area().pack_start(e, True, True, 8)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            name = e.get_text().strip()
            if name and name != self.cur and name not in self.data["lists"]:
                self.data["lists"][name] = self.data["lists"].pop(self.cur)
                self.cur = name
                save_store(STORE, self.data)
                self.refresh()
        d.destroy()

    def delete_list(self, _it):
        if len(self.data["lists"]) <= 1:
            d = Gtk.MessageDialog(transient_for=self, modal=True,
                                 message_type=Gtk.MessageType.INFO,
                                 buttons=Gtk.ButtonsType.OK,
                                 text="Cannot delete the last list.")
            d.run()
            d.destroy()
            return
        n = len(self.data["lists"].get(self.cur, []))
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                             message_type=Gtk.MessageType.WARNING,
                             buttons=Gtk.ButtonsType.NONE,
                             text="Delete list?")
        d.format_secondary_text('"%s" and its %d task(s) will be '
                                "permanently removed." % (self.cur, n))
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                      "Delete", Gtk.ResponseType.OK)
        if d.run() == Gtk.ResponseType.OK:
            del self.data["lists"][self.cur]
            self.cur = next(iter(self.data["lists"]))
            save_store(STORE, self.data)
            self.refresh()
        d.destroy()

    def selected_task_id(self):
        _m, it = self.ttv.get_selection().get_selected()
        if it is None:
            return None
        return self.tstore[it][4]

    def on_task_button(self, tv, ev):
        if ev.button != 3:
            return False
        row = tv.get_path_at_pos(int(ev.x), int(ev.y))
        if row is None:
            return False
        tv.get_selection().select_path(row[0])
        menu = Gtk.Menu()
        for label, cb in [("Edit", self.ctx_edit),
                          ("Toggle Done", self.ctx_toggle),
                          ("Delete", self.ctx_delete)]:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", cb)
            menu.append(item)
        menu.show_all()
        menu.popup(None, None, None, None, 0, ev.time)
        return True

    def on_list_button(self, tv, ev):
        if ev.button != 3:
            return False
        row = tv.get_path_at_pos(int(ev.x), int(ev.y))
        if row is None:
            return False
        tv.get_selection().select_path(row[0])
        menu = Gtk.Menu()
        for label, cb in [("Rename List", self.rename_list),
                          ("Delete List", self.delete_list)]:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", cb)
            menu.append(item)
        menu.show_all()
        menu.popup(None, None, None, None, 0, ev.time)
        return True

    def ctx_edit(self, _it):
        tid = self.selected_task_id()
        if tid:
            self.edit_task(tid)

    def ctx_toggle(self, _it):
        tid = self.selected_task_id()
        if tid:
            for t in self.data["lists"].get(self.cur, []):
                if t["id"] == tid:
                    t["done"] = not t.get("done", False)
            save_store(STORE, self.data)
            self.refresh()

    def ctx_delete(self, _it):
        tid = self.selected_task_id()
        if tid:
            self.delete_task(tid)

    def on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        if ctrl and shift and ev.keyval == Gdk.KEY_n:
            self.add_list(None)
            return True
        if ctrl and ev.keyval == Gdk.KEY_n:
            self.add_task(None)
            return True
        if ctrl and ev.keyval == Gdk.KEY_f:
            self.search.grab_focus()
            return True
        if ev.keyval == Gdk.KEY_Delete:
            tid = self.selected_task_id()
            if tid:
                self.delete_task(tid)
            return True
        if ev.keyval == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
                self.query = ""
                self.refresh()
                return True
        return False

    def on_destroy(self, _w):
        x, y = self.get_position()
        w, h = self.get_size()
        self.data["geometry"] = {"x": x, "y": y, "w": w, "h": h}
        save_store(STORE, self.data)

    def _warn_if_needed(self):
        if not self.store_warnings:
            return
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                             message_type=Gtk.MessageType.WARNING,
                             buttons=Gtk.ButtonsType.OK,
                             text="Reminders store warning")
        d.format_secondary_text("\n".join(self.store_warnings))
        d.run()
        d.destroy()


def main():
    w = Reminders()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--check-due":
        check_due()
    else:
        sys.exit(main())
