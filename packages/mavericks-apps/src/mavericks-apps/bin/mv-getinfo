#!/usr/bin/env python3
"""mv-getinfo — Finder-like Get Info dialog for files/folders.
Shows: name, kind, size, location, created/modified, permissions, open with.
"""
import os
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gio
import stat
import time
import mimetypes


def format_size(size):
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if size < 1024:
            return f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} PB"


def format_time(timestamp):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(timestamp))


def get_file_kind(path):
    if os.path.isdir(path):
        return "Folder"
    mime_type, _ = mimetypes.guess_type(path)
    if mime_type:
        return mime_type.split('/')[0].capitalize() + " file"
    return "File"


class GetInfoDialog(Gtk.Dialog):
    def __init__(self, paths):
        super().__init__(title="Get Info", transient_for=None)
        self.set_modal(True)
        self.set_resizable(False)
        self.add_button("Close", Gtk.ResponseType.CLOSE)

        box = self.get_content_area()
        box.set_spacing(12)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        box.set_margin_start(12)
        box.set_margin_end(12)

        # For multiple selection, show summary
        if len(paths) > 1:
            self.show_multiple_info(box, paths)
        else:
            self.show_single_info(box, paths[0])

        self.show_all()

    def show_single_info(self, box, path):
        path = os.path.abspath(path)
        name = os.path.basename(path)
        st = os.stat(path)

        # Icon + name row
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        hbox.set_margin_bottom(8)

        # Try to get icon
        icon_theme = Gtk.IconTheme.get_default()
        mime_type, _ = mimetypes.guess_type(path)
        icon_name = "text-x-generic"
        if os.path.isdir(path):
            icon_name = "folder"
        elif mime_type:
            icon_name = Gio.content_type_get_icon(mime_type).get_names()[0] if Gio.content_type_get_icon(mime_type).get_names() else "text-x-generic"

        try:
            pixbuf = icon_theme.load_icon(icon_name, 48, 0)
            img = Gtk.Image.new_from_pixbuf(pixbuf)
        except:
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        hbox.pack_start(img, False, False, 0)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name_label = Gtk.Label(label=name)
        name_label.set_halign(Gtk.Align.START)
        name_label.get_style_context().add_class("title")
        name_label.set_markup(f"<b><big>{GLib.markup_escape_text(name)}</big></b>")
        vbox.pack_start(name_label, False, False, 0)

        kind = get_file_kind(path)
        kind_label = Gtk.Label(label=f"Kind: {kind}")
        kind_label.set_halign(Gtk.Align.START)
        vbox.pack_start(kind_label, False, False, 0)

        hbox.pack_start(vbox, True, True, 0)
        box.pack_start(hbox, False, False, 0)

        # Separator
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        box.pack_start(sep, False, False, 0)

        # Details grid
        grid = Gtk.Grid()
        grid.set_row_spacing(6)
        grid.set_column_spacing(12)
        grid.set_margin_top(6)

        details = [
            ("Size:", format_size(st.st_size)),
            ("Location:", os.path.dirname(path) or "/"),
            ("Created:", format_time(st.st_ctime)),
            ("Modified:", format_time(st.st_mtime)),
        ]

        for i, (label_text, value_text) in enumerate(details):
            label = Gtk.Label(label=label_text)
            label.set_halign(Gtk.Align.START)
            label.get_style_context().add_class("dim-label")
            value = Gtk.Label(label=value_text)
            value.set_halign(Gtk.Align.START)
            value.set_selectable(True)
            grid.attach(label, 0, i, 1, 1)
            grid.attach(value, 1, i, 1, 1)

        box.pack_start(grid, False, False, 0)

        # Permissions
        perm_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        perm_box.set_margin_top(12)
        perm_label = Gtk.Label(label="Permissions:")
        perm_label.get_style_context().add_class("dim-label")
        perm_box.pack_start(perm_label, False, False, 0)

        mode = stat.S_IMODE(st.st_mode)
        perm_str = oct(mode)[2:]
        # Build rwx string properly
        rwx = ""
        for shift in (6, 3, 0):
            bits = (mode >> shift) & 7
            rwx += "r" if bits & 4 else "-"
            rwx += "w" if bits & 2 else "-"
            rwx += "x" if bits & 1 else "-"
        perm_value = Gtk.Label(label=f"{perm_str} ({rwx})")
        perm_value.set_selectable(True)
        perm_box.pack_start(perm_value, False, False, 0)
        box.pack_start(perm_box, False, False, 0)

    def show_multiple_info(self, box, paths):
        total_size = 0
        total_items = len(paths)
        for p in paths:
            try:
                total_size += os.path.getsize(p)
            except:
                pass

        label = Gtk.Label()
        label.set_markup(f"<b>{total_items} items</b>, total size: {format_size(total_size)}")
        label.set_halign(Gtk.Align.START)
        label.set_margin_bottom(12)
        box.pack_start(label, False, False, 0)


def main():
    if len(sys.argv) < 2:
        print("Usage: mv-getinfo <file> [file...]", file=sys.stderr)
        return 1

    paths = sys.argv[1:]
    # Expand paths if they contain wildcards (though Thunar should pass actual paths)
    expanded = []
    for p in paths:
        expanded.append(p)

    dialog = GetInfoDialog(expanded)
    dialog.run()
    dialog.destroy()
    return 0


if __name__ == "__main__":
    sys.exit(main())