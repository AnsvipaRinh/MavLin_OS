#!/usr/bin/env python3
"""mv-calculator — Mavericks-like Calculator.
Basic, Scientific, and Programmer modes.
Backend: Python math (state machine, no eval). UI: GTK3 with Mavericks styling.
Features: paper tape with persistence, keyboard input (incl. numpad),
copy/paste result, safe error states.
"""
import json
import math
import os
import sys


def _gtk():
    """Lazy Gtk/Gdk load so pure logic (parse/apply/tape) imports headless."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk
    return Gtk, Gdk

STORE = os.path.expanduser("~/.local/share/mv-calculator/tape.json")

BASES = {"HEX": 16, "DEC": 10, "OCT": 8, "BIN": 2}


def parse_number(text, base=10):
    if base == 10:
        return float(text)
    return int(text, base)


def format_number(val, base=10):
    if base != 10:
        return to_base(int(val), base)
    if isinstance(val, float):
        if val == int(val) and abs(val) < 1e15:
            return str(int(val))
        return "{:.10g}".format(val)
    return str(val)


def to_base(val, base):
    if val < 0:
        return "-" + to_base(-val, base)
    digits = "0123456789ABCDEF"
    if base == 10:
        return str(val)
    out = ""
    while val:
        out = digits[val % base] + out
        val //= base
    return out or "0"


def apply_operator(op, a, b):
    if op == "+":
        return a + b
    if op == "−":
        return a - b
    if op == "×":
        return a * b
    if op == "÷":
        if b == 0:
            raise ZeroDivisionError("division by zero")
        if isinstance(a, int) and isinstance(b, int):
            q = abs(a) // abs(b)
            return q if (a < 0) == (b < 0) else -q
        return a / b
    if op == "^":
        result = a ** b
        if isinstance(result, complex):
            raise ValueError("complex result")
        return result
    if op == "AND":
        return int(a) & int(b)
    if op == "OR":
        return int(a) | int(b)
    if op == "XOR":
        return int(a) ^ int(b)
    if op == "<<":
        return int(a) << int(b)
    if op == ">>":
        return int(a) >> int(b)
    raise ValueError("unknown operator %r" % op)


def apply_unary(func, val):
    if func == "sin":
        return math.sin(math.radians(val))
    if func == "cos":
        return math.cos(math.radians(val))
    if func == "tan":
        return math.tan(math.radians(val))
    if func == "log":
        return math.log10(val)
    if func == "ln":
        return math.log(val)
    if func == "eˣ":
        return math.exp(val)
    if func == "x²":
        return val ** 2
    if func == "√x":
        return math.sqrt(val)
    raise ValueError("unknown function %r" % func)


def load_tape(path=None):
    path = path or STORE
    if not os.path.exists(path):
        return []
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return []
    if not isinstance(data, list):
        return []
    return [str(entry) for entry in data]


def save_tape(tape, path=None):
    path = path or STORE
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(tape[-200:], f, indent=2)
    os.replace(tmp, path)


def build_calculator_class():
    """Build the GUI class lazily; pure helpers above import without gi."""
    Gtk, Gdk = _gtk()

    class Calculator(Gtk.Window):
        def __init__(self):
            super().__init__(title="Calculator")
            self.set_default_size(320, 480)
            self.set_resizable(False)

            self.mode = "Basic"
            self.base = 10
            self.current = "0"
            self.pending_op = None
            self.pending_val = None
            self.new_input = True
            self.tape = load_tape()
            self.tape_window = None
            self.tape_buffer = Gtk.TextBuffer()
            for entry in self.tape:
                self.tape_buffer.insert(self.tape_buffer.get_end_iter(),
                                        entry + "\n")

            self.set_decorated(True)
            toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            toolbar.get_style_context().add_class("mavericks-calculator-toolbar")

            self.mode_combo = Gtk.ComboBoxText()
            for mode in ["Basic", "Scientific", "Programmer"]:
                self.mode_combo.append_text(mode)
            self.mode_combo.set_active(0)
            self.mode_combo.connect("changed", self.on_mode_change)
            toolbar.pack_start(self.mode_combo, False, False, 0)

            tape_btn = Gtk.Button()
            tape_btn.set_image(Gtk.Image.new_from_icon_name("text-x-generic",
                                                            Gtk.IconSize.BUTTON))
            tape_btn.set_tooltip_text("Paper Tape")
            tape_btn.connect("clicked", self.show_tape)
            toolbar.pack_end(tape_btn, False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.pack_start(toolbar, False, False, 0)
            root.pack_start(vbox, True, True, 0)
            self.add(root)

            disp_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            disp_row.set_margin_top(16)
            disp_row.set_margin_bottom(8)
            disp_row.set_margin_start(16)
            disp_row.set_margin_end(16)
            self.base_label = Gtk.Label(label="")
            self.base_label.get_style_context().add_class("mavericks-calc-base-label")
            self.base_label.set_no_show_all(True)
            disp_row.pack_start(self.base_label, False, False, 0)
            self.display = Gtk.Entry()
            self.set_display("0")
            self.display.set_editable(False)
            self.display.set_can_focus(False)
            self.display.set_alignment(1.0)
            self.display.get_style_context().add_class("mavericks-calc-display")
            self.display.set_hexpand(True)
            disp_row.pack_start(self.display, True, True, 0)
            vbox.pack_start(disp_row, False, False, 0)

            self.grid = Gtk.Grid()
            self.grid.set_row_spacing(8)
            self.grid.set_column_spacing(8)
            self.grid.set_margin_top(8)
            self.grid.set_margin_bottom(16)
            self.grid.set_margin_start(16)
            self.grid.set_margin_end(16)
            vbox.pack_start(self.grid, True, True, 0)

            self.apply_mavericks_css()
            self.build_basic()
            self.show_all()
            self.connect("key-press-event", self.on_key)

        def apply_mavericks_css(self):
            css = b"""
            .mavericks-calc-display {
                background: #f8f8f8;
                background-image: linear-gradient(to bottom, #e4e4e4 0%, #f8f8f8 10%, #f8f8f8 100%);
                border: 1px solid #c0c0c0;
                border-radius: 4px;
                color: #222;
                font-family: "Lucida Grande", "Helvetica Neue", sans-serif;
                font-size: 28px;
                padding: 8px 12px;
            }
            .mavericks-calc-display.error {
                color: #c0392b;
            }
            .mavericks-calc-button {
                background-image: linear-gradient(to bottom, #f5f5f5 0%, #e2e2e2 100%);
                border: 1px solid #b8b8b8;
                border-radius: 4px;
                color: #222;
                font-family: "Lucida Grande", "Helvetica Neue", sans-serif;
                font-size: 15px;
                padding: 10px 0;
            }
            .mavericks-calc-button:hover {
                background-image: linear-gradient(to bottom, #ffffff 0%, #e8e8e8 100%);
            }
            .mavericks-calc-button:active {
                background-image: linear-gradient(to bottom, #d2d2d2 0%, #e2e2e2 100%);
            }
            .mavericks-calc-equals {
                background-image: linear-gradient(to bottom, #f0e6d2 0%, #e2d2b4 100%);
                border: 1px solid #c4b494;
            }
            .mavericks-calc-equals:hover {
                background-image: linear-gradient(to bottom, #f6ecdc 0%, #e8d8bc 100%);
            }
            .mavericks-calc-base-label {
                color: #777;
                font-size: 11px;
                padding: 0 6px 0 0;
            }
            .mavericks-calc-tape {
                background: #fffef8;
                font-family: monospace;
                font-size: 12px;
            }
            """
            provider = Gtk.CssProvider()
            try:
                provider.load_from_data(css)
            except Exception:
                # cosmetic only: a bad rule must not kill the window
                pass
            screen = Gdk.Screen.get_default()
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def make_button(self, label):
            btn = Gtk.Button(label=label)
            btn.set_hexpand(True)
            btn.set_vexpand(True)
            btn.set_can_focus(False)
            btn.get_style_context().add_class("mavericks-calc-button")
            if label == "=":
                btn.get_style_context().add_class("mavericks-calc-equals")
            return btn

        def build_basic(self):
            self.clear_grid()
            buttons = [
                ["C", "±", "%", "÷"],
                ["7", "8", "9", "×"],
                ["4", "5", "6", "−"],
                ["1", "2", "3", "+"],
                ["0", ".", "="],
            ]
            for r, row in enumerate(buttons):
                col = 0
                for label in row:
                    btn = self.make_button(label)
                    if label in "0123456789.":
                        btn.connect("clicked", self.on_digit, label)
                    elif label == "C":
                        btn.connect("clicked", self.on_clear)
                    elif label == "=":
                        btn.connect("clicked", self.on_equals)
                    elif label in "+−×÷":
                        btn.connect("clicked", self.on_operator, label)
                    elif label == "±":
                        btn.connect("clicked", self.on_sign)
                    elif label == "%":
                        btn.connect("clicked", self.on_percent)
                    self.grid.attach(btn, col, r, 2 if label == "0" else 1, 1)
                    col += 2 if label == "0" else 1

        def build_scientific(self):
            self.clear_grid()
            buttons = [
                ["C", "←", "sin", "÷"],
                ["cos", "tan", "log", "×"],
                ["ln", "eˣ", "x²", "−"],
                ["√x", "xʸ", "π", "+"],
                ["7", "8", "9", "="],
                ["4", "5", "6", "="],
                ["1", "2", "3", "="],
                ["0", ".", "e", "="],
            ]
            for r, row in enumerate(buttons):
                col = 0
                for label in row:
                    btn = self.make_button(label)
                    if label in "0123456789.eπ":
                        btn.connect("clicked", self.on_digit, label)
                    elif label == "C":
                        btn.connect("clicked", self.on_clear)
                    elif label == "←":
                        btn.connect("clicked", self.on_backspace)
                    elif label == "=":
                        btn.connect("clicked", self.on_equals)
                    elif label in "+−×÷":
                        btn.connect("clicked", self.on_operator, label)
                    elif label in ("sin", "cos", "tan", "log", "ln",
                                   "eˣ", "x²", "√x", "xʸ"):
                        btn.connect("clicked", self.on_function, label)
                    if label == "=":
                        self.grid.attach(btn, col, r, 1, 4)
                    else:
                        self.grid.attach(btn, col, r, 1, 1)
                    col += 1

        def build_programmer(self):
            self.clear_grid()
            buttons = [
                ["AC", "HEX", "DEC", "OCT", "BIN"],
                ["7", "8", "9", "÷", "A"],
                ["4", "5", "6", "×", "B"],
                ["1", "2", "3", "−", "C"],
                ["0", ".", "+", "=", "D"],
                ["AND", "OR", "XOR", "NOT", "E"],
                ["<<", ">>", "←", "F"],
            ]
            for r, row in enumerate(buttons):
                col = 0
                for label in row:
                    btn = self.make_button(label)
                    if label in "0123456789.ABCDEF":
                        btn.connect("clicked", self.on_digit, label)
                    elif label == "AC":
                        btn.connect("clicked", self.on_clear)
                    elif label == "←":
                        btn.connect("clicked", self.on_backspace)
                    elif label == "=":
                        btn.connect("clicked", self.on_equals)
                    elif label in "+−×÷":
                        btn.connect("clicked", self.on_operator, label)
                    elif label in ("HEX", "DEC", "OCT", "BIN"):
                        btn.connect("clicked", self.on_base, label)
                    elif label in ("AND", "OR", "XOR", "NOT", "<<", ">>"):
                        btn.connect("clicked", self.on_bitwise, label)
                    self.grid.attach(btn, col, r, 1, 1)
                    col += 1

        def clear_grid(self):
            for child in self.grid.get_children():
                self.grid.remove(child)

        def on_mode_change(self, combo):
            old_mode = self.mode
            mode = combo.get_active_text()
            if mode == old_mode:
                return
            if mode == "Programmer":
                try:
                    val = parse_number(self.current, self.base)
                    self.base = 10
                    self.current = to_base(int(val), 10)
                except ValueError:
                    self.current = "Error"
                self.base_label.set_text("DEC")
                self.base_label.show()
            else:
                if old_mode == "Programmer":
                    try:
                        self.current = format_number(
                            parse_number(self.current, self.base), 10)
                    except ValueError:
                        self.current = "Error"
                self.base_label.hide()
            self.mode = mode
            if mode == "Basic":
                self.build_basic()
            elif mode == "Scientific":
                self.build_scientific()
            elif mode == "Programmer":
                self.build_programmer()
            self.set_display(self.current, error=self.current == "Error")
            self.show_all()

        def set_display(self, text, error=False):
            self.display.set_text(text)
            ctx = self.display.get_style_context()
            if error:
                ctx.add_class("error")
            else:
                ctx.remove_class("error")

        def set_error(self):
            self.pending_op = None
            self.pending_val = None
            self.new_input = True
            self.set_display("Error", error=True)

        def entry_base(self):
            return self.base if self.mode == "Programmer" else 10

        def on_digit(self, _, digit):
            if self.new_input:
                self.current = ""
                self.new_input = False
            if self.mode == "Programmer":
                if digit == ".":
                    return
                if self.base == 2 and digit not in "01":
                    return
                if self.base == 8 and digit not in "01234567":
                    return
                if self.base == 10 and digit not in "0123456789":
                    return
                if self.base == 16 and digit not in "0123456789ABCDEF":
                    return
            elif digit == "." and "." in self.current:
                return
            if digit in ("π", "e"):
                self.current = str(math.pi if digit == "π" else math.e)
            else:
                self.current += digit
            self.set_display(self.current)

        def on_operator(self, _, op):
            if not self.new_input:
                self.calculate()
            if self.current == "Error":
                return
            try:
                self.pending_val = parse_number(self.current, self.entry_base())
            except ValueError:
                self.set_error()
                return
            self.pending_op = op
            self.new_input = True

        def on_function(self, _, func):
            if self.current == "Error":
                return
            try:
                orig = self.current
                val = float(self.current)
                if func == "xʸ":
                    self.pending_op = "^"
                    self.pending_val = val
                    self.new_input = True
                    return
                result = apply_unary(func, val)
                text = format_number(result)
                self.add_tape("%s(%s) = %s" % (func, orig, text))
                self.current = text
                self.set_display(text)
                self.new_input = True
            except (ValueError, OverflowError):
                self.set_error()

        def on_base(self, _, base):
            try:
                val = parse_number(self.current, self.base)
            except ValueError:
                self.set_error()
                return
            self.base = BASES[base]
            self.current = to_base(int(val), self.base)
            self.base_label.set_text(base)
            self.set_display(self.current)
            self.new_input = True

        def on_bitwise(self, _, op):
            if op == "NOT":
                if self.current == "Error":
                    return
                try:
                    val = parse_number(self.current, self.base)
                    result = ~int(val)
                    self.add_tape("NOT(%s) = %s" % (
                        format_number(val, self.base),
                        format_number(result, self.base)))
                    self.current = format_number(result, self.base)
                    self.set_display(self.current)
                    self.new_input = True
                except ValueError:
                    self.set_error()
                return
            if not self.new_input:
                self.calculate()
            if self.current == "Error":
                return
            try:
                self.pending_val = parse_number(self.current, self.base)
            except ValueError:
                self.set_error()
                return
            self.pending_op = op
            self.new_input = True

        def on_sign(self, _):
            if self.current in ("0", "Error"):
                return
            try:
                if self.mode == "Programmer":
                    val = parse_number(self.current, self.base)
                    self.current = to_base(-int(val), self.base)
                elif self.current.startswith("-"):
                    self.current = self.current[1:]
                else:
                    self.current = "-" + self.current
                self.set_display(self.current)
            except ValueError:
                self.set_error()

        def on_percent(self, _):
            if self.current == "Error":
                return
            try:
                val = float(self.current) / 100
                self.current = format_number(val)
                self.set_display(self.current)
            except (ValueError, OverflowError):
                self.set_error()

        def on_clear(self, _):
            self.current = "0"
            self.pending_op = None
            self.pending_val = None
            self.new_input = True
            self.set_display("0")

        def on_backspace(self, _):
            if self.current == "Error":
                self.current = "0"
            elif not self.new_input and len(self.current) > 1:
                self.current = self.current[:-1]
            elif len(self.current) == 1:
                self.current = "0"
            self.set_display(self.current)

        def calculate(self):
            if self.pending_op is None or self.pending_val is None:
                return
            op = self.pending_op
            a = self.pending_val
            self.pending_op = None
            self.pending_val = None
            try:
                b = parse_number(self.current, self.entry_base())
                result = apply_operator(op, a, b)
                base = self.entry_base()
                self.add_tape("%s %s %s = %s" % (
                    format_number(a, base), op,
                    format_number(b, base), format_number(result, base)))
                self.current = format_number(result, base)
                self.set_display(self.current)
            except (ZeroDivisionError, ValueError, OverflowError):
                self.set_error()

        def on_equals(self, _):
            self.calculate()
            self.new_input = True

        def add_tape(self, entry):
            self.tape.append(entry)
            end = self.tape_buffer.get_end_iter()
            self.tape_buffer.insert(end, entry + "\n")
            save_tape(self.tape)

        def clear_tape(self, _):
            self.tape = []
            save_tape(self.tape)
            self.tape_buffer.set_text("")

        def show_tape(self, _):
            if self.tape_window:
                self.tape_window.present()
                return
            self.tape_window = Gtk.Window(title="Paper Tape", transient_for=self)
            self.tape_window.set_default_size(240, 400)
            self.tape_window.set_type_hint(Gdk.WindowTypeHint.UTILITY)
            hb = Gtk.HeaderBar(title="Paper Tape", show_close_button=True)
            clear_btn = Gtk.Button(label="Clear")
            clear_btn.connect("clicked", self.clear_tape)
            hb.pack_start(clear_btn)
            self.tape_window.set_titlebar(hb)
            sw = Gtk.ScrolledWindow()
            view = Gtk.TextView(buffer=self.tape_buffer)
            view.set_editable(False)
            view.set_monospace(True)
            view.get_style_context().add_class("mavericks-calc-tape")
            sw.add(view)
            self.tape_window.add(sw)
            self.tape_window.connect("destroy",
                                     lambda _: setattr(self, "tape_window", None))
            self.tape_window.show_all()

        def copy_result(self):
            if self.current == "Error":
                return
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(self.current, -1)

        def paste_input(self):
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            text = clipboard.wait_for_text()
            if not text:
                return
            for ch in text.strip():
                if ch in "0123456789" or ch == ".":
                    self.on_digit(None, ch)
                elif (self.mode == "Programmer" and self.base == 16
                      and ch.upper() in "ABCDEF"):
                    self.on_digit(None, ch.upper())

        def on_key(self, _w, ev):
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            kv = ev.keyval
            if ctrl and kv == Gdk.KEY_c:
                self.copy_result()
                return True
            if ctrl and kv == Gdk.KEY_v:
                self.paste_input()
                return True
            if kv in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.on_equals(None)
                return True
            if kv == Gdk.KEY_Escape:
                self.on_clear(None)
                return True
            if kv == Gdk.KEY_BackSpace:
                self.on_backspace(None)
                return True
            if kv in (Gdk.KEY_plus, Gdk.KEY_KP_Add):
                self.on_operator(None, "+")
                return True
            if kv in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
                self.on_operator(None, "−")
                return True
            if kv in (Gdk.KEY_asterisk, Gdk.KEY_KP_Multiply):
                self.on_operator(None, "×")
                return True
            if kv in (Gdk.KEY_slash, Gdk.KEY_KP_Divide):
                self.on_operator(None, "÷")
                return True
            ch = Gdk.keyval_to_unicode(kv)
            if not ch:
                return False
            c = chr(ch)
            if c in "0123456789" or c == ".":
                self.on_digit(None, c)
                return True
            if (self.mode == "Programmer" and self.base == 16
                    and c.upper() in "ABCDEF"):
                self.on_digit(None, c.upper())
                return True
            if self.mode == "Scientific":
                if c == "p":
                    self.on_digit(None, "π")
                    return True
                if c == "e":
                    self.on_digit(None, "e")
                    return True
            if c == "c":
                self.on_clear(None)
                return True
            return False

    return Calculator


if __name__ == "__main__":
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    Calculator = build_calculator_class()
    sys.exit(run_application(
        "com.mavlinos.Calculator", "Calculator", Calculator, sys.argv))
