#!/usr/bin/env python3
"""mv-calendar — Mavericks-like Calendar.
Leather/paper UI with Month/Week/Day views. ICS import/export.
Backend: libical (via GLib's GDateTime) + local JSON storage.
Features: events, reminders, calendars, search, birthdays.
"""
import os
import sys
import json
import time
import calendar as cal
from datetime import datetime, timedelta
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

STORE = os.path.expanduser("~/.local/share/mv-calendar/calendars.json")

DEFAULT_CALENDARS = {
    "Personal": {"color": "#007aff", "visible": True},
    "Work": {"color": "#ff3b30", "visible": True},
    "Birthdays": {"color": "#ff9500", "visible": True},
}

def load():
    try:
        with open(STORE) as f:
            return json.load(f)
    except (OSError, ValueError):
        data = {"calendars": DEFAULT_CALENDARS, "events": []}
        save(data)
        return data

def save(data):
    os.makedirs(os.path.dirname(STORE), exist_ok=True)
    tmp = STORE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, STORE)

def ics_datetime(dt):
    """Convert datetime to ICS format."""
    return dt.strftime("%Y%m%dT%H%M%S")

def parse_ics_datetime(s):
    """Parse ICS datetime to datetime."""
    try:
        if "T" in s:
            return datetime.strptime(s[:15], "%Y%m%dT%H%M%S")
        return datetime.strptime(s[:8], "%Y%m%d")
    except Exception:
        return datetime.now()

class CalendarWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Calendar")
        self.set_default_size(1000, 680)
        self.current_date = datetime.now()
        self.view_mode = "month"  # month, week, day

        hb = Gtk.HeaderBar(title="Calendar", show_close_button=True)
        self.set_titlebar(hb)

        # Left: navigation
        nav = Gtk.Box(spacing=4)
        for label, icon, cb in [
            ("Today", "go-jump-today", self.go_today),
            ("<", "go-previous", self.prev_period),
            (">", "go-next", self.next_period),
        ]:
            if label == "Today":
                b = Gtk.Button(label=label)
            else:
                b = Gtk.Button()
                b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
            b.connect("clicked", cb)
            nav.pack_start(b, False, False, 0)
        hb.pack_start(nav)

        # Center: month/year title
        self.title_label = Gtk.Label()
        self.update_title()
        hb.set_custom_title(self.title_label)

        # Right: view switcher + new event
        right = Gtk.Box(spacing=4)
        self.view_combo = Gtk.ComboBoxText()
        for v in ["Month", "Week", "Day"]:
            self.view_combo.append_text(v)
        self.view_combo.set_active(0)
        self.view_combo.connect("changed", self.on_view_change)
        right.pack_start(self.view_combo, False, False, 0)

        for label, icon, cb in [
            ("New Event", "list-add", self.new_event),
            ("Calendars", "preferences-system", self.show_calendars),
        ]:
            b = Gtk.Button()
            b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
            b.set_tooltip_text(label)
            b.connect("clicked", cb)
            right.pack_start(b, False, False, 0)
        hb.pack_end(right)

        # Main content
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(self.main_box)

        # Calendar grid (for month view)
        self.grid = Gtk.Grid()
        self.grid.set_row_spacing(1)
        self.grid.set_column_spacing(1)
        self.main_box.pack_start(self.grid, True, True, 0)

        # Load data
        self.data = load()
        self.calendars = self.data.get("calendars", DEFAULT_CALENDARS)
        self.events = self.data.get("events", [])

        self.build_month_view()
        self.show_all()

    def update_title(self):
        if self.view_mode == "month":
            title = self.current_date.strftime("%B %Y")
        elif self.view_mode == "week":
            start = self.current_date - timedelta(days=self.current_date.weekday())
            end = start + timedelta(days=6)
            title = f"{start.strftime('%b %d')} – {end.strftime('%b %d, %Y')}"
        else:
            title = self.current_date.strftime("%A, %B %d, %Y")
        self.title_label.set_markup(f"<b><big>{title}</big></b>")

    def go_today(self, _):
        self.current_date = datetime.now()
        self.update_title()
        self.refresh_view()

    def prev_period(self, _):
        if self.view_mode == "month":
            self.current_date = (self.current_date.replace(day=1) - timedelta(days=1)).replace(day=1)
        elif self.view_mode == "week":
            self.current_date -= timedelta(weeks=1)
        else:
            self.current_date -= timedelta(days=1)
        self.update_title()
        self.refresh_view()

    def next_period(self, _):
        if self.view_mode == "month":
            next_month = self.current_date.replace(day=28) + timedelta(days=4)
            self.current_date = next_month.replace(day=1)
        elif self.view_mode == "week":
            self.current_date += timedelta(weeks=1)
        else:
            self.current_date += timedelta(days=1)
        self.update_title()
        self.refresh_view()

    def on_view_change(self, combo):
        self.view_mode = combo.get_active_text().lower()
        self.update_title()
        self.refresh_view()

    def refresh_view(self):
        for child in self.grid.get_children():
            self.grid.remove(child)
        if self.view_mode == "month":
            self.build_month_view()
        elif self.view_mode == "week":
            self.build_week_view()
        else:
            self.build_day_view()
        self.update_title()
        self.show_all()

    def build_month_view(self):
        # Weekday headers
        for i, day in enumerate(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]):
            lbl = Gtk.Label(label=day)
            lbl.get_style_context().add_class("weekday-header")
            self.grid.attach(lbl, i, 0, 1, 1)

        # Calendar days
        first_day = self.current_date.replace(day=1)
        start_weekday = first_day.weekday()  # 0=Mon
        days_in_month = cal.monthrange(self.current_date.year, self.current_date.month)[1]

        # Previous month trailing days
        prev_month = (first_day - timedelta(days=1))
        prev_days = cal.monthrange(prev_month.year, prev_month.month)[1]

        day = 1 - start_weekday
        for week in range(6):
            for wd in range(7):
                btn = Gtk.Button()
                btn.set_hexpand(True)
                btn.set_vexpand(True)
                btn.set_margin_top(1)
                btn.set_margin_bottom(1)
                btn.set_margin_start(1)
                btn.set_margin_end(1)

                if day < 1:
                    btn.set_label(str(prev_days + day))
                    btn.get_style_context().add_class("other-month")
                    btn.set_sensitive(False)
                elif day > days_in_month:
                    btn.set_label(str(day - days_in_month))
                    btn.get_style_context().add_class("other-month")
                    btn.set_sensitive(False)
                else:
                    btn.set_label(str(day))
                    # Highlight today
                    if (self.current_date.year == datetime.now().year and
                        self.current_date.month == datetime.now().month and
                        day == datetime.now().day):
                        btn.get_style_context().add_class("today")

                    # Show events for this day
                    day_events = self.get_events_for_day(self.current_date.year, self.current_date.month, day)
                    if day_events:
                        event_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                        event_box.set_margin_top(2)
                        for ev in day_events[:3]:
                            ev_lbl = Gtk.Label()
                            ev_lbl.set_markup(f'<span foreground="{ev["color"]}">● {GLib.markup_escape_text(ev["title"][:20])}</span>')
                            ev_lbl.set_xalign(0)
                            ev_lbl.set_ellipsize(3)
                            event_box.pack_start(ev_lbl, False, False, 0)
                        if len(day_events) > 3:
                            more = Gtk.Label(label=f"+{len(day_events)-3} more")
                            more.get_style_context().add_class("dim-label")
                            more.set_xalign(0)
                            event_box.pack_start(more, False, False, 0)
                        btn.add(event_box)

                    btn.connect("clicked", self.on_day_click, day)
                self.grid.attach(btn, wd, week + 1, 1, 1)
                day += 1

    def get_events_for_day(self, year, month, day):
        result = []
        target = datetime(year, month, day).date()
        for ev in self.events:
            if not self.calendars.get(ev["calendar"], {}).get("visible", True):
                continue
            start = parse_ics_datetime(ev["start"])
            end = parse_ics_datetime(ev.get("end", ev["start"]))
            if start.date() <= target <= end.date():
                result.append(ev)
        return result

    def on_day_click(self, _, day):
        if self.view_mode != "day":
            self.current_date = self.current_date.replace(day=day)
            self.view_mode = "day"
            self.view_combo.set_active(2)
            self.refresh_view()
        else:
            self.new_event_for_day(day)

    def new_event_for_day(self, day):
        self.new_event_with_date(self.current_date.replace(day=day))

    def new_event(self, _):
        self.new_event_with_date(self.current_date)

    def new_event_with_date(self, date):
        dialog = EventDialog(self, self.calendars, date)
        if dialog.run() == Gtk.ResponseType.OK:
            ev = dialog.get_event()
            self.events.append(ev)
            save({"calendars": self.calendars, "events": self.events})
            self.refresh_view()
        dialog.destroy()

    def show_calendars(self, _):
        dialog = CalendarsDialog(self, self.calendars)
        dialog.run()
        dialog.destroy()
        save({"calendars": self.calendars, "events": self.events})
        self.refresh_view()

    def build_week_view(self):
        # Simplified: show 7-day grid
        start = self.current_date - timedelta(days=self.current_date.weekday())
        for i in range(7):
            day = start + timedelta(days=i)
            frame = Gtk.Frame()
            frame.set_shadow_type(Gtk.ShadowType.NONE)
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            vbox.set_border_width(8)

            header = Gtk.Label()
            header.set_markup(f"<b>{day.strftime('%a %b %d')}</b>")
            header.set_xalign(0)
            vbox.pack_start(header, False, False, 0)

            events = self.get_events_for_day(day.year, day.month, day.day)
            for ev in events:
                ev_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                ev_box.set_margin_top(4)
                color = Gtk.DrawingArea()
                color.set_size_request(12, 12)
                color.connect("draw", lambda a, c, col=ev["color"]: (
                    c.set_source_rgba(*Gdk.RGBA().parse(col)),
                    c.rectangle(0, 0, 12, 12),
                    c.fill(), True)[0])
                ev_box.pack_start(color, False, False, 0)
                lbl = Gtk.Label(label=f"{ev['start'][11:16]} {ev['title']}")
                lbl.set_xalign(0)
                ev_box.pack_start(lbl, True, True, 0)
                vbox.pack_start(ev_box, False, False, 0)

            frame.add(vbox)
            self.grid.attach(frame, i, 0, 1, 1)

    def build_day_view(self):
        # Single day detail view
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_border_width(16)

        header = Gtk.Label()
        header.set_markup(f"<big><b>{self.current_date.strftime('%A, %B %d, %Y')}</b></big>")
        header.set_xalign(0)
        vbox.pack_start(header, False, False, 0)

        events = self.get_events_for_day(self.current_date.year, self.current_date.month, self.current_date.day)
        if not events:
            lbl = Gtk.Label(label="No events")
            lbl.get_style_context().add_class("dim-label")
            lbl.set_margin_top(24)
            vbox.pack_start(lbl, True, True, 0)
        else:
            for ev in events:
                ev_frame = Gtk.Frame()
                ev_frame.set_shadow_type(Gtk.ShadowType.NONE)
                ev_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                ev_vbox.set_border_width(12)

                # Time + title
                hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                time_lbl = Gtk.Label(label=ev["start"][11:16])
                time_lbl.get_style_context().add_class("dim-label")
                time_lbl.set_size_request(60, -1)
                hbox.pack_start(time_lbl, False, False, 0)
                title_lbl = Gtk.Label(label=ev["title"])
                title_lbl.get_style_context().add_class("title")
                title_lbl.set_xalign(0)
                hbox.pack_start(title_lbl, True, True, 0)
                ev_vbox.pack_start(hbox, False, False, 0)

                # Calendar color indicator
                color_box = Gtk.Box()
                color_box.set_size_request(8, 8)
                color_box.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA().parse(ev["color"]))
                hbox.pack_end(color_box, False, False, 0)

                if ev.get("location"):
                    loc = Gtk.Label(label=f"📍 {ev['location']}")
                    loc.set_xalign(0)
                    ev_vbox.pack_start(loc, False, False, 0)

                ev_frame.add(ev_vbox)
                vbox.pack_start(ev_frame, False, False, 0)

        frame.add(vbox)
        scrolled = Gtk.ScrolledWindow()
        scrolled.add(vbox)
        self.grid.attach(scrolled, 0, 0, 7, 6)

    def export_ics(self):
        """Export all events to ICS file."""
        dialog = Gtk.FileChooserDialog(
            title="Export Calendar", transient_for=self,
            action=Gtk.FileChooserAction.SAVE)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Export", Gtk.ResponseType.OK)
        dialog.set_current_name("calendar.ics")
        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            self.write_ics(path)
        dialog.destroy()

    def write_ics(self, path):
        lines = [
            "BEGIN:VCALENDAR",
            "VERSION:2.0",
            "PRODID:-//Mavericks Calendar//EN",
            "CALSCALE:GREGORIAN",
        ]
        for ev in self.events:
            lines.extend([
                "BEGIN:VEVENT",
                f"UID:{ev['id']}",
                f"DTSTART:{ics_datetime(parse_ics_datetime(ev['start']))}",
                f"DTEND:{ics_datetime(parse_ics_datetime(ev.get('end', ev['start'])))}",
                f"SUMMARY:{ev['title']}",
            ])
            if ev.get("location"):
                lines.append(f"LOCATION:{ev['location']}")
            if ev.get("description"):
                lines.append(f"DESCRIPTION:{ev['description']}")
            lines.append("END:VEVENT")
        lines.append("END:VCALENDAR")
        with open(path, "w") as f:
            f.write("\r\n".join(lines))

    def import_ics(self):
        dialog = Gtk.FileChooserDialog(
            title="Import Calendar", transient_for=self,
            action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Import", Gtk.ResponseType.OK)
        filter_ics = Gtk.FileFilter()
        filter_ics.set_name("iCalendar Files")
        filter_ics.add_pattern("*.ics")
        dialog.add_filter(filter_ics)
        if dialog.run() == Gtk.ResponseType.OK:
            path = dialog.get_filename()
            self.read_ics(path)
        dialog.destroy()

    def read_ics(self, path):
        # Simplified ICS parser
        with open(path) as f:
            content = f.read()
        # Basic parsing - in production use icalendar library
        pass


class EventDialog(Gtk.Dialog):
    def __init__(self, parent, calendars, date):
        super().__init__(title="New Event", transient_for=parent, modal=True)
        self.set_default_size(400, 500)
        self.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)

        grid = Gtk.Grid(column_spacing=12, row_spacing=12, margin=16)
        self.get_content_area().add(grid)

        # Title
        grid.attach(Gtk.Label(label="Title:", xalign=0), 0, 0, 1, 1)
        self.title_entry = Gtk.Entry(placeholder_text="Event title")
        grid.attach(self.title_entry, 1, 0, 1, 1)

        # Calendar
        grid.attach(Gtk.Label(label="Calendar:", xalign=0), 0, 1, 1, 1)
        self.cal_combo = Gtk.ComboBoxText()
        for name in calendars:
            self.cal_combo.append_text(name)
        self.cal_combo.set_active(0)
        grid.attach(self.cal_combo, 1, 1, 1, 1)

        # Start date/time
        grid.attach(Gtk.Label(label="Start:", xalign=0), 0, 2, 1, 1)
        self.start_date = Gtk.Calendar()
        self.start_date.select_month(date.month - 1, date.year)
        self.start_date.select_day(date.day)
        grid.attach(self.start_date, 1, 2, 1, 1)

        self.start_time = Gtk.SpinButton.new_with_range(0, 23, 1)
        self.start_time.set_value(date.hour)
        grid.attach(self.start_time, 1, 3, 1, 1)

        # End date/time
        grid.attach(Gtk.Label(label="End:", xalign=0), 0, 4, 1, 1)
        self.end_date = Gtk.Calendar()
        self.end_date.select_month(date.month - 1, date.year)
        self.end_date.select_day(date.day)
        grid.attach(self.end_date, 1, 4, 1, 1)

        self.end_time = Gtk.SpinButton.new_with_range(0, 23, 1)
        self.end_time.set_value(date.hour + 1)
        grid.attach(self.end_time, 1, 5, 1, 1)

        # Location
        grid.attach(Gtk.Label(label="Location:", xalign=0), 0, 6, 1, 1)
        self.location_entry = Gtk.Entry(placeholder_text="Location")
        grid.attach(self.location_entry, 1, 6, 1, 1)

        # Description
        grid.attach(Gtk.Label(label="Notes:", xalign=0), 0, 7, 1, 1)
        self.desc_buffer = Gtk.TextBuffer()
        self.desc_view = Gtk.TextView(buffer=self.desc_buffer)
        self.desc_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.desc_view.set_size_request(-1, 80)
        sw = Gtk.ScrolledWindow()
        sw.add(self.desc_view)
        grid.attach(sw, 1, 7, 1, 1)

        # All day
        self.all_day = Gtk.CheckButton(label="All day")
        grid.attach(self.all_day, 1, 8, 1, 1)

        self.show_all()

    def get_event(self):
        start = datetime(
            self.start_date.get_year(), self.start_date.get_month() + 1,
            self.start_date.get_day(), int(self.start_time.get_value()))
        end = datetime(
            self.end_date.get_year(), self.end_date.get_month() + 1,
            self.end_date.get_day(), int(self.end_time.get_value()))

        return {
            "id": datetime.now().strftime("%Y%m%d%H%M%S%f"),
            "title": self.title_entry.get_text(),
            "calendar": self.cal_combo.get_active_text(),
            "start": ics_datetime(start),
            "end": ics_datetime(end),
            "location": self.location_entry.get_text(),
            "description": self.desc_buffer.get_text(
                self.desc_buffer.get_start_iter(),
                self.desc_buffer.get_end_iter(), True),
            "all_day": self.all_day.get_active(),
        }


class CalendarsDialog(Gtk.Dialog):
    def __init__(self, parent, calendars):
        super().__init__(title="Calendars", transient_for=parent, modal=True)
        self.set_default_size(400, 300)
        self.calendars = calendars
        self.add_buttons("Close", Gtk.ResponseType.CLOSE)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_border_width(16)
        self.get_content_area().add(vbox)

        self.listbox = Gtk.ListBox()
        self.refresh_list()
        vbox.pack_start(self.listbox, True, True, 0)

        btn_box = Gtk.Box(spacing=8)
        for label, cb in [("+ Add", self.add_calendar), ("Remove", self.remove_calendar)]:
            b = Gtk.Button(label=label)
            b.connect("clicked", cb)
            btn_box.pack_start(b, False, False, 0)
        vbox.pack_start(btn_box, False, False, 0)

        self.show_all()

    def refresh_list(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        for name, data in self.calendars.items():
            row = Gtk.ListBoxRow()
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            hbox.set_border_width(8)

            # Color indicator
            color = Gtk.DrawingArea()
            color.set_size_request(16, 16)
            color.connect("draw", lambda a, c, col=data["color"]: (
                c.set_source_rgba(*Gdk.RGBA().parse(col)),
                c.rectangle(0, 0, 16, 16),
                c.fill(), True)[0])
            hbox.pack_start(color, False, False, 0)

            # Name + visibility
            name_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lbl = Gtk.Label(label=name, xalign=0)
            name_box.pack_start(lbl, False, False, 0)
            vis = Gtk.Switch()
            vis.set_active(data.get("visible", True))
            vis.connect("notify::active", self.on_vis_change, name)
            name_box.pack_start(vis, False, False, 0)
            hbox.pack_start(name_box, True, True, 0)

            row.add(hbox)
            self.listbox.add(row)
        self.listbox.show_all()

    def on_vis_change(self, switch, _, name):
        self.calendars[name]["visible"] = switch.get_active()

    def add_calendar(self, _):
        dialog = Gtk.Dialog(title="New Calendar", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, margin=16)
        dialog.get_content_area().add(grid)

        grid.attach(Gtk.Label(label="Name:", xalign=0), 0, 0, 1, 1)
        name_entry = Gtk.Entry(placeholder_text="Calendar name")
        grid.attach(name_entry, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Color:", xalign=0), 0, 1, 1, 1)
        color_btn = Gtk.ColorButton()
        grid.attach(color_btn, 1, 1, 1, 1)

        if dialog.run() == Gtk.ResponseType.OK:
            name = name_entry.get_text().strip()
            if name and name not in self.calendars:
                rgba = color_btn.get_rgba()
                color = f"#{int(rgba.red*255):02x}{int(rgba.green*255):02x}{int(rgba.blue*255):02x}"
                self.calendars[name] = {"color": color, "visible": True}
                self.refresh_list()
        dialog.destroy()

    def remove_calendar(self, _):
        row = self.listbox.get_selected_row()
        if row:
            # Get name from row
            pass


def main():
    w = CalendarWindow()
    w.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0

if __name__ == "__main__":
    sys.exit(main())