#!/usr/bin/env python3
"""mv-calendar — Mavericks-like Calendar.
Leather sidebar (mini month + calendar list) over a paper content area with
Month/Week/Day views. Events: timed + all-day, simple repeat
(none/daily/weekly/monthly/yearly), location, notes. Local JSON storage
(~/.local/share/mv-calendar/calendars.json) — no daemon, no Electron.
ICS import/export (RFC-5545 subset: VEVENT, DATE/DATETIME, RRULE FREQ).
Upcoming-event nudges via user systemd timer (--check-upcoming oneshot,
every 5 min, notify-send). Birthdays from Contacts is out of scope
(Contacts is excluded from the app inventory).
License: GPL-2.0-or-later."""
import calendar as cal
import json
import os
import subprocess
import sys
import time
import uuid
from datetime import datetime, timedelta

# Timer one-shots (--check-upcoming) are pure Python + notify-send; defining
# the GUI classes only in GUI mode keeps the Gtk import (~150-400 ms) out of
# the 5-min timer path.
_GUI = len(sys.argv) <= 1 or sys.argv[1] != "--check-upcoming"

if _GUI:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib, Gdk, Gio

# Import EDS sync bridge (always available for headless --sync)
try:
    # When imported as module (from same package)
    from .mv_calendar_eds import (
        sync_eds, get_sync_status, _is_eds_available,
        MIN_SYNC_INTERVAL, _EDS_AVAILABLE
    )
    _EDS_SYNC_AVAILABLE = True
except ImportError:
    # When run as script (relative import fails)
    try:
        import importlib.machinery
        import importlib.util
        import os
        base = os.path.dirname(os.path.abspath(__file__))
        eds_path = os.path.join(base, "mv_calendar_eds.py")
        loader = importlib.machinery.SourceFileLoader("mv_calendar_eds", eds_path)
        spec = importlib.util.spec_from_loader("mv_calendar_eds", loader)
        eds_mod = importlib.util.module_from_spec(spec)
        loader.exec_module(eds_mod)
        sync_eds = eds_mod.sync_eds
        get_sync_status = eds_mod.get_sync_status
        _is_eds_available = eds_mod._is_eds_available
        MIN_SYNC_INTERVAL = eds_mod.MIN_SYNC_INTERVAL
        _EDS_AVAILABLE = eds_mod._EDS_AVAILABLE
        _EDS_SYNC_AVAILABLE = True
    except Exception:
        _EDS_SYNC_AVAILABLE = False
        _EDS_AVAILABLE = False
        MIN_SYNC_INTERVAL = 15 * 60
        def sync_eds(force=False, on_progress=None):
            return {"success": False, "imported": 0, "errors": 0,
                    "skipped": True, "reason": "EDS sync module not available",
                    "sources_synced": []}
        def get_sync_status():
            return {"eds_available": False, "source_count": 0,
                    "last_sync": 0, "last_sync_str": "Never",
                    "sources": {}, "next_sync_in": 0}
        def _is_eds_available():
            return False

STORE = os.path.expanduser("~/.local/share/mv-calendar/calendars.json")
REPEAT_MODES = ["none", "daily", "weekly", "monthly", "yearly"]
DEFAULT_ACCOUNTS = {
    "Personal": {
        "calendars": {
            "Personal": {"color": "#007aff", "visible": True},
            "Family": {"color": "#34c759", "visible": True},
        }
    },
    "Work": {
        "calendars": {
            "Work": {"color": "#ff3b30", "visible": True},
            "Projects": {"color": "#af52de", "visible": True},
        }
    },
}
ROW_H_WEEK = 40
ROW_H_DAY = 48
GUTTER_W = 48
DAY_COL_W = 150


def now():
    return datetime.now()


def today_str():
    return time.strftime("%Y-%m-%d")


# ---------------------------------------------------------------- store I/O

def _backup_path(path):
    return path + ".bak"


def _quarantine_path(path):
    return "%s.corrupt-%d" % (path, int(time.time()))


def load_store(path=None, on_warn=None):
    """JSON store with backup-restore + quarantine (same pattern as
    mv-notes/mv-reminders). Corrupt file is never silently overwritten."""
    path = path or STORE

    def warn(msg):
        if on_warn:
            on_warn(msg)

    if not os.path.exists(path):
        return _normalize({"accounts": DEFAULT_ACCOUNTS, "events": []})
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        bak = _backup_path(path)
        if os.path.exists(bak):
            try:
                with open(bak) as f:
                    data = json.load(f)
                warn("Calendar store was unreadable (%s); restored from backup." % e)
                return _normalize(data)
            except (OSError, ValueError):
                pass
        try:
            os.replace(path, _quarantine_path(path))
        except OSError:
            pass
        warn("Calendar store was unreadable (%s); the corrupt file was "
             "quarantined and a fresh store was started." % e)
        data = {"accounts": DEFAULT_ACCOUNTS, "events": []}
    return _normalize(data)


def save_store(path=None, data=None):
    path = path or STORE
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        try:
            os.replace(path, _backup_path(path))
        except OSError:
            pass
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def _normalize(data):
    if not isinstance(data, dict):
        return {"accounts": {k: {"calendars": dict(v["calendars"])}
                            for k, v in DEFAULT_ACCOUNTS.items()},
                "events": [], "geometry": {}}

    # Migration from old flat "calendars" format to new "accounts" format
    if "accounts" not in data and "calendars" in data:
        accounts = {}
        for cal_name, cal_data in data["calendars"].items():
            # Heuristic: group calendars into Personal/Work accounts based on name
            if cal_name in ("Personal", "Family", "Birthdays"):
                acc = "Personal"
            elif cal_name in ("Work", "Projects"):
                acc = "Work"
            else:
                acc = "Personal"
            if acc not in accounts:
                accounts[acc] = {"calendars": {}}
            accounts[acc]["calendars"][cal_name] = cal_data
        # Ensure defaults exist
        for acc_name, acc_data in DEFAULT_ACCOUNTS.items():
            if acc_name not in accounts:
                accounts[acc_name] = {"calendars": dict(acc_data["calendars"])}
            else:
                for cal_name, cal_data in acc_data["calendars"].items():
                    if cal_name not in accounts[acc_name]["calendars"]:
                        accounts[acc_name]["calendars"][cal_name] = cal_data
        data["accounts"] = accounts
        data.pop("calendars", None)

    if not isinstance(data.get("accounts"), dict):
        data["accounts"] = {k: {"calendars": dict(v["calendars"])}
                            for k, v in DEFAULT_ACCOUNTS.items()}

    for acc_name, acc_data in list(data["accounts"].items()):
        if not isinstance(acc_data, dict) or not isinstance(acc_data.get("calendars"), dict):
            default_cals = DEFAULT_ACCOUNTS.get(acc_name, {}).get("calendars", {})
            data["accounts"][acc_name] = {"calendars": dict(default_cals)}
            continue
        for cal_name, cal_data in list(acc_data["calendars"].items()):
            if not isinstance(cal_data, dict):
                acc_data["calendars"][cal_name] = {"color": "#888888", "visible": True}
                continue
            cal_data.setdefault("color", "#888888")
            cal_data.setdefault("visible", True)

    if not isinstance(data.get("events"), list):
        data["events"] = []
    data["events"] = [ev for ev in data["events"] if isinstance(ev, dict)]
    data.setdefault("geometry", {})

    # Migration: add "account" field to events that only have "calendar"
    # Determine account from calendar name
    cal_to_acc = {}
    for acc_name, acc_data in data["accounts"].items():
        for cal_name in acc_data["calendars"]:
            cal_to_acc[cal_name] = acc_name

    for ev in data["events"]:
        ev.setdefault("id", uuid.uuid4().hex[:12])
        ev.setdefault("title", "")
        ev_cal = ev.get("calendar", "")
        ev.setdefault("calendar", ev_cal)
        ev.setdefault("account", cal_to_acc.get(ev_cal, "Personal"))
        ev.setdefault("start", datetime.now().strftime("%Y%m%dT%H%M%S"))
        ev.setdefault("end", ev["start"])
        ev.setdefault("location", "")
        ev.setdefault("description", "")
        ev.setdefault("all_day", False)
        ev.setdefault("repeat", "none")
        if not isinstance(ev.get("notified"), list):
            ev["notified"] = []
    return data


# ---------------------------------------------------------------- dates

def parse_dt(s):
    """Strict ICS datetime parse: 'YYYYMMDDTHHMMSS' (local floating) or
    'YYYYMMDD' (all-day DATE). Returns None on anything malformed —
    callers must skip, never fall back to now() (silent data corruption)."""
    if not isinstance(s, str):
        return None
    s = s.strip()
    try:
        if "T" in s:
            return datetime.strptime(s[:15], "%Y%m%dT%H%M%S")
        return datetime.strptime(s[:8], "%Y%m%d")
    except ValueError:
        return None


def fmt_ics(dt, all_day=False):
    if all_day:
        return dt.strftime("%Y%m%d")
    return dt.strftime("%Y%m%dT%H%M%S")


def fmt_time(dt):
    return dt.strftime("%H:%M")


def iter_event_dates(ev):
    """Yield occurrence start datetimes honoring repeat (bounded: 3-year
    horizon, max 500 occurrences)."""
    start = parse_dt(ev.get("start"))
    if not start:
        return
    end = parse_dt(ev.get("end") or ev.get("start"))
    if not end or end < start:
        end = start
    freq = ev.get("repeat", "none")
    if freq not in REPEAT_MODES[1:]:
        yield start
        return
    horizon = start + timedelta(days=365 * 5)
    count = 0
    if freq in ("daily", "weekly"):
        step = timedelta(days=1 if freq == "daily" else 7)
        cur = start
        while cur <= end and cur <= horizon and count < 500:
            yield cur
            cur += step
            count += 1
    else:
        months = 1 if freq == "monthly" else 12
        anchor = start.day
        cur = start
        while cur <= end and cur <= horizon and count < 500:
            yield cur
            m = cur.month - 1 + months
            y = cur.year + m // 12
            m = m % 12 + 1
            day = min(anchor, cal.monthrange(y, m)[1])
            cur = cur.replace(year=y, month=m, day=day)
            count += 1


def get_calendar_info(accounts, account, calendar):
    """Get calendar info dict from accounts structure."""
    return accounts.get(account, {}).get("calendars", {}).get(calendar, {})


def is_calendar_visible(accounts, account, calendar):
    """Check if a calendar is visible."""
    return get_calendar_info(accounts, account, calendar).get("visible", True)


def get_calendar_color(accounts, account, calendar):
    """Get calendar color."""
    return get_calendar_info(accounts, account, calendar).get("color", "#888888")


def iter_all_calendars(accounts):
    """Yield (account, calendar, info) for all calendars."""
    for acc_name, acc_data in accounts.items():
        for cal_name, cal_data in acc_data.get("calendars", {}).items():
            yield acc_name, cal_name, cal_data


def events_for_day(events, accounts, target, query=""):
    """Visible, query-matching events occurring on target date (datetime).
    All-day and multi-day spans match per date."""
    result = []
    q = (query or "").strip().lower()
    for ev in events:
        acc = ev.get("account", "Personal")
        ev_cal = ev.get("calendar", "")
        if not is_calendar_visible(accounts, acc, ev_cal):
            continue
        if q and not matches_event(ev, q):
            continue
        if not parse_dt(ev.get("start")):
            continue
        for s in iter_event_dates(ev):
            e = parse_dt(ev.get("end") or ev.get("start")) or s
            if s.date() <= target.date() <= e.date():
                result.append(ev)
                break
    return result


def matches_event(ev, query):
    if not query:
        return True
    return (query in ev.get("title", "").lower()
            or query in ev.get("location", "").lower())


def validate_event(title, start, end, all_day):
    """Returns error string or None (headless-testable)."""
    if not title.strip():
        return "Title is required."
    if not all_day and end < start:
        return "End time must be after start time."
    return None


def check_upcoming(events, within_min=15, now_dt=None):
    """Events starting within within_min minutes that were not yet notified.
    Returns list of event dicts (GUI marks notified + saves)."""
    now_dt = now_dt or now()
    out = []
    for ev in events:
        if ev.get("all_day"):
            continue
        s = parse_dt(ev.get("start"))
        if not s:
            continue
        delta = (s - now_dt).total_seconds()
        key = s.strftime("%Y-%m-%dT%H:%M")
        if 0 <= delta <= within_min * 60 and key not in ev.get("notified", []):
            out.append(ev)
    return out


# ---------------------------------------------------------------- ICS

def ics_escape(text):
    return (text.replace("\\", "\\\\").replace(";", "\\;")
            .replace(",", "\\,").replace("\n", "\\n"))


def ics_fold(line):
    """RFC-5545 line folding at 75 chars with CRLF continuation."""
    out = []
    rest = line
    while len(rest) > 75:
        out.append(rest[:75])
        rest = rest[75:]
        out.append("\r\n ")
    out.append(rest)
    return "".join(out)


def _ics_prop(name, value):
    return ics_fold("%s:%s" % (name, ics_escape(value)))


def _ics_prop_date(name, dt, all_day):
    if all_day:
        return ics_fold("%s;VALUE=DATE:%s" % (name, dt.strftime("%Y%m%d")))
    return ics_fold("%s:%s" % (name, dt.strftime("%Y%m%dT%H%M%S")))


def ics_unescape(text):
    out, i = [], 0
    while i < len(text):
        c = text[i]
        if c == "\\" and i + 1 < len(text):
            nxt = text[i + 1]
            if nxt == "n":
                out.append("\n")
            elif nxt == "N":
                out.append("\n")
            else:
                out.append(nxt)
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def write_ics(path, events):
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0",
             "PRODID:-//Mavericks Calendar//EN", "CALSCALE:GREGORIAN"]
    for ev in events:
        lines.append("BEGIN:VEVENT")
        lines.append("UID:%s" % ev.get("id", uuid.uuid4().hex[:12]))
        lines.append(_ics_prop_date("DTSTART", parse_dt(ev["start"]),
                                    ev.get("all_day", False)))
        lines.append(_ics_prop_date("DTEND",
                                    parse_dt(ev.get("end") or ev["start"]),
                                    ev.get("all_day", False)))
        lines.append(_ics_prop("SUMMARY", ev.get("title", "")))
        if ev.get("location"):
            lines.append(_ics_prop("LOCATION", ev["location"]))
        if ev.get("description"):
            lines.append(_ics_prop("DESCRIPTION", ev["description"]))
        if ev.get("repeat", "none") != "none":
            lines.append("RRULE:FREQ=%s" % ev["repeat"].upper())
        lines.append("END:VEVENT")
    lines.append("END:VCALENDAR")
    with open(path, "w") as f:
        f.write("\r\n".join(lines) + "\r\n")


def _parse_ics_datetime_value(value):
    value = value.strip()
    if value.startswith("VALUE=DATE:"):
        value = value.split(":", 1)[1]
    if value.endswith("Z"):
        value = value[:-1]
    return parse_dt(value)


def read_ics(path):
    """Minimal RFC-5545 VEVENT parser. Returns (events, error_count).
    Unparseable VEVENTs are skipped, never crash the import."""
    events, errors = [], 0
    with open(path) as f:
        raw = f.read()
    # unfold continuation lines
    lines = []
    for line in raw.replace("\r\n", "\n").split("\n"):
        if line.startswith(" ") and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line)
    cur = None
    for line in lines:
        if line == "BEGIN:VEVENT":
            cur = {"id": uuid.uuid4().hex[:12], "title": "", "location": "",
                   "description": "", "all_day": False, "repeat": "none",
                   "notified": []}
        elif line == "END:VEVENT":
            if cur is not None:
                if parse_dt(cur.get("start")):
                    events.append(cur)
                else:
                    errors += 1
            cur = None
        elif cur is not None and ":" in line:
            name, value = line.split(":", 1)
            name = name.split(";", 1)[0].upper()
            if name == "DTSTART":
                dt = _parse_ics_datetime_value(value)
                if dt:
                    cur["start"] = fmt_ics(dt, "T" not in value)
                    cur["all_day"] = "T" not in value
            elif name == "DTEND":
                dt = _parse_ics_datetime_value(value)
                if dt:
                    cur["end"] = fmt_ics(dt, "T" not in value)
            elif name == "SUMMARY":
                cur["title"] = ics_unescape(value)
            elif name == "LOCATION":
                cur["location"] = ics_unescape(value)
            elif name == "DESCRIPTION":
                cur["description"] = ics_unescape(value)
            elif name == "UID":
                cur["id"] = value
            elif name == "RRULE":
                for part in value.split(";"):
                    if part.upper().startswith("FREQ="):
                        freq = part.split("=", 1)[1].lower()
                        if freq in REPEAT_MODES[1:]:
                            cur["repeat"] = freq
    return events, errors


# ---------------------------------------------------------------- GUI

if _GUI:
    class CalendarWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="Calendar")
            self.store_warnings = []
            self.data = load_store(STORE, self.store_warnings.append)
            g = self.data.get("geometry", {})
            if g.get("w") and g.get("h"):
                self.set_default_size(g["w"], g["h"])
                self.move(g.get("x", 100), g.get("y", 100))
            else:
                self.set_default_size(1050, 700)
            self.accounts = self.data.get("accounts", DEFAULT_ACCOUNTS)
            self.events = self.data.get("events", [])
            self.current_date = datetime.now()
            self.view_mode = "month"
            self.query = ""
            self.selected_id = None
            self.apply_mavericks_css()

            hb = Gtk.HeaderBar(title="Calendar", show_close_button=True)
            self.set_titlebar(hb)

            self.search = Gtk.SearchEntry(placeholder_text="Search")
            self.search.connect("changed", self.on_search)
            hb.pack_start(self.search)

            nav = Gtk.Box(spacing=4)
            for label, icon, cb in [("Today", None, self.go_today),
                                    ("‹", "go-previous", self.prev_period),
                                    ("›", "go-next", self.next_period)]:
                if icon is None:
                    b = Gtk.Button(label=label)
                else:
                    b = Gtk.Button()
                    b.set_image(Gtk.Image.new_from_icon_name(
                        icon, Gtk.IconSize.BUTTON))
                b.get_style_context().add_class("mavericks-toolbar-btn")
                b.connect("clicked", cb)
                nav.pack_start(b, False, False, 0)
            hb.pack_end(nav)

            self.view_btns = {}
            vbox = Gtk.Box(spacing=0)
            for i, v in enumerate(["Month", "Week", "Day"]):
                b = Gtk.ToggleButton(label=v)
                b.get_style_context().add_class("mavericks-toolbar-btn")
                b.set_active(i == 0)
                b.connect("toggled", self.on_view_toggle, v.lower())
                vbox.pack_start(b, False, False, 0)
                self.view_btns[v.lower()] = b
            hb.pack_end(vbox)

            for label, icon, cb in [
                    ("New Event", "list-add", self.new_event),
                    ("Calendars", "preferences-system", self.show_calendars),
                    ("Import", "document-open", self.import_ics_gui),
                    ("Export", "document-save-as", self.export_ics_gui),
                    ("Sync EDS", "view-refresh", self.sync_eds_gui)]:
                b = Gtk.Button()
                b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
                b.set_tooltip_text(label)
                b.get_style_context().add_class("mavericks-toolbar-btn")
                b.connect("clicked", cb)
                hb.pack_end(b)

            self.title_label = Gtk.Label()
            self.title_label.set_margin_end(12)
            hb.set_custom_title(self.title_label)

            paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
            self.add(paned)

            # === LEFT: leather sidebar (mini month + calendar list) ===
            side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            side.set_border_width(8)
            mini = Gtk.Calendar()
            mini.get_style_context().add_class("cal-mini-month")
            mini.set_size_request(210, -1)
            mini.connect("day-selected", self.on_mini_day)
            side.pack_start(mini, False, False, 0)
            self.mini = mini

            cal_header = Gtk.Label(label="Calendars")
            cal_header.get_style_context().add_class("cal-sidebar-header")
            cal_header.set_xalign(0)
            side.pack_start(cal_header, False, False, 4)

            self.cal_list = Gtk.ListBox()
            self.cal_list.set_selection_mode(Gtk.SelectionMode.NONE)
            side.pack_start(self.cal_list, True, True, 0)
            sw = Gtk.ScrolledWindow()
            sw.get_style_context().add_class("cal-sidebar")
            sw.set_size_request(220, -1)
            sw.add(side)
            paned.add1(sw)

            # === RIGHT: paper content ===
            self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            csw = Gtk.ScrolledWindow()
            csw.get_style_context().add_class("cal-content")
            csw.add(self.content)
            paned.add2(csw)

            self.update_title()
            self.refresh()
            self.connect("key-press-event", self.on_key)
            self.connect("destroy", self.on_destroy)
            self.show_all()
            self._warn_if_needed()
            # On-launch EDS sync check (respects 15-min interval)
            if _EDS_SYNC_AVAILABLE:
                GLib.idle_add(self._check_eds_sync_on_launch)

        def _check_eds_sync_on_launch(self):
            """Check if EDS sync should run on launch (non-blocking)."""
            status = get_sync_status()
            if status["eds_available"] and status["next_sync_in"] == 0:
                def on_progress(msg):
                    pass  # Silent on launch
                result = sync_eds(force=False, on_progress=on_progress)
                if result["success"] and result["imported"] > 0:
                    self.toast("EDS sync: imported %d event(s)" % result["imported"])
                    self.refresh()

        def apply_mavericks_css(self):
            css = b"""
            .cal-sidebar {
                background: #e8dcc8;
                background-image: linear-gradient(135deg, #e8dcc8 0%, #d4c4a8 100%);
                border-right: 1px solid #c4b898;
            }
            .cal-sidebar > viewport { background: transparent; }
            .cal-sidebar list { background: transparent; }
            .cal-sidebar row { background: transparent; padding: 6px 8px; }
            .cal-sidebar row:hover { background: rgba(0,122,255,0.12); }
            .cal-sidebar-header {
                color: #5a4a38; font-weight: bold; font-size: 9pt;
                text-shadow: 0 1px 0 rgba(255,255,255,0.4);
            }
            .cal-account-header {
                color: #5a4a38; font-weight: bold; font-size: 9pt;
                text-shadow: 0 1px 0 rgba(255,255,255,0.4);
            }
            .cal-content {
                background: #f5f0e8;
                background-image: linear-gradient(180deg, #f5f0e8 0%, #ece2d4 100%);
            }
            .cal-content > viewport { background: transparent; }
            .mavericks-toolbar-btn {
                border-radius: 4px;
                padding: 6px 12px;
                margin: 2px;
                background-image: linear-gradient(to bottom, #f0ebe0 0%, #e0d8c8 100%);
                border: 1px solid #d0c8b8;
                color: #333;
                text-shadow: 0 1px 0 rgba(255,255,255,0.5);
            }
            .mavericks-toolbar-btn:checked {
                background-image: linear-gradient(to bottom, #c8d8f0 0%, #a8c0e0 100%);
                border: 1px solid #7898c0;
            }
            .mavericks-toolbar-btn:hover {
                background-image: linear-gradient(to bottom, #e8e0d0 0%, #d8d0c0 100%);
                box-shadow: 0 1px 2px rgba(0,0,0,0.1);
            }
            .mavericks-toolbar-btn:active {
                background-image: linear-gradient(to bottom, #d8d0c0 0%, #c8c0b0 100%);
            }
            .cal-mini-month { font-size: 8pt; }
            .cal-weekday-header {
                font-weight: bold; font-size: 9pt; color: #5a4a38;
                padding: 4px; text-shadow: 0 1px 0 rgba(255,255,255,0.4);
            }
            .cal-other-month { color: #b0a490; }
            .cal-today {
                background-image: linear-gradient(to bottom, #4a90d9 0%, #007aff 100%);
                color: white; border-radius: 4px; font-weight: bold;
            }
            .cal-today-num { font-weight: bold; }
            .cal-day-cell { border: 1px solid #ddd2c0; background: rgba(255,255,255,0.4); }
            .cal-day-cell:hover { background: rgba(0,122,255,0.08); }
            .cal-event-block {
                border-radius: 3px;
                border: 1px solid rgba(0,0,0,0.25);
            }
            .cal-event-block-selected {
                border: 2px solid #007aff;
                box-shadow: 0 1px 4px rgba(0,122,255,0.4);
            }
            .cal-day-header { font-weight: bold; font-size: 10pt; color: #4a4a4a; }
            .cal-day-header-today { color: #007aff; }
            .cal-hour-label { font-size: 8pt; color: #999088; }
            .cal-all-day-label {
                font-size: 8pt; color: #999088; font-style: italic;
            }
            .cal-empty { color: #998877; font-style: italic; font-size: 11pt; padding: 40px; }
            """
            provider = Gtk.CssProvider()
            try:
                provider.load_from_data(css)
            except Exception:
                # cosmetic only: a bad rule must not kill the window
                pass
            screen = Gdk.Screen.get_default()
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # ------------------------------------------------------------ plumbing

        def _warn_if_needed(self):
            if not self.store_warnings:
                return
            d = Gtk.MessageDialog(transient_for=self, modal=True,
                                 message_type=Gtk.MessageType.WARNING,
                                 buttons=Gtk.ButtonsType.OK,
                                 text="Calendar store warning")
            d.format_secondary_text("\n".join(self.store_warnings))
            d.run()
            d.destroy()

        def save(self):
            save_store(STORE, self.data)

        def update_title(self):
            if self.view_mode == "month":
                title = self.current_date.strftime("%B %Y")
            elif self.view_mode == "week":
                start = self.current_date - timedelta(days=self.current_date.weekday())
                end = start + timedelta(days=6)
                title = "%s – %s" % (start.strftime("%b %d"),
                                      end.strftime("%b %d, %Y"))
            else:
                title = self.current_date.strftime("%A, %B %d, %Y")
            self.title_label.set_markup("<b>%s</b>" % GLib.markup_escape_text(title))

        def go_today(self, _):
            self.current_date = datetime.now()
            self.refresh()

        def prev_period(self, _):
            if self.view_mode == "month":
                self.current_date = (self.current_date.replace(day=1)
                                     - timedelta(days=1)).replace(day=1)
            elif self.view_mode == "week":
                self.current_date -= timedelta(weeks=1)
            else:
                self.current_date -= timedelta(days=1)
            self.refresh()

        def next_period(self, _):
            if self.view_mode == "month":
                nxt = self.current_date.replace(day=28) + timedelta(days=4)
                self.current_date = nxt.replace(day=1)
            elif self.view_mode == "week":
                self.current_date += timedelta(weeks=1)
            else:
                self.current_date += timedelta(days=1)
            self.refresh()

        def on_view_toggle(self, btn, mode):
            if not btn.get_active():
                # clicking the already-current segment is a no-op
                if mode == self.view_mode:
                    btn.handler_block_by_func(self.on_view_toggle)
                    btn.set_active(True)
                    btn.handler_unblock_by_func(self.on_view_toggle)
                return
            self.view_mode = mode
            for m, b in self.view_btns.items():
                if m != mode and b.get_active():
                    b.handler_block_by_func(self.on_view_toggle)
                    b.set_active(False)
                    b.handler_unblock_by_func(self.on_view_toggle)
            self.refresh()

        def on_search(self, _e):
            self.query = self.search.get_text().strip()
            self.refresh_view()

        def on_mini_day(self, _cal):
            y, m, d = self.mini.get_date()
            self.current_date = self.current_date.replace(
                year=y, month=m + 1, day=min(d, cal.monthrange(y, m + 1)[1]))
            self.refresh()

        def refresh(self):
            self.accounts = self.data.get("accounts", DEFAULT_ACCOUNTS)
            self.events = self.data.get("events", [])
            self.update_title()
            self.rebuild_calendar_list()
            self.refresh_view()

        def rebuild_calendar_list(self):
            for child in self.cal_list.get_children():
                self.cal_list.remove(child)
            for acc_name, acc_data in self.accounts.items():
                # Account header row
                acc_row = Gtk.ListBoxRow()
                acc_row.set_activatable(False)
                acc_row.set_selectable(False)
                acc_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                acc_hbox.set_border_width(4)
                acc_lbl = Gtk.Label(label=acc_name.upper(), xalign=0)
                acc_lbl.get_style_context().add_class("cal-account-header")
                acc_hbox.pack_start(acc_lbl, True, True, 0)
                acc_row.add(acc_hbox)
                self.cal_list.add(acc_row)
                # Calendar rows under this account
                for cal_name, cal_data in acc_data.get("calendars", {}).items():
                    row = Gtk.ListBoxRow()
                    hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                                   spacing=8)
                    hbox.set_border_width(4)
                    dot = Gtk.DrawingArea()
                    dot.set_size_request(14, 14)
                    dot.connect("draw", self.draw_dot, cal_data["color"])
                    hbox.pack_start(dot, False, False, 0)
                    lbl = Gtk.Label(label="  " + cal_name, xalign=0)
                    hbox.pack_start(lbl, True, True, 0)
                    vis = Gtk.CheckButton()
                    vis.set_active(cal_data.get("visible", True))
                    vis.connect("toggled", self.on_vis_toggle, acc_name, cal_name)
                    hbox.pack_start(vis, False, False, 0)
                    row.add(hbox)
                    self.cal_list.add(row)
            self.cal_list.show_all()

        @staticmethod
        def draw_dot(area, cr, color):
            rgba = Gdk.RGBA()
            if not rgba.parse(color):
                rgba.parse("#888888")
            cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
            cr.arc(7, 7, 5, 0, 6.2832)
            cr.fill()

        def on_vis_toggle(self, btn, acc_name, cal_name):
            self.accounts[acc_name]["calendars"][cal_name]["visible"] = btn.get_active()
            self.save()
            self.refresh_view()

        def refresh_view(self):
            for child in self.content.get_children():
                self.content.remove(child)
            if self.view_mode == "month":
                self.content.pack_start(self.build_month_view(), True, True, 0)
            elif self.view_mode == "week":
                self.content.pack_start(self.build_week_view(), True, True, 0)
            else:
                self.content.pack_start(self.build_day_view(), True, True, 0)
            self.mark_mini_month()
            self.update_title()
            self.content.show_all()

        def mark_mini_month(self):
            self.mini.clear_marks()
            y, m = self.current_date.year, self.current_date.month
            days_with_events = set()
            for ev in self.events:
                acc = ev.get("account", "Personal")
                ev_cal = ev.get("calendar", "")
                if not is_calendar_visible(self.accounts, acc, ev_cal):
                    continue
                for s in iter_event_dates(ev):
                    e = parse_dt(ev.get("end") or ev.get("start")) or s
                    if s.year == y and s.month == m:
                        days_with_events.add(s.day)
                    if e.year == y and e.month == m:
                        days_with_events.add(e.day)
                    if (s.year, s.month) < (y, m) < (e.year, e.month):
                        days_with_events.update(
                            range(1, cal.monthrange(y, m)[1] + 1))
            for d in days_with_events:
                try:
                    self.mini.mark_day(d)
                except Exception:
                    pass

        # ------------------------------------------------------------ month

        def build_month_view(self):
            grid = Gtk.Grid()
            grid.set_row_spacing(1)
            grid.set_column_spacing(1)
            for i, day in enumerate(["Mon", "Tue", "Wed", "Thu", "Fri",
                                     "Sat", "Sun"]):
                lbl = Gtk.Label(label=day)
                lbl.get_style_context().add_class("cal-weekday-header")
                grid.attach(lbl, i, 0, 1, 1)

            first_day = self.current_date.replace(day=1)
            start_weekday = first_day.weekday()
            days_in_month = cal.monthrange(self.current_date.year,
                                           self.current_date.month)[1]
            prev_month = first_day - timedelta(days=1)
            prev_days = cal.monthrange(prev_month.year, prev_month.month)[1]
            weeks = (start_weekday + days_in_month + 6) // 7

            day = 1 - start_weekday
            for week in range(weeks):
                for wd in range(7):
                    if day < 1:
                        label = str(prev_days + day)
                        cls = "cal-other-month"
                    elif day > days_in_month:
                        label = str(day - days_in_month)
                        cls = "cal-other-month"
                    else:
                        label = str(day)
                        cls = "cal-day-cell"
                        is_today = (self.current_date.year == datetime.now().year
                                    and self.current_date.month
                                    == datetime.now().month
                                    and day == datetime.now().day)
                        if is_today:
                            cls += " cal-today"
                        btn = Gtk.Button()
                        btn.get_style_context().add_class(cls)
                        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                                        spacing=2)
                        inner.set_margin_top(2)
                        num = Gtk.Label(label=label)
                        num.get_style_context().add_class("cal-today-num"
                                                          if is_today else "")
                        num.set_xalign(0)
                        inner.pack_start(num, False, False, 0)
                        day_events = events_for_day(
                            self.events, self.accounts,
                            datetime(self.current_date.year,
                                     self.current_date.month, day), self.query)
                        for ev in day_events[:3]:
                            t = fmt_time(parse_dt(ev["start"])) if not ev.get(
                                "all_day") else "all-day"
                            acc = ev.get("account", "Personal")
                            ev_cal = ev.get("calendar", "")
                            color = get_calendar_color(self.accounts, acc, ev_cal)
                            ev_lbl = Gtk.Label()
                            ev_lbl.set_markup(
                                '<span foreground="%s">%s %s</span>'
                                % (GLib.markup_escape_text(color),
                                   "●", GLib.markup_escape_text(
                                       "%s %s" % (t, ev["title"][:18]))))
                            ev_lbl.set_xalign(0)
                            ev_lbl.set_ellipsize(3)
                            inner.pack_start(ev_lbl, False, False, 0)
                        if len(day_events) > 3:
                            more = Gtk.Label(label="+%d more"
                                                    % (len(day_events) - 3))
                            more.get_style_context().add_class("cal-all-day-label")
                            more.set_xalign(0)
                            inner.pack_start(more, False, False, 0)
                        btn.add(inner)
                        btn.set_hexpand(True)
                        btn.set_vexpand(True)
                        btn.connect("clicked", self.on_day_click, day)
                        grid.attach(btn, wd, week + 1, 1, 1)
                        day += 1
                        continue
                    lbl = Gtk.Label(label=label)
                    lbl.get_style_context().add_class(cls)
                    lbl.set_sensitive(False)
                    grid.attach(lbl, wd, week + 1, 1, 1)
                    day += 1
            return grid

        def on_day_click(self, _, day):
            self.current_date = self.current_date.replace(day=day)
            self.view_mode = "day"
            self.view_btns["day"].set_active(True)
            self.refresh_view()

        # ------------------------------------------------------------ week

        def build_week_view(self):
            start = self.current_date - timedelta(days=self.current_date.weekday())
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            outer.set_border_width(8)

            # all-day strip
            allday = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            lbl = Gtk.Label(label="all-day")
            lbl.get_style_context().add_class("cal-all-day-label")
            lbl.set_size_request(GUTTER_W, -1)
            lbl.set_xalign(0)
            allday.pack_start(lbl, False, False, 0)
            for i in range(7):
                day = start + timedelta(days=i)
                cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                cell.set_size_request(DAY_COL_W, -1)
                cell.get_style_context().add_class("cal-day-cell")
                for ev in events_for_day(self.events, self.accounts, day,
                                          self.query):
                    if ev.get("all_day"):
                        cell.pack_start(self.make_event_block(ev, wide=True),
                                        False, False, 0)
                allday.pack_start(cell, False, False, 0)
            outer.pack_start(allday, False, False, 0)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            gutter = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            gutter.set_size_request(GUTTER_W, -1)
            for h in range(24):
                gl = Gtk.Label(label=self._hour_label(h))
                gl.get_style_context().add_class("cal-hour-label")
                gl.set_size_request(GUTTER_W, ROW_H_WEEK)
                gl.set_yalign(0)
                gutter.pack_start(gl, False, False, 0)
            row.pack_start(gutter, False, False, 0)

            grid_sw = Gtk.ScrolledWindow()
            grid_sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            grid_sw.set_size_request(-1, 24 * ROW_H_WEEK)
            grid_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                               spacing=4)
            for i in range(7):
                day = start + timedelta(days=i)
                grid_box.pack_start(self.make_day_column(day), False, False, 0)
            grid_sw.add(grid_box)
            row.pack_start(grid_sw, True, True, 0)
            outer.pack_start(row, True, True, 0)
            return outer

        def make_day_column(self, day):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            is_today = day.date() == datetime.now().date()
            header = Gtk.Label()
            header.set_markup("<b>%s</b>" % GLib.markup_escape_text(
                day.strftime("%a %b %d")))
            header.get_style_context().add_class(
                "cal-day-header-today" if is_today else "cal-day-header")
            header.set_size_request(DAY_COL_W, -1)
            col.pack_start(header, False, False, 0)

            fixed = Gtk.Fixed()
            fixed.set_size_request(DAY_COL_W, 24 * ROW_H_WEEK)
            bg = Gtk.DrawingArea()
            bg.set_size_request(DAY_COL_W, 24 * ROW_H_WEEK)
            bg.connect("draw", self.draw_hour_lines, 24, ROW_H_WEEK)
            fixed.put(bg, 0, 0)

            for ev in events_for_day(self.events, self.accounts, day,
                                      self.query):
                if ev.get("all_day"):
                    continue
                s = parse_dt(ev["start"])
                e = parse_dt(ev.get("end") or ev["start"]) or s
                y = (s.hour * 60 + s.minute) / 60.0 * ROW_H_WEEK
                h = max((e - s).total_seconds() / 3600.0 * ROW_H_WEEK,
                        ROW_H_WEEK // 2)
                y = min(y, 24 * ROW_H_WEEK - h)
                block = self.make_event_block(ev, wide=True)
                block.set_size_request(DAY_COL_W - 6, int(h))
                fixed.put(block, 3, int(y))
            col.add(fixed)
            return col

        @staticmethod
        def draw_hour_lines(area, cr, hours, row_h):
            w = area.get_allocated_width()
            h = area.get_allocated_height()
            cr.set_source_rgba(0.93, 0.90, 0.85, 1)
            cr.rectangle(0, 0, w, h)
            cr.fill()
            cr.set_source_rgba(0.80, 0.76, 0.68, 1)
            cr.set_line_width(1)
            for i in range(hours + 1):
                y = i * row_h + 0.5
                cr.move_to(0, y)
                cr.line_to(w, y)
                cr.stroke()

        @staticmethod
        def _hour_label(h):
            if h == 0:
                return "12 AM"
            if h < 12:
                return "%d AM" % h
            if h == 12:
                return "12 PM"
            return "%d PM" % (h - 12)

        # ------------------------------------------------------------ day

        def build_day_view(self):
            day = self.current_date
            outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            outer.set_border_width(8)
            gutter = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            gutter.set_size_request(GUTTER_W, -1)
            for h in range(24):
                gl = Gtk.Label(label=self._hour_label(h))
                gl.get_style_context().add_class("cal-hour-label")
                gl.set_size_request(GUTTER_W, ROW_H_DAY)
                gl.set_yalign(0)
                gutter.pack_start(gl, False, False, 0)
            outer.pack_start(gutter, False, False, 0)

            evs = events_for_day(self.events, self.accounts, day, self.query)
            if not evs:
                lbl = Gtk.Label(label="No events"
                                + (" match your search" if self.query else ""))
                lbl.get_style_context().add_class("cal-empty")
                lbl.set_justify(Gtk.Justification.CENTER)
                outer.pack_start(lbl, True, True, 0)
                return outer

            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            col.get_style_context().add_class("cal-day-cell")
            allday = [ev for ev in evs if ev.get("all_day")]
            timed = [ev for ev in evs if not ev.get("all_day")]
            timed.sort(key=lambda ev: ev["start"])
            for ev in allday + timed:
                col.pack_start(self.make_event_block(ev, wide=True, details=True),
                               False, False, 0)
            outer.pack_start(col, True, True, 0)
            return outer

        # ------------------------------------------------------------ events

        def make_event_block(self, ev, wide=False, details=False):
            acc = ev.get("account", "Personal")
            ev_cal = ev.get("calendar", "")
            color = get_calendar_color(self.accounts, acc, ev_cal)
            rgba = Gdk.RGBA()
            if not rgba.parse(color):
                rgba.parse("#888888")
            block = Gtk.Frame()
            block.get_style_context().add_class("cal-event-block")
            if ev.get("id") == self.selected_id:
                block.get_style_context().add_class("cal-event-block-selected")
            block.override_background_color(Gtk.StateFlags.NORMAL, rgba)

            s = parse_dt(ev["start"])
            if not ev.get("all_day") and s:
                time_s = fmt_time(s)
            else:
                time_s = "all-day"
            text = "%s  %s" % (GLib.markup_escape_text(time_s),
                               GLib.markup_escape_text(ev["title"]))
            if details:
                e = parse_dt(ev.get("end") or ev["start"])
                if not ev.get("all_day") and e:
                    text += " – %s" % GLib.markup_escape_text(fmt_time(e))
                if ev.get("location"):
                    text += "\n@ %s" % GLib.markup_escape_text(ev["location"])
                if ev.get("description"):
                    desc = ev["description"].split("\n")[0][:60]
                    text += "\n%s" % GLib.markup_escape_text(desc)
            lbl = Gtk.Label(label=text)
            lbl.set_xalign(0)
            lbl.set_line_wrap(wide)
            lbl.set_markup('<span foreground="white">%s</span>' % text)
            block.add(lbl)
            block.set_tooltip_text(ev["title"])
            block.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            block.connect("button-press-event", self.on_event_button, ev)
            return block

        def on_event_button(self, block, ev, ev2):
            if ev2.button == 1 and ev2.type == Gdk.EventType._2BUTTON_PRESS:
                self.edit_event(ev["id"])
                return True
            if ev2.button == 3:
                self.selected_id = ev["id"]
                self.refresh_view()
                menu = Gtk.Menu()
                for label, cb in [("Edit", self.ctx_edit),
                                  ("Delete", self.ctx_delete)]:
                    item = Gtk.MenuItem(label=label)
                    item.connect("activate", cb)
                    menu.append(item)
                menu.show_all()
                menu.popup(None, None, None, None, 0, ev2.time)
                return True
            if ev2.button == 1:
                self.selected_id = ev["id"]
                self.refresh_view()
                return True
            return False

        def find_event(self, eid):
            return next((e for e in self.events if e.get("id") == eid), None)

        def edit_event(self, eid):
            ev = self.find_event(eid)
            if ev is None:
                return
            dialog = EventDialog(self, self.accounts,
                                 parse_dt(ev["start"]) or datetime.now(), ev=ev)
            if dialog.run() == Gtk.ResponseType.OK:
                new = dialog.get_event()
                if new is not None:
                    new["id"] = ev["id"]
                    new["notified"] = ev.get("notified", [])
                    idx = self.events.index(ev)
                    self.events[idx] = new
                    self.save()
                    self.refresh()
            dialog.destroy()

        def delete_event(self, eid):
            ev = self.find_event(eid)
            if ev is None:
                return
            d = Gtk.MessageDialog(transient_for=self, modal=True,
                                 message_type=Gtk.MessageType.WARNING,
                                 buttons=Gtk.ButtonsType.NONE,
                                 text="Delete event?")
            d.format_secondary_text('"%s" will be permanently removed.'
                                    % ev["title"])
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                          "Delete", Gtk.ResponseType.OK)
            if d.run() == Gtk.ResponseType.OK:
                self.events = [e for e in self.events if e["id"] != eid]
                if self.selected_id == eid:
                    self.selected_id = None
                self.save()
                self.refresh()
            d.destroy()

        def ctx_edit(self, _it):
            if self.selected_id:
                self.edit_event(self.selected_id)

        def ctx_delete(self, _it):
            if self.selected_id:
                self.delete_event(self.selected_id)

        def new_event(self, _):
            self.new_event_with_date(self.current_date)

        def new_event_with_date(self, date):
            dialog = EventDialog(self, self.accounts, date)
            if dialog.run() == Gtk.ResponseType.OK:
                ev = dialog.get_event()
                if ev is not None:
                    self.events.append(ev)
                    self.save()
                    self.refresh()
            dialog.destroy()

        # ------------------------------------------------------------ ICS

        def export_ics_gui(self, _):
            dialog = Gtk.FileChooserDialog(
                title="Export Calendar", transient_for=self,
                action=Gtk.FileChooserAction.SAVE)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Export", Gtk.ResponseType.OK)
            dialog.set_current_name("calendar.ics")
            if dialog.run() == Gtk.ResponseType.OK:
                path = dialog.get_filename()
                try:
                    write_ics(path, self.events)
                    self.toast("Exported %d events to %s"
                               % (len(self.events), os.path.basename(path)))
                except OSError as e:
                    self.error_dialog("Export failed: %s" % e)
            dialog.destroy()

        def import_ics_gui(self, _):
            dialog = Gtk.FileChooserDialog(
                title="Import Calendar", transient_for=self,
                action=Gtk.FileChooserAction.OPEN)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Import", Gtk.ResponseType.OK)
            filter_ics = Gtk.FileFilter()
            filter_ics.set_name("iCalendar Files")
            filter_ics.add_pattern("*.ics")
            dialog.add_filter(filter_ics)
            if dialog.run() == Gtk.ResponseType.OK:
                path = dialog.get_filename()
                try:
                    imported, errors = read_ics(path)
                except OSError as e:
                    self.error_dialog("Cannot read file: %s" % e)
                    dialog.destroy()
                    return
                if not imported and errors:
                    self.error_dialog("No valid events found in file "
                                      "(%d entries skipped)." % errors)
                else:
                    default_acc = list(self.accounts)[0] if self.accounts else "Personal"
                    default_cal = list(self.accounts[default_acc]["calendars"])[0] if self.accounts[default_acc]["calendars"] else "Personal"
                    for ev in imported:
                        ev.setdefault("calendar", default_cal)
                        ev.setdefault("account", default_acc)
                    self.events.extend(imported)
                    self.save()
                    self.refresh()
                    msg = "Imported %d event(s)." % len(imported)
                    if errors:
                        msg += " %d entr%s skipped." % (
                            errors, "y" if errors == 1 else "ies")
                    self.toast(msg)
            dialog.destroy()

        def toast(self, text):
            d = Gtk.MessageDialog(transient_for=self, modal=False,
                                 message_type=Gtk.MessageType.INFO,
                                 buttons=Gtk.ButtonsType.OK, text=text)
            d.run()
            d.destroy()

        def error_dialog(self, text):
            d = Gtk.MessageDialog(transient_for=self, modal=True,
                                 message_type=Gtk.MessageType.ERROR,
                                 buttons=Gtk.ButtonsType.OK, text=text)
            d.run()
            d.destroy()

        # ------------------------------------------------------------ calendars

        def show_calendars(self, _):
            dialog = CalendarsDialog(self, self.accounts)
            dialog.run()
            dialog.destroy()
            self.save()
            self.refresh()

        # ------------------------------------------------------------ EDS sync

        def sync_eds_gui(self, _):
            def on_progress(msg):
                # Update status in window title or show toast
                self.toast(msg)

            def do_sync():
                result = sync_eds(force=True, on_progress=on_progress)
                if result["success"]:
                    self.toast("EDS sync: imported %d event(s) from %d source(s)"
                               % (result["imported"], len(result["sources_synced"])))
                    self.refresh()
                elif result["skipped"]:
                    self.toast("EDS sync skipped: %s" % result["reason"])
                else:
                    self.error_dialog("EDS sync failed: %s" % result["reason"])

            # Run sync in background to avoid blocking UI
            GLib.idle_add(do_sync)

        # ------------------------------------------------------------ keyboard

        def on_key(self, _w, ev):
            focus = self.get_focus()
            in_text = isinstance(focus, (Gtk.Entry, Gtk.TextView))
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            if ctrl and ev.keyval == Gdk.KEY_n and not in_text:
                self.new_event(None)
                return True
            if ctrl and ev.keyval == Gdk.KEY_f:
                self.search.grab_focus()
                return True
            if ctrl and ev.keyval == Gdk.KEY_e and not in_text:
                self.export_ics_gui(None)
                return True
            if ctrl and ev.keyval == Gdk.KEY_i and not in_text:
                self.import_ics_gui(None)
                return True
            # Ctrl+Shift+R for EDS sync
            shift = ev.state & Gdk.ModifierType.SHIFT_MASK
            if ctrl and shift and ev.keyval == Gdk.KEY_r and not in_text:
                self.sync_eds_gui(None)
                return True
            if in_text:
                return False
            if ev.keyval in (Gdk.KEY_Left, Gdk.KEY_Right):
                self.prev_period(None) if ev.keyval == Gdk.KEY_Left \
                    else self.next_period(None)
                return True
            if ev.keyval == Gdk.KEY_t:
                self.go_today(None)
                return True
            if ev.keyval in (Gdk.KEY_1, Gdk.KEY_2, Gdk.KEY_3):
                mode = ["month", "week", "day"][ev.keyval - Gdk.KEY_1]
                self.view_btns[mode].set_active(True)
                return True
            if ev.keyval == Gdk.KEY_Delete:
                if self.selected_id:
                    self.delete_event(self.selected_id)
                return True
            if ev.keyval == Gdk.KEY_Escape:
                if self.search.get_text():
                    self.search.set_text("")
                    self.query = ""
                    self.refresh_view()
                    return True
            return False

        def on_destroy(self, _w):
            try:
                x, y = self.get_position()
                w, h = self.get_size()
                self.data["geometry"] = {"x": x, "y": y, "w": w, "h": h}
                self.save()
            except Exception:
                pass


    class EventDialog(Gtk.Dialog):
        def __init__(self, parent, accounts, date, ev=None):
            editing = ev is not None
            super().__init__(title="Edit Event" if editing else "New Event",
                             transient_for=parent, modal=True)
            self.set_default_size(380, 430)
            self.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                             "Save" if editing else "Add", Gtk.ResponseType.OK)
            self.accounts = accounts
            self.set_response_sensitive(Gtk.ResponseType.OK, False)

            grid = Gtk.Grid(column_spacing=12, row_spacing=10, margin=16)
            self.get_content_area().add(grid)

            grid.attach(Gtk.Label(label="Title:", xalign=0), 0, 0, 1, 1)
            self.title_entry = Gtk.Entry(placeholder_text="Event title")
            self.title_entry.connect("changed", self.on_title_changed)
            grid.attach(self.title_entry, 1, 0, 1, 1)

            grid.attach(Gtk.Label(label="Account:", xalign=0), 0, 1, 1, 1)
            self.acc_combo = Gtk.ComboBoxText()
            for acc_name in accounts:
                self.acc_combo.append_text(acc_name)
            self.acc_combo.set_active(0)
            self.acc_combo.connect("changed", self.on_account_changed)
            grid.attach(self.acc_combo, 1, 1, 1, 1)

            grid.attach(Gtk.Label(label="Calendar:", xalign=0), 0, 2, 1, 1)
            self.cal_combo = Gtk.ComboBoxText()
            self.update_calendar_combo()
            grid.attach(self.cal_combo, 1, 2, 1, 1)

            grid.attach(Gtk.Label(label="Starts:", xalign=0), 0, 3, 1, 1)
            hb = Gtk.Box(spacing=6)
            self.start_date = Gtk.Calendar()
            self.start_date.select_month(date.month - 1, date.year)
            self.start_date.select_day(date.day)
            hb.pack_start(self.start_date, False, False, 0)
            grid.attach(hb, 1, 3, 1, 1)

            grid.attach(Gtk.Label(label="Time:", xalign=0), 0, 4, 1, 1)
            hb = Gtk.Box(spacing=4)
            self.start_hour = Gtk.SpinButton.new_with_range(0, 23, 1)
            self.start_hour.set_value(date.hour)
            self.start_min = Gtk.SpinButton.new_with_range(0, 59, 1)
            self.start_min.set_value(0)
            hb.pack_start(self.start_hour, True, True, 0)
            hb.pack_start(Gtk.Label(label=":"), False, False, 0)
            hb.pack_start(self.start_min, True, True, 0)
            grid.attach(hb, 1, 4, 1, 1)

            grid.attach(Gtk.Label(label="Ends:", xalign=0), 0, 5, 1, 1)
            hb = Gtk.Box(spacing=6)
            self.end_date = Gtk.Calendar()
            end_d = date + timedelta(hours=1)
            self.end_date.select_month(end_d.month - 1, end_d.year)
            self.end_date.select_day(end_d.day)
            hb.pack_start(self.end_date, False, False, 0)
            grid.attach(hb, 1, 5, 1, 1)

            grid.attach(Gtk.Label(label="Time:", xalign=0), 0, 6, 1, 1)
            hb = Gtk.Box(spacing=4)
            self.end_hour = Gtk.SpinButton.new_with_range(0, 23, 1)
            self.end_hour.set_value(min(date.hour + 1, 23))
            self.end_min = Gtk.SpinButton.new_with_range(0, 59, 1)
            self.end_min.set_value(0)
            hb.pack_start(self.end_hour, True, True, 0)
            hb.pack_start(Gtk.Label(label=":"), False, False, 0)
            hb.pack_start(self.end_min, True, True, 0)
            grid.attach(hb, 1, 6, 1, 1)

            self.all_day = Gtk.CheckButton(label="All day")
            self.all_day.connect("toggled", self.on_all_day_toggled)
            grid.attach(self.all_day, 1, 7, 1, 1)

            grid.attach(Gtk.Label(label="Repeat:", xalign=0), 0, 8, 1, 1)
            self.repeat_combo = Gtk.ComboBoxText()
            for label, key in [("None", "none"), ("Daily", "daily"),
                               ("Weekly", "weekly"), ("Monthly", "monthly"),
                               ("Yearly", "yearly")]:
                self.repeat_combo.append_text(label)
            self.repeat_combo.set_active(0)
            grid.attach(self.repeat_combo, 1, 8, 1, 1)

            grid.attach(Gtk.Label(label="Location:", xalign=0), 0, 9, 1, 1)
            self.location_entry = Gtk.Entry(placeholder_text="Location")
            grid.attach(self.location_entry, 1, 9, 1, 1)

            grid.attach(Gtk.Label(label="Notes:", xalign=0), 0, 10, 1, 1)
            self.desc_buffer = Gtk.TextBuffer()
            self.desc_view = Gtk.TextView(buffer=self.desc_buffer)
            self.desc_view.set_wrap_mode(Gtk.WrapMode.WORD)
            self.desc_view.set_size_request(-1, 70)
            sw = Gtk.ScrolledWindow()
            sw.add(self.desc_view)
            grid.attach(sw, 1, 10, 1, 1)

            if editing:
                self.title_entry.set_text(ev.get("title", ""))
                self.location_entry.set_text(ev.get("location", ""))
                if ev.get("description"):
                    self.desc_buffer.set_text(ev["description"])
                # Set account combo
                acc = ev.get("account", "Personal")
                for i, acc_name in enumerate(self.accounts):
                    if acc_name == acc:
                        self.acc_combo.set_active(i)
                        break
                self.update_calendar_combo()
                ev_cal = ev.get("calendar", "")
                for i in range(self.cal_combo.get_active() + 1):
                    if self.cal_combo.get_active_text() == ev_cal:
                        break
                else:
                    for i in range(self.cal_combo.get_model().iter_n_children(None) if self.cal_combo.get_model() else 0):
                        pass
                self.all_day.set_active(bool(ev.get("all_day")))
                self.repeat_combo.set_active(
                    REPEAT_MODES.index(ev.get("repeat", "none")))
                if not ev.get("all_day") and parse_dt(ev["start"]):
                    s = parse_dt(ev["start"])
                    self.start_hour.set_value(s.hour)
                    self.start_min.set_value(s.minute)
                    e = parse_dt(ev.get("end")) or s
                    self.end_hour.set_value(e.hour)
                    self.end_min.set_value(e.minute)
            self.on_all_day_toggled(None)
            self.on_title_changed(None)
            self.show_all()

        def on_account_changed(self, _combo):
            self.update_calendar_combo()

        def update_calendar_combo(self):
            self.cal_combo.remove_all()
            acc_name = self.acc_combo.get_active_text()
            if acc_name and acc_name in self.accounts:
                for cal_name in self.accounts[acc_name]["calendars"]:
                    self.cal_combo.append_text(cal_name)
            if self.cal_combo.get_active_text() is None:
                self.cal_combo.set_active(0)

        def on_title_changed(self, _e):
            self.set_response_sensitive(
                Gtk.ResponseType.OK, bool(self.title_entry.get_text().strip()))

        def on_all_day_toggled(self, _b):
            timed = not self.all_day.get_active()
            for w in (self.start_hour, self.start_min, self.end_hour,
                      self.end_min):
                w.set_sensitive(timed)

        def get_datetimes(self):
            sy, sm, sd = self.start_date.get_date()
            ey, em, ed = self.end_date.get_date()
            start = datetime(sy, sm + 1, sd,
                             int(self.start_hour.get_value()),
                             int(self.start_min.get_value()))
            end = datetime(ey, em + 1, ed,
                           int(self.end_hour.get_value()),
                           int(self.end_min.get_value()))
            return start, end

        def get_event(self):
            """Returns event dict, or None if invalid (error dialog shown)."""
            title = self.title_entry.get_text().strip()
            start, end = self.get_datetimes()
            all_day = self.all_day.get_active()
            if all_day:
                start = datetime(start.year, start.month, start.day)
                end = datetime(end.year, end.month, end.day)
            err = validate_event(title, start, end, all_day)
            if err:
                d = Gtk.MessageDialog(transient_for=self, modal=True,
                                     message_type=Gtk.MessageType.WARNING,
                                     buttons=Gtk.ButtonsType.OK, text=err)
                d.run()
                d.destroy()
                return None
            return {
                "id": uuid.uuid4().hex[:12],
                "title": title,
                "account": self.acc_combo.get_active_text() or "Personal",
                "calendar": self.cal_combo.get_active_text() or "Personal",
                "start": fmt_ics(start, all_day),
                "end": fmt_ics(end, all_day),
                "location": self.location_entry.get_text().strip(),
                "description": self.desc_buffer.get_text(
                    self.desc_buffer.get_start_iter(),
                    self.desc_buffer.get_end_iter(), True).strip(),
                "all_day": all_day,
                "repeat": REPEAT_MODES[self.repeat_combo.get_active()],
                "notified": [],
            }


    class CalendarsDialog(Gtk.Dialog):
        def __init__(self, parent, accounts):
            super().__init__(title="Calendars", transient_for=parent, modal=True)
            self.set_default_size(360, 400)
            self.accounts = accounts
            self.add_buttons("Close", Gtk.ResponseType.CLOSE)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            vbox.set_border_width(16)
            self.get_content_area().add(vbox)

            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.refresh_list()
            vbox.pack_start(self.listbox, True, True, 0)

            btn_box = Gtk.Box(spacing=8)
            for label, cb in [
                ("+ Add Account", self.add_account),
                ("+ Add Calendar", self.add_calendar),
                ("Remove", self.remove_item),
                ("Edit", self.edit_item)]:
                b = Gtk.Button(label=label)
                b.connect("clicked", cb)
                btn_box.pack_start(b, False, False, 0)
            vbox.pack_start(btn_box, False, False, 0)
            self.show_all()

        def refresh_list(self):
            for child in self.listbox.get_children():
                self.listbox.remove(child)
            for acc_name, acc_data in self.accounts.items():
                # Account header
                acc_row = Gtk.ListBoxRow()
                acc_row.set_data("type", "account")
                acc_row.set_data("name", acc_name)
                acc_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                acc_hbox.set_border_width(8)
                acc_lbl = Gtk.Label(label=acc_name.upper(), xalign=0)
                acc_lbl.get_style_context().add_class("cal-account-header")
                acc_hbox.pack_start(acc_lbl, True, True, 0)
                acc_row.add(acc_hbox)
                self.listbox.add(acc_row)
                # Calendars in this account
                for cal_name, cal_data in acc_data.get("calendars", {}).items():
                    cal_row = Gtk.ListBoxRow()
                    cal_row.set_data("type", "calendar")
                    cal_row.set_data("account", acc_name)
                    cal_row.set_data("name", cal_name)
                    cal_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                                       spacing=12)
                    cal_hbox.set_border_width(8)
                    dot = Gtk.DrawingArea()
                    dot.set_size_request(16, 16)
                    dot.connect("draw", self.draw_dot, cal_data["color"])
                    cal_hbox.pack_start(dot, False, False, 0)
                    lbl = Gtk.Label(label="  " + cal_name, xalign=0)
                    cal_hbox.pack_start(lbl, True, True, 0)
                    vis = Gtk.CheckButton()
                    vis.set_active(cal_data.get("visible", True))
                    vis.connect("toggled", self.on_vis_toggle, acc_name, cal_name)
                    cal_hbox.pack_start(vis, False, False, 0)
                    cal_row.add(cal_hbox)
                    self.listbox.add(cal_row)
            self.listbox.show_all()

        @staticmethod
        def draw_dot(area, cr, color):
            rgba = Gdk.RGBA()
            if not rgba.parse(color):
                rgba.parse("#888888")
            cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1)
            cr.arc(8, 8, 6, 0, 6.2832)
            cr.fill()

        def on_vis_toggle(self, btn, acc_name, cal_name):
            self.accounts[acc_name]["calendars"][cal_name]["visible"] = btn.get_active()

        def get_selected_item(self):
            row = self.listbox.get_selected_row()
            if row is None:
                return None
            return {
                "type": row.get_data("type"),
                "name": row.get_data("name"),
                "account": row.get_data("account"),
            }

        def add_account(self, _):
            dialog = Gtk.Dialog(title="New Account", transient_for=self,
                                modal=True)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Add", Gtk.ResponseType.OK)
            grid = Gtk.Grid(column_spacing=12, row_spacing=12, margin=16)
            dialog.get_content_area().add(grid)
            grid.attach(Gtk.Label(label="Name:", xalign=0), 0, 0, 1, 1)
            name_entry = Gtk.Entry(placeholder_text="Account name")
            grid.attach(name_entry, 1, 0, 1, 1)
            if dialog.run() == Gtk.ResponseType.OK:
                name = name_entry.get_text().strip()
                if name and name not in self.accounts:
                    self.accounts[name] = {"calendars": {}}
                    self.refresh_list()
            dialog.destroy()

        def add_calendar(self, _):
            # Need to know which account to add to
            item = self.get_selected_item()
            default_acc = item["account"] if item and item["type"] == "calendar" else (
                item["name"] if item and item["type"] == "account" else list(self.accounts)[0])
            dialog = Gtk.Dialog(title="New Calendar", transient_for=self,
                                modal=True)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Add", Gtk.ResponseType.OK)
            grid = Gtk.Grid(column_spacing=12, row_spacing=12, margin=16)
            dialog.get_content_area().add(grid)
            grid.attach(Gtk.Label(label="Account:", xalign=0), 0, 0, 1, 1)
            acc_combo = Gtk.ComboBoxText()
            for acc in self.accounts:
                acc_combo.append_text(acc)
            if default_acc in self.accounts:
                for i, acc in enumerate(self.accounts):
                    if acc == default_acc:
                        acc_combo.set_active(i)
                        break
            grid.attach(acc_combo, 1, 0, 1, 1)
            grid.attach(Gtk.Label(label="Name:", xalign=0), 0, 1, 1, 1)
            name_entry = Gtk.Entry(placeholder_text="Calendar name")
            grid.attach(name_entry, 1, 1, 1, 1)
            grid.attach(Gtk.Label(label="Color:", xalign=0), 0, 2, 1, 1)
            color_btn = Gtk.ColorButton()
            grid.attach(color_btn, 1, 2, 1, 1)
            if dialog.run() == Gtk.ResponseType.OK:
                acc = acc_combo.get_active_text()
                name = name_entry.get_text().strip()
                if acc and name and name not in self.accounts[acc]["calendars"]:
                    rgba = color_btn.get_rgba()
                    color = "#%02x%02x%02x" % (int(rgba.red * 255),
                                               int(rgba.green * 255),
                                               int(rgba.blue * 255))
                    self.accounts[acc]["calendars"][name] = {"color": color, "visible": True}
                    self.refresh_list()
            dialog.destroy()

        def remove_item(self, _):
            item = self.get_selected_item()
            if not item:
                return
            if item["type"] == "account":
                d = Gtk.MessageDialog(transient_for=self, modal=True,
                                     message_type=Gtk.MessageType.WARNING,
                                     buttons=Gtk.ButtonsType.NONE,
                                     text="Delete account?")
                d.format_secondary_text('Account "%s" and all its calendars and events '
                                        "will be permanently removed." % item["name"])
                d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Delete", Gtk.ResponseType.OK)
                if d.run() == Gtk.ResponseType.OK:
                    del self.accounts[item["name"]]
                    self.refresh_list()
                d.destroy()
            else:
                d = Gtk.MessageDialog(transient_for=self, modal=True,
                                     message_type=Gtk.MessageType.WARNING,
                                     buttons=Gtk.ButtonsType.NONE,
                                     text="Delete calendar?")
                d.format_secondary_text('Calendar "%s" and its events will be permanently '
                                        "removed." % item["name"])
                d.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Delete", Gtk.ResponseType.OK)
                if d.run() == Gtk.ResponseType.OK:
                    del self.accounts[item["account"]]["calendars"][item["name"]]
                    self.refresh_list()
                d.destroy()

        def edit_item(self, _):
            item = self.get_selected_item()
            if not item or item["type"] != "calendar":
                return
            acc_name = item["account"]
            cal_name = item["name"]
            cal_data = self.accounts[acc_name]["calendars"][cal_name]
            dialog = Gtk.Dialog(title="Edit Calendar", transient_for=self,
                                modal=True)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                              "Save", Gtk.ResponseType.OK)
            grid = Gtk.Grid(column_spacing=12, row_spacing=12, margin=16)
            dialog.get_content_area().add(grid)
            grid.attach(Gtk.Label(label="Name:", xalign=0), 0, 0, 1, 1)
            name_entry = Gtk.Entry()
            name_entry.set_text(cal_name)
            grid.attach(name_entry, 1, 0, 1, 1)
            grid.attach(Gtk.Label(label="Color:", xalign=0), 0, 1, 1, 1)
            color_btn = Gtk.ColorButton()
            rgba = Gdk.RGBA()
            if rgba.parse(cal_data["color"]):
                color_btn.set_rgba(rgba)
            grid.attach(color_btn, 1, 1, 1, 1)
            if dialog.run() == Gtk.ResponseType.OK:
                new_name = name_entry.get_text().strip()
                if new_name:
                    rgba = color_btn.get_rgba()
                    color = "#%02x%02x%02x" % (int(rgba.red * 255),
                                               int(rgba.green * 255),
                                               int(rgba.blue * 255))
                    # Handle rename
                    if new_name != cal_name:
                        del self.accounts[acc_name]["calendars"][cal_name]
                    self.accounts[acc_name]["calendars"][new_name] = {
                        "color": color, "visible": cal_data.get("visible", True)}
                    self.refresh_list()
            dialog.destroy()



def build_calendar_menu(app, app_name, get_window, add_action):
    def w():
        return get_window()

    add_action("new-event", lambda: w().new_event(None) if w() else None)
    add_action("today", lambda: w().go_today(None) if w() else None)
    add_action("previous", lambda: w().prev_period(None) if w() else None)
    add_action("next", lambda: w().next_period(None) if w() else None)
    add_action("month", lambda: w().view_btns["month"].set_active(True) if w() else None)
    add_action("week", lambda: w().view_btns["week"].set_active(True) if w() else None)
    add_action("day", lambda: w().view_btns["day"].set_active(True) if w() else None)
    add_action("find", lambda: w().search.grab_focus() if w() else None)
    add_action("edit-event", lambda: w().edit_event(w().selected_id)
               if w() and w().selected_id else None)
    add_action("delete-event", lambda: w().delete_event(w().selected_id)
               if w() and w().selected_id else None)
    add_action("import", lambda: w().import_ics_gui(None) if w() else None)
    add_action("export", lambda: w().export_ics_gui(None) if w() else None)
    add_action("sync", lambda: w().sync_eds_gui(None) if w() else None)
    add_action("calendars", lambda: w().show_calendars(None) if w() else None)
    add_action("close", lambda: w().destroy() if w() else None)
    add_action("quit", app.quit)

    menu = Gio.Menu()
    app_menu = Gio.Menu()
    app_menu.append("About Calendar", "app.about")
    app_menu.append("Quit Calendar", "app.quit")
    menu.append_submenu("Calendar", app_menu)

    file_menu = Gio.Menu()
    file_menu.append("New Event", "app.new-event")
    file_menu.append("Import…", "app.import")
    file_menu.append("Export…", "app.export")
    file_menu.append("Close Window", "app.close")
    menu.append_submenu("File", file_menu)

    edit_menu = Gio.Menu()
    edit_menu.append("Edit Selected Event", "app.edit-event")
    edit_menu.append("Delete Selected Event", "app.delete-event")
    edit_menu.append("Find", "app.find")
    menu.append_submenu("Edit", edit_menu)

    view_menu = Gio.Menu()
    view_menu.append("Month", "app.month")
    view_menu.append("Week", "app.week")
    view_menu.append("Day", "app.day")
    menu.append_submenu("View", view_menu)

    go_menu = Gio.Menu()
    go_menu.append("Today", "app.today")
    go_menu.append("Previous Period", "app.previous")
    go_menu.append("Next Period", "app.next")
    menu.append_submenu("Go", go_menu)

    window_menu = Gio.Menu()
    window_menu.append("Calendars…", "app.calendars")
    window_menu.append("Sync EDS", "app.sync")
    window_menu.append("Close Window", "app.close")
    menu.append_submenu("Window", window_menu)
    return menu

# ------------------------------------------------------------ CLI (timer)

def check_upcoming_cli():
    """Oneshot entry for mv-calendar-check.timer: notify for events
    starting within 15 minutes, mark them notified, save. Exits."""
    data = load_store()
    notified_events = check_upcoming(data.get("events", []))
    for ev in notified_events:
        s = parse_dt(ev.get("start"))
        when = fmt_time(s) if s and not ev.get("all_day") else "all-day"
        subprocess.run(["notify-send", "Calendar",
                        "%s — %s" % (when, ev.get("title", ""))])
        ev.setdefault("notified", []).append(
            s.strftime("%Y-%m-%dT%H:%M"))
    if notified_events:
        save_store(data=data)
    return 0


def sync_eds_cli():
    """Oneshot entry for manual EDS sync."""
    import json
    result = sync_eds(force=True, on_progress=lambda m: print(m, file=sys.stderr))
    print(json.dumps(result))
    return 0 if result["success"] or result["skipped"] else 1


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--check-upcoming":
        return check_upcoming_cli()
    if len(sys.argv) > 1 and sys.argv[1] == "--sync":
        return sync_eds_cli()
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    return run_application(
        "com.mavlinos.Calendar", "Calendar", CalendarWindow, sys.argv,
        build_calendar_menu)


if __name__ == "__main__":
    sys.exit(main())
