#!/usr/bin/env python3
"""mv-dictionary — Mavericks-like Dictionary.

Lookup sources (in order):
  1. built-in glossary (offline, ships with the app)
  2. WordNet via dictd (`dict -d wn`, optional, offline)
  3. system word list /usr/share/dict/* (existence check only)
  4. online: Wiktionary / thesaurus.com / Wikipedia (WebKit2)
  5. local Apple terminology database (offline)

WebKit2 (tries 4.1, then 4.0) renders the online tabs. When WebKit2 is
absent the app runs in local mode: glossary + Apple tab + word of the
day + history + bookmarks still work; online tabs show an honest notice.
No daemon, no polling: search-as-you-type is a debounced one-shot timer,
pronunciation is an on-demand espeak-ng subprocess (button hidden when
absent).
"""
import os
import re
import sys
import json
import html
import shutil
import subprocess
import urllib.request
import urllib.parse
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

WebKit2 = None
_WEBKIT_TRIED = False


def _ensure_webkit():
    global WebKit2, _WEBKIT_TRIED
    if _WEBKIT_TRIED:
        return WebKit2
    _WEBKIT_TRIED = True
    for _ver in ("4.1", "4.0"):
        try:
            gi.require_version("WebKit2", _ver)
            from gi.repository import WebKit2 as _WebKit2
            WebKit2 = _WebKit2
            break
        except ValueError:
            continue
    return WebKit2

CACHE_DIR = os.path.expanduser("~/.cache/mv-dictionary")
HISTORY_FILE = os.path.join(CACHE_DIR, "history.json")
BOOKMARKS_FILE = os.path.join(CACHE_DIR, "bookmarks.json")
HISTORY_LIMIT = 50
SEARCH_DELAY_MS = 300
WORDLIST_PATHS = ("/usr/share/dict/american-english",
                   "/usr/share/dict/british-english")
WEB_RSS_BUDGET_MB = int(os.environ.get("MV_DICT_WEB_BUDGET_MB", "500"))

