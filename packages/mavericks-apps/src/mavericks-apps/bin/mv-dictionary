def definition_html(word, text, source, online_url=None):
    link = ""
    if online_url:
        link = '<p><a href="%s">View on Wiktionary</a></p>' % _esc(online_url)
    return ("<html><head><style>%s</style></head><body>"
            "<h1>%s</h1><p class=\"source\">%s</p>"
            "<p class=\"definition\">%s</p>%s</body></html>"
            % (MAVERICKS_CSS, _esc(word), _esc(source), _esc(text), link))


def welcome_html():
    wod_word, wod_def = word_of_the_day()
    return ("<html><head><style>%s</style></head><body>"
            "<div class=\"wod\"><div class=\"wod-title\">Word of the Day</div>"
            "<div class=\"wod-word\">%s</div>"
            "<div class=\"wod-def\">%s</div></div>"
            "<p>Look up a word to get started. Sources: built-in glossary, "
            "WordNet (dictd), Apple terminology, and online dictionaries."
            "</p></body></html>"
            % (MAVERICKS_CSS, _esc(wod_word), _esc(wod_def)))


class LocalView:
    """WebKit2-absent fallback: read-only text view with the same
    load_uri/load_html interface the web views are called through."""

    def __init__(self):
        self.buf = Gtk.TextBuffer()
        self.tv = Gtk.TextView(buffer=self.buf)
        self.tv.set_editable(False)
        self.tv.set_cursor_visible(False)
        self.tv.set_wrap_mode(Gtk.WrapMode.WORD)

    def load_uri(self, uri):
        self.buf.set_text(
            "Online content is unavailable: %s\n\n"
            "Install webkit2gtk for the full Dictionary experience. "
            "Offline sources (built-in glossary, WordNet via dictd, Apple "
            "terminology, Word of the Day) still work." % uri)

    def load_html(self, html_text, base):
        self.buf.set_text(_strip_tags(html_text))


class DictionaryWindow(Gtk.Window):
    TAB_IDS = ("dictionary", "thesaurus", "wikipedia", "apple")
    TABS = (("dict", "dictionary", "Dictionary"),
            ("thes", "thesaurus", "Thesaurus"),
            ("wiki", "wikipedia", "Wikipedia"),
            ("apple", "apple", "Apple"))

    def __init__(self):
        super().__init__(title="Dictionary")
        self.set_default_size(900, 600)
        self.history = load_history()
        self.bookmarks = load_bookmarks()
        self.current_word = ""
        self._search_timeout = 0
        self._search_gen = 0
        self._online_disabled = False
        self._scrolled = {}
        self._budget_warned = False

        hb = Gtk.HeaderBar(title="Dictionary", show_close_button=True)
        self.set_titlebar(hb)

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search Dictionary...")
        self.search_entry.connect("activate", self.on_search)
        self.search_entry.connect("search-changed", self.on_search_changed)
        self.search_entry.set_hexpand(True)

        self.source_stack = Gtk.Stack()
        self.source_stack.set_transition_type(
            Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)

        for attr, page_id, title in self.TABS:
            scrolled = Gtk.ScrolledWindow()
            if _ensure_webkit() is not None:
                view = WebKit2.WebView()
                view.connect("load-failed", self.on_load_failed)
                scrolled.add(view)
            else:
                view = LocalView()
                scrolled.add(view.tv)
            self.source_stack.add_titled(scrolled, page_id, title)
            self._scrolled[attr] = scrolled
            setattr(self, attr + "_view", view)

        self.source_stack.connect("notify::visible-child",
                                  self._on_visible_child)
        self.stack_switcher = Gtk.StackSwitcher()
        self.stack_switcher.set_stack(self.source_stack)

        self.bookmark_btn = Gtk.ToggleButton()
        self.bookmark_btn.set_image(Gtk.Image.new_from_icon_name(
            "bookmark-new", Gtk.IconSize.BUTTON))
        self.bookmark_btn.set_tooltip_text("Bookmark this word (Ctrl+B)")
        self.bookmark_btn.set_sensitive(False)
        self.bookmark_btn.connect("toggled", self.on_bookmark)
        hb.pack_end(self.bookmark_btn)

        self.hist_btn = Gtk.ToggleButton()
        self.hist_btn.set_image(Gtk.Image.new_from_icon_name(
            "view-history", Gtk.IconSize.BUTTON))
        self.hist_btn.set_tooltip_text("Show History (Ctrl+H)")
        self.hist_btn.connect("toggled", self.on_history_toggle)
        hb.pack_end(self.hist_btn)

        self.speak_btn = Gtk.Button()
        self.speak_btn.set_image(Gtk.Image.new_from_icon_name(
            "audio-speakers", Gtk.IconSize.BUTTON))
        self.speak_btn.set_tooltip_text("Pronounce (espeak-ng)")
        self.speak_btn.set_sensitive(False)
        self.speak_btn.connect("clicked", self.on_speak)
        if shutil.which("espeak-ng") or shutil.which("espeak"):
            hb.pack_end(self.speak_btn)

        self.wod_banner = Gtk.InfoBar()
        self.wod_banner.set_message_type(Gtk.MessageType.INFO)
        wod_word, wod_def = word_of_the_day()
        wod_lbl = Gtk.Label()
        wod_lbl.set_markup(
            "<b>Word of the Day:</b> <b>%s</b> — %s"
            % (_esc(wod_word), _esc(wod_def)))
        wod_lbl.set_line_wrap(True)
        self.wod_banner.get_content_area().add(wod_lbl)
        self.wod_banner.add_button("Close", Gtk.ResponseType.CLOSE)
        self.wod_banner.connect("response", self.on_wod_close)

        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        toolbar.set_margin_start(12)
        toolbar.set_margin_end(12)
        toolbar.set_margin_top(6)
        toolbar.set_margin_bottom(6)
        toolbar.pack_start(self.search_entry, True, True, 0)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.vbox = vbox
        vbox.pack_start(toolbar, False, False, 0)
        vbox.pack_start(self.wod_banner, False, False, 0)
        vbox.pack_start(self.source_stack, True, True, 0)

        self.history_revealer = Gtk.Revealer()
        self.history_revealer.set_transition_type(
            Gtk.RevealerTransitionType.SLIDE_RIGHT)
        self.history_revealer.set_reveal_child(False)
        self.history_list = Gtk.ListBox()
        self.history_list.connect("row-activated", self.on_history_click)
        hist_scrolled = Gtk.ScrolledWindow()
        hist_scrolled.set_size_request(200, -1)
        hist_scrolled.add(self.history_list)
        self.history_revealer.add(hist_scrolled)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        sidebar.pack_start(self.history_revealer, False, False, 0)
        sidebar.pack_start(vbox, True, True, 0)
        self.add(sidebar)

        self.connect("key-press-event", self.on_key_press)
        self.refresh_history()
        self.show_welcome()
        self.show_all()

    def show_welcome(self):
        self.dict_view.load_html(welcome_html(), "about:blank")

    def on_wod_close(self, banner, response):
        banner.hide()

    def on_search_changed(self, entry):
        self._cancel_search()
        text = entry.get_text().strip()
        if not text:
            self.show_welcome()
            return
        self._search_gen += 1
        gen = self._search_gen
        self._search_timeout = GLib.timeout_add(
            SEARCH_DELAY_MS, self._deferred_search, gen)

    def _cancel_search(self):
        self._search_gen += 1
        if self._search_timeout:
            GLib.source_remove(self._search_timeout)
            self._search_timeout = 0

    def _deferred_search(self, gen):
        self._search_timeout = 0
        if gen != self._search_gen:
            return False
        word = self.search_entry.get_text().strip()
        if len(word) >= 2:
            self.on_search(self.search_entry)
        return False

    def on_search(self, entry):
        word = entry.get_text().strip()
        if not word:
            return
        self._cancel_search()
        self.load_definitions(word)
        self.add_to_history(word)
        self.update_bookmark_button()

    def load_definitions(self, word):
        self.current_word = word
        self._load_tab(self.source_stack.get_visible_child_name(), word)
        self._check_web_budget()

    def _load_tab(self, page_id, word):
        if self._online_disabled and page_id != "apple":
            return
        encoded = urllib.parse.quote(word)
        if page_id == "dictionary":
            local = local_definition(word)
            if local:
                source, text = local
                online_url = "https://en.wiktionary.org/wiki/" + encoded
                self.dict_view.load_html(
                    definition_html(word, text, source, online_url),
                    "about:blank")
            else:
                self.dict_view.load_uri(
                    "https://en.wiktionary.org/wiki/" + encoded)
        elif page_id == "thesaurus":
            self.thes_view.load_uri(
                "https://www.thesaurus.com/browse/" + encoded)
        elif page_id == "wikipedia":
            self.wiki_view.load_uri(
                "https://en.wikipedia.org/wiki/" + encoded)
        elif page_id == "apple":
            self.apple_view.load_html(apple_definition(word), "file://")

    def _on_visible_child(self, stack, pspec):
        if self.current_word:
            self._load_tab(stack.get_visible_child_name(), self.current_word)
            self._check_web_budget()

    def _web_process_rss_kb(self):
        total = 0
        try:
            with open("/proc/%d/task/%d/children"
                      % (os.getpid(), os.getpid())) as f:
                pids = f.read().split()
        except OSError:
            return 0
        for pid in pids:
            try:
                with open("/proc/%s/cmdline" % pid, "rb") as f:
                    exe = f.read().split(b"\0")[0].decode(errors="replace")
                if "WebKitWebProcess" not in exe:
                    continue
                with open("/proc/%s/status" % pid) as f:
                    for line in f:
                        if line.startswith("VmRSS:"):
                            total += int(line.split()[1])
                            break
            except (OSError, ValueError, IndexError):
                continue
        return total

    def _check_web_budget(self):
        if self._online_disabled or self._budget_warned:
            return
        if not WEB_RSS_BUDGET_MB:
            return
        rss_mb = self._web_process_rss_kb() / 1024.0
        if rss_mb <= WEB_RSS_BUDGET_MB:
            return
        self._budget_warned = True
        bar = Gtk.InfoBar()
        bar.set_message_type(Gtk.MessageType.WARNING)
        lbl = Gtk.Label()
        lbl.set_markup(
            "<b>Memory:</b> the Dictionary web process is using %.0f MB. "
            "You can disable the online tabs to save memory." % rss_mb)
        lbl.set_line_wrap(True)
        bar.get_content_area().add(lbl)
        bar.add_button("Disable online tabs", Gtk.ResponseType.YES)
        bar.add_button("Keep online tabs", Gtk.ResponseType.NO)
        bar.connect("response", self._on_memory_warning)
        self.vbox.pack_start(bar, False, False, 0)
        self.vbox.reorder_child(bar, 1)
        bar.show_all()

    def _on_memory_warning(self, bar, response):
        bar.hide()
        if response == Gtk.ResponseType.YES:
            self._disable_online_tabs()

    def _disable_online_tabs(self):
        self._online_disabled = True
        for attr in ("dict", "thes", "wiki"):
            scrolled = self._scrolled[attr]
            child = scrolled.get_child()
            if child is not None:
                scrolled.remove(child)
            local = LocalView()
            scrolled.add(local.tv)
            local.tv.show()
            setattr(self, attr + "_view", local)

    def add_to_history(self, word):
        if word in self.history:
            self.history.remove(word)
        self.history.insert(0, word)
        self.history = self.history[:HISTORY_LIMIT]
        save_history(self.history)
        self.refresh_history()

    def refresh_history(self):
        for child in self.history_list.get_children():
            self.history_list.remove(child)
        if not self.history:
            row = Gtk.ListBoxRow()
            row.set_selectable(False)
            lbl = Gtk.Label(label="No recent lookups", xalign=0)
            lbl.set_margin_start(12)
            lbl.set_margin_top(6)
            lbl.set_margin_bottom(6)
            lbl.set_sensitive(False)
            row.add(lbl)
            self.history_list.add(row)
        else:
            for word in self.history:
                row = Gtk.ListBoxRow()
                lbl = Gtk.Label(label=word, xalign=0)
                lbl.set_margin_start(12)
                lbl.set_margin_top(6)
                lbl.set_margin_bottom(6)
                row.add(lbl)
                self.history_list.add(row)
        self.history_list.show_all()

    def update_bookmark_button(self):
        is_bookmarked = self.current_word in self.bookmarks
        self.bookmark_btn.set_sensitive(bool(self.current_word))
        self.bookmark_btn.set_active(is_bookmarked)
        self.bookmark_btn.set_tooltip_text(
            "Remove bookmark (Ctrl+B)" if is_bookmarked
            else "Bookmark this word (Ctrl+B)")
        self.speak_btn.set_sensitive(bool(self.current_word))

    def on_bookmark(self, btn):
        if not self.current_word:
            return
        if btn.get_active():
            if self.current_word not in self.bookmarks:
                self.bookmarks.append(self.current_word)
        else:
            if self.current_word in self.bookmarks:
                self.bookmarks.remove(self.current_word)
        save_bookmarks(self.bookmarks)

    def on_speak(self, btn):
        if self.current_word:
            speak(self.current_word)

    def on_history_toggle(self, btn):
        self.history_revealer.set_reveal_child(btn.get_active())

    def on_history_click(self, listbox, row):
        idx = row.get_index()
        if 0 <= idx < len(self.history):
            word = self.history[idx]
            self.search_entry.set_text(word)
            self.on_search(self.search_entry)

    def on_load_failed(self, web_view, load_event, failing_uri, error):
        web_view.load_html(OFFLINE_HTML, "about:blank")
        return True

    def on_key_press(self, widget, event):
        if event.state & Gdk.ModifierType.CONTROL_MASK:
            if event.keyval == Gdk.KEY_l:
                self.search_entry.grab_focus()
                return True
            if event.keyval in (Gdk.KEY_1, Gdk.KEY_2,
                                Gdk.KEY_3, Gdk.KEY_4):
                idx = event.keyval - Gdk.KEY_1
                if idx < len(self.TAB_IDS):
                    self.source_stack.set_visible_child_name(
                        self.TAB_IDS[idx])
                return True
            if event.keyval == Gdk.KEY_b:
                if self.bookmark_btn.get_sensitive():
                    self.bookmark_btn.set_active(
                        not self.bookmark_btn.get_active())
                return True
            if event.keyval == Gdk.KEY_h:
                self.hist_btn.set_active(not self.hist_btn.get_active())
                return True
        if event.keyval == Gdk.KEY_Escape:
            self.search_entry.set_text("")
            return True
        return False


def run(word=""):
    w = DictionaryWindow()
    if word:
        w.search_entry.set_text(word)
        w.on_search(w.search_entry)
    return w


def main():
    word = sys.argv[1] if len(sys.argv) > 1 else ""
    w = run(word)
    w.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
