def ensure_cache():
    os.makedirs(CACHE_DIR, exist_ok=True)


def _load_wordlist(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return []
    if not isinstance(data, list):
        return []
    return [w for w in data if isinstance(w, str)][:HISTORY_LIMIT]


def load_history():
    return _load_wordlist(HISTORY_FILE)


def save_history(history):
    ensure_cache()
    with open(HISTORY_FILE, "w") as f:
        json.dump(history[-HISTORY_LIMIT:], f)


def load_bookmarks():
    return _load_wordlist(BOOKMARKS_FILE)


def save_bookmarks(bookmarks):
    ensure_cache()
    with open(BOOKMARKS_FILE, "w") as f:
        json.dump(bookmarks, f)


def word_of_the_day():
    import datetime
    words = sorted(GLOSSARY)
    day = datetime.date.today().timetuple().tm_yday
    word = words[day % len(words)]
    return word, GLOSSARY[word]


def query_dictd(word):
    if not shutil.which("dict"):
        return None
    try:
        out = subprocess.run(["dict", "-d", "wn", "--", word],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    text = out.stdout.strip()
    if out.returncode == 0 and text and "No definitions found" not in text:
        return text
    return None


_wordlist_cache = None


def word_in_wordlist(word):
    global _wordlist_cache
    w = word.strip().lower()
    if not w or not w.isalpha():
        return False
    if _wordlist_cache is None:
        _wordlist_cache = set()
        for path in WORDLIST_PATHS:
            if not os.path.isfile(path):
                continue
            try:
                with open(path, errors="ignore") as f:
                    for line in f:
                        _wordlist_cache.add(line.strip().lower())
            except OSError:
                continue
    return w in _wordlist_cache


def local_definition(word):
    """Return (source, text) from offline sources, or None."""
    w = word.strip().lower()
    if w in GLOSSARY:
        return ("built-in glossary", GLOSSARY[w])
    dictd = query_dictd(w)
    if dictd:
        return ("WordNet (dictd)", dictd)
    if word_in_wordlist(w):
        return ("system word list",
                "'%s' is a recognized English word. No local definition "
                "is available; see the online tabs." % word.strip())
    return None


def speak(word):
    for binary in ("espeak-ng", "espeak"):
        if shutil.which(binary):
            try:
                subprocess.Popen([binary, "-q", "-v", "en", word],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                return True
            except OSError:
                return False
    return False


def _esc(s):
    return html.escape(str(s), quote=True)


def _strip_tags(fragment):
    return html.unescape(re.sub(r"<[^>]+>", " ", fragment))


