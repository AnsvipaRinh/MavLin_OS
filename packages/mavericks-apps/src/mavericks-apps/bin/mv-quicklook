#!/usr/bin/env python3
"""mv-quicklook — Space-to-preview. Single-shot GTK3 window.
Images: GdkPixbuf. PDF: poppler-glib first page. Text/code: GtkSourceView
(or plain TextView). Audio/video: metadata via ffprobe/GStreamer discoverer
fallback; full playback delegated to default app. Multi-file navigation
with preview selection grid. No indexer, no daemon. License: GPL-2.0-or-later."""
import mimetypes
import os
import subprocess
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, GdkPixbuf, Gdk, GLib, GObject

_POPPLER = None
_POPPLER_TRIED = False
_GTKSOURCE = None
_GTKSOURCE_TRIED = False

IMG_EXT = {".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp", ".tiff", ".tif", ".svg", ".ico", ".heic", ".avif"}
TEXT_EXT = {".txt", ".md", ".c", ".h", ".py", ".rs", ".sh", ".js", ".ts",
            ".json", ".xml", ".css", ".scss", ".log", ".ini", ".conf",
            ".yaml", ".yml", ".toml", ".html", ".htm", ".css", ".less",
            ".sql", ".rb", ".pl", ".php", ".go", ".swift", ".kt", ".scala",
            ".clj", ".hs", ".ml", ".fs", ".vim", ".zsh", ".fish", ".bat",
            ".ps1", ".dockerfile", ".gitignore", ".gitattributes", ".editorconfig"}
MEDIA_EXT = {".mp3", ".ogg", ".wav", ".flac", ".m4a", ".aac", ".opus",
             ".mp4", ".mkv", ".webm", ".avi", ".mov", ".m4v", ".mpg",
             ".mpeg", ".3gp", ".ogv", ".ts", ".mts", ".m2ts"}
DOC_EXT = {".pdf", ".doc", ".docx", ".odt", ".rtf", ".tex", ".epub"}

def _ensure_poppler():
    global _POPPLER, _POPPLER_TRIED
    if _POPPLER_TRIED:
        return _POPPLER
    _POPPLER_TRIED = True
    try:
        gi.require_version("Poppler", "0.18")
        from gi.repository import Poppler as _P
        _POPPLER = _P
    except (ImportError, ValueError):
        _POPPLER = None
    return _POPPLER

def _ensure_gtksource():
    global _GTKSOURCE, _GTKSOURCE_TRIED
    if _GTKSOURCE_TRIED:
        return _GTKSOURCE
    _GTKSOURCE_TRIED = True
    try:
        gi.require_version("GtkSource", "4")
        from gi.repository import GtkSource as _G
        _GTKSOURCE = _G
    except (ImportError, ValueError):
        _GTKSOURCE = None
    return _GTKSOURCE

class PreviewSelectionGrid(Gtk.Window):
    """Grid view for selecting which file to preview from multiple files."""
    def __init__(self, paths, callback):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.paths = [p for p in paths if os.path.isfile(p)]
        self.callback = callback
        self.selected_index = 0

        self.set_title("Quick Look — Select Preview")
        self.set_default_size(800, 600)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(True)
        self.set_skip_taskbar_hint(True)
        self.set_keep_above(True)

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", lambda *_: Gtk.main_quit())

        self.build_ui()
        self.show_all()
        self.grab_focus()

    def build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_border_width(16)
        self.add(vbox)

        # Title
        title = Gtk.Label()
        title.set_markup(f"<b>Quick Look</b> — {len(self.paths)} files selected\nPress <b>Enter</b> or <b>Space</b> to preview, <b>Esc</b> to cancel")
        title.set_xalign(0)
        title.set_line_wrap(True)
        vbox.pack_start(title, False, False, 0)

        # Scrolled grid
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scrolled, True, True, 0)

        flowbox = Gtk.FlowBox()
        flowbox.set_valign(Gtk.Align.START)
        flowbox.set_max_children_per_line(6)
        flowbox.set_min_children_per_line(2)
        flowbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        flowbox.connect("child-activated", self.on_child_activated)
        scrolled.add(flowbox)

        for i, path in enumerate(self.paths):
            child = self.create_grid_item(path, i)
            flowbox.add(child)

        # Select first item by default
        children = flowbox.get_children()
        if children:
            flowbox.select_child(children[0])
            self.selected_index = 0

        # Bottom hint
        hint = Gtk.Label()
        hint.set_markup("<small>↑/↓/←/→ navigate · Enter/Space preview · Esc cancel</small>")
        hint.set_xalign(0)
        hint.get_style_context().add_class("dim-label")
        vbox.pack_start(hint, False, False, 8)

    def create_grid_item(self, path, index):
        ext = os.path.splitext(path)[1].lower()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_size_request(120, 120)
        box.get_style_context().add_class("preview-grid-item")

        # Thumbnail/preview
        try:
            if ext in IMG_EXT:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 100, 100, True)
                img = Gtk.Image.new_from_pixbuf(pix)
            elif ext == ".pdf" and _ensure_poppler() is not None:
                doc = _POPPLER.Document.new_from_file(GLib.filename_to_uri(path, None), None)
                page = doc.get_page(0)
                w, h = page.get_size()
                scale = min(100 / w, 100 / h, 2.0)
                pix = page.render_to_pixbuf(int(w * scale), int(h * scale))
                img = Gtk.Image.new_from_pixbuf(pix)
            elif ext in MEDIA_EXT:
                img = Gtk.Image.new_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
            elif ext in TEXT_EXT or ext in DOC_EXT:
                img = Gtk.Image.new_from_icon_name("text-x-generic", Gtk.IconSize.DIALOG)
            else:
                img = Gtk.Image.new_from_icon_name("text-x-generic", Gtk.IconSize.DIALOG)
        except Exception:
            img = Gtk.Image.new_from_icon_name("text-x-generic", Gtk.IconSize.DIALOG)

        img.set_valign(Gtk.Align.CENTER)
        img.set_halign(Gtk.Align.CENTER)
        box.pack_start(img, True, True, 0)

        # Filename
        name = os.path.basename(path)
        if len(name) > 18:
            name = name[:15] + "…"
        lbl = Gtk.Label(label=name)
        lbl.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        lbl.set_xalign(0.5)
        lbl.get_style_context().add_class("dim-label")
        box.pack_start(lbl, False, False, 0)

        box.path = path
        box.index = index
        return box

    def on_child_activated(self, flowbox, child):
        self.callback(child.path, child.index)
        self.destroy()
        return True

    def on_key_press(self, _widget, event):
        key = Gdk.keyval_name(event.keyval)
        if key in ("Escape",):
            self.destroy()
            return True
        if key in ("Return", "KP_Enter", "space"):
            children = self.get_children()[0].get_children()[1].get_children()[0].get_children()
            # Navigate to find selected child
            flowbox = self.get_children()[0].get_children()[1].get_children()[0]
            selected = flowbox.get_selected_children()
            if selected:
                child = selected[0]
                self.callback(child.path, child.index)
                self.destroy()
            return True
        return False


class PreviewWindow(Gtk.Window):
    """Main preview window with full Mavericks-like behavior."""
    def __init__(self, paths, start_index=0, show_selection_grid=False):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.paths = [p for p in paths if os.path.isfile(p)]
        if not self.paths:
            self.paths = [paths[0]] if paths else []
        self.index = max(0, min(start_index, len(self.paths) - 1))
        self.fullscreen = False
        self.prev_size = (800, 600)
        self.show_selection_grid = show_selection_grid and len(self.paths) > 1

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", Gtk.main_quit)
        self.connect("focus-out-event", self.on_focus_out)

        if self.show_selection_grid:
            self.show_selection_grid_callback()
        else:
            self.update_ui()

    def show_selection_grid_callback(self):
        self.hide()
        grid = PreviewSelectionGrid(self.paths, self.on_grid_selection)
        Gtk.main()

    def on_grid_selection(self, path, index):
        self.index = index
        self.show_selection_grid = False
        self.update_ui()
        self.show_all()
        self.present()

    def update_ui(self):
        for child in self.get_children():
            self.remove(child)

        path = self.paths[self.index]
        ext = os.path.splitext(path)[1].lower()
        title = os.path.basename(path)
        if len(self.paths) > 1:
            title += "  (%d of %d)" % (self.index + 1, len(self.paths))

        self.set_decorated(True)
        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        hb.get_style_context().add_class("mavericks-quicklook-toolbar")
        title_label = Gtk.Label(label=title)
        title_label.get_style_context().add_class("mavericks-quicklook-title")
        hb.pack_start(title_label, True, True, 0)

        # Open button
        open_b = Gtk.Button(label="Open")
        open_b.get_style_context().add_class("suggested-action")
        open_b.connect("clicked", self.open_full, path)
        hb.pack_end(open_b)

        # Navigation buttons (if multi-file)
        if len(self.paths) > 1:
            prev_b = Gtk.Button.new_from_icon_name("go-previous", Gtk.IconSize.BUTTON)
            prev_b.set_tooltip_text("Previous (← / P / Up)")
            prev_b.connect("clicked", lambda *_: self.navigate(-1))
            hb.pack_start(prev_b)

            # Grid button
            grid_b = Gtk.Button.new_from_icon_name("view-grid", Gtk.IconSize.BUTTON)
            grid_b.set_tooltip_text("Preview Selection (G)")
            grid_b.connect("clicked", lambda *_: self.show_grid())
            hb.pack_start(grid_b)

            next_b = Gtk.Button.new_from_icon_name("go-next", Gtk.IconSize.BUTTON)
            next_b.set_tooltip_text("Next (→ / N / Down / Space)")
            next_b.connect("clicked", lambda *_: self.navigate(1))
            hb.pack_start(next_b)

        # Fullscreen button
        fs_b = Gtk.Button.new_from_icon_name("view-fullscreen", Gtk.IconSize.BUTTON)
        fs_b.set_tooltip_text("Fullscreen (F)")
        fs_b.connect("clicked", lambda *_: self.toggle_fullscreen())
        hb.pack_end(fs_b)

        # Build content widget
        widget = self.build_content(path, ext)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)

        if isinstance(widget, Gtk.Image):
            vp = Gtk.Viewport()
            vp.add(widget)
            sw.add(vp)
        elif isinstance(widget, (Gtk.TextView, Gtk.TreeView, Gtk.Box, Gtk.Viewport)):
            sw.add(widget)
        else:
            sw.add(widget)

        self.add(sw)
        self.show_all()

        if not self.fullscreen:
            self.set_default_size(800, 600)
        else:
            self.fullscreen()

    def build_content(self, path, ext):
        # PDF
        if ext == ".pdf" and _ensure_poppler() is not None:
            return self.build_pdf_preview(path)

        # Images
        if ext in IMG_EXT:
            return self.build_image_preview(path)

        # Text files
        if ext in TEXT_EXT or (mimetypes.guess_type(path)[0] or "").startswith("text/"):
            return self.build_text_preview(path)

        # Media files
        if ext in MEDIA_EXT:
            return self.build_media_preview(path)

        # Office documents (via libreoffice thumbnailer if available)
        if ext in DOC_EXT and ext != ".pdf":
            return self.build_office_preview(path)

        return Gtk.Label(label="No preview available for this file.\nPress Open.")

    def build_pdf_preview(self, path):
        try:
            doc = _POPPLER.Document.new_from_file(GLib.filename_to_uri(path, None), None)
            page = doc.get_page(0)
            w, h = page.get_size()
            scale = min(780 / w, 580 / h, 2.0)
            pix = page.render_to_pixbuf(int(w * scale), int(h * scale))
            return Gtk.Image.new_from_pixbuf(pix)
        except Exception as e:
            return Gtk.Label(label="Cannot render PDF: %s" % e)

    def build_image_preview(self, path):
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 780, 580, True)
            return Gtk.Image.new_from_pixbuf(pix)
        except Exception as e:
            return Gtk.Label(label="Cannot load image: %s" % e)

    def build_text_preview(self, path):
        try:
            with open(path, errors="replace") as f:
                text = f.read(500000)  # Increased limit
        except OSError as e:
            return Gtk.Label(label=str(e))

        if _ensure_gtksource() is not None:
            buf = _GTKSOURCE.Buffer()
            tv = _GTKSOURCE.View(buffer=buf)
            # Try to set language for syntax highlighting
            lang_manager = _GTKSOURCE.LanguageManager.get_default()
            ext = os.path.splitext(path)[1].lower()
            lang = lang_manager.guess_language(path, None)
            if lang:
                buf.set_language(lang)
        else:
            buf = Gtk.TextBuffer()
            tv = Gtk.TextView(buffer=buf)

        buf.set_text(text)
        tv.set_editable(False)
        tv.set_monospace(True)
        tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        tv.set_left_margin(12)
        tv.set_right_margin(12)
        tv.set_top_margin(8)
        tv.set_bottom_margin(8)
        return tv

    def build_media_preview(self, path):
        info = self.probe_media(path)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(24)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)

        # Icon
        icon = Gtk.Image.new_from_icon_name("video-x-generic" if any(path.endswith(e) for e in [".mp4", ".mkv", ".webm", ".avi", ".mov", ".m4v", ".mpg", ".mpeg", ".3gp", ".ogv", ".ts", ".mts", ".m2ts"]) else "audio-x-generic", Gtk.IconSize.DIALOG)
        icon.set_pixel_size(64)
        box.pack_start(icon, False, False, 0)

        # Title
        title = Gtk.Label()
        title.set_markup(f"<b><big>{GLib.markup_escape_text(os.path.basename(path))}</big></b>")
        title.set_xalign(0.5)
        title.set_line_wrap(True)
        box.pack_start(title, False, False, 0)

        # Metadata grid
        grid = Gtk.Grid()
        grid.set_column_spacing(16)
        grid.set_row_spacing(8)
        grid.set_halign(Gtk.Align.CENTER)

        row = 0
        for label, value in info.items():
            lbl = Gtk.Label(label=label + ":")
            lbl.set_xalign(1)
            lbl.get_style_context().add_class("dim-label")
            grid.attach(lbl, 0, row, 1, 1)

            val_lbl = Gtk.Label(label=value)
            val_lbl.set_xalign(0)
            val_lbl.set_selectable(True)
            grid.attach(val_lbl, 1, row, 1, 1)
            row += 1

        box.pack_start(grid, False, False, 0)

        # Hint
        hint = Gtk.Label(label="Press Open for full playback.")
        hint.get_style_context().add_class("dim-label")
        hint.set_xalign(0.5)
        box.pack_start(hint, False, False, 8)

        vp = Gtk.Viewport()
        vp.add(box)
        return vp

    def build_office_preview(self, path):
        """Attempt to preview office documents via libreoffice or unoconv."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_border_width(24)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)

        icon = Gtk.Image.new_from_icon_name("application-vnd.oasis.opendocument.text" if path.endswith(".odt") else
                                            "application-msword" if path.endswith(".doc") else
                                            "application-vnd.openxmlformats-officedocument.wordprocessingml.document" if path.endswith(".docx") else
                                            "application-rtf" if path.endswith(".rtf") else
                                            "application-x-tex" if path.endswith(".tex") else
                                            "application-epub+zip", Gtk.IconSize.DIALOG)
        icon.set_pixel_size(64)
        box.pack_start(icon, False, False, 0)

        title = Gtk.Label()
        title.set_markup(f"<b><big>{GLib.markup_escape_text(os.path.basename(path))}</big></b>")
        title.set_xalign(0.5)
        title.set_line_wrap(True)
        box.pack_start(title, False, False, 0)

        # Try to get basic info
        try:
            stat = os.stat(path)
            info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            info_box.set_halign(Gtk.Align.CENTER)
            size_lbl = Gtk.Label(label="Size: %s" % self.format_size(stat.st_size))
            size_lbl.get_style_context().add_class("dim-label")
            mtime_lbl = Gtk.Label(label="Modified: %s" % GLib.DateTime.new_from_unix_local(stat.st_mtime).format("%c"))
            mtime_lbl.get_style_context().add_class("dim-label")
            info_box.pack_start(size_lbl, False, False, 0)
            info_box.pack_start(mtime_lbl, False, False, 0)
            box.pack_start(info_box, False, False, 0)
        except Exception:
            pass

        hint = Gtk.Label(label="Press Open to view in default application.")
        hint.get_style_context().add_class("dim-label")
        hint.set_xalign(0.5)
        box.pack_start(hint, False, False, 8)

        vp = Gtk.Viewport()
        vp.add(box)
        return vp

    def probe_media(self, path):
        """Return dict of media metadata for display."""
        info = {}
        try:
            out = subprocess.run(
                ["ffprobe", "-v", "quiet", "-show_format", "-show_streams", "-of", "json", path],
                capture_output=True, text=True, timeout=10
            )
            if out.returncode != 0:
                info["Error"] = "ffprobe failed"
                return info

            import json
            data = json.loads(out.stdout)
            fmt = data.get("format", {})
            streams = data.get("streams", [])

            # Format info
            duration = fmt.get("duration")
            if duration:
                info["Duration"] = self.format_duration(float(duration))
            bitrate = fmt.get("bit_rate")
            if bitrate:
                info["Bitrate"] = f"{int(bitrate) // 1000} kbps"
            size = fmt.get("size")
            if size:
                info["Size"] = self.format_size(int(size))
            fmt_name = fmt.get("format_name")
            if fmt_name:
                info["Container"] = fmt_name

            # Stream info
            for i, stream in enumerate(streams):
                ctype = stream.get("codec_type")
                codec = stream.get("codec_name", "unknown")
                if ctype == "video":
                    w = stream.get("width")
                    h = stream.get("height")
                    fps = stream.get("avg_frame_rate", "").split("/")
                    fps_val = ""
                    if len(fps) == 2 and int(fps[1]) != 0:
                        fps_val = f" @ {float(fps[0]) / float(fps[1]):.3g} fps"
                    info[f"Video #{i+1}"] = f"{w}x{h} ({codec}){fps_val}"
                elif ctype == "audio":
                    rate = stream.get("sample_rate")
                    ch = stream.get("channels")
                    lang = stream.get("tags", {}).get("language", "")
                    lang_str = f" ({lang})" if lang else ""
                    info[f"Audio #{i+1}"] = f"{codec}, {rate} Hz, {ch} ch{lang_str}"
                elif ctype == "subtitle":
                    lang = stream.get("tags", {}).get("language", "")
                    info[f"Subtitle #{i+1}"] = f"{codec} ({lang})" if lang else codec

            if not info:
                info["Note"] = "No metadata available"

        except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError) as e:
            info["Error"] = f"Failed to read metadata: {e}"

        return info

    def format_duration(self, seconds):
        """Format duration as HH:MM:SS or MM:SS."""
        hours = int(seconds // 3600)
        minutes = int((seconds % 3600) // 60)
        secs = int(seconds % 60)
        if hours > 0:
            return f"{hours}:{minutes:02d}:{secs:02d}"
        return f"{minutes}:{secs:02d}"

    def format_size(self, size):
        """Format file size human-readable."""
        for unit in ["B", "KB", "MB", "GB", "TB"]:
            if size < 1024:
                return f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} PB"

    def navigate(self, delta):
        if len(self.paths) <= 1:
            return
        self.index = (self.index + delta) % len(self.paths)
        self.update_ui()

    def show_grid(self):
        self.show_selection_grid = True
        self.show_selection_grid_callback()

    def toggle_fullscreen(self):
        self.fullscreen = not self.fullscreen
        if self.fullscreen:
            self.prev_size = self.get_size()
            self.fullscreen()
        else:
            self.unfullscreen()
            self.resize(*self.prev_size)

    def on_key_press(self, _widget, event):
        key = Gdk.keyval_name(event.keyval)
        state = event.get_state() & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK)

        # Close keys
        if key in ("Escape", "q", "Q"):
            self.destroy()
            return True

        # Open in default app
        if key in ("Return", "KP_Enter", "o", "O"):
            self.open_full(None, self.paths[self.index])
            return True

        # Navigation
        if key in ("Left", "KP_Left", "p", "P", "Up", "KP_Up"):
            self.navigate(-1)
            return True
        if key in ("Right", "KP_Right", "n", "N", "Down", "KP_Down", "space"):
            self.navigate(1)
            return True

        # Grid view
        if key in ("g", "G"):
            self.show_grid()
            return True

        # Fullscreen
        if key in ("f", "F", "F11"):
            self.toggle_fullscreen()
            return True

        # Home/End
        if key in ("Home",):
            self.index = 0
            self.update_ui()
            return True
        if key in ("End",):
            self.index = len(self.paths) - 1
            self.update_ui()
            return True

        # Page up/down (jump 10)
        if key in ("Page_Up",):
            self.navigate(-10)
            return True
        if key in ("Page_Down",):
            self.navigate(10)
            return True

        return False

    def on_focus_out(self, _widget, event):
        # Auto-close on focus loss after a brief delay (Mavericks behavior)
        # Only if not in fullscreen and not modal
        if not self.fullscreen:
            GLib.timeout_add(500, self._maybe_close_on_focus_loss)
        return False

    def _maybe_close_on_focus_loss(self):
        # Check if we still have focus or if another window took it
        if not self.has_toplevel_focus():
            self.destroy()
        return False

    def open_full(self, _b, path):
        subprocess.Popen(["xdg-open", path])
        self.destroy()


def main():
    if len(sys.argv) < 2:
        print("usage: mv-quicklook <file> [file...]", file=sys.stderr)
        sys.exit(2)

    files = sys.argv[1:]
    if len(files) == 1 and os.path.isdir(files[0]):
        try:
            files = sorted(os.path.join(files[0], f) for f in os.listdir(files[0])
                           if os.path.isfile(os.path.join(files[0], f)))
        except OSError:
            pass

    if not files:
        print("No valid files to preview", file=sys.stderr)
        sys.exit(1)

    # Show selection grid if multiple files passed (Mavericks-like behavior)
    show_grid = len(files) > 1

    w = PreviewWindow(files, start_index=0, show_selection_grid=show_grid)
    Gtk.main()


if __name__ == "__main__":
    main()