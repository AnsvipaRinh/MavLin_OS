#!/usr/bin/env python3
"""mv-notify-send — notify-send wrapper that logs notifications to history.

Logs to ~/.local/share/mavericks/notifications.json (max 500 entries).
No daemon; on-demand logging. License: GPL-2.0-or-later.
"""
import fcntl, json, os, subprocess, time, uuid

STORE_DIR = os.path.expanduser("~/.local/share/mavericks")
STORE_FILE = os.path.join(STORE_DIR, "notifications.json")
LOCK_FILE = os.path.join(STORE_DIR, "notifications.lock")
MAX_ENTRIES = 500

def load():
    try:
        with open(STORE_FILE) as f:
            data = json.load(f)
            if isinstance(data, list):
                return data
    except (OSError, ValueError):
        pass
    return []

def save(data):
    os.makedirs(STORE_DIR, exist_ok=True)
    with open(LOCK_FILE, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        tmp = STORE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data[-MAX_ENTRIES:], f, ensure_ascii=False)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, STORE_FILE)
    os.chmod(STORE_FILE, 0o600)

def log_notification(app_name, summary, body, icon, urgency, category, hints):
    os.makedirs(STORE_DIR, exist_ok=True)
    with open(LOCK_FILE, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load()
        entry = {
            "id": uuid.uuid4().hex[:12],
            "timestamp": int(time.time()),
            "app_name": app_name,
            "summary": summary,
            "body": body,
            "icon": icon,
            "urgency": urgency,
            "category": category,
            "hints": hints,
        }
        data.append(entry)
        tmp = STORE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data[-MAX_ENTRIES:], f, ensure_ascii=False)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, STORE_FILE)
    os.chmod(STORE_FILE, 0o600)

def main():
    # Parse notify-send arguments
    import argparse
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-a", "--app-name", default="")
    parser.add_argument("-i", "--icon", default="")
    parser.add_argument("-u", "--urgency", default="normal", choices=["low", "normal", "critical"])
    parser.add_argument("-c", "--category", default="")
    parser.add_argument("-h", "--hint", action="append", default=[])
    parser.add_argument("-t", "--expire-time", default="")
    parser.add_argument("summary", nargs="?")
    parser.add_argument("body", nargs="?")
    args, unknown = parser.parse_known_args()

    # Build hints dict
    hints = {}
    for h in args.hint:
        if ":" in h:
            k, v = h.split(":", 1)
            hints[k] = v

    # Log the notification
    log_notification(args.app_name, args.summary or "", args.body or "",
                     args.icon, args.urgency, args.category, hints)

    # Forward to actual notify-send
    cmd = ["notify-send"]
    if args.app_name:
        cmd += ["-a", args.app_name]
    if args.icon:
        cmd += ["-i", args.icon]
    if args.urgency:
        cmd += ["-u", args.urgency]
    if args.category:
        cmd += ["-c", args.category]
    for h in args.hint:
        cmd += ["-h", h]
    if args.expire_time:
        cmd += ["-t", args.expire_time]
    if args.summary:
        cmd.append(args.summary)
    if args.body:
        cmd.append(args.body)
    cmd += unknown

    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

if __name__ == "__main__":
    main()