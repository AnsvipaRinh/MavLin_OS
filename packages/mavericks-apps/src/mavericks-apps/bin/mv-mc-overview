#!/usr/bin/env python3
"""Native GTK3 Mission Control overview for MavLinOS.

Read-only window discovery and thumbnail capture are delegated to the shared
Mission Control libraries. The overlay never redirects or reparents windows.
"""
import os
import sys

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Pango
except ImportError:
    raise SystemExit("GTK3/PyGObject is required")

LIBDIR = "/usr/share/mavericks-apps"
if LIBDIR not in sys.path:
    sys.path.insert(0, LIBDIR)

import mission_control
import mission_control_thumbnail


CSS = """
window.mav-mc {
  background-color: rgba(18, 20, 24, 0.94);
}
.mav-header {
  color: #f2f2f2;
  font-size: 20px;
  font-weight: 600;
}
.mav-workspace {
  color: #d8d8d8;
  font-size: 14px;
  font-weight: 600;
}
.mav-card {
  background-color: rgba(45, 47, 52, 0.96);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  padding: 6px;
}
.mav-card.mav-selected { background-color: rgba(72, 104, 145, 0.98); border-color: rgba(255,255,255,0.78); box-shadow: 0 0 0 2px rgba(255,255,255,0.22); }\n.mav-card:hover {
  background-color: rgba(70, 72, 78, 0.98);
  border-color: rgba(255,255,255,0.38);
}
.mav-title {
  color: #eeeeee;
  font-size: 12px;
}
.mav-workspace-button { background-color: rgba(45,47,52,0.88); color:#d8d8d8; border:1px solid rgba(255,255,255,0.10); border-radius:6px; padding:5px 12px; }\n.mav-workspace-button:checked { background-color:rgba(80,96,118,0.98); color:#fff; border-color:rgba(255,255,255,0.45); }\n.mav-hint { color:#8f9399; font-size:11px; }\n.mav-muted {
  color: #9b9b9b;
  font-size: 11px;
}
"""

def _safe_title(window):
    title = (window.get("title") or "").strip()
    return title if title else window.get("wm_class", "Window")


class Overview(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("mav-mc")
        self.set_title("Mission Control")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_app_paintable(True)
        self.fullscreen()

        self.connect("key-press-event", self._on_key)
        self.connect("button-press-event", self._on_background_click)

        screen = self.get_screen()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.box.set_margin_start(28)
        self.box.set_margin_end(28)
        self.box.set_margin_top(22)
        self.box.set_margin_bottom(22)
        self.add(self.box)

        self._build()

    def _build(self):
        windows = mission_control.enumerate_windows()
        workspaces = mission_control.get_workspaces()
        active = mission_control.get_active_window() or {}
        active_id = str(active.get("win_id", "")).lower()

        header_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)\n        self.box.pack_start(header_row, False, False, 0)\n        header = Gtk.Label(label="Mission Control")
        header.set_xalign(0)
        header.get_style_context().add_class("mav-header")
        header_row.pack_start(header, False, False, 0)\n        workspace_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)\n        header_row.pack_end(workspace_bar, False, False, 0)\n        count = max(1, int(workspaces.get("count", 1)))\n        current = int(workspaces.get("current", 0))\n        names = workspaces.get("names", [])\n        for desktop in range(count):\n            label = names[desktop] if desktop < len(names) else f"Desktop {desktop + 1}"\n            button = Gtk.ToggleButton(label=label)\n            button.set_can_focus(True)\n            button.get_style_context().add_class("mav-workspace-button")\n            button.set_active(desktop == current)\n            button.connect("clicked", self._switch_workspace, desktop)\n            workspace_bar.pack_start(button, False, False, 0)\n            self._workspace_buttons.append(button)\n        hint = Gtk.Label(label="← ↑ ↓ → / Tab: select   Enter: open   Esc: close")\n        hint.set_xalign(0)\n        hint.get_style_context().add_class("mav-hint")\n        self.box.pack_start(hint, False, False, 0)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.box.pack_start(scrolled, True, True, 0)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content.set_margin_bottom(20)
        scrolled.add(content)

        count = max(1, int(workspaces.get("count", 1)))
        current = int(workspaces.get("current", 0))
        names = workspaces.get("names", [])

        by_desktop = {i: [] for i in range(count)}
        for win in windows:
            desktop = int(win.get("desktop", -1))
            if desktop < 0:
                # Sticky/all-desktop windows belong to the current desktop for
                # presentation purposes, but retain their real desktop=-1.
                desktop = current
            if desktop >= count:
                continue
            by_desktop[desktop].append(win)

        order = [current] + [i for i in range(count) if i != current]
        for desktop in order:
            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
            label = names[desktop] if desktop < len(names) else f"Desktop {desktop + 1}"
            ws_label = Gtk.Label(label=label + ("  • current" if desktop == current else ""))
            ws_label.set_xalign(0)
            ws_label.get_style_context().add_class("mav-workspace")
            section.pack_start(ws_label, False, False, 0)

            grid = Gtk.Grid()
            grid.set_column_spacing(12)
            grid.set_row_spacing(12)
            section.pack_start(grid, False, False, 0)

            items = by_desktop[desktop]
            if not items:
                empty = Gtk.Label(label="No windows")
                empty.set_xalign(0)
                empty.get_style_context().add_class("mav-muted")
                grid.attach(empty, 0, 0, 1, 1)
            else:
                cols = 1 if len(items) <= 2 else (2 if len(items) <= 6 else 3)
                for index, win in enumerate(items):
                    card = self._make_card(win, win.get("win_id", "").lower() == active_id)
                    grid.attach(card, index % cols, index // cols, 1, 1)\n                    self._cards.append((card, win.get("win_id")))

            content.pack_start(section, False, False, 0)

        self.show_all()

    def _make_card(self, win, is_active):
        event = Gtk.EventBox()
        event.set_visible_window(True)\n        event.set_can_focus(True)
        event.get_style_context().add_class("mav-card")
        event.set_tooltip_text(_safe_title(win))
        event.connect("button-release-event", self._activate, win.get("win_id"))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        box.set_size_request(250, 150)

        pixbuf = None
        try:
            wid = int(str(win.get("win_id")), 0)
            pixbuf = mission_control_thumbnail.capture_window(wid, (238, 112))
        except Exception:
            pixbuf = None

        if pixbuf is not None:
            image = Gtk.Image.new_from_pixbuf(pixbuf)
            image.set_size_request(238, 112)
        else:
            image = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
            image.set_size_request(238, 112)

        box.pack_start(image, True, True, 0)

        title = Gtk.Label(label=("• " if is_active else "") + _safe_title(win))
        title.set_xalign(0)
        title.set_ellipsize(Pango.EllipsizeMode.END)
        title.get_style_context().add_class("mav-title")
        box.pack_start(title, False, False, 0)

        meta = Gtk.Label(label=win.get("wm_class", ""))
        meta.set_xalign(0)
        meta.get_style_context().add_class("mav-muted")
        box.pack_start(meta, False, False, 0)

        event.add(box)
        return event

    def _activate(self, _widget, event, win_id):
        if event.button != 1 or not win_id:
            return False
        if mission_control.activate_window(win_id):
            self.destroy()
        return True

    def _on_background_click(self, _widget, event):
        if event.window is self.get_window() and event.button == 1:
            self.destroy()
        return False

    def _on_key(self, _widget, event):
        key = Gdk.keyval_name(event.keyval)
        if key in ("Escape", "q"):
            self.destroy()
            return True
        if key in ("Return", "KP_Enter"):
            return self._activate_selected()
        if key in ("Right", "Down", "Tab"):
            if self._cards:
                self._select_card(self._selected_index + 1)
                return True
        if key in ("Left", "Up"):
            if self._cards:
                self._select_card(self._selected_index - 1)
                return True
        if key and key.isdigit():
            desktop = int(key) - 1
            if 0 <= desktop < len(self._workspace_buttons):
                self._workspace_buttons[desktop].set_active(True)
                return True
        return False

def main():
    overview = Overview()
    overview.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
