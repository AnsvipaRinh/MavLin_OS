#!/usr/bin/env python3
"""Mission Control Overview UI - Mavericks-style window overview.

This is the main entry point for Mission Control in MavLinOS.
It integrates:
- Window listing by workspace (mv-mc-window-spaces)
- Thumbnail generation (mv-mc-thumbnail)
- Grid layout calculation (mv-mc-grid)
- Window activation (mv-mc-activate-window)

Usage: mv-mc-overview [--debug]
"""
import sys
import os
import subprocess
import json
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))


def run_helper(helper_name, args=None):
    """Run a Mission Control helper script."""
    helper_path = os.path.join(SCRIPT_DIR, helper_name)
    cmd = ["python3", helper_path]
    if args:
        cmd.extend(args)
    
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return result.stdout
    except subprocess.CalledProcessError as e:
        print(f"Error running {helper_name}: {e.stderr}", file=sys.stderr)
        return None
    except FileNotFoundError:
        print(f"Error: {helper_name} not found", file=sys.stderr)
        return None


def get_windows_by_space():
    """Get windows grouped by workspace."""
    output = run_helper("mv-mc-window-spaces")
    if not output:
        return None
    
    try:
        return json.loads(output)
    except json.JSONDecodeError:
        print("Error: Invalid JSON from mv-mc-window-spaces", file=sys.stderr)
        return None


def generate_thumbnail(wid, width=200):
    """Generate thumbnail for a window."""
    output = run_helper("mv-mc-thumbnail", [str(wid), str(width)])
    return output  # Binary PNG data


def calculate_grid(window_count, screen_width=1920, screen_height=1080, margin=50):
    """Calculate grid layout for windows."""
    output = run_helper("mv-mc-grid", [str(window_count), str(screen_width), str(screen_height), str(margin)])
    if not output:
        return None
    
    try:
        return json.loads(output)
    except json.JSONDecodeError:
        print("Error: Invalid JSON from mv-mc-grid", file=sys.stderr)
        return None


def activate_window(wid):
    """Activate/focus a window."""
    run_helper("mv-mc-activate-window", [str(wid)])


def main():
    parser = argparse.ArgumentParser(description="Mission Control Overview")
    parser.add_argument("--debug", action="store_true", help="Enable debug output")
    parser.add_argument("--list", action="store_true", help="List windows only (no UI)")
    parser.add_argument("--activate", type=int, help="Activate window by ID")
    args = parser.parse_args()
    
    if args.activate:
        activate_window(args.activate)
        return
    
    # Get windows by workspace
    data = get_windows_by_space()
    if not data:
        sys.exit(1)
    
    if args.debug:
        print("Workspaces:", json.dumps(data, indent=2))
    
    if args.list:
        # Simple list mode for testing
        for ws in data.get("workspaces", []):
            print(f"\n{ws['name']}:")
            for win in ws.get("windows", []):
                print(f"  - [{win['wid']}] {win['title']} ({win['app']})")
        return
    
    # Calculate grid for all windows
    total_windows = sum(len(ws.get("windows", [])) for ws in data.get("workspaces", []))
    grid = calculate_grid(total_windows)
    
    if args.debug:
        print("\nGrid layout:", json.dumps(grid, indent=2))
    
    # In a full UI implementation, this would:
    # 1. Create a fullscreen overlay window
    # 2. Generate thumbnails for each window
    # 3. Position them according to grid
    # 4. Handle mouse/keyboard interaction
    # 5. Activate selected window on click/enter
    
    print("Mission Control Overview ready")
    print(f"Total windows: {total_windows}")
    print(f"Grid: {grid['rows']} rows x {grid['cols']} cols")
    
    # For now, just list windows (placeholder for full UI)
    print("\nWindows:")
    for ws in data.get("workspaces", []):
        for win in ws.get("windows", []):
            print(f"  [{win['wid']}] {ws['name']}: {win['title']} ({win['app']})")


if __name__ == "__main__":
    main()
