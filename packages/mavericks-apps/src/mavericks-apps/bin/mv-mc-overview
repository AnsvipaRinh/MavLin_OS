#!/usr/bin/env python3
"""Native GTK3 Mission Control overview for MavLinOS.

Read-only window discovery and thumbnail capture are delegated to the shared
Mission Control libraries. The overlay never redirects or reparents windows.
"""
import os
import sys
import json
import time
import argparse
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

LIBDIR = "/usr/share/mavericks-apps"
for _p in (LIBDIR, os.path.join(SCRIPT_DIR, "..", "lib")):
    if os.path.isdir(_p) and _p not in sys.path:
        sys.path.insert(0, _p)

import mission_control
import mission_control_thumbnail
import mission_control_previews
import mission_control_anim
import mission_control_live

# GTK is only required for the default UI mode; --list/--debug/--activate
# stay usable on headless systems.
try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Pango
    _GTK_OK = True
except (ImportError, ValueError):
    _GTK_OK = False


if _GTK_OK:
    CSS = """
    window.mav-mc {
      background-color: #3b3c3f;
    }
    .mav-header {
      color: #f2f2f2;
      font-size: 20px;
      font-weight: 600;
    }
    .mav-workspace {
      color: #d8d8d8;
      font-size: 14px;
      font-weight: 600;
    }
    .mav-card {
      background-color: transparent;
      border: 4px solid transparent;
      border-radius: 6px;
      padding: 0;
    }
    .mav-card.mav-selected {
      background-color: transparent;
      border-color: rgba(83,110,191,1);
      box-shadow: none;
    }
    .mav-card:hover {
      background-color: transparent;
      border-color: rgba(83,110,191,0.72);
    }
    .mav-app-group { background-color: transparent; }
    .mav-app-heading { color:#ffffff; font-size:14px; font-weight:600; text-shadow:0 1px 2px #000; }
    .mav-app-icon { min-width:20px; min-height:20px; }
    .mav-title {
      color: #ffffff;
      font-size: 18px;
      font-weight: 500;
      text-shadow: 0 1px 3px #000;
      padding: 0;
    }
    .mav-workspace-button { background-color: rgba(30,31,33,0.35); color:#d8d8d8; border:1px solid transparent; border-radius:2px; padding:4px; min-width:136px; }
    .mav-workspace-button:checked { background-color:rgba(45,46,49,0.65); color:#fff; border-color:rgba(255,255,255,0.72); }
    .mav-workspace-button:hover { border-color:rgba(255,255,255,0.35); }
    .mav-workspace-button:checked:hover { border-color:rgba(255,255,255,0.85); }
    .mav-workspace-add { background-color:rgba(30,31,33,0.35); color:#e4e4e4; border:1px solid transparent; border-radius:2px; min-width:34px; min-height:34px; font-size:18px; }
    .mav-workspace-add:hover { border-color:rgba(255,255,255,0.35); }
    .mav-workspace-button:hover .mav-workspace-close { opacity:1; }
    .mav-workspace-close { opacity:0; min-width:18px; min-height:18px; padding:0; border:0; background:transparent; color:#ddd; font-size:12px; }
    .mav-workspace-button.mav-drop-target { background-color:rgba(100,125,160,0.98); border-color:rgba(255,255,255,0.95); box-shadow:0 0 0 2px rgba(255,255,255,0.32); }
    .mav-workspace-preview { min-height:80px; }
    .mav-workspace-label { color:#e4e4e4; font-size:11px; font-weight:600; }
    .mav-workspace-count { color:#9b9b9b; font-size:10px; }
    .mav-hint { color:#8f9399; font-size:11px; }
    .mav-muted {
      color: #9b9b9b;
      font-size: 11px;
    }
    """

    def _safe_title(window):
        title = (window.get("title") or "").strip()
        return title if title else window.get("wm_class", "Window")


    def _preview_priority(window, active_id):
        """Rank workspace preview candidates by Mission Control relevance."""
        win_id = str(window.get("win_id", "")).lower()
        state = window.get("state") or []
        hidden = "_NET_WM_STATE_HIDDEN" in state
        mapped = bool(window.get("mapped", False))
        active = win_id == active_id
        geo = window.get("geometry") or {}
        try:
            area = int(geo.get("width", 0)) * int(geo.get("height", 0))
        except (TypeError, ValueError):
            area = 0
        # Largest, currently viewable windows define a Space's miniature;
        # the active window is always kept. Preview compositing caps the
        # window count (§7), so ordering decides what survives the cap.
        return (0 if active else 1, 0 if mapped and not hidden else 1, -area)


    class Overview(Gtk.Window):
        def __init__(self):
            super().__init__(type=Gtk.WindowType.TOPLEVEL)
            self.set_name("mav-mc")
            self.set_title("Mission Control")
            self.set_decorated(False)
            self.set_keep_above(True)
            self.set_skip_taskbar_hint(True)
            self.set_skip_pager_hint(True)
            self.set_app_paintable(True)
            self.fullscreen()

            self.connect("key-press-event", self._on_key)
            self.connect("button-press-event", self._on_background_click)
            self.connect("destroy", self._on_destroy)

            screen = self.get_screen()
            provider = Gtk.CssProvider()
            provider.load_from_data(CSS.encode())
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

            self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            self.box.set_margin_start(28)
            self.box.set_margin_end(28)
            self.box.set_margin_top(22)
            self.box.set_margin_bottom(22)
            self.add(self.box)

            self._cards = []
            self._card_images = {}
            self._selected_index = -1
            self._workspace_buttons = []
            self._workspace_preview_pixbufs = {}
            self._expanded_groups = set()
            # O6 choreography + live-update state
            self._choreo = []
            self._animator = mission_control_anim.Animator()
            self._anim_tick_id = None
            self._exiting = False
            self._exit_started_at = None
            self._live = None
            self._live_capture = None
            self._build()

        def _build(self):
            windows = mission_control.enumerate_windows()
            self._windows = windows
            workspaces = mission_control.get_workspaces()
            active = mission_control.get_active_window() or {}
            active_id = str(active.get("win_id", "")).lower()
            screen = self.get_screen()
            self._card_images = {}

            # Mavericks keeps the Spaces strip at the top without an extra
            # application title/header inside Mission Control.
            workspace_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            self.box.pack_start(workspace_bar, False, False, 0)
            count = max(1, int(workspaces.get("count", 1)))
            current = int(workspaces.get("current", 0))
            names = workspaces.get("names", [])
            by_desktop = {i: [] for i in range(count)}
            for win in windows:
                desktop = int(win.get("desktop", -1))
                if desktop < 0:
                    desktop = current
                if desktop >= count:
                    continue
                by_desktop[desktop].append(win)

            # Mavericks Spaces strip: one live-composed miniature per Space
            # (one-shot window captures at scaled positions over the
            # desktop background; empty Spaces show the bare desktop).
            screen_geom = screen.get_monitor_geometry(0) if screen.get_n_monitors() > 0 else None
            screen_w = screen_geom.width if screen_geom else 1440
            screen_h = screen_geom.height if screen_geom else 900
            sorted_by_desktop = {
                desk: sorted(
                    wins,
                    key=lambda win: _preview_priority(win, active_id),
                )
                for desk, wins in by_desktop.items()
            }

            def _capture_for_preview(win_id, size):
                try:
                    return mission_control_thumbnail.capture_window(
                        int(str(win_id), 0), size)
                except Exception:
                    return None

            workspace_previews = mission_control_previews.build_workspace_previews(
                sorted_by_desktop, screen_w, screen_h, (128, 80),
                capture_fn=_capture_for_preview, desktop_count=count,
            )
            self._workspace_preview_pixbufs = workspace_previews

            for desktop in range(count):
                label = names[desktop] if desktop < len(names) else f"Desktop {desktop + 1}"
                button = Gtk.ToggleButton()
                button.set_can_focus(True)
                button.get_style_context().add_class("mav-workspace-button")
                button.set_active(desktop == current)
                button.connect("clicked", self._switch_workspace, desktop)
                button.drag_dest_set(
                    Gtk.DestDefaults.ALL,
                    [Gtk.TargetEntry.new("application/x-mav-mission-window", Gtk.TargetFlags.SAME_APP, 0)],
                    Gdk.DragAction.MOVE,
                )
                button.connect("drag-motion", self._on_workspace_drag_motion, desktop)
                button.connect("drag-leave", self._on_workspace_drag_leave)
                button.connect("drag-data-received", self._on_workspace_drop, desktop)

                button_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                preview_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
                preview_row.get_style_context().add_class("mav-workspace-preview")
                preview_pixbuf = workspace_previews.get(desktop)
                if preview_pixbuf is not None:
                    preview_image = Gtk.Image.new_from_pixbuf(preview_pixbuf)
                else:
                    # Preview compositor unavailable (no GdkPixbuf path):
                    # labelled empty placeholder keeps the Space clickable.
                    preview_image = Gtk.Label(label="—")
                    preview_image.get_style_context().add_class("mav-muted")
                preview_row.pack_start(preview_image, True, True, 0)

                text_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
                name_label = Gtk.Label(label=label)
                name_label.set_xalign(0)
                name_label.get_style_context().add_class("mav-workspace-label")
                text_row.pack_start(name_label, True, True, 0)
                count_label = Gtk.Label(label=str(len(by_desktop[desktop])))
                count_label.set_xalign(1)
                count_label.get_style_context().add_class("mav-workspace-count")
                text_row.pack_end(count_label, False, False, 0)

                button_box.pack_start(preview_row, False, False, 0)
                button_box.pack_start(text_row, False, False, 0)

                overlay = Gtk.Overlay()
                overlay.add(button_box)
                if desktop > 0 and desktop != current and count > 1:
                    close_button = Gtk.Button(label="×")
                    close_button.set_can_focus(False)
                    close_button.get_style_context().add_class("mav-workspace-close")
                    close_button.set_halign(Gtk.Align.START)
                    close_button.set_valign(Gtk.Align.START)
                    close_button.connect("clicked", self._remove_workspace, desktop)
                    overlay.add_overlay(close_button)
                button.add(overlay)
                workspace_bar.pack_start(button, False, False, 0)
                self._workspace_buttons.append(button)

            # Mavericks Spaces exposes an Add Desktop control in the Spaces bar.
            add_button = Gtk.Button(label="+")
            add_button.set_can_focus(True)
            add_button.set_tooltip_text("Add Desktop")
            add_button.get_style_context().add_class("mav-workspace-add")
            add_button.connect("clicked", self._add_workspace)
            workspace_bar.pack_start(add_button, False, False, 0)

            scrolled = Gtk.ScrolledWindow()
            scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            self.box.pack_start(scrolled, True, True, 0)

            # Mavericks Mission Control presents the windows for the current
            # Space as one visual layer. Other Spaces are represented by the
            # thumbnails in the Spaces strip above, not by separate sections.
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            content.set_margin_bottom(20)
            scrolled.add(content)

            current_items = by_desktop[current]
            grid = Gtk.Grid()
            grid.set_column_spacing(38)
            grid.set_row_spacing(38)
            grid.set_margin_start(38)
            grid.set_margin_end(38)
            grid.set_margin_top(12)
            content.pack_start(grid, True, True, 0)

            if not current_items:
                empty = Gtk.Label(label="No windows")
                empty.set_xalign(0)
                empty.get_style_context().add_class("mav-muted")
                grid.attach(empty, 0, 0, 1, 1)
            else:
                # Mavericks can group Mission Control windows by application.
                # Grouping is visual-only: each window remains independently
                # activatable and usable as a drag source.
                groups = []
                group_map = {}
                for win in current_items:
                    key = (win.get("wm_class") or "(unknown)").strip().lower()
                    if key not in group_map:
                        group_map[key] = []
                        groups.append((key, group_map[key]))
                    group_map[key].append(win)

                cols = 1 if len(groups) <= 2 else (2 if len(groups) <= 6 else 3)
                for group_index, (group_key, group_windows) in enumerate(groups):
                    group_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                    group_box.get_style_context().add_class("mav-app-group")

                    # Mavericks presents grouped windows as a compact stack.
                    stack = Gtk.Fixed()
                    visible_count = min(len(group_windows), 6)
                    group_token = group_key
                    expanded = group_token in self._expanded_groups
                    self._layout_group_stack(stack, visible_count, expanded)
                    for card_index, win in enumerate(group_windows[:6]):
                        card = self._make_card(win, win.get("win_id", "").lower() == active_id)
                        stack.put(card, 0, 0)
                        self._cards.append((card, win.get("win_id")))
                    stack.add_events(Gdk.EventMask.SCROLL_MASK)
                    stack.connect("scroll-event", self._on_group_scroll, group_token, visible_count)
                    self._layout_group_stack(stack, visible_count, expanded)
                    group_box.pack_start(stack, False, False, 0)

                    # Mavericks identifies a grouped application beneath the cluster.
                    heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
                    heading.set_halign(Gtk.Align.CENTER)
                    icon = self._application_icon(group_windows[0])
                    heading.pack_start(icon, False, False, 0)
                    app_label = Gtk.Label(label=self._application_name(group_windows[0]))
                    app_label.get_style_context().add_class("mav-app-heading")
                    heading.pack_start(app_label, False, False, 0)
                    group_box.pack_start(heading, False, False, 0)
                    grid.attach(group_box, group_index % cols, group_index // cols, 1, 1)

            self.show_all()
            if self._cards:
                active_index = next((i for i, (_card, wid) in enumerate(self._cards) if str(wid).lower() == active_id), 0)
                self._select_card(active_index)
            self._start_live()

        def _layout_group_stack(self, stack, count, expanded):
            """Arrange a grouped application like Mavericks: stacked or scattered."""
            if count <= 0:
                stack.set_size_request(250, 178)
                return
            if expanded:
                cols = 2 if count > 1 else 1
                rows = (count + cols - 1) // cols
                stack.set_size_request(250 * cols + 14 * (cols - 1), 178 * rows + 14 * (rows - 1))
                for index, child in enumerate(stack.get_children()):
                    x = (index % cols) * 264
                    y = (index // cols) * 192
                    stack.move(child, x, y)
            else:
                offset = 18
                stack.set_size_request(250 + offset * (count - 1), 178 + offset * (count - 1))
                for index, child in enumerate(stack.get_children()):
                    stack.move(child, offset * index, offset * index)

        def _on_group_scroll(self, _stack, event, group_token, count):
            # Mavericks 10.9 lets the user scatter a grouped application by
            # scrolling upward over its group. Scrolling downward collapses it.
            if event.direction == Gdk.ScrollDirection.UP or (
                event.direction == Gdk.ScrollDirection.SMOOTH and event.delta_y < 0
            ):
                self._expanded_groups.add(group_token)
            elif event.direction == Gdk.ScrollDirection.DOWN or (
                event.direction == Gdk.ScrollDirection.SMOOTH and event.delta_y > 0
            ):
                self._expanded_groups.discard(group_token)
            else:
                return False
            self._layout_group_stack(_stack, count, group_token in self._expanded_groups)
            _stack.show_all()
            return True

        # ---- O6: entrance/exit choreography (fade + directional scale) ----

        def _choreography_data(self):
            """Per-card (stack, card, base_x, base_y, pull_x, pull_y).

            The pull is the capped 12% delta toward the window's real
            on-screen position — cards leave their window's place and
            settle into the grid (Mavericks fade+scale feel without a
            full-geometry traversal).
            """
            data = []
            for card, win_id in self._cards:
                stack = card.get_parent()
                if not isinstance(stack, Gtk.Fixed):
                    continue
                win = next((w for w in self._windows if str(w.get("win_id")) == str(win_id)), None)
                if win is None:
                    continue
                geo = win.get("geometry") or {}
                try:
                    win_x, win_y = int(geo.get("x", 0)), int(geo.get("y", 0))
                except (TypeError, ValueError):
                    continue
                try:
                    base_x = stack.child_get_property(card, "x")
                    base_y = stack.child_get_property(card, "y")
                except TypeError:
                    base_x, base_y = 0, 0
                translated = card.translate_coordinates(self, 0, 0)
                card_x, card_y = translated if translated else (base_x, base_y)
                pull_x, pull_y = mission_control_anim.directional_offset(
                    win_x, win_y, card_x, card_y)
                data.append((stack, card, base_x, base_y, pull_x, pull_y))
            return data

        def _apply_choreo(self, progress, exiting=False):
            factor = progress if exiting else (1.0 - progress)
            opacity = (1.0 - progress) if exiting else progress
            for stack, card, base_x, base_y, pull_x, pull_y in self._choreo:
                try:
                    stack.move(card, base_x + pull_x * factor, base_y + pull_y * factor)
                except Exception:
                    pass
                card.set_opacity(max(0.0, min(1.0, opacity)))
            self.set_opacity(max(0.0, min(1.0, opacity)))

        def _anim_tick(self):
            now = time.monotonic() * 1000.0
            alive = self._animator.tick(now)
            if alive:
                return True
            self._anim_tick_id = None
            if self._exiting:
                self.destroy()
            return False

        def _ensure_ticker(self):
            if self._anim_tick_id is None:
                self._anim_tick_id = GLib.timeout_add(16, self._anim_tick)

        def _start_entrance(self):
            """O6 entrance: fade + slide from window positions (~160ms)."""
            if mission_control_anim.when_mv_reduced_motion() or self._exiting:
                self.set_opacity(1.0)
                return False
            self._choreo = self._choreography_data()
            self.set_opacity(0.0)
            self._apply_choreo(0.0)
            timeline = mission_control_anim.Timeline(mission_control_anim.ENTRANCE_MS)
            self._animator = mission_control_anim.Animator()
            self._animator.add(timeline, lambda p: self._apply_choreo(p))
            self._ensure_ticker()
            return False

        def _begin_exit(self):
            """O6 exit: reverse choreography (~140ms), then destroy."""
            if self._exiting:
                # Impatient second Escape during the exit: finish now.
                self.destroy()
                return
            if mission_control_anim.when_mv_reduced_motion():
                self.destroy()
                return
            self._teardown_live()
            if not self._choreo:
                self._choreo = self._choreography_data()
            self._exiting = True
            timeline = mission_control_anim.Timeline(mission_control_anim.EXIT_MS)
            self._animator = mission_control_anim.Animator()
            self._animator.add(timeline, lambda p: self._apply_choreo(p, exiting=True))
            self._ensure_ticker()

        def _on_destroy(self, _widget):
            self._teardown_live()
            if self._anim_tick_id is not None:
                GLib.source_remove(self._anim_tick_id)
                self._anim_tick_id = None
            Gtk.main_quit()

        # ---- O6: damage-driven live thumbnails while the overview is open ----

        def _start_live(self):
            """Event-driven live updates for the visible window cards.

            XDamage wakes us via an fd watch only when window pixels
            actually change; no polling, no timers. Unavailable damage
            or a failed start keeps the static one-shot captures.
            """
            if self._live is not None or self._exiting:
                return
            try:
                tc = mission_control_thumbnail.ThumbnailCapture()
            except RuntimeError:
                return
            if not tc.live_available:
                tc.close()
                return
            sizes = {}
            for _card, win_id in self._cards:
                parsed = mission_control._parse_window_id(win_id)
                if parsed is not None:
                    sizes[parsed] = (238, 134)
            if not sizes:
                tc.close()
                return
            live = mission_control_live.LiveThumbnails(tc, self._on_live_window_updated)
            if live.start(sizes):
                self._live = live
                self._live_capture = tc
            else:
                tc.close()

        def _on_live_window_updated(self, win_id, pixbuf):
            # Damage events carry int ids; enumerate_windows() keys are
            # hex strings — accept both spellings.
            image = self._card_images.get(str(win_id))
            if image is None:
                try:
                    image = self._card_images.get(hex(int(win_id)))
                except (TypeError, ValueError):
                    image = None
            if image is not None and not self._exiting:
                image.set_from_pixbuf(pixbuf)

        def _teardown_live(self):
            if self._live is not None:
                self._live.stop()
                self._live = None
                self._live_capture = None

        def _select_card(self, index):
            if not self._cards:
                return
            index %= len(self._cards)
            if 0 <= self._selected_index < len(self._cards):
                self._cards[self._selected_index][0].get_style_context().remove_class("mav-selected")
            self._selected_index = index
            card = self._cards[index][0]
            card.get_style_context().add_class("mav-selected")
            card.grab_focus()

        def _activate_selected(self):
            if not (0 <= self._selected_index < len(self._cards)):
                return False
            _card, win_id = self._cards[self._selected_index]
            if win_id and mission_control.activate_window(win_id):
                self._begin_exit()
                return True
            return False

        def _remove_workspace(self, _button, desktop):
            if mission_control.remove_workspace(desktop):
                self._refresh_after_workspace_switch()

        def _add_workspace(self, _button):
            workspaces = mission_control.get_workspaces()
            count = max(1, int(workspaces.get("count", 1)))
            if count >= 16:
                return
            if mission_control.set_workspace_count(count + 1):
                self._refresh_after_workspace_switch()

        def _switch_workspace(self, button, desktop):
            # Clicking the already-selected Space must not toggle its radio-like
            # state off. Mavericks always keeps one Space selected.
            if desktop == int(mission_control.get_workspaces().get("current", 0)):
                button.set_active(True)
                return
            if not button.get_active():
                return
            if mission_control.switch_workspace(desktop):
                self._refresh_after_workspace_switch()
            else:
                button.set_active(False)

        def _refresh_after_workspace_switch(self):
            def refresh():
                self._teardown_live()
                for child in self.box.get_children():
                    self.box.remove(child)
                self._cards = []
                self._selected_index = -1
                self._workspace_buttons = []
                self._build()
                return False
            GLib.timeout_add(100, refresh)

        def _on_window_drag_data_get(self, _widget, _context, selection, _info, _time, win_id):
            if win_id:
                selection.set_text(str(win_id), -1)

        def _clear_drop_highlight(self):
            for button in self._workspace_buttons:
                button.get_style_context().remove_class("mav-drop-target")
            return False

        def _on_workspace_drag_motion(self, _button, _context, _x, _y, _time, desktop):
            self._clear_drop_highlight()
            if 0 <= desktop < len(self._workspace_buttons):
                self._workspace_buttons[desktop].get_style_context().add_class("mav-drop-target")
            return True

        def _on_workspace_drag_leave(self, _button, _context, _time):
            self._clear_drop_highlight()

        def _on_workspace_drop(self, _button, context, _x, _y, selection, _info, _time, desktop):
            self._clear_drop_highlight()
            win_id = selection.get_text()
            if not win_id:
                context.finish(False, False, _time)
                return
            if mission_control.move_window_to_workspace(win_id, desktop):
                context.finish(True, False, _time)
                self._refresh_after_workspace_switch()
                return
            context.finish(False, False, _time)

        def _application_name(self, win):
            name = (win.get("wm_class") or "").strip()
            if name:
                return name
            title = (win.get("title") or "").strip()
            return title if title else "Application"

        def _application_icon(self, win):
            theme = Gtk.IconTheme.get_default()
            wm_class = (win.get("wm_class") or "").strip()
            candidates = [wm_class, wm_class.lower(), wm_class.replace(" ", "-").lower()] if wm_class else []
            candidates.append("application-x-executable")
            for name in candidates:
                try:
                    if theme.has_icon(name):
                        image = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
                        image.set_size_request(20, 20)
                        image.get_style_context().add_class("mav-app-icon")
                        return image
                except Exception:
                    pass
            return Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.MENU)

        def _make_card(self, win, is_active):
            event = Gtk.EventBox()
            event.set_visible_window(True)
            event.set_can_focus(True)
            event.get_style_context().add_class("mav-card")
            event.set_tooltip_text(_safe_title(win))
            event.connect("button-release-event", self._activate, win.get("win_id"))
            event.drag_source_set(
                Gdk.ModifierType.BUTTON1_MASK,
                [Gtk.TargetEntry.new("application/x-mav-mission-window", Gtk.TargetFlags.SAME_APP, 0)],
                Gdk.DragAction.MOVE,
            )
            event.connect("drag-data-get", self._on_window_drag_data_get, win.get("win_id"))

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            box.set_size_request(250, 178)

            pixbuf = None
            try:
                wid = int(str(win.get("win_id")), 0)
                pixbuf = mission_control_thumbnail.capture_window(wid, (238, 112))
            except Exception:
                pixbuf = None

            if pixbuf is not None:
                image = Gtk.Image.new_from_pixbuf(pixbuf)
                image.set_size_request(238, 134)
            else:
                image = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
                image.set_size_request(238, 134)

            box.pack_start(image, True, True, 0)
            # Window titles remain available through the tooltip and keyboard selection;
            # Mavericks does not render a modern card caption inside the grouped stack.

            event.add(box)
            self._card_images[str(win.get("win_id"))] = image
            return event

        def _activate(self, _widget, event, win_id):
            if event.button != 1 or not win_id:
                return False
            if mission_control.activate_window(win_id):
                self._begin_exit()
            return True

        def _on_background_click(self, _widget, event):
            if event.window is self.get_window() and event.button == 1:
                self._begin_exit()
            return False

        def _on_key(self, _widget, event):
            key = Gdk.keyval_name(event.keyval)
            if key in ("Escape", "q"):
                self._begin_exit()
                return True

            # Keyboard navigation is essential for a full-screen window overview:
            # the selected card must remain usable without a mouse. Mission
            # Control's grid is application-grouped, so linear traversal is the
            # deterministic fallback across varying group sizes.
            if key in ("Return", "KP_Enter", "space"):
                if self._activate_selected():
                    return True
            if key in ("Left", "Up"):
                if self._cards:
                    self._select_card(self._selected_index - 1)
                    return True
            if key in ("Right", "Down"):
                if self._cards:
                    self._select_card(self._selected_index + 1)
                    return True
            if key == "Home":
                if self._cards:
                    self._select_card(0)
                    return True
            if key == "End":
                if self._cards:
                    self._select_card(len(self._cards) - 1)
                    return True

            state = event.state & Gtk.accelerator_get_default_mod_mask()
            if state & Gdk.ModifierType.CONTROL_MASK:
                current = int(mission_control.get_workspaces().get("current", 0))
                if key == "Left":
                    target = max(0, current - 1)
                    if target != current and target < len(self._workspace_buttons):
                        self._switch_workspace(self._workspace_buttons[target], target)
                        return True
                if key == "Right":
                    target = min(len(self._workspace_buttons) - 1, current + 1)
                    if target != current and target >= 0:
                        self._switch_workspace(self._workspace_buttons[target], target)
                        return True
            return False

def _run_helper(helper_name, args=None):
    """Run a Mission Control helper script, return its stdout."""
    helper_path = os.path.join(SCRIPT_DIR, helper_name)
    cmd = ["python3", helper_path]
    if args:
        cmd.extend(args)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return result.stdout
    except subprocess.CalledProcessError as e:
        print(f"Error running {helper_name}: {e.stderr}", file=sys.stderr)
        return None
    except FileNotFoundError:
        print(f"Error: {helper_name} not found", file=sys.stderr)
        return None


def _list_mode(debug=False):
    """CLI listing mode (headless contract; data via the shared backend)."""
    output = _run_helper("mv-mc-window-spaces")
    if not output:
        sys.exit(1)
    try:
        data = json.loads(output)
    except json.JSONDecodeError:
        print("Error: Invalid JSON from mv-mc-window-spaces", file=sys.stderr)
        sys.exit(1)

    if debug:
        print("Workspaces:", json.dumps(data, indent=2))
        return

    for ws in data.get("workspaces", []):
        print(f"\n{ws['name']}:")
        for win in ws.get("windows", []):
            print(f"  - [{win['wid']}] {win['title']} ({win['app']})")


def main():
    parser = argparse.ArgumentParser(description="Mission Control Overview")
    parser.add_argument("--debug", action="store_true", help="Enable debug output (JSON dump)")
    parser.add_argument("--list", action="store_true", help="List windows only (no UI)")
    parser.add_argument("--activate", type=int, help="Activate window by ID")
    args = parser.parse_args()

    if args.activate is not None:
        raise SystemExit(0 if mission_control.activate_window(args.activate) else 1)

    if args.list or args.debug:
        _list_mode(debug=args.debug)
        return 0

    if not _GTK_OK:
        raise SystemExit("GTK3/PyGObject is required for the overview UI")

    overview = Overview()
    overview.show_all()
    # Entrance choreography starts after the first layout pass (resize
    # allocation runs at higher priority than idle).
    GLib.idle_add(overview._start_entrance)
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
