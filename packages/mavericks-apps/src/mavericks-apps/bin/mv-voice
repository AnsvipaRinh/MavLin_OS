#!/usr/bin/env python3
"""mv-voice — Voice Memos (Mavericks-like).
Cassette tape UI, waveform visualization, metadata editing.
Backend: pw-record/parec (PipeWire) or parec fallback.
Mavericks visual: cassette tape UI, waveform, leather texture.
"""
import os, signal, subprocess, time, threading
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango

MEMO_DIR = os.path.expanduser("~/Music/Voice Memos")

class VoiceMemos(Gtk.Window):
    def __init__(self):
        super().__init__(title="Voice Memos")
        self.set_default_size(520, 500)
        
        self.apply_mavericks_css()

        hb = Gtk.HeaderBar(title="Voice Memos", show_close_button=True)
        self.set_titlebar(hb)

        # Main container
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        vbox.set_border_width(16)
        self.add(vbox)

        # Cassette tape visual
        self.cassette = CassetteWidget()
        vbox.pack_start(self.cassette, False, False, 0)

        # Status label
        self.status = Gtk.Label(label="Ready to record")
        self.status.get_style_context().add_class("voice-status")
        vbox.pack_start(self.status, False, False, 0)

        # Recording time
        self.time_label = Gtk.Label(label="00:00")
        self.time_label.get_style_context().add_class("voice-time")
        vbox.pack_start(self.time_label, False, False, 0)

        # Record button
        self.rec_btn = Gtk.Button()
        self.rec_btn.set_image(Gtk.Image.new_from_icon_name("media-record", Gtk.IconSize.DND))
        self.rec_btn.set_always_show_image(True)
        self.rec_btn.get_style_context().add_class("voice-record-btn")
        self.rec_btn.connect("clicked", self.toggle_record)
        vbox.pack_start(self.rec_btn, False, False, 0)

        # Memo list
        self.store = Gtk.ListStore(str, str, str, int)  # name, date, duration, duration_sec
        tv = Gtk.TreeView(model=self.store, headers_visible=True)
        tv.set_headers_visible(False)
        
        renderer = Gtk.CellRendererText()
        renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
        col = Gtk.TreeViewColumn("", renderer, text=0)
        col.set_cell_data_func(renderer, self.render_memo_cell)
        tv.append_column(col)
        
        tv.connect("row-activated", self.on_play)
        
        sw = Gtk.ScrolledWindow()
        sw.set_size_request(-1, 200)
        sw.get_style_context().add_class("voice-memo-list")
        sw.add(tv)
        self.tv = tv
        self.store_ref = self.store

        vbox.pack_start(sw, True, True, 0)

        # Edit/Delete buttons
        btn_box = Gtk.Box(spacing=8)
        for label, cb in [("Rename", self.rename_memo), ("Delete", self.delete_memo)]:
            b = Gtk.Button(label=label)
            b.get_style_context().add_class("mavericks-toolbar-btn")
            b.connect("clicked", cb)
            btn_box.pack_start(b, True, True, 0)
        vbox.pack_start(btn_box, False, False, 0)

        self.apply_mavericks_css()

        self.MEMO_DIR = os.path.expanduser("~/Music/Voice Memos")
        os.makedirs(self.MEMO_DIR, exist_ok=True)

        self.proc = None
        self.path = None
        self.recording_start = 0
        self.recording_timer = None
        self.waveform_data = []

        self.refresh()
        self.show_all()

    def apply_mavericks_css(self):
        css = b"""
        .voice-memo-window {
            background: #f0ebe0;
            background-image: linear-gradient(135deg, #f0ebe0 0%, #e0d8c8 100%);
        }
        .voice-status {
            color: #666;
            font-size: 11pt;
            font-family: "San Francisco", sans-serif;
        }
        .voice-time {
            color: #007aff;
            font-size: 24pt;
            font-weight: bold;
            font-family: "SF Mono", "Menlo", monospace;
            font-variant-numeric: tabular-nums;
        }
        .voice-record-btn {
            min-width: 80px;
            min-height: 80px;
            border-radius: 40px;
            background: #ff3b30;
            border: none;
            box-shadow: 0 4px 12px rgba(255,59,48,0.4);
        }
        .voice-record-btn:hover {
            background: #ff453a;
            box-shadow: 0 6px 16px rgba(255,59,48,0.5);
        }
