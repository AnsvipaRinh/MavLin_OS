            background: rgba(0,122,255,0.1);
        }
        .memo-row:selected {
            background: #007aff;
            color: white;
        }
        .cassette-widget {
            background: #2d2d2d;
            border-radius: 8px;
            padding: 20px;
        }
        .cassette-label {
            color: #ccc;
            font-family: "San Francisco", sans-serif;
            font-size: 10pt;
        }
        .voice-status {
            color: #666;
            font-size: 11pt;
            font-family: "San Francisco", sans-serif;
        }
        .voice-time {
            color: #007aff;
            font-size: 28pt;
            font-weight: bold;
            font-family: "SF Mono", "Menlo", monospace;
            font-variant-numeric: tabular-nums;
        }
        .voice-record-btn {
            min-width: 88px;
            min-height: 88px;
            border-radius: 44px;
            background: #ff3b30;
            border: none;
            box-shadow: 0 4px 12px rgba(255,59,48,0.4);
        }
        .voice-record-btn:hover {
            background: #ff453a;
            box-shadow: 0 6px 16px rgba(255,59,48,0.5);
        }
        .voice-record-btn:active {
            background: #cc2e26;
        }
        .voice-record-btn.recording {
            background: #34c759;
            box-shadow: 0 4px 12px rgba(52,199,89,0.4);
        }
        .voice-record-btn.recording:hover {
            background: #38d962;
        }
        .voice-memo-list {
            background: #f5f0e8;
            background-image: linear-gradient(180deg, #f5f0e8 0%, #e8ddd0 100%);
            border: 1px solid #d4c8b8;
            border-radius: 8px;
        }
        .voice-memo-list > viewport { background: transparent; }
        .memo-row {
            padding: 12px 16px;
            border-bottom: 1px solid #e0d8c8;
        }
        .memo-row:hover {
            background: rgba(0,122,255,0.1);
        }
        .memo-row:selected {
            background: #007aff;
            color: white;
        }
        .mavericks-toolbar-btn {
            border-radius: 4px;
            padding: 6px 12px;
            margin: 2px;
            background-image: linear-gradient(to bottom, #f0ebe0 0%, #e0d8c8 100%);
            border: 1px solid #d0c8b8;
            color: #333;
            text-shadow: 0 1px 0 rgba(255,255,255,0.5);
        }
        .mavericks-toolbar-btn:hover {
            background-image: linear-gradient(to bottom, #e8e0d0 0%, #d8d0c0 100%);
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }
        .mavericks-toolbar-btn:active {
            background-image: linear-gradient(to bottom, #d8d0c0 0%, #c8c0b0 100%);
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def render_memo_cell(self, column, cell, model, iter_, data):
        name = model[iter_][0]
        date_str = model[iter_][1]
        duration = model[iter_][2]
        
        markup = f'<span weight="bold" size="11000">{GLib.markup_escape_text(name)}</span>\n'
        markup += f'<span size="9000" foreground="#666">{date_str}  •  {duration}</span>'
        cell.set_property("markup", markup)
        cell.set_property("xalign", 0.0)
        cell.set_property("ypad", 10)
        cell.set_property("xpad", 16)

    def backend(self):
        for exe, args in (("pw-record", ["--format=wav"]), ("parec", ["--format=wav"])):
            try:
                subprocess.run([exe, "--help"], capture_output=True, timeout=3)
                return [exe] + args
            except (OSError, subprocess.SubprocessError):
                continue
        return None

    def toggle_record(self, _b):
        if self.proc:
            self.stop_recording()
        else:
            self.start_recording()

    def start_recording(self):
        be = self.backend()
        if not be:
            self.status.set_text("No recorder found (pw-record/parec).")
            return
        os.makedirs(self.MEMO_DIR, exist_ok=True)
        self.path = os.path.join(self.MEMO_DIR, "memo-%s.wav" % time.strftime("%Y%m%d-%H%M%S"))
        try:
            self.proc = subprocess.Popen(be + [self.path])
        except Exception as e:
            self.status.set_text("Failed to start recording: %s" % e)
            return
        
        self.recording_start = time.time()
        self.rec_btn.get_style_context().add_class("recording")
        self.rec_btn.set_image(Gtk.Image.new_from_icon_name("media-playback-stop", Gtk.IconSize.DND))
        self.status.set_text("Recording…")
        self.update_recording_time()
        self.recording_timer = GLib.timeout_add(100, self.update_recording_time)
        self.status.set_text("Recording…")

    def stop_recording(self):
        if self.proc:
            self.proc.send_signal(signal.SIGINT)
            self.proc.wait(timeout=10)
            self.proc = None
        
        if self.recording_timer:
            GLib.source_remove(self.recording_timer)
            self.recording_timer = None
        
        self.rec_btn.get_style_context().remove_class("recording")
        self.rec_btn.set_image(Gtk.Image.new_from_icon_name("media-record", Gtk.IconSize.DND))
        self.status.set_text("Saved: %s" % os.path.basename(self.path))
        self.refresh()
        self.path = None

    def update_recording_time(self):
        if self.proc and self.recording_start > 0:
            elapsed = int(time.time() - self.recording_start)
            mins = elapsed // 60
            secs = elapsed % 60
            self.time_label.set_text("%02d:%02d" % (mins, secs))
            return True
        return False

    def refresh(self):
        self.store.clear()
        if os.path.isdir(self.MEMO_DIR):
            for f in sorted(os.listdir(self.MEMO_DIR), reverse=True):
                if f.endswith(".wav"):
                    path = os.path.join(self.MEMO_DIR, f)
                    stat = os.stat(path)
                    date_str = time.strftime("%b %d, %Y %H:%M", time.localtime(stat.st_mtime))
                    duration = self.get_audio_duration(path)
                    self.store.append([f, date_str, duration, stat.st_size])

    def get_audio_duration(self, path):
        try:
            out = subprocess.run(["ffprobe", "-v", "quiet", "-show_entries", "format=duration",
                                  "-of", "csv=p=0", path], capture_output=True, text=True, timeout=5).stdout
            dur = float(out.strip())
            mins = int(dur // 60)
            secs = int(dur % 60)
            return "%d:%02d" % (mins, secs)
        except Exception:
            return "—"

    def on_play(self, _tv, path, _col):
        name = self.store[path][0]
        subprocess.Popen(["xdg-open", os.path.join(self.MEMO_DIR, name)])

    def rename_memo(self, _b):
        row = self.tv.get_selection().get_selected()
        if not row:
            return
        model, iter_ = row
        old_name = model[iter_][0]
        
        dialog = Gtk.Dialog(title="Rename Memo", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Rename", Gtk.ResponseType.OK)
        entry = Gtk.Entry()
        entry.set_text(old_name)
        dialog.get_content_area().pack_start(entry, True, True, 0)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            new_name = entry.get_text().strip()
            if new_name and new_name != old_name:
                if not new_name.endswith(".wav"):
                    new_name += ".wav"
                old_path = os.path.join(self.MEMO_DIR, old_name)
                new_path = os.path.join(self.MEMO_DIR, new_name)
                try:
                    os.rename(old_path, new_path)
                    self.refresh()
                except Exception as e:
                    self.show_error("Failed to rename: %s" % e)
        dialog.destroy()

    def delete_memo(self, _b):
        row = self.tv.get_selection().get_selected()
        if not row:
            return
        model, iter_ = row
        name = model[iter_][0]
        
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Delete '%s'?" % name)
        dialog.format_secondary_text("This cannot be undone.")
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.YES:
            path = os.path.join(self.MEMO_DIR, name)
            try:
                os.remove(path)
                self.refresh()
            except Exception as e:
                self.show_error("Failed to delete: %s" % e)

    def show_error(self, msg):
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=msg)
        dialog.run()
        dialog.destroy()


def main():
    w = VoiceMemos()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()
    return 0

if __name__ == "__main__":
    sys.exit(main())