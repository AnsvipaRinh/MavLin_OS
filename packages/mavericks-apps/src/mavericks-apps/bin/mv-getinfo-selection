#!/usr/bin/env python3
"""mv-getinfo-selection — global-shortcut wrapper: Get Info on Thunar selection.

Bound to Super+Shift+I (Mavericks Cmd+I on a selected item). Resolves the
current selection via the shared mv-selection helper and passes real paths
to mv-getinfo. When nothing is selected, falls back to $HOME — same target
as Super+I — so the shortcut always opens an Info window like Mavericks
instead of silently doing nothing.
License: GPL-2.0-or-later.
"""
import os
import subprocess
import sys


def _tool(name):
    here = os.path.dirname(os.path.abspath(__file__))
    cand = os.path.join(here, name)
    return cand if os.path.isfile(cand) else "/usr/bin/" + name


def main():
    out = subprocess.run([_tool("mv-selection")],
                         capture_output=True, text=True, timeout=5)
    paths = [l for l in out.stdout.splitlines() if l.strip()]
    if not paths:
        paths = [os.path.expanduser("~")]
    cmd = [_tool("mv-getinfo")] + paths
    sys.exit(subprocess.run(cmd).returncode)


if __name__ == "__main__":
    sys.exit(main())
