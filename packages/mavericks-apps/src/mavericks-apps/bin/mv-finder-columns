#!/usr/bin/env python3
"""mv-finder-columns — Finder column-view companion.

Thunar has no column view and the thunarx-3 API exposes no view provider
(see docs/DECISIONS.md), so the Mavericks column experience lives here:
a multi-pane column browser (folder → subfolder → …) with the same visual
language as the other mv-* apps. Finder-native file actions cover the core
P0 surface (rename, trash, copy/paste, Get Info, Quick Look, Open With, and
New Folder). "Open in Thunar" remains the fallback for the broader Thunar
surface, including UCA actions not duplicated by this companion. On-demand
single-shot process: no daemon, no indexer, no polling.

License: GPL-2.0-or-later."""
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf  # noqa: E402

COLUMN_WIDTH = 240
MAX_COLUMNS = 24  # horizontal scroll still handles it; cap is a safety net

# Finder-like icon-size ladder (Ctrl+= / Ctrl+- / Ctrl+0, same as
# mv-finder-search and Thunar's in-window zoom)
ZOOM_LADDER = [16, 22, 32, 48]
ZOOM_DEFAULT = ZOOM_LADDER[0]


def zoom_step(size, delta):
    """Next/previous step on the zoom ladder (clamped). Unknown sizes start at default."""
    base = ZOOM_LADDER.index(size) if size in ZOOM_LADDER \
        else ZOOM_LADDER.index(ZOOM_DEFAULT)
    index = base + delta
    index = max(0, min(len(ZOOM_LADDER) - 1, index))
    return ZOOM_LADDER[index]


def list_entries(directory, include_hidden=False):
    """Entries of one column: folders first, then case-insensitive name.

    Raises OSError for unreadable directories (caller shows error state).
    """
    out = []
    with os.scandir(directory) as scan:
        for entry in scan:
            name = entry.name
            if not include_hidden and name.startswith("."):
                continue
            try:
                is_dir = entry.is_dir(follow_symlinks=False)
            except OSError:
                continue
            try:
                st = entry.stat(follow_symlinks=False)
                size = 0 if is_dir else st.st_size
            except OSError:
                size = 0
            out.append({"name": name, "is_dir": is_dir, "size": size})
    out.sort(key=lambda e: (not e["is_dir"], e["name"].casefold(), e["name"]))
    return out


def icon_for(name, is_dir):
    """Icon name for a row; never raises."""
    if is_dir:
        return "folder"
    import mimetypes
    mime = mimetypes.guess_type(name)[0]
    if mime:
        try:
            names = Gio.content_type_get_icon(mime).get_names()
            try:
                theme = Gtk.IconTheme.get_default()
            except Exception:
                theme = None
            for n in names:
                if n and (theme is None or theme.has_icon(n)):
                    return n
        except Exception:
            pass
    return "text-x-generic"


def load_icon_pixbuf(name, size):
    """Pixbuf for an icon name; falls back to text-x-generic, never raises."""
    try:
        theme = Gtk.IconTheme.get_default()
        if theme is not None:
            try:
                return theme.load_icon(name, size,
                                       Gtk.IconLookupFlags.GENERIC_FALLBACK)
            except Exception:
                pass
            try:
                return theme.load_icon("text-x-generic", size,
                                       Gtk.IconLookupFlags.GENERIC_FALLBACK)
            except Exception:
                pass
    except Exception:
        pass
    return None


class ColumnRow(Gtk.ListBoxRow):
    def __init__(self, entry, icon_size=ZOOM_DEFAULT):
        super().__init__()
        self.entry = entry
        self.set_tooltip_text(entry["name"])
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_margin_top(3)
        box.set_margin_bottom(3)
        box.set_margin_start(6)
        box.set_margin_end(6)
        pixbuf = load_icon_pixbuf(icon_for(entry["name"], entry["is_dir"]),
                                  icon_size)
        if pixbuf is not None:
            img = Gtk.Image.new_from_pixbuf(pixbuf)
        else:
            img = Gtk.Image()
        label = Gtk.Label(label=entry["name"])
        label.set_ellipsize(3)  # middle
        label.set_halign(Gtk.Align.START)
        box.pack_start(img, False, False, 0)
        box.pack_start(label, False, False, 0)
        self.add(box)


class ColumnsWindow(Gtk.Window):
    def __init__(self, root):
        super().__init__(title=os.path.basename(root) or root)
        self.root = os.path.abspath(root)
        self.chain = [self.root]
        self.history = [[self.root]]
        self.history_index = 0
        self.listboxes = []
        self.icon_size = ZOOM_DEFAULT
        self._clipboard_mode = None

        self.set_default_size(760, 480)
        self.set_position(Gtk.WindowPosition.CENTER)

        self._install_finder_css()

        self.set_decorated(True)
        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        hb.get_style_context().add_class("mavericks-finder-toolbar")

        self.back_button = Gtk.Button(label="‹")
        self.back_button.set_tooltip_text("Back")
        self.back_button.connect("clicked", self.on_back)
        hb.pack_start(self.back_button, False, False, 0)

        self.forward_button = Gtk.Button(label="›")
        self.forward_button.set_tooltip_text("Forward")
        self.forward_button.connect("clicked", self.on_forward)
        hb.pack_start(self.forward_button, False, False, 0)

        up_button = Gtk.Button(label="↑")
        up_button.set_tooltip_text("Enclosing Folder")
        up_button.connect("clicked", self.on_up)
        hb.pack_start(up_button, False, False, 0)

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search")
        self.search_entry.set_width_chars(18)
        self.search_entry.connect("activate", self.on_search)
        hb.pack_end(self.search_entry, False, False, 0)

        open_tb = Gtk.Button(label="Open in Thunar")
        open_tb.set_tooltip_text("Open current location in Thunar")
        open_tb.connect("clicked", self.on_open_thunar)
        hb.pack_end(open_tb, False, False, 0)

        self.columns_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)

        self._drag_source = None
        self._drag_target = None

        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        self.scrolled.add(self.columns_box)

        self.error_label = Gtk.Label()
        self.error_label.get_style_context().add_class("dim-label")
        self.error_label.set_justify(Gtk.Justification.CENTER)

        self.status_label = Gtk.Label(label="")
        self.status_label.get_style_context().add_class("dim-label")
        self.status_label.set_halign(Gtk.Align.START)
        status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        status.set_border_width(4)
        status.pack_start(self.status_label, False, False, 0)

        self.overlay = Gtk.Overlay()
        self.overlay.add(self.scrolled)
        self.overlay.add_overlay(self.error_label)
        self.overlay.set_overlay_pass_through(self.error_label, True)

        content = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        content.set_position(175)
        self.sidebar = self._build_sidebar()
        content.pack1(self.sidebar, False, False)
        content.pack2(self.overlay, True, False)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.pack_start(hb, False, False, 0)
        vbox.pack_start(content, True, True, 0)
        vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
        vbox.pack_start(status, False, False, 0)
        self.add(vbox)

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

        self.show_all()
        self.rebuild_columns()

    def _install_finder_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(b"""
        .mavericks-finder-sidebar { background: #f2f2f2; border-right: 1px solid #c8c8c8; }
        .mavericks-finder-section { color: #777; font-size: 10px; font-weight: bold; padding: 8px 8px 3px; }
        .mavericks-finder-row { padding: 3px 7px; border-radius: 3px; }
        .mavericks-finder-row:selected { background: #6f8fbd; color: white; }
        .mavericks-finder-toolbar { background: #e2e2e2; }
        .mavericks-finder-column { background: #fff; }
        .mavericks-finder-column row { padding: 2px 5px; border-radius: 2px; }
        .mavericks-finder-column row:selected { background: #6f8fbd; color: white; }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _build_sidebar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("mavericks-finder-sidebar")
        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        listbox.connect("row-activated", self._sidebar_activated)
        self.sidebar_list = listbox
        for title, entries in (
                ("FAVORITES", [
                    ("Home", os.path.expanduser("~")),
                    ("Desktop", os.path.expanduser("~/Desktop")),
                    ("Documents", os.path.expanduser("~/Documents")),
                    ("Downloads", os.path.expanduser("~/Downloads")),
                    ("Pictures", os.path.expanduser("~/Pictures")),
                ]),
                ("DEVICES", [("File System", "/")])):
            label = Gtk.Label(label=title, xalign=0)
            label.get_style_context().add_class("mavericks-finder-section")
            box.pack_start(label, False, False, 0)
            for name, path in entries:
                if not os.path.isdir(path):
                    continue
                row = Gtk.ListBoxRow()
                row.path = path
                row.add(Gtk.Label(label="  " + name, xalign=0))
                row.get_style_context().add_class("mavericks-finder-row")
                listbox.add(row)
        try:
            volume_monitor = Gio.VolumeMonitor.get()
            self.volume_monitor = volume_monitor
            volume_monitor.connect("mount-added", self._mount_changed)
            volume_monitor.connect("mount-removed", self._mount_changed)
            volume_monitor.connect("mount-changed", self._mount_changed)
            self._append_mounted_devices()
        except Exception:
            self.volume_monitor = None
        box.pack_start(listbox, True, True, 0)
        return box

    def _append_mounted_devices(self):
        if not getattr(self, "sidebar_list", None) or not getattr(self, "volume_monitor", None):
            return
        for row in list(self.sidebar_list.get_children()):
            if hasattr(row, "mount"):
                self.sidebar_list.remove(row)
        for mount in self.volume_monitor.get_mounts():
            root = mount.get_root()
            path = root.get_path() if root is not None else None
            if not path or os.path.abspath(path) == "/":
                continue
            row = Gtk.ListBoxRow()
            row.path = path
            row.mount = mount
            row.add(Gtk.Label(label="  " + (mount.get_name() or path), xalign=0))
            row.get_style_context().add_class("mavericks-finder-row")
            row.connect("button-press-event", self._sidebar_button_press)
            self.sidebar_list.add(row)
        self.sidebar_list.show_all()

    def _refresh_mount_state(self):
        self._append_mounted_devices()
        # If the user is currently inside a volume that disappeared, rebuild
        # the columns so Finder exposes its normal unavailable-folder state
        # instead of leaving a stale mounted path on screen.
        if self.chain and not os.path.isdir(self.chain[-1]):
            self.rebuild_columns()
        return False

    def _mount_changed(self, *_args):
        GLib.idle_add(self._refresh_mount_state)

    def _sidebar_button_press(self, row, event):
        if event.button != 3 or not hasattr(row, "mount"):
            return False
        if not row.mount.can_eject():
            return False
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label="Eject")
        item.connect("activate", lambda _item: self._eject_mount(row.mount))
        menu.append(item)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def _eject_mount(self, mount):
        if not mount or not mount.can_eject():
            return
        try:
            mount.eject_with_operation(
                Gio.MountUnmountFlags.NONE, None, None,
                self._eject_finished, None)
        except Exception as e:
            self._show_error("Eject", str(e))

    def _eject_finished(self, mount, result, _user_data):
        try:
            mount.eject_with_operation_finish(result)
        except Exception as e:
            self._show_error("Eject", str(e))
        else:
            self.rebuild_columns()

    def _sidebar_activated(self, _listbox, row):
        if hasattr(row, "path") and os.path.isdir(row.path):
            target = [os.path.abspath(row.path)]
            if target == self.chain:
                return
            self.history = self.history[:self.history_index + 1] + [target]
            self.history_index += 1
            self.chain = target
            self.rebuild_columns()

    def on_search(self, _entry):
        query = self.search_entry.get_text().strip()
        if not query:
            return
        target = self.chain[-1]
        try:
            subprocess.Popen(["mv-finder-search", target, query],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._show_error("Search", e.strerror or str(e))

    def on_back(self, _button):
        if self.history_index > 0:
            self.history_index -= 1
            self.chain = self.history[self.history_index].copy()
            self.rebuild_columns()

    def on_forward(self, _button):
        if self.history_index + 1 < len(self.history):
            self.history_index += 1
            self.chain = self.history[self.history_index].copy()
            self.rebuild_columns()

    def on_go_to_folder(self, _action=None):
        """Navigate to an absolute/tilde-expanded folder entered by the user."""
        from mv_dialogs import entry_dialog
        target = entry_dialog(
            self,
            "Go to Folder",
            label="Enter a folder path:",
            initial=self.chain[-1],
            ok_label="Go",
            validator=lambda value: None if os.path.isdir(
                os.path.abspath(os.path.expanduser(value))) else "Folder not found.",
        )
        if not target:
            return
        target = os.path.abspath(os.path.expanduser(target))
        if target == self.chain[-1]:
            return
        self.history = self.history[:self.history_index + 1] + [[target]]
        self.history_index += 1
        self.chain = [target]
        self.rebuild_columns()

    def on_home(self, _button):
        home = os.path.expanduser("~")
        if self.chain == [home]:
            return
        self.history = self.history[:self.history_index + 1] + [[home]]
        self.history_index += 1
        self.chain = [home]
        self.rebuild_columns()

    def on_up(self, _button):
        parent = os.path.dirname(self.chain[-1])
        if not parent or parent == self.chain[-1]:
            return
        # At the top-level chain there is no preceding column to collapse;
        # Up must replace the root location with its parent instead of
        # indexing an empty list.
        if len(self.chain) == 1:
            new_chain = [parent]
        else:
            new_chain = self.chain[:-1]
            new_chain[-1] = parent
        self.history = self.history[:self.history_index + 1] + [new_chain]
        self.history_index += 1
        self.chain = new_chain
        self.rebuild_columns()

    # ---------- column construction ----------

    def rebuild_columns(self, keep_depth=None):
        for child in self.columns_box.get_children():
            self.columns_box.remove(child)
        self.listboxes = []

        if keep_depth is not None:
            self.chain = self.chain[:keep_depth]

        columns = []
        last_error = None
        for directory in self.chain:
            try:
                columns.append((directory, list_entries(directory)))
            except OSError as e:
                columns.append((directory, None))
                if directory == self.chain[-1]:
                    last_error = e

        for directory, entries in columns:
            self.append_column(directory, entries)

        last_entries = columns[-1][1]
        if last_entries is None:
            self.error_label.set_text(
                "Could not open “%s”\n%s" % (
                    self.chain[-1],
                    (last_error.strerror if last_error else None) or "permission denied"))
            self.status_label.set_text("Folder unavailable")
        else:
            self.error_label.set_text("")
            count = len(last_entries)
            name = os.path.basename(self.chain[-1]) or self.chain[-1]
            try:
                stat = os.statvfs(self.chain[-1])
                free_bytes = stat.f_bavail * stat.f_frsize
                units = ("B", "KB", "MB", "GB", "TB")
                free_value = float(free_bytes)
                unit = units[0]
                for candidate in units[1:]:
                    if free_value < 1024:
                        break
                    free_value /= 1024
                    unit = candidate
                free_text = "%.1f %s" % (free_value, unit)
            except OSError:
                free_text = "free space unavailable"
            self.status_label.set_text(
                "%d item%s in “%s” • %s free" %
                (count, "" if count == 1 else "s", name, free_text))

        self.columns_box.show_all()
        self.error_label.set_visible(last_entries is None)
        # scroll to the newest (right-most) column
        GLib.idle_add(self.scroll_to_end)

    def append_column(self, directory, entries):
        if len(self.listboxes) >= MAX_COLUMNS:
            return
        listbox = Gtk.ListBox()
        listbox.set_size_request(COLUMN_WIDTH, -1)
        listbox.set_activate_on_single_click(False)
        listbox.connect("row-activated", self.on_row_activated)
        listbox.connect("button-press-event", self.on_column_button_press)
        self._setup_drop_target(listbox)
        listbox.get_style_context().add_class("mavericks-finder-column")
        if entries:
            for entry in entries:
                row = ColumnRow(entry, self.icon_size)
                self._setup_drag_source(row)
                listbox.add(row)
        elif entries is None:
            error_row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="Cannot open")
            lbl.get_style_context().add_class("dim-label")
            error_row.add(lbl)
            listbox.add(error_row)
        separator = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        self.columns_box.pack_start(listbox, False, False, 0)
        self.columns_box.pack_start(separator, False, False, 0)
        self.listboxes.append(listbox)

    # ---------- Finder drag and drop ----------

    def _setup_drag_source(self, row):
        target = Gtk.TargetEntry.new("text/uri-list", 0, 0)
        row.drag_source_set(Gdk.ModifierType.BUTTON1_MASK,
                            [target], Gdk.DragAction.MOVE)
        row.connect("drag-begin", self._on_drag_begin)
        row.connect("drag-data-get", self._on_drag_data_get)

    def _setup_drop_target(self, listbox):
        target = Gtk.TargetEntry.new("text/uri-list", 0, 0)
        listbox.drag_dest_set(Gtk.DestDefaults.ALL, [target], Gdk.DragAction.MOVE)
        listbox.connect("drag-motion", self._on_drag_motion)
        listbox.connect("drag-data-received", self._on_drag_data_received)

    def _on_drag_begin(self, row, _context):
        self._drag_source = row

    def _on_drag_data_get(self, row, _context, selection_data, _info, _time):
        if not hasattr(row, "entry"):
            return
        index = None
        for i, listbox in enumerate(self.listboxes):
            if row.get_parent() is listbox:
                index = i
                break
        if index is None:
            return
        path = os.path.join(self.chain[index], row.entry["name"])
        selection_data.set_uris([Gio.File.new_for_path(path).get_uri()])

    def _drop_directory(self, listbox, x, y):
        row = listbox.get_row_at_y(int(y))
        index = self.listboxes.index(listbox)
        if row is not None and hasattr(row, "entry") and row.entry["is_dir"]:
            return os.path.join(self.chain[index], row.entry["name"])
        return self.chain[index]

    def _on_drag_motion(self, listbox, context, x, y, _time):
        self._drag_target = self._drop_directory(listbox, x, y)
        Gdk.drag_status(context, Gdk.DragAction.MOVE, _time)
        return True

    def _on_drag_data_received(self, listbox, context, x, y, selection_data, _info, time_):
        target_dir = self._drop_directory(listbox, x, y)
        uris = selection_data.get_uris() or []
        moved = False
        try:
            for uri in uris:
                source = Gio.File.new_for_uri(uri).get_path()
                if not source or not os.path.exists(source):
                    continue
                source_abs = os.path.abspath(source)
                target_abs = os.path.abspath(target_dir)
                if source_abs == target_abs:
                    continue
                if os.path.isdir(source_abs) and os.path.commonpath(
                        [source_abs, target_abs]) == source_abs:
                    continue
                destination = os.path.join(target_abs, os.path.basename(source_abs))
                if os.path.abspath(destination) == source_abs:
                    continue
                if os.path.exists(destination):
                    self._show_error(
                        "Move",
                        "An item named “%s” already exists in the destination."
                        % os.path.basename(source_abs))
                    continue
                shutil.move(source_abs, destination)
                moved = True
        except (OSError, ValueError) as e:
            self._show_error("Move", e.strerror or str(e))
        finally:
            self._drag_source = None
            self._drag_target = None
            context.drag_finish(bool(moved), False, time_)
            if moved:
                self.rebuild_columns()

    def set_icon_size(self, size):
        """Finder-like Ctrl+=/-/0 zoom: rebuild columns with new icon size."""
        if size == self.icon_size:
            return
        self.icon_size = size
        self.rebuild_columns()

    def scroll_to_end(self):
        adj = self.scrolled.get_hadjustment()
        adj.set_value(adj.get_upper())
        if self.listboxes:
            last = self.listboxes[-1]
            last.grab_focus()
            if last.get_selected_row() is None:
                first = last.get_row_at_index(0)
                if first is not None and hasattr(first, "entry"):
                    last.select_row(first)
        return False

    # ---------- Finder file actions ----------

    def _row_path(self, listbox, row):
        if not hasattr(row, "entry"):
            return None
        try:
            index = self.listboxes.index(listbox)
        except ValueError:
            return None
        return os.path.join(self.chain[index], row.entry["name"])

    def _show_error(self, title, message):
        from mv_dialogs import alert
        alert(self, title, secondary=message,
              msg_type=Gtk.MessageType.ERROR,
              buttons=[("OK", Gtk.ResponseType.OK)])

    def _selected_path(self):
        # Finder actions operate on the column that currently owns keyboard focus.
        # Older columns may retain GTK selection while focus moves right, so do
        # not let a stale selection shadow the actionable row.
        index = self.focus_column_index()
        if index is not None:
            listbox = self.listboxes[index]
            row = listbox.get_selected_row()
            if row is not None:
                path = self._row_path(listbox, row)
                if path:
                    return path
        for listbox in reversed(self.listboxes):
            row = listbox.get_selected_row()
            if row is not None:
                path = self._row_path(listbox, row)
                if path:
                    return path
        return None

    def _new_folder(self):
        """Create a Finder-style New Folder in the current directory."""
        target_dir = self.chain[-1]
        try:
            result = subprocess.run(
                ["mv-newfolder", target_dir],
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
        except (OSError, subprocess.CalledProcessError) as e:
            message = getattr(e, "stderr", None) or getattr(e, "strerror", None) or str(e)
            self._show_error("New Folder", message.strip() or "Could not create folder.")
            return
        created = result.stdout.strip()
        self.rebuild_columns()
        # Keep the new folder actionable after refresh when it is visible in
        # the current column.  This mirrors Finder's immediate post-create focus.
        for listbox in self.listboxes[-1:]:
            for row in listbox.get_children():
                if getattr(row, "entry", {}).get("name") == os.path.basename(created):
                    listbox.select_row(row)
                    listbox.grab_focus()
                    return

    def _copy_selected(self):
        path = self._selected_path()
        if not path:
            return
        try:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_uris([Gio.File.new_for_path(path).get_uri()])
            clipboard.store()
            self._clipboard_mode = "copy"
        except Exception as e:
            self._show_error("Copy", str(e))

    def _paste(self):
        try:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            uris = clipboard.wait_for_uris() or []
        except Exception as e:
            self._show_error("Paste", str(e))
            return
        if not uris:
            return
        target_dir = self.chain[-1]
        pasted = False
        try:
            for uri in uris:
                source = Gio.File.new_for_uri(uri).get_path()
                if not source or not os.path.exists(source):
                    continue
                destination = os.path.join(
                    target_dir, os.path.basename(os.path.abspath(source)))
                if os.path.abspath(source) == os.path.abspath(destination):
                    continue
                if os.path.exists(destination):
                    self._show_error(
                        "Paste",
                        "An item named “%s” already exists in the destination."
                        % os.path.basename(source))
                    continue
                if os.path.isdir(source):
                    shutil.copytree(source, destination)
                else:
                    shutil.copy2(source, destination)
                pasted = True
        except (OSError, ValueError) as e:
            self._show_error("Paste", e.strerror or str(e))
        if pasted:
            self.rebuild_columns()

    def _is_archive_path(path):
    """Return whether PATH has an archive suffix supported by Archive Utility."""
    from mv_archive_utility import ARCHIVE_SUFFIXES
    lower = os.path.basename(path).lower()
    return any(lower.endswith(suffix.lower()) for suffix in ARCHIVE_SUFFIXES)


def _archive_destination(self, path):
        """Choose a Finder-style adjacent .zip without overwriting an existing archive."""
        base = os.path.basename(os.path.abspath(path))
        candidate = os.path.join(os.path.dirname(os.path.abspath(path)), base + ".zip")
        if not os.path.exists(candidate):
            return candidate
        stem = base + " "
        n = 2
        while os.path.exists(os.path.join(
                os.path.dirname(os.path.abspath(path)), "%s%d.zip" % (stem, n))):
            n += 1
        return os.path.join(
            os.path.dirname(os.path.abspath(path)), "%s%d.zip" % (stem, n))

    def _archive_compress(self, path):
        """Compress the selected item through the shared Archive Utility backend."""
        if not path or not os.path.exists(path):
            return
        destination = self._archive_destination(path)
        try:
            subprocess.run(
                ["mv-archive-utility", "--new", destination, path],
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
        except (OSError, subprocess.CalledProcessError) as e:
            message = getattr(e, "stderr", None) or getattr(e, "strerror", None) or str(e)
            self._show_error("Compress", message.strip() or "Could not create archive.")
            return
        self.rebuild_columns()

    def _archive_extract_here(self, path):
        """Extract an archive beside itself through the shared Archive Utility backend."""
        if not path or not os.path.isfile(path):
            return
        try:
            subprocess.run(
                ["mv-archive-utility", "--here", "--no-open", path],
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
        except (OSError, subprocess.CalledProcessError) as e:
            message = getattr(e, "stderr", None) or getattr(e, "strerror", None) or str(e)
            self._show_error("Extract Here", message.strip() or "Could not extract archive.")
            return
        self.rebuild_columns()

    def _get_info(self, path):
        if not path:
            return
        try:
            subprocess.Popen(["mv-getinfo", path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._show_error("Get Info", e.strerror or str(e))

    def _rename(self, path):
        if not path or not os.path.exists(path):
            return
        from mv_dialogs import entry_dialog

        def validate_name(name):
            if os.path.basename(name) != name or name in (".", ".."):
                return "Please enter a single valid file name."
            target = os.path.join(os.path.dirname(path), name)
            if os.path.abspath(target) != os.path.abspath(path) and os.path.exists(target):
                return "An item with that name already exists."
            return None

        new_name = entry_dialog(
            self,
            "Rename",
            label="Name:",
            initial=os.path.basename(path),
            ok_label="Rename",
            validator=validate_name,
        )
        if new_name is None or new_name == os.path.basename(path):
            return
        target = os.path.join(os.path.dirname(path), new_name)
        try:
            os.rename(path, target)
            self.rebuild_columns()
        except OSError as e:
            self._show_error("Rename", e.strerror or str(e))

    def _move_to_trash(self, path, confirm=False):
        """Move an item to Trash using Finder's non-destructive delete semantics.

        Finder's Delete/Command+Delete moves the selection to Trash without a
        confirmation sheet. The destructive confirmation belongs to Empty
        Trash, not to this operation. Keep an explicit confirm hook for any
        future caller that genuinely needs it, but the normal Finder action
        must remain silent.
        """
        if not path or not os.path.exists(path):
            return
        if confirm:
            from mv_dialogs import confirm_delete
            response = confirm_delete(
                self,
                "Move “%s” to the Trash?" % os.path.basename(path),
                "The item will be moved to the Trash.",
                delete_label="Move to Trash")
            if response != Gtk.ResponseType.OK:
                return
        try:
            Gio.File.new_for_path(path).trash(None)
        except Exception as e:
            if shutil.which("trash-put"):
                try:
                    subprocess.run(["trash-put", path], check=True,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except Exception as fallback_error:
                    self._show_error("Move to Trash", str(fallback_error))
                    return
            else:
                self._show_error("Move to Trash", str(e))
                return
        self.rebuild_columns()

    def _quick_look(self, path):
        """Open the selected item in the lightweight Mavericks Quick Look surface."""
        if not path or not os.path.exists(path):
            return
        try:
            subprocess.Popen(["mv-quicklook", path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._show_error("Quick Look", e.strerror or str(e))

    def _open_with(self, path):
        """Present the installed applications that can open PATH.

        xdg-open is intentionally not used here: it resolves the default
        application and therefore cannot implement Finder's Open With…
        interaction. Gio provides the desktop/MIME registry we already use
        for the project's file associations, so the chooser stays native,
        lightweight, and consistent with the rest of this GTK3 frontend.
        """
        if not path or not os.path.exists(path):
            return
        try:
            content_type, uncertain = Gio.content_type_guess(path, None, 0)
            apps = Gio.AppInfo.get_all_for_type(content_type) if content_type else []
            # Keep the chooser deterministic and remove duplicate desktop IDs.
            unique = {}
            for app in apps:
                try:
                    app_id = app.get_id() or app.get_name()
                    if app_id and app_id not in unique:
                        unique[app_id] = app
                except Exception:
                    continue
            apps = sorted(unique.values(),
                          key=lambda app: (app.get_display_name() or app.get_name() or "").lower())
        except Exception as e:
            self._show_error("Open With", "Could not enumerate applications: %s" % e)
            return

        if not apps:
            self._show_error(
                "Open With",
                "No installed application can open this item.")
            return

        dialog = Gtk.Dialog(title="Open With", transient_for=self,
                            flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Open", Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(8)
        area.set_margin_top(12)
        area.set_margin_bottom(12)
        area.set_margin_start(12)
        area.set_margin_end(12)
        area.pack_start(
            Gtk.Label(label="Choose an application to open this item:",
                      xalign=0),
            False, False, 0)

        store = Gtk.ListStore(object, str)
        for app in apps:
            name = app.get_display_name() or app.get_name() or "Application"
            store.append([app, name])

        tree = Gtk.TreeView(model=store)
        tree.set_headers_visible(False)
        tree.set_vexpand(True)
        tree.set_size_request(360, min(320, max(120, 34 * len(apps))))
        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn("Application", renderer, text=1)
        tree.append_column(column)
        selection = tree.get_selection()
        selection.select_path(Gtk.TreePath.new_first())
        tree.connect("row-activated",
                     lambda *_args: dialog.response(Gtk.ResponseType.OK))
        area.pack_start(tree, True, True, 0)

        dialog.show_all()
        response = dialog.run()
        model, iterator = selection.get_selected()
        selected = model.get_value(iterator, 0) if iterator is not None else None
        dialog.destroy()

        if response != Gtk.ResponseType.OK or selected is None:
            return
        try:
            selected.launch([Gio.File.new_for_path(path)], None)
        except Exception as e:
            self._show_error(
                "Open With",
                "Could not open “%s”: %s" % (
                    selected.get_display_name() or "the selected application", e))

    def _popup_context_menu(self, listbox, row, event):
        path = self._row_path(listbox, row)
        if not path:
            return
        listbox.select_row(row)
        listbox.grab_focus()
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label="Open")
        item.connect("activate", lambda _i: self._activate_path(path))
        menu.append(item)
        item = Gtk.MenuItem(label="Copy")
        item.connect("activate", lambda _i: self._copy_selected())
        menu.append(item)
        item = Gtk.MenuItem(label="Get Info")
        item.connect("activate", lambda _i: self._get_info(path))
        menu.append(item)
        item = Gtk.MenuItem(label="Rename")
        item.connect("activate", lambda _i: self._rename(path))
        menu.append(item)
        item = Gtk.MenuItem(label="Move to Trash")
        item.connect("activate", lambda _i: self._move_to_trash(path))
        menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        item = Gtk.MenuItem(label="Quick Look")
        item.connect("activate", lambda _i: self._quick_look(path))
        menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        item = Gtk.MenuItem(label="Open With…")
        item.connect("activate", lambda _i: self._open_with(path))
        menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        item = Gtk.MenuItem(label="Compress")
        item.connect("activate", lambda _i: self._archive_compress(path))
        menu.append(item)
        if os.path.isfile(path) and _is_archive_path(path):
            item = Gtk.MenuItem(label="Extract Here")
            item.connect("activate", lambda _i: self._archive_extract_here(path))
            menu.append(item)
        menu.show_all()
        menu.popup_at_pointer(event)

    def on_column_button_press(self, listbox, event):
        if event.button != 3:
            return False
        try:
            row = listbox.get_row_at_y(int(event.y))
        except Exception:
            row = None
        if row is not None:
            self._popup_context_menu(listbox, row, event)
            return True
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label="Paste")
        item.connect("activate", lambda _i: self._paste())
        menu.append(item)
        item = Gtk.MenuItem(label="New Folder")
        item.connect("activate", lambda _i: self._new_folder())
        menu.append(item)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def _activate_path(self, path):
        if os.path.isdir(path):
            parent = os.path.dirname(path)
            for i, directory in enumerate(self.chain):
                if os.path.abspath(directory) == os.path.abspath(parent):
                    new_chain = self.chain[:i + 1] + [path]
                    if new_chain == self.chain:
                        return
                    self.history = self.history[:self.history_index + 1] + [new_chain]
                    self.history_index += 1
                    self.chain = new_chain
                    self.rebuild_columns()
                    return
            target = os.path.abspath(path)
            if target == self.chain[-1]:
                return
            self.history = self.history[:self.history_index + 1] + [[target]]
            self.history_index += 1
            self.chain = [target]
            self.rebuild_columns()
            return
        try:
            subprocess.Popen(["xdg-open", path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._show_error("Open", e.strerror or str(e))

    # ---------- interaction ----------

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "entry"):
            return
        entry = row.entry
        index = self.listboxes.index(listbox)
        path = os.path.join(self.chain[index], entry["name"])
        if os.path.isdir(path):
            # A normal Finder folder-open is a history navigation event.
            # Keep the complete column chain so Back/Forward restores the
            # exact visible depth rather than only the last directory.
            new_chain = self.chain[:index + 1] + [path]
            if new_chain == self.chain:
                return
            self.history = self.history[:self.history_index + 1] + [new_chain]
            self.history_index += 1
            self.chain = new_chain
            self.rebuild_columns()
            return
        self._activate_path(path)

    def _empty_trash(self):
        """Invoke Finder's native Empty Trash surface with confirmation."""
        try:
            subprocess.Popen(["mv-empty-trash"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._show_error("Empty Trash", e.strerror or str(e))

    def on_open_thunar(self, _button):
        target = self.chain[-1]
        opener = ["thunar", target] if shutil.which("thunar") else ["xdg-open", target]
        try:
            subprocess.Popen(opener, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self._show_error("Open in Thunar", e.strerror or str(e))

    def on_key_press(self, _widget, event):
        key = Gdk.keyval_name(event.keyval)
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and key in ("equal", "plus", "KP_Add"):
            self.set_icon_size(zoom_step(self.icon_size, +1))
            return True
        if ctrl and key in ("minus", "KP_Subtract"):
            self.set_icon_size(zoom_step(self.icon_size, -1))
            return True
        if ctrl and key in ("0", "KP_0"):
            self.set_icon_size(ZOOM_DEFAULT)
            return True
        if key == "Escape":
            # Escape is a cancel/navigation key in Finder, not Quit.  Keep
            # the Finder window alive; transient controls handle their own
            # cancellation through GTK focus/event handling.
            return False
        if key == "F2":
            path = self._selected_path()
            if path:
                self._rename(path)
                return True
        if key in ("space", "Space"):
            path = self._selected_path()
            if path:
                self._quick_look(path)
                return True
        if key in ("Delete", "KP_Delete"):
            path = self._selected_path()
            if path:
                self._move_to_trash(path)
                return True
        if ctrl and key in ("c", "C"):
            self._copy_selected()
            return True
        if ctrl and key in ("v", "V"):
            self._paste()
            return True
        if ctrl and key in ("i", "I"):
            path = self._selected_path()
            if path:
                self._get_info(path)
                return True
        if not self.listboxes:
            return False
        if key == "Right":
            index = self.focus_column_index()
            if index is not None and index + 1 < len(self.listboxes):
                target = self.listboxes[index + 1]
                target.grab_focus()
                if target.get_selected_row() is None:
                    first = target.get_row_at_index(0)
                    if first is not None and hasattr(first, "entry"):
                        target.select_row(first)
            return True
        if key == "Left":
            index = self.focus_column_index()
            if index is not None and index > 0:
                target = self.listboxes[index - 1]
                target.grab_focus()
                if target.get_selected_row() is None:
                    first = target.get_row_at_index(0)
                    if first is not None and hasattr(first, "entry"):
                        target.select_row(first)
            return True
        if key == "BackSpace":
            if self.history_index > 0:
                self.on_back(None)
            return True
        return False

    def focus_column_index(self):
        focus = self.get_focus()
        for i, listbox in enumerate(self.listboxes):
            if focus is listbox or (focus is not None and
                                    focus.get_ancestor(Gtk.ListBox) is listbox):
                return i
        return None



def build_finder_menu(app, app_name, get_window, add_action):
    def w():
        return get_window()

    add_action("back", lambda: w().on_back(None) if w() else None)
    add_action("forward", lambda: w().on_forward(None) if w() else None)
    add_action("home", lambda: w().on_home(None) if w() else None)
    add_action("open-thunar", lambda: w().on_open_thunar(None) if w() else None)
    add_action("open-with", lambda: w()._open_with(w()._selected_path()) if w() and w()._selected_path() else None)
    add_action("compress", lambda: w()._archive_compress(w()._selected_path()) if w() and w()._selected_path() else None)
    add_action("extract-here", lambda: w()._archive_extract_here(w()._selected_path()) if w() and w()._selected_path() else None)
    add_action("copy", lambda: w()._copy_selected() if w() else None)
    add_action("new-folder", lambda: w()._new_folder() if w() else None)
    add_action("paste", lambda: w()._paste() if w() else None)
    add_action("get-info", lambda: w()._get_info(w()._selected_path()) if w() and w()._selected_path() else None)
    add_action("rename", lambda: w()._rename(w()._selected_path()) if w() and w()._selected_path() else None)
    add_action("move-to-trash", lambda: w()._move_to_trash(w()._selected_path()) if w() and w()._selected_path() else None)
    add_action("focus-search", lambda: w().search_entry.grab_focus() if w() else None)
    add_action("empty-trash", lambda: w()._empty_trash() if w() else None)
    add_action("zoom-in", lambda: w().set_icon_size(zoom_step(w().icon_size, 1))
               if w() else None)
    add_action("zoom-out", lambda: w().set_icon_size(zoom_step(w().icon_size, -1))
               if w() else None)
    add_action("zoom-default", lambda: w().set_icon_size(ZOOM_DEFAULT) if w() else None)
    add_action("close", lambda: w().destroy() if w() else None)
    add_action("quit", app.quit)

    menu = Gio.Menu()
    app_menu = Gio.Menu()
    app_menu.append("About Finder", "app.about")
    app_menu.append("Empty Trash", "app.empty-trash")
    app_menu.append("Quit Finder", "app.quit")
    menu.append_submenu("Finder", app_menu)

    edit_menu = Gio.Menu()
    edit_menu.append("Copy", "app.copy")
    edit_menu.append("Paste", "app.paste")
    edit_menu.append("Get Info", "app.get-info")
    edit_menu.append("Rename", "app.rename")
    edit_menu.append("Move to Trash", "app.move-to-trash")
    edit_menu.append("Open With…", "app.open-with")
    edit_menu.append("Compress", "app.compress")
    edit_menu.append("Extract Here", "app.extract-here")
    menu.append_submenu("Edit", edit_menu)

    file_menu = Gio.Menu()
    file_menu.append("New Folder", "app.new-folder")
    file_menu.append("Open in Thunar…", "app.open-thunar")
    file_menu.append("Close Window", "app.close")
    menu.append_submenu("File", file_menu)

    view_menu = Gio.Menu()
    view_menu.append("Zoom In", "app.zoom-in")
    view_menu.append("Zoom Out", "app.zoom-out")
    view_menu.append("Actual Size", "app.zoom-default")
    menu.append_submenu("View", view_menu)

    go_menu = Gio.Menu()
    go_menu.append("Back", "app.back")
    go_menu.append("Forward", "app.forward")
    go_menu.append("Home", "app.home")
    go_menu.append("Go to Folder…", "app.go-to-folder")
    add_action("go-to-folder", lambda: get_window().on_go_to_folder() if get_window() else None)
    app.set_accels_for_action("app.go-to-folder", ["<Super><Shift>g"])
    app.set_accels_for_action("app.new-folder", ["<Super><Shift>n"])
    app.set_accels_for_action("app.back", ["<Super>bracketleft"])
    app.set_accels_for_action("app.forward", ["<Super>bracketright"])
    app.set_accels_for_action("app.copy", ["<Super>c"])
    app.set_accels_for_action("app.paste", ["<Super>v"])
    app.set_accels_for_action("app.get-info", ["<Super>i"])
    app.set_accels_for_action("app.rename", ["Return"])
    app.set_accels_for_action("app.move-to-trash", ["<Super>Delete"])
    app.set_accels_for_action("app.empty-trash", ["<Super><Shift>Delete"])
    app.set_accels_for_action("app.focus-search", ["<Super>f"])
    app.set_accels_for_action("app.open-with", ["<Super>o", "<Super><Shift>o"])
    app.set_accels_for_action("app.get-info", ["<Super>i", "<Super><Shift>i"])
    app.set_accels_for_action("app.open-thunar", ["<Super>e"])
    menu.append_submenu("Go", go_menu)

    window_menu = Gio.Menu()
    window_menu.append("Close Window", "app.close")
    menu.append_submenu("Window", window_menu)
    return menu

def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print("usage: mv-finder-columns FOLDER\n"
              "  Finder-like column view browser for FOLDER with native Finder actions;\n"
              "  Open in Thunar remains available for the full Thunar surface.")
        return 0
    if len(args) != 1:
        print("usage: mv-finder-columns FOLDER", file=sys.stderr)
        return 2
    root = args[0]
    if not os.path.isdir(root):
        print("mv-finder-columns: not a folder: %s" % root, file=sys.stderr)
        return 2
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    # GApplication treats positional argv entries as files to open; without
    # HANDLES_OPEN it aborts before activate ever runs. The folder is already
    # parsed into `root` above (same class of bug as mv-preview, f643a2d).
    return run_application(
        "com.mavlinos.Finder", "Finder", lambda: ColumnsWindow(root),
        [sys.argv[0]], build_finder_menu)


if __name__ == "__main__":
    sys.exit(main())
