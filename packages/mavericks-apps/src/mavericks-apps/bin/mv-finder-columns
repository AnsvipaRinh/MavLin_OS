#!/usr/bin/env python3
"""mv-finder-columns — Finder column-view navigation companion.

Thunar has no column view and the thunarx-3 API exposes no view provider
(see docs/DECISIONS.md), so the Mavericks column experience lives here:
a multi-pane column browser (folder → subfolder → …) with the same visual
language as the other mv-* apps. Navigation and opening only — all file
management (rename/delete/copy) is handed off to Thunar ("Open in Thunar"
button / opening a folder). On-demand single-shot process: no daemon,
no indexer, no polling.

License: GPL-2.0-or-later."""
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf  # noqa: E402

COLUMN_WIDTH = 240
MAX_COLUMNS = 24  # horizontal scroll still handles it; cap is a safety net

# Finder-like icon-size ladder (Ctrl+= / Ctrl+- / Ctrl+0, same as
# mv-finder-search and Thunar's in-window zoom)
ZOOM_LADDER = [16, 22, 32, 48]
ZOOM_DEFAULT = ZOOM_LADDER[0]


def zoom_step(size, delta):
    """Next/previous step on the zoom ladder (clamped). Unknown sizes start at default."""
    base = ZOOM_LADDER.index(size) if size in ZOOM_LADDER \
        else ZOOM_LADDER.index(ZOOM_DEFAULT)
    index = base + delta
    index = max(0, min(len(ZOOM_LADDER) - 1, index))
    return ZOOM_LADDER[index]


def list_entries(directory, include_hidden=False):
    """Entries of one column: folders first, then case-insensitive name.

    Raises OSError for unreadable directories (caller shows error state).
    """
    out = []
    with os.scandir(directory) as scan:
        for entry in scan:
            name = entry.name
            if not include_hidden and name.startswith("."):
                continue
            try:
                is_dir = entry.is_dir(follow_symlinks=False)
            except OSError:
                continue
            try:
                st = entry.stat(follow_symlinks=False)
                size = 0 if is_dir else st.st_size
            except OSError:
                size = 0
            out.append({"name": name, "is_dir": is_dir, "size": size})
    out.sort(key=lambda e: (not e["is_dir"], e["name"].casefold(), e["name"]))
    return out


def icon_for(name, is_dir):
    """Icon name for a row; never raises."""
    if is_dir:
        return "folder"
    import mimetypes
    mime = mimetypes.guess_type(name)[0]
    if mime:
        try:
            names = Gio.content_type_get_icon(mime).get_names()
            try:
                theme = Gtk.IconTheme.get_default()
            except Exception:
                theme = None
            for n in names:
                if n and (theme is None or theme.has_icon(n)):
                    return n
        except Exception:
            pass
    return "text-x-generic"


def load_icon_pixbuf(name, size):
    """Pixbuf for an icon name; falls back to text-x-generic, never raises."""
    try:
        theme = Gtk.IconTheme.get_default()
        if theme is not None:
            try:
                return theme.load_icon(name, size,
                                       Gtk.IconLookupFlags.GENERIC_FALLBACK)
            except Exception:
                pass
            try:
                return theme.load_icon("text-x-generic", size,
                                       Gtk.IconLookupFlags.GENERIC_FALLBACK)
            except Exception:
                pass
    except Exception:
        pass
    return None


class ColumnRow(Gtk.ListBoxRow):
    def __init__(self, entry, icon_size=ZOOM_DEFAULT):
        super().__init__()
        self.entry = entry
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_margin_top(3)
        box.set_margin_bottom(3)
        box.set_margin_start(6)
        box.set_margin_end(6)
        pixbuf = load_icon_pixbuf(icon_for(entry["name"], entry["is_dir"]),
                                  icon_size)
        if pixbuf is not None:
            img = Gtk.Image.new_from_pixbuf(pixbuf)
        else:
            img = Gtk.Image()
        label = Gtk.Label(label=entry["name"])
        label.set_ellipsize(3)  # middle
        label.set_halign(Gtk.Align.START)
        box.pack_start(img, False, False, 0)
        box.pack_start(label, False, False, 0)
        self.add(box)


class ColumnsWindow(Gtk.Window):
    def __init__(self, root):
        super().__init__(title=os.path.basename(root) or root)
        self.root = os.path.abspath(root)
        self.chain = [self.root]
        self.listboxes = []
        self.icon_size = ZOOM_DEFAULT

        self.set_default_size(760, 480)
        self.set_position(Gtk.WindowPosition.CENTER)

        self._install_finder_css()

        hb = Gtk.HeaderBar(title=self.get_title(), show_close_button=True)
        hb.set_subtitle("Finder")
        self.set_titlebar(hb)

        self.back_button = Gtk.Button(label="‹")
        self.back_button.set_tooltip_text("Back")
        self.back_button.connect("clicked", self.on_back)
        hb.pack_start(self.back_button)

        self.forward_button = Gtk.Button(label="›")
        self.forward_button.set_tooltip_text("Forward")
        self.forward_button.connect("clicked", self.on_forward)
        hb.pack_start(self.forward_button)

        up_button = Gtk.Button(label="↑")
        up_button.set_tooltip_text("Enclosing Folder")
        up_button.connect("clicked", self.on_up)
        hb.pack_start(up_button)

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search")
        self.search_entry.set_width_chars(18)
        self.search_entry.connect("activate", self.on_search)
        hb.pack_end(self.search_entry)

        open_tb = Gtk.Button(label="Open in Thunar")
        open_tb.set_tooltip_text("Open current location in Thunar")
        open_tb.connect("clicked", self.on_open_thunar)
        hb.pack_end(open_tb)

        self.columns_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)

        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        self.scrolled.add(self.columns_box)

        self.error_label = Gtk.Label()
        self.error_label.get_style_context().add_class("dim-label")
        self.error_label.set_justify(Gtk.Justification.CENTER)

        self.status_label = Gtk.Label(label="")
        self.status_label.get_style_context().add_class("dim-label")
        self.status_label.set_halign(Gtk.Align.START)
        status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        status.set_border_width(4)
        status.pack_start(self.status_label, False, False, 0)

        self.overlay = Gtk.Overlay()
        self.overlay.add(self.scrolled)
        self.overlay.add_overlay(self.error_label)
        self.overlay.set_overlay_pass_through(self.error_label, True)

        content = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        content.set_position(175)
        self.sidebar = self._build_sidebar()
        content.pack1(self.sidebar, False, False)
        content.pack2(self.overlay, True, False)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.pack_start(content, True, True, 0)
        vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
        vbox.pack_start(status, False, False, 0)
        self.add(vbox)

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

        self.show_all()
        self.rebuild_columns()

    def _install_finder_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(b"""
        .mavericks-finder-sidebar { background: #f2f2f2; border-right: 1px solid #c8c8c8; }
        .mavericks-finder-section { color: #777; font-size: 10px; font-weight: bold; padding: 8px 8px 3px; }
        .mavericks-finder-row { padding: 3px 7px; border-radius: 3px; }
        .mavericks-finder-row:selected { background: #6f8fbd; color: white; }
        .mavericks-finder-toolbar { background: #e2e2e2; }
        .mavericks-finder-column { background: #fff; }
        .mavericks-finder-column row { padding: 2px 5px; border-radius: 2px; }
        .mavericks-finder-column row:selected { background: #6f8fbd; color: white; }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _build_sidebar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("mavericks-finder-sidebar")
        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        listbox.connect("row-activated", self._sidebar_activated)
        self.sidebar_list = listbox
        for title, entries in (
                ("FAVORITES", [
                    ("Home", os.path.expanduser("~")),
                    ("Desktop", os.path.expanduser("~/Desktop")),
                    ("Documents", os.path.expanduser("~/Documents")),
                    ("Downloads", os.path.expanduser("~/Downloads")),
                    ("Pictures", os.path.expanduser("~/Pictures")),
                ]),
                ("DEVICES", [("File System", "/")])):
            label = Gtk.Label(label=title, xalign=0)
            label.get_style_context().add_class("mavericks-finder-section")
            box.pack_start(label, False, False, 0)
            for name, path in entries:
                if not os.path.isdir(path):
                    continue
                row = Gtk.ListBoxRow()
                row.path = path
                row.add(Gtk.Label(label="  " + name, xalign=0))
                row.get_style_context().add_class("mavericks-finder-row")
                listbox.add(row)
        box.pack_start(listbox, True, True, 0)
        return box

    def _sidebar_activated(self, _listbox, row):
        if hasattr(row, "path") and os.path.isdir(row.path):
            self.chain = [os.path.abspath(row.path)]
            self.history = self.history[:self.history_index + 1] + [self.chain[0]]
            self.history_index += 1
            self.rebuild_columns()

    def on_search(self, _entry):
        query = self.search_entry.get_text().strip()
        if not query:
            return
        target = self.chain[-1]
        try:
            subprocess.Popen(["mv-finder-search", target, query],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def on_back(self, _button):
        if self.history_index > 0:
            self.history_index -= 1
            self.chain = [self.history[self.history_index]]
            self.rebuild_columns()

    def on_forward(self, _button):
        if self.history_index + 1 < len(self.history):
            self.history_index += 1
            self.chain = [self.history[self.history_index]]
            self.rebuild_columns()

    def on_up(self, _button):
        parent = os.path.dirname(self.chain[-1])
        if parent and parent != self.chain[-1]:
            self.history = self.history[:self.history_index + 1] + [parent]
            self.history_index += 1
            self.chain = [parent]
            self.rebuild_columns()

    # ---------- column construction ----------

    def rebuild_columns(self, keep_depth=None):
        for child in self.columns_box.get_children():
            self.columns_box.remove(child)
        self.listboxes = []

        if keep_depth is not None:
            self.chain = self.chain[:keep_depth]

        columns = []
        last_error = None
        for directory in self.chain:
            try:
                columns.append((directory, list_entries(directory)))
            except OSError as e:
                columns.append((directory, None))
                if directory == self.chain[-1]:
                    last_error = e

        for directory, entries in columns:
            self.append_column(directory, entries)

        last_entries = columns[-1][1]
        if last_entries is None:
            self.error_label.set_text(
                "Could not open “%s”\n%s" % (
                    self.chain[-1],
                    (last_error.strerror if last_error else None) or "permission denied"))
            self.status_label.set_text("Folder unavailable")
        else:
            self.error_label.set_text("")
            count = len(last_entries)
            name = os.path.basename(self.chain[-1]) or self.chain[-1]
            self.status_label.set_text(
                "%d item%s in “%s”" % (count, "" if count == 1 else "s", name))

        self.columns_box.show_all()
        self.error_label.set_visible(last_entries is None)
        # scroll to the newest (right-most) column
        GLib.idle_add(self.scroll_to_end)

    def append_column(self, directory, entries):
        if len(self.listboxes) >= MAX_COLUMNS:
            return
        listbox = Gtk.ListBox()
        listbox.set_size_request(COLUMN_WIDTH, -1)
        listbox.set_activate_on_single_click(False)
        listbox.connect("row-activated", self.on_row_activated)
        listbox.get_style_context().add_class("mavericks-finder-column")
        if entries:
            for entry in entries:
                listbox.add(ColumnRow(entry, self.icon_size))
        elif entries is None:
            error_row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="Cannot open")
            lbl.get_style_context().add_class("dim-label")
            error_row.add(lbl)
            listbox.add(error_row)
        separator = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        self.columns_box.pack_start(listbox, False, False, 0)
        self.columns_box.pack_start(separator, False, False, 0)
        self.listboxes.append(listbox)

    def set_icon_size(self, size):
        """Finder-like Ctrl+=/-/0 zoom: rebuild columns with new icon size."""
        if size == self.icon_size:
            return
        self.icon_size = size
        self.rebuild_columns()

    def scroll_to_end(self):
        adj = self.scrolled.get_hadjustment()
        adj.set_value(adj.get_upper())
        if self.listboxes:
            self.listboxes[-1].grab_focus()
        return False

    # ---------- interaction ----------

    def on_row_activated(self, listbox, row):
        if not hasattr(row, "entry"):
            return
        entry = row.entry
        index = self.listboxes.index(listbox)
        path = os.path.join(self.chain[index], entry["name"])
        if entry["is_dir"]:
            self.chain = self.chain[:index + 1]
            self.chain.append(path)
            self.rebuild_columns()
        else:
            try:
                subprocess.Popen(["xdg-open", path],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass

    def on_open_thunar(self, _button):
        target = self.chain[-1]
        opener = ["thunar", target] if shutil.which("thunar") else ["xdg-open", target]
        try:
            subprocess.Popen(opener, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def on_key_press(self, _widget, event):
        key = Gdk.keyval_name(event.keyval)
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and key in ("equal", "plus", "KP_Add"):
            self.set_icon_size(zoom_step(self.icon_size, +1))
            return True
        if ctrl and key in ("minus", "KP_Subtract"):
            self.set_icon_size(zoom_step(self.icon_size, -1))
            return True
        if ctrl and key in ("0", "KP_0"):
            self.set_icon_size(ZOOM_DEFAULT)
            return True
        if key == "Escape":
            self.destroy()
            return True
        if not self.listboxes:
            return False
        if key == "Right":
            index = self.focus_column_index()
            if index is not None and index + 1 < len(self.listboxes):
                self.listboxes[index + 1].grab_focus()
            return True
        if key == "Left":
            index = self.focus_column_index()
            if index is not None and index > 0:
                self.listboxes[index - 1].grab_focus()
            return True
        if key == "BackSpace":
            if len(self.chain) > 1:
                self.rebuild_columns(keep_depth=len(self.chain) - 1)
            return True
        return False

    def focus_column_index(self):
        focus = self.get_focus()
        for i, listbox in enumerate(self.listboxes):
            if focus is listbox or (focus is not None and
                                    focus.get_ancestor(Gtk.ListBox) is listbox):
                return i
        return None



def build_finder_menu(app, app_name, get_window, add_action):
    def w():
        return get_window()

    add_action("back", lambda: w().rebuild_columns(keep_depth=len(w().chain) - 1)
               if w() and len(w().chain) > 1 else None)
    add_action("home", lambda: (setattr(w(), "chain", [os.path.expanduser("~")]),
                                w().rebuild_columns()) if w() else None)
    add_action("open-thunar", lambda: w().on_open_thunar(None) if w() else None)
    add_action("zoom-in", lambda: w().set_icon_size(zoom_step(w().icon_size, 1))
               if w() else None)
    add_action("zoom-out", lambda: w().set_icon_size(zoom_step(w().icon_size, -1))
               if w() else None)
    add_action("zoom-default", lambda: w().set_icon_size(ZOOM_DEFAULT) if w() else None)
    add_action("close", lambda: w().destroy() if w() else None)
    add_action("quit", app.quit)

    menu = Gio.Menu()
    app_menu = Gio.Menu()
    app_menu.append("About Finder", "app.about")
    app_menu.append("Quit Finder", "app.quit")
    menu.append_submenu("Finder", app_menu)

    file_menu = Gio.Menu()
    file_menu.append("Open in Thunar…", "app.open-thunar")
    file_menu.append("Close Window", "app.close")
    menu.append_submenu("File", file_menu)

    view_menu = Gio.Menu()
    view_menu.append("Zoom In", "app.zoom-in")
    view_menu.append("Zoom Out", "app.zoom-out")
    view_menu.append("Actual Size", "app.zoom-default")
    menu.append_submenu("View", view_menu)

    go_menu = Gio.Menu()
    go_menu.append("Back", "app.back")
    go_menu.append("Home", "app.home")
    menu.append_submenu("Go", go_menu)

    window_menu = Gio.Menu()
    window_menu.append("Close Window", "app.close")
    menu.append_submenu("Window", window_menu)
    return menu

def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print("usage: mv-finder-columns FOLDER\n"
              "  Finder-like column view browser for FOLDER (navigation only;\n"
              "  file management hands off to Thunar).")
        return 0
    if len(args) != 1:
        print("usage: mv-finder-columns FOLDER", file=sys.stderr)
        return 2
    root = args[0]
    if not os.path.isdir(root):
        print("mv-finder-columns: not a folder: %s" % root, file=sys.stderr)
        return 2
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    # GApplication treats positional argv entries as files to open; without
    # HANDLES_OPEN it aborts before activate ever runs. The folder is already
    # parsed into `root` above (same class of bug as mv-preview, f643a2d).
    return run_application(
        "com.mavlinos.Finder", "Finder", lambda: ColumnsWindow(root),
        [sys.argv[0]], build_finder_menu)


if __name__ == "__main__":
    sys.exit(main())
