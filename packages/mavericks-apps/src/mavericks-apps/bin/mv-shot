#!/usr/bin/env python3
"""mv-shot — Mavericks-like Screenshot (canonical objective #8).

Backend: xfce4-screenshooter (stills) + ffmpeg x11grab (screen recording).
Surfaces: region selection, active window, full screen, screenshot tools bar,
timed capture (-T), clipboard capture (-c), capture flash, and the floating
post-capture thumbnail with Mavericks actions. One-shot process, no daemon.

macOS-compatible flag subset: -i (region), -w (window), -m (full screen),
-T seconds (timer), -c (clipboard), -o file, --record, --toolbar,
--no-preview, --config, --version.
Config: ~/.config/mv-shot/config.ini — save_dir, show_preview,
preview_timeout, copy_to_clipboard, flash, countdown.
Save default: ~/Desktop with 'Screen Shot YYYY-MM-DD at HH.MM.SS.png'
(macOS 10.9 naming); ~/Pictures/Screenshots remains a valid override.
License: GPL-2.0-or-later."""
import os
import sys
import time
import shutil
import tempfile
import subprocess
import configparser

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango
    HAVE_GTK = True
except (ImportError, ValueError):
    HAVE_GTK = False

VERSION = "1.1"
APP = os.environ.get("MV_SHOT_BACKEND", "xfce4-screenshooter")
PREVIEW_APP = "mv-preview"
SAVE_DIR_DEFAULT = os.path.expanduser("~/Desktop")
LEGACY_SAVE_DIR = os.path.expanduser("~/Pictures/Screenshots")
MOVIES_DIR_DEFAULT = os.path.expanduser("~/Movies")
CONFIG_PATH = os.path.expanduser("~/.config/mv-shot/config.ini")
CONFIG_SECTIONS = ("defaults", "mv-shot", "screenshot", "shot")
THUMB_W, THUMB_H = 260, 146
MARGIN = 24

CONFIG_DEFAULTS = {
    "save_dir": SAVE_DIR_DEFAULT,
    "show_preview": "true",
    "preview_timeout": "5",
    "copy_to_clipboard": "false",
    "flash": "true",
    "countdown": "true",
}

MAVERICKS_CSS = b"""
window.mv-shot-float {
    background-color: rgba(246, 243, 238, 0.94);
    border: 1px solid #c9bfb0;
    border-radius: 6px;
}
.mv-thumb-frame {
    background: #ffffff;
    border: 1px solid #d8cfc0;
    border-radius: 3px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
}
.mv-shot-float .mv-caption {
    color: #4a4640;
    font-size: 9pt;
}
.mv-shot-float .mv-action {
    border: 1px solid #c3b8a7;
    border-radius: 4px;
    padding: 4px 8px;
    color: #2f2b26;
}
.mv-shot-float .mv-action:hover {
    background-image: none;
    background-color: #007aff;
    border-color: #007aff;
    color: #ffffff;
}
.mv-shot-float .mv-action.primary {
    background-image: none;
    background-color: #007aff;
    border-color: #0069d9;
    color: #ffffff;
}
.mv-shot-float .mv-action.primary:hover {
    background-color: #0056cc;
}
.mv-tools-bar {
    background-image: linear-gradient(180deg, #f7f4ef 0%, #e3dcd0 100%);
    border: 1px solid #b8ae9d;
