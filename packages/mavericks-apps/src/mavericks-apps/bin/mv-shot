.mv-timer-box {
    background-color: rgba(38, 34, 30, 0.86);
    border-radius: 10px;
}
.mv-timer-label {
    color: #ffffff;
    font-size: 34pt;
    font-weight: 300;
}
"""


def _css_provider():
    """Return a provider carrying the shared screenshot CSS (never fatal)."""
    provider = Gtk.CssProvider()
    try:
        provider.load_from_data(MAVERICKS_CSS)
    except Exception:
        pass
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    return provider


def _truthy(value, fallback=True):
    """Coerce a config value to bool without raising on typos."""
    if value is None:
        return fallback
    try:
        return configparser.ConfigParser.BOOLEAN_STATES[str(value).strip().lower()]
    except KeyError:
        return fallback


def _intish(value, fallback=0):
    """Coerce a config value to int without raising on typos."""
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return fallback


def _config_section(config):
    """Return the config section to read, tolerating a renamed section."""
    for name in CONFIG_SECTIONS:
        if config.has_section(name):
            return name
    sections = config.sections()
    return sections[0] if sections else None


def load_config():
    """Load configuration from file. An unreadable or malformed file yields
    an empty parser rather than partial state, so resolve_settings can fall
    back per option."""
    config = configparser.ConfigParser()
    if os.path.isfile(CONFIG_PATH):
        try:
            config.read(CONFIG_PATH)
        except Exception:
            pass
    return config


def resolve_settings(config):
    """Resolve settings into a plain dict. Malformed values degrade to the
    default and are reported as warnings instead of raising a traceback."""
    section = _config_section(config)
    warnings = []
    settings = {}

    def raw(option):
        if section is not None and config.has_option(section, option):
            return config[section].get(option)
        return CONFIG_DEFAULTS[option]

    for option in ("save_dir",):
        value = str(raw(option)).strip() or CONFIG_DEFAULTS[option]
        settings[option] = os.path.expanduser(value)

    for option in ("show_preview", "copy_to_clipboard", "flash", "countdown"):
        given = str(raw(option)).strip().lower()
        try:
            configparser.ConfigParser.BOOLEAN_STATES[given]
            settings[option] = _truthy(given)
        except KeyError:
            warnings.append("%s: not a boolean (%r); using %s" % (
                option, given, CONFIG_DEFAULTS[option]))
            settings[option] = _truthy(CONFIG_DEFAULTS[option])

    given = str(raw("preview_timeout")).strip()
    if given.lstrip("-").isdigit():
        settings["preview_timeout"] = _intish(given, 5)
    else:
        warnings.append("preview_timeout: not an integer (%r); using 5" % given)
        settings["preview_timeout"] = 5

    settings["preview_timeout"] = max(0, min(settings["preview_timeout"], 120))
    return settings, warnings


def ensure_dir(path):
    """Create a directory if needed, returning True when it is usable."""
    try:
        os.makedirs(path, exist_ok=True)
        return os.access(path, os.W_OK)
    except Exception:
        return False


def resolve_save_dir(save_dir):
    """Return a writable save directory, falling back to ~/Pictures."""
    if ensure_dir(save_dir):
        return save_dir
    if save_dir != LEGACY_SAVE_DIR and ensure_dir(LEGACY_SAVE_DIR):
        return LEGACY_SAVE_DIR
    return None


def mavericks_stem(when=None):
    """macOS 10.9 screenshot name stem: 'Screen Shot 2026-10-06 at 04.21.30'."""
    when = time.localtime() if when is None else when
    return "Screen Shot %s at %s" % (time.strftime("%Y-%m-%d", when),
                                     time.strftime("%H.%M.%S", when))


def unique_path(directory, stem, ext):
    """Return a non-colliding path, macOS style: name, 'name 2', 'name 3'."""
    candidate = os.path.join(directory, stem + ext)
    counter = 2
    while os.path.exists(candidate):
        candidate = os.path.join(directory, "%s %d%s" % (stem, counter, ext))
        counter += 1
    return candidate


def run(cmd):
    """Run command and return CompletedProcess."""
    return subprocess.run(cmd)


def check_backend_available():
    """Check if the stills backend is available."""
    try:
        subprocess.run([APP, "--help"], capture_output=True, timeout=2)
        return True
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False


def check_preview_available():
    """Check if mv-preview is available."""
    try:
        subprocess.run([PREVIEW_APP, "--help"], capture_output=True, timeout=2)
        return True
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False


def backend_flag(mode):
    """Map a capture mode to its backend flag."""
    return {"region": "-r", "window": "-w", "fullscreen": "-f"}.get(mode, "-r")


def _work_area():
    """Return the usable work area of the primary monitor."""
    display = Gdk.Display.get_default()
    if display is None:
        return None
    monitor = display.get_primary_monitor() or display.get_monitor(0)
    return monitor.get_workarea() if monitor is not None else None


def _have_display():
    """True when an X display is reachable for any overlay surface."""
    return HAVE_GTK and Gdk.Display.get_default() is not None


def _set_opacity(widget, value):
    """Set whole-widget opacity without the deprecated Gtk.Window setter.
    Before the window is realised the Gdk window does not exist yet, so the
    request is replayed once it is mapped."""
    value = max(0.0, min(1.0, float(value)))
    gdk_window = widget.get_window()
    if gdk_window is not None:
        gdk_window.set_opacity(value)
        return True
    try:
        pending = [value]

        def _on_map(widget, _event):
            if pending:
                _set_opacity(widget, pending.pop())

        widget.connect("map-event", _on_map)
    except Exception:
        widget.set_opacity(value)
    return False


def _preferred_size(widget):
    """Normalise get_preferred_size(), which returns ints on some
    PyGObject builds and Requisition objects on others."""
    width, height = widget.get_preferred_size()
    width = getattr(width, "width", width)
    height = getattr(height, "height", height)
    return int(width), int(height)


def flash_screen(hold_ms=70, fade_ms=200):
    """One-shot white capture flash, macOS style. No resident process:
    the overlay maps, fades out and destroys itself inside one nested loop."""
    if not _have_display() or not os.environ.get("DISPLAY"):
        return False

    try:
        area = _work_area()
        if area is None:
            return False

        window = Gtk.Window(type=Gtk.WindowType.POPUP)
        window.set_decorated(False)
        window.set_keep_above(True)
        window.set_accept_focus(False)
        window.set_app_paintable(True)
        window.set_size_request(area.width, area.height)
        window.move(area.x, area.y)
        window.connect("draw", lambda _w, cr: _paint_white(cr, area.width, area.height))

        loop = GLib.MainLoop()

        def _fade_in():
            _set_opacity(window, 0.85)
            GLib.timeout_add(hold_ms, _fade_out)

        def _fade_out():
            def _step(step):
                _set_opacity(window, 0.85 * (1.0 - step / 10.0))
                return True if step < 10 else None

            GLib.timeout_add(max(1, fade_ms // 10), _step, 0)
            GLib.timeout_add(hold_ms + fade_ms, _shutdown)

        def _shutdown():
            loop.quit()
            return False

        window.show_all()
        _set_opacity(window, 0.0)
        GLib.timeout_add(30, _fade_in)
        GLib.timeout_add(3000, _shutdown)
        loop.run()
        window.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()
        return True
    except Exception:
        return False


def _paint_white(cr, width, height):
    """Fill a cairo context with the flash white."""
    cr.set_source_rgb(1.0, 1.0, 1.0)
    cr.rectangle(0, 0, width, height)
    cr.fill()
    return False


def countdown(seconds):
    """Mavericks pre-capture timer. Shows an on-screen countdown when a
    display is reachable, otherwise falls back to a plain sleep. The timer
    surface is always torn down before the backend takes the shot, so it can
    never end up inside the screenshot.

    Driven from a monotonic deadline rather than by decrementing on each
    callback: GLib's timeout_add_seconds may fire up to a second early, which
    would silently shorten every timed capture."""
    if seconds is None or seconds <= 0:
        return 0

    deadline = time.monotonic() + float(seconds)

    def remaining():
        return int(deadline - time.monotonic() + 0.999)

    if not _have_display() or not os.environ.get("DISPLAY"):
        time.sleep(max(0.0, deadline - time.monotonic()))
        return int(seconds)

    try:
        window = Gtk.Window(type=Gtk.WindowType.POPUP)
        window.set_decorated(False)
        window.set_keep_above(True)
        window.set_app_paintable(True)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("mv-timer-box")
        box.set_border_width(22)
        label = Gtk.Label()
        label.get_style_context().add_class("mv-timer-label")
        box.pack_start(label, False, False, 0)
        window.add(box)

        def _place(*_args):
            area = _work_area()
            if area is None:
                return False
            width, height = _preferred_size(window)
            window.move(area.x + (area.width - width) // 2,
                        area.y + (area.height - height) // 2)
            return False

        window.connect("show", _place)
        label.set_text(str(max(0, remaining())))
        window.show_all()
        _set_opacity(window, 0.94)
        window.get_preferred_size()

        loop = GLib.MainLoop()

        def _tick():
            left = remaining()
            if left <= 0:
                loop.quit()
                return False
            label.set_text(str(left))
            return True

        GLib.timeout_add(100, _tick)
        GLib.timeout_add_seconds(int(seconds) + 5, loop.quit)
        loop.run()
        window.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()
    except Exception:
        time.sleep(max(0.0, deadline - time.monotonic()))
    return int(seconds)


def take_screenshot(mode, out_path, clip=False):
    """Capture via the stills backend. Returns (ok, message|path)."""
    if not check_backend_available():
        return False, ("Backend %r not found — install xfce4-screenshooter "
                       "(or set MV_SHOT_BACKEND)." % APP)

    cmd = [APP, backend_flag(mode)]
    cmd.append("-c") if clip else cmd.extend(["-s", out_path])

    result = run(cmd)
    if result.returncode != 0:
        return False, "Screenshot failed (exit code %d)" % result.returncode
    if clip:
        return True, None
    if not os.path.isfile(out_path):
        return False, "Backend reported success but wrote no file."
    return True, out_path


def copy_to_clipboard(image_path):
    """Put a saved screenshot on the CLIPBOARD selection."""
    if not HAVE_GTK:
        return False
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file(image_path)
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_image(pixbuf)
        return True
    except Exception:
        return False


def record_screen(output_path):
    """Record the screen using ffmpeg x11grab on the active display."""
    try:
        subprocess.run(["ffmpeg", "-version"], capture_output=True, timeout=2)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False, "Backend 'ffmpeg' not found — install ffmpeg to record."

    display = os.environ.get("DISPLAY", ":0")
    cmd = [
        "ffmpeg", "-f", "x11grab", "-i", display,
        "-c:v", "libx264", "-preset", "ultrafast",
        output_path,
    ]
    print("Recording %s (press Ctrl+C to stop)…" % output_path)
    try:
        result = subprocess.run(cmd)
    except KeyboardInterrupt:
        return True, output_path
    if result.returncode != 0:
        return False, "Recording failed (exit code %d)" % result.returncode
    return True, output_path


class CaptureThumbnail(Gtk.Window):
    """Mavericks floating capture thumbnail: borderless, always on top,
    bottom-right of the work area, auto-fading, with post-capture actions."""

    def __init__(self, image_path, caption, actions, timeout_sec=5):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Screenshot Captured")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_resizable(False)
        self.set_app_paintable(True)
        self.image_path = image_path
        self.result_action = None
        self.finished = False
        self.add_events(
            Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("key-press-event", self.on_key_press)
        self.connect("button-press-event", self.on_click_thumb)
        self.connect("destroy", self.on_destroy)

        _css_provider()
        self.get_style_context().add_class("mv-shot-float")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        root.set_border_width(10)
        self.add(root)

        pixbuf = None
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                image_path, THUMB_W, THUMB_H, True)
        except Exception:
            pixbuf = None

        if pixbuf is not None:
            image = Gtk.Image.new_from_pixbuf(pixbuf)
            frame = Gtk.EventBox()
            frame.add(image)
            frame.get_style_context().add_class("mv-thumb-frame")
            root.pack_start(frame, False, False, 0)
        else:
            fallback = Gtk.Image.new_from_icon_name(
                "image-missing", Gtk.IconSize.DIALOG)
            root.pack_start(fallback, False, False, 0)

        label = Gtk.Label(label=caption)
        label.get_style_context().add_class("mv-caption")
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(THUMB_W // 5)
        root.pack_start(label, False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.set_halign(Gtk.Align.CENTER)
        root.pack_start(row, False, False, 0)

        for label_text, icon, action, primary in actions:
            button = Gtk.Button()
            button.set_label(label_text)
            button.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
            button.set_always_show_image(True)
            button.get_style_context().add_class("mv-action")
            if primary:
                button.get_style_context().add_class("primary")
            button.connect("clicked", lambda _b, a=action: self.finish(a))
            row.pack_start(button, False, False, 0)

        self.show_all()
        self._place()

        if timeout_sec > 0:
            GLib.timeout_add_seconds(timeout_sec, self.on_timeout)

    def _place(self):
        """Anchor the thumbnail to the bottom-right of the work area."""
        area = _work_area()
        if area is None:
            return
        width, height = self.get_size()
        self.move(max(area.x, area.x + area.width - width - MARGIN),
                  max(area.y, area.y + area.height - height - MARGIN))

    def on_key_press(self, _widget, event):
        """Keyboard contract: Enter opens Preview, Escape/q dismisses."""
        name = Gdk.keyval_name(event.keyval)
        if name in ("Escape", "q", "Q"):
            self.finish("dismiss")
            return True
        if name in ("Return", "KP_Enter"):
            self.finish("preview")
            return True
        return False

    def on_click_thumb(self, _widget, _event):
        """Clicking the thumbnail opens it in Preview, as in macOS."""
        self.finish("preview")
        return True

    def on_timeout(self):
        """Auto-dismiss once the preview window lapsed."""
        self.fade_out()
        return False

    def fade_out(self):
        """Fade the thumbnail away, then close it."""
        def _step(step):
            _set_opacity(self, max(0.0, 1.0 - step / 10.0))
            return True if step < 10 else None

        GLib.timeout_add(25, _step, 0)
        GLib.timeout_add(300, self.finish, "dismiss")
        return False

    def finish(self, action):
        """Record the chosen action and close exactly once."""
        if self.result_action is None:
            self.result_action = action
        self.finished = True
        self.destroy()

    def on_destroy(self, _widget):
        self.finished = True


def show_capture_thumbnail(image_path, caption, actions, timeout_sec=5):
    """Show the floating thumbnail and block until the user acts or it
    lapses. Returns the chosen action, or None when no UI was possible."""
    if not HAVE_GTK:
        return None
    try:
        window = CaptureThumbnail(image_path, caption, actions, timeout_sec)
    except Exception:
        return None

    loop = GLib.MainLoop()

    def _quit(_widget=None):
        loop.quit()
        return False

    window.connect("destroy", _quit)
    GLib.timeout_add_seconds(max(1, timeout_sec) + 5, _quit)
    loop.run()
    while Gtk.events_pending():
        Gtk.main_iteration()
    return window.result_action


def thumbnail_caption(image_path):
    """Build the 'name.png • 12.4 KB' caption macOS shows under the shot."""
    name = os.path.basename(image_path)
    try:
        size = os.path.getsize(image_path)
    except OSError:
        return name
    if size >= 1024 * 1024:
        return "%s  •  %.1f MB" % (name, size / (1024.0 * 1024.0))
    return "%s  •  %.1f KB" % (name, size / 1024.0)


SAVED_ACTIONS = [
    ("Open", "document-open", "preview", True),
    ("Finder", "folder-open", "finder", False),
    ("Trash", "user-trash", "trash", False),
]

CLIP_ACTIONS = [
    ("Open", "document-open", "preview", True),
    ("Dismiss", "window-close", "dismiss", False),
]


def open_in_preview(image_path):
    """Hand a capture to mv-preview; report whether the handoff worked."""
    try:
        subprocess.Popen([PREVIEW_APP, image_path])
        return True
    except Exception:
        return False


def handle_post_capture_actions(image_path, action):
    """Execute a post-capture action chosen in the thumbnail."""
    if action == "preview":
        return open_in_preview(image_path)
    if action == "finder":
        try:
            subprocess.Popen(["thunar", "--select", image_path])
            return True
        except Exception:
            return False
    if action == "trash":
        try:
            subprocess.run(["trash-put", image_path], check=True)
            return True
        except Exception:
            return False
    return False


class ToolsBar(Gtk.Window):
    """Mavericks screenshot tools bar: pick the capture mode and the delay
    from one surface, fully keyboard operable. Returns (mode, delay)."""

    MODES = [
        ("Screen", "video-display", "fullscreen"),
        ("Area", "edit-select", "region"),
        ("Window", "window-new", "window"),
    ]
    DELAYS = [0, 3, 5, 10]

    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Screenshot Tools")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_app_paintable(True)
        self.result = None
        self.add_events(Gdk.EventMask.KEY_PRESS_MASK)
        self.connect("key-press-event", self.on_key_press)

        _css_provider()
        self.get_style_context().add_class("mv-tools-bar")

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.set_border_width(10)
        self.add(root)

        self.buttons = []
        for index, (label, icon, mode) in enumerate(self.MODES):
            button = Gtk.Button()
            button.set_label(label)
            button.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
            button.set_always_show_image(True)
            button.get_style_context().add_class("mv-tool")
            button.connect("clicked", self.on_mode_clicked, mode, self.DELAYS[index])
            root.pack_start(button, False, False, 0)
            self.buttons.append(button)

        root.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False,
                        False, 0)

        self.delay_index = 1
        self.delay_button = Gtk.Button()
        self.delay_button.get_style_context().add_class("mv-tool")
        root.pack_start(self.delay_button, False, False, 0)
        self.delay_button.connect("clicked", self.on_delay_clicked)
        self._update_delay_label()

        cancel = Gtk.Button(label="Cancel")
        cancel.get_style_context().add_class("mv-tool")
        cancel.connect("clicked", lambda _b: self.finish(None))
        root.pack_start(cancel, False, False, 0)

        self.show_all()
        self._place()
        if self.buttons:
            self.buttons[0].grab_focus()

    def _place(self):
        """Centre the bar horizontally near the top of the work area."""
        area = _work_area()
        if area is None:
            return
        width, height = _preferred_size(self)
        self.move(area.x + (area.width - width) // 2, area.y + MARGIN)

    def _update_delay_label(self):
        self.delay_button.set_label("Timer: %ds" % self.DELAYS[self.delay_index])

    def on_mode_clicked(self, _button, mode, _unused_delay):
        self.finish((mode, self.DELAYS[self.delay_index]))

    def on_delay_clicked(self, _button):
        self.delay_index = (self.delay_index + 1) % len(self.DELAYS)
        self._update_delay_label()

    def on_key_press(self, _widget, event):
        """Keyboard contract: arrows move, Enter captures, Escape cancels."""
        name = Gdk.keyval_name(event.keyval)
        if name == "Escape":
            self.finish(None)
            return True
        if name in ("Left", "Right"):
            self.delay_index = (self.delay_index + (1 if name == "Right" else -1)) \
                % len(self.DELAYS)
            self._update_delay_label()
            return True
        if name in ("Return", "KP_Enter", "space"):
            focus = self.get_focus()
            mode = self.MODES[self.buttons.index(focus)][2] if focus in self.buttons \
                else "region"
            self.finish((mode, self.DELAYS[self.delay_index]))
            return True
        return False

    def finish(self, result):
        self.result = result
        self.destroy()


def show_tools_bar():
    """Show the screenshot tools bar. Returns (mode, delay) or None."""
    if not HAVE_GTK:
        return None
    try:
        bar = ToolsBar()
    except Exception:
        return None

    loop = GLib.MainLoop()

    def _quit(_widget=None):
        loop.quit()
        return False

    bar.connect("destroy", _quit)
    GLib.timeout_add_seconds(60, _quit)
    loop.run()
    while Gtk.events_pending():
        Gtk.main_iteration()
    return bar.result


def notify(message, icon="camera-photo"):
    """Non-blocking desktop notification, best effort."""
    if not shutil.which("notify-send"):
        return False
    try:
        subprocess.Popen(["notify-send", "-i", icon, "Screenshot", message])
        return True
    except Exception:
        return False


def show_error_dialog(message):
    """Report a failure. A hotkey invocation has no terminal and nobody to
    dismiss a modal dialog, so the blocking GTK dialog is reserved for an
    interactive CLI run; otherwise it degrades to stderr + notification."""
    print("ERROR: %s" % message, file=sys.stderr)
    interactive = sys.stderr.isatty() and sys.stdout.isatty()
    if interactive:
        notify(message)
    if not HAVE_GTK or not interactive:
        return False
    try:
        dialog = Gtk.MessageDialog(
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text="Screenshot Error")
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()
        return True
    except Exception:
        return False


USAGE = """\
Usage: mv-shot [options] [file...]

macOS-compatible capture modes (one per run):
  -i              interactive region selection (Shift+Cmd+4)
  -w              active window capture
  -m              full screen capture (Shift+Cmd+3)
  -T <seconds>    timed capture; shows the Mavericks countdown
  -c              copy the capture to the clipboard only
  -o <path>       write to <path> (a directory gets a Mavericks name)

MavLinOS surfaces:
  --toolbar       screenshot tools bar: mode + timer in one place
  --no-preview    skip the floating post-capture thumbnail
  --record        screen recording to ~/Movies (experimental)
  --config        print the config path
  --version       print the version

Save default: ~/Desktop/'Screen Shot YYYY-MM-DD at HH.MM.SS.png'
Config: %s (save_dir, show_preview, preview_timeout,
copy_to_clipboard, flash, countdown)
""" % CONFIG_PATH


def parse_args(argv):
    """Parse the CLI into a settings overlay."""
    opts = {
        "mode": "region", "delay": 0, "clip": False, "out": None,
        "record": False, "toolbar": False, "preview": True, "files": [],
    }
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "-i":
            opts["mode"] = "region"
        elif arg == "-w":
            opts["mode"] = "window"
        elif arg == "-m":
            opts["mode"] = "fullscreen"
        elif arg == "-T" and index + 1 < len(argv):
            index += 1
            try:
                opts["delay"] = max(0, int(argv[index]))
            except ValueError:
                raise ValueError("invalid delay value: %r" % argv[index])
        elif arg == "-c":
            opts["clip"] = True
        elif arg == "-o" and index + 1 < len(argv):
            index += 1
            opts["out"] = argv[index]
        elif arg == "--record":
            opts["record"] = True
        elif arg == "--toolbar":
            opts["toolbar"] = True
        elif arg == "--no-preview":
            opts["preview"] = False
        elif arg in ("-h", "--help"):
            opts["help"] = True
        elif arg == "--version":
            opts["version"] = True
        elif arg == "--config":
            opts["config"] = True
        elif arg.startswith("-") and arg != "-":
            raise ValueError("unknown option: %s" % arg)
        else:
            opts["files"].append(arg)
        index += 1
    return opts


def capture(opts, settings):
    """Run one capture honouring mode, delay, clipboard and save behaviour."""
    save_dir = resolve_save_dir(settings["save_dir"])
    if not save_dir:
        show_error_dialog("No writable save directory (%s, %s)" % (
            settings["save_dir"], LEGACY_SAVE_DIR))
        return 1

    target = opts["out"]
    if target and os.path.isdir(target):
        target = unique_path(target, mavericks_stem(), ".png")
    elif target:
        parent = os.path.dirname(os.path.abspath(target))
        if not ensure_dir(parent):
            show_error_dialog("Cannot create directory: %s" % parent)
            return 1
    elif not opts["clip"]:
        # Name the capture after the timer, not before it, so -T N files
        # carry the moment the shot was actually taken.
        target = unique_path(save_dir, mavericks_stem(), ".png")

    if settings["countdown"]:
        countdown(opts["delay"])
    else:
        time.sleep(opts["delay"])

    ok, result = take_screenshot(opts["mode"], target, clip=opts["clip"])
    if not ok:
        show_error_dialog(result)
        return 1

    if opts["clip"]:
        return finish_clipboard_capture(settings)

    if settings["flash"]:
        flash_screen()

    if settings["copy_to_clipboard"]:
        copy_to_clipboard(target)

    if not opts["preview"] or not settings["show_preview"]:
        return 0

    action = show_capture_thumbnail(
        target, thumbnail_caption(target), SAVED_ACTIONS,
        settings["preview_timeout"])
    if action and action != "dismiss":
        if not handle_post_capture_actions(target, action):
            notify("Could not run '%s' on %s" % (action, os.path.basename(target)))
    return 0


def finish_clipboard_capture(settings):
    """Clipboard-only capture still shows the macOS thumbnail."""
    if not HAVE_GTK or not settings["show_preview"]:
        return 0
    try:
        pixbuf = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_image()
    except Exception:
        pixbuf = None
    if pixbuf is None:
        return 0

    handle, temp_path = tempfile.mkstemp(prefix="mv-shot-", suffix=".png")
    os.close(handle)
    try:
        pixbuf.savev(temp_path, "png", [], [])
    except Exception:
        return 0

    try:
        action = show_capture_thumbnail(
            temp_path, "Copied to Clipboard", CLIP_ACTIONS,
            settings["preview_timeout"])
        if action == "preview":
            open_in_preview(temp_path)
    finally:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
    return 0


def main(argv):
    settings, warnings = resolve_settings(load_config())
    for warning in warnings:
        print("WARNING: mv-shot config: %s" % warning, file=sys.stderr)

    try:
        opts = parse_args(argv)
    except ValueError as exc:
        show_error_dialog(str(exc))
        return 1

    if opts.get("help"):
        print(USAGE)
        return 0
    if opts.get("version"):
        print("mv-shot %s" % VERSION)
        return 0
    if opts.get("config"):
        print(CONFIG_PATH)
        return 0

    if opts["files"]:
        opened = 0
        for path in opts["files"]:
            if os.path.exists(path) and open_in_preview(path):
                opened += 1
        if not opened:
            show_error_dialog("mv-preview is unavailable for: %s" % ", ".join(opts["files"]))
            return 1
        return 0

    if opts["toolbar"] and not _have_display():
        print("WARNING: mv-shot: no display reachable; falling back to a "
              "timed full-screen capture.", file=sys.stderr)
        opts["mode"] = "fullscreen"

    if opts["toolbar"]:
        choice = show_tools_bar()
        if choice is None:
            return 1
        opts["mode"], opts["delay"] = choice

    if opts["preview"]:
        opts["preview"] = settings["show_preview"]

    if opts["record"]:
        if not ensure_dir(MOVIES_DIR_DEFAULT):
            show_error_dialog("Cannot create directory: %s" % MOVIES_DIR_DEFAULT)
            return 1
        stem = "Screen Recording %s" % time.strftime("%Y-%m-%d at %H.%M.%S")
        target = unique_path(MOVIES_DIR_DEFAULT, stem, ".mkv")
        ok, result = record_screen(target)
        if not ok:
            show_error_dialog(result)
            return 1
        return 0

    return capture(opts, settings)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))