#!/usr/bin/env python3
"""Mission Control: generate thumbnail for a window.

Usage: mv-mc-thumbnail <window_id> [width] [output_file]

Generates a thumbnail screenshot of the specified window.
Default width: 200px
Default output: stdout (PNG)
"""
import sys
import subprocess
import os

DEFAULT_WIDTH = 200


def get_window_geometry(wid):
    """Get window geometry via xdotool."""
    try:
        result = subprocess.run(
            ["xdotool", "getwindowgeometry", "--shell", str(wid)],
            capture_output=True,
            text=True,
            check=True
        )
        props = {}
        for line in result.stdout.splitlines():
            if "=" in line:
                key, val = line.split("=", 1)
                props[key.strip()] = val.strip()
        
        x = int(props.get("X", 0))
        y = int(props.get("Y", 0))
        width = int(props.get("WIDTH", 0))
        height = int(props.get("HEIGHT", 0))
        return x, y, width, height
    except (subprocess.CalledProcessError, FileNotFoundError, KeyError, ValueError) as e:
        print(f"Error getting window geometry: {e}", file=sys.stderr)
        return None


def capture_thumbnail(wid, width=DEFAULT_WIDTH, output=None):
    """Capture window thumbnail using import (ImageMagick) or scrot."""
    geom = get_window_geometry(wid)
    if not geom:
        return False
    
    x, y, win_width, win_height = geom
    
    # Calculate scaled dimensions
    if win_width <= 0 or win_height <= 0:
        print("Error: Invalid window dimensions", file=sys.stderr)
        return False
    
    scale = width / win_width
    thumb_height = int(win_height * scale)
    
    # Try ImageMagick's import first
    try:
        cmd = ["import", "-window", str(wid), "-resize", f"{width}x{thumb_height}", "png:-"]
        if output:
            cmd = ["import", "-window", str(wid), "-resize", f"{width}x{thumb_height}", output]
        
        result = subprocess.run(cmd, capture_output=(output is None))
        if result.returncode == 0:
            if output is None:
                sys.stdout.buffer.write(result.stdout)
            print(f"Generated thumbnail: {width}x{thumb_height}", file=sys.stderr)
            return True
    except FileNotFoundError:
        pass
    
    # Fallback to scrot
    try:
        temp_file = f"/tmp/mc_thumb_{wid}.png"
        cmd = ["scrot", "-a", f"{x},{y},{win_width},{win_height}", temp_file]
        subprocess.run(cmd, check=True)
        
        # Resize with convert if available
        if output:
            try:
                subprocess.run(
                    ["convert", temp_file, "-resize", f"{width}x{thumb_height}", output],
                    check=True
                )
            except FileNotFoundError:
                # No convert, just copy
                subprocess.run(["cp", temp_file, output], check=True)
        else:
            with open(temp_file, "rb") as f:
                sys.stdout.buffer.write(f.read())
        
        os.remove(temp_file)
        print(f"Generated thumbnail: {width}x{thumb_height}", file=sys.stderr)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        print(f"Error capturing thumbnail: {e}", file=sys.stderr)
        return False


def main():
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        sys.exit(1)
    
    try:
        wid = int(sys.argv[1])
    except ValueError:
        print(f"Error: Invalid window ID: {sys.argv[1]}", file=sys.stderr)
        sys.exit(1)
    
    width = DEFAULT_WIDTH
    output = None
    
    if len(sys.argv) >= 3:
        try:
            width = int(sys.argv[2])
        except ValueError:
            print(f"Error: Invalid width: {sys.argv[2]}", file=sys.stderr)
            sys.exit(1)
    
    if len(sys.argv) >= 4:
        output = sys.argv[3]
    
    if not capture_thumbnail(wid, width, output):
        sys.exit(1)


if __name__ == "__main__":
    main()
