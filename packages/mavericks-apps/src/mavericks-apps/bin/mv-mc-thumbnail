#!/usr/bin/env python3
"""Mission Control: generate a PNG thumbnail for a window.

Usage: mv-mc-thumbnail <window_id> [width] [output_file]

Uses the shared XComposite capture backend from mavericks-apps. No
ImageMagick, scrot, temporary files, or geometry scraping are required.
"""
import os
import sys

LIBDIR = "/usr/share/mavericks-apps"
for candidate in (LIBDIR, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib")):
    if os.path.isdir(candidate) and candidate not in sys.path:
        sys.path.insert(0, candidate)

DEFAULT_WIDTH = 200

try:
    from mission_control_thumbnail import capture_window
except ImportError as exc:
    print(f"Error: Mission Control thumbnail backend unavailable: {exc}", file=sys.stderr)
    sys.exit(1)


def capture_thumbnail(wid, width=DEFAULT_WIDTH, output=None):
    """Capture a mapped X11 window and write a scaled PNG."""
    if width <= 0:
        print("Error: width must be greater than zero", file=sys.stderr)
        return False

    pixbuf = capture_window(wid, max_size=(width, width))
    if pixbuf is None:
        print(f"Error: unable to capture window {wid}", file=sys.stderr)
        return False

    try:
        if output:
            ok = pixbuf.savev(output, "png", [], [])
        else:
            ok, data = pixbuf.save_to_bufferv("png", [], [])
            if not ok:
                return False
            sys.stdout.buffer.write(data)
        return True
    except Exception as exc:
        print(f"Error writing thumbnail: {exc}", file=sys.stderr)
        return False


def main():
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        sys.exit(1)

    try:
        wid = int(sys.argv[1], 0)
    except ValueError:
        print(f"Error: Invalid window ID: {sys.argv[1]}", file=sys.stderr)
        sys.exit(1)

    width = DEFAULT_WIDTH
    output = None
    if len(sys.argv) >= 3:
        try:
            width = int(sys.argv[2])
        except ValueError:
            print(f"Error: Invalid width: {sys.argv[2]}", file=sys.stderr)
            sys.exit(1)
    if len(sys.argv) >= 4:
        output = sys.argv[3]

    if not capture_thumbnail(wid, width, output):
        sys.exit(1)


if __name__ == "__main__":
    main()
