#!/usr/bin/env python3
"""mv-eject-selection — global-shortcut wrapper: eject selected Thunar volume.

Bound to Super+F4 (Mavericks Cmd+E on a mounted volume). Delegates to
mv-eject with the 'selection' token, which resolves the current Thunar
selection via the clipboard technique shared with mv-quicklook-thunar.
Exit code is propagated: no selection => non-zero + stderr message
(never a silent success).
License: GPL-2.0-or-later.
"""
import os
import subprocess
import sys

here = os.path.dirname(os.path.abspath(__file__))
target = os.path.join(here, "mv-eject")
if not os.path.isfile(target):
    target = "/usr/bin/mv-eject"

sys.exit(subprocess.run([target, "selection"]).returncode)
