#!/usr/bin/env python3
"""mv-hide-app — Hide the currently focused application (Super+H).

Mavericks-like: hides all windows of the focused app without quitting.
Uses xdotool to send the hide signal (iconify all windows of the app).
"""
import subprocess
import sys

def main():
    try:
        # Get the active window's PID
        result = subprocess.run(
            ["xdotool", "getactivewindow", "getwindowpid"],
            capture_output=True, text=True, timeout=2
        )
        if result.returncode != 0:
            return 1
        pid = result.stdout.strip()
        if not pid:
            return 1
        
        # Find all windows belonging to this PID and iconify them
        result = subprocess.run(
            ["xdotool", "search", "--pid", pid],
            capture_output=True, text=True, timeout=2
        )
        if result.returncode != 0:
            return 1
        
        for win_id in result.stdout.strip().split():
            if win_id:
                subprocess.run(["xdotool", "windowminimize", win_id], timeout=1)
        return 0
    except Exception:
        return 1

if __name__ == "__main__":
    sys.exit(main())