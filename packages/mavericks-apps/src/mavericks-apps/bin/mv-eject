#!/usr/bin/env python3
"""mv-eject — Finder-like eject/unmount for removable devices.
Handles: USB drives, SD cards, mounted volumes (GIO UnixMount).

Bug fixed 2026-10-05: the old code called the ASYNC unmount_with_operation()
with a no-op callback and returned immediately; with no main loop running,
the process exited before GIO ever started the unmount — nothing happened.
Now uses the sync API (this is a short-lived CLI by design), reports real
errors, and falls back to a polite umount(8) for non-GIO mount points.
License: GPL-2.0-or-later.
"""
import os
import subprocess
import sys


def find_mount(mounts, arg):
    """Find a Gio.Mount matching arg by mount path or device file."""
    abspath = os.path.abspath(arg)
    for mount in mounts:
        root = mount.get_root()
        if root and root.get_path() == abspath:
            return mount
    if os.path.exists(arg):
        for mount in mounts:
            try:
                device = mount.get_device()
            except Exception:
                device = None
            if device and device.get_device_file() == arg:
                return mount
    return None


def resolve_selection(paths):
    """Expand the special token 'selection' to the current Thunar selection.

    Delegates to the shared mv-selection helper (single implementation of
    the clipboard-copy technique used by all *-selection wrappers).
    Returns [] when nothing usable is selected — callers must handle that
    explicitly (never silently no-op with exit 0).
    """
    if paths != ["selection"]:
        return paths
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (os.path.join(here, "mv-selection"), "/usr/bin/mv-selection"):
        if not os.path.isfile(cand):
            continue
        try:
            out = subprocess.run([cand],
                                 capture_output=True, text=True, timeout=5)
            return [l for l in out.stdout.splitlines() if l.strip()]
        except Exception:
            return []
    return []


def main():
    if len(sys.argv) < 2:
        print("Usage: mv-eject <mount-point-or-device|selection>", file=sys.stderr)
        return 1

    args = resolve_selection(sys.argv[1:])
    if not args:
        print("mv-eject: no removable volume selected in Thunar",
              file=sys.stderr)
        return 1

    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio

    rc = 0
    for arg in args:
        try:
            mounts = Gio.UnixMountMonitor.get().get_mounts()
            mount = find_mount(mounts, arg)

            if mount is None:
                # Not a GIO-tracked mount: try a plain umount for directories
                # under /media//run/media (Finder-style fallback).
                abspath = os.path.abspath(arg)
                if os.path.isdir(abspath) and (
                        abspath.startswith("/media/")
                        or abspath.startswith("/run/media/")):
                    ret = os.system("umount %r 2>/dev/null || umount -l %r"
                                    % (abspath, abspath))
                    if ret == 0:
                        print("Ejected: %s" % arg)
                        continue
                print("No mount found for: %s" % arg, file=sys.stderr)
                rc = 1
                continue

            if not mount.can_unmount():
                print("Cannot eject (busy): %s" % arg, file=sys.stderr)
                rc = 1
                continue

            op = Gio.MountOperation()
            mount.unmount_with_operation(
                Gio.MountUnmountFlags.FORCE, op, None)
            print("Ejected: %s" % arg)

        except Exception as e:
            print("Error ejecting %s: %s" % (arg, e), file=sys.stderr)
            rc = 1

    return rc


if __name__ == "__main__":
    sys.exit(main())
