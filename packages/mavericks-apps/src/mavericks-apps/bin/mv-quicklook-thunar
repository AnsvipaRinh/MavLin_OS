#!/usr/bin/env python3
"""mv-quicklook-thunar — Global hotkey handler for Quick Look in Thunar.
Uses xdotool to copy selection and parse clipboard for file URIs.
Falls back to xdg-open if Thunar not focused or no selection.
License: GPL-2.0-or-later."""
import os, subprocess, sys, gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

def get_thunar_selection():
    """Try to get selected files from Thunar via clipboard copy."""
    try:
        # Check if Thunar is the active window
        active = subprocess.run(["xdotool", "getactivewindow", "getwindowname"],
                                capture_output=True, text=True, timeout=2)
        if "thunar" not in active.stdout.lower():
            return None

        # Copy selection to clipboard (Ctrl+C)
        subprocess.run(["xdotool", "key", "ctrl+c"], timeout=1)

        # Give clipboard time to update
        import time
        time.sleep(0.15)

        # Get clipboard content
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard_text = clipboard.wait_for_text()

        if not clipboard_text:
            return None

        # Parse file:// URIs from clipboard
        import urllib.parse
        files = []
        for line in clipboard_text.strip().splitlines():
            line = line.strip()
            if line.startswith("file://"):
                path = urllib.parse.unquote(line[7:])
                if os.path.isfile(path):
                    files.append(path)

        return files if files else None
    except Exception:
        return None


def main():
    files = get_thunar_selection()

    if files:
        # Launch mv-quicklook with the selected files
        os.execvp("mv-quicklook", ["mv-quicklook"] + files)
    else:
        # Fallback: show a brief notification
        try:
            subprocess.run(["notify-send", "-t", "1500",
                            "Quick Look", "No files selected in Thunar"],
                           timeout=2)
        except Exception:
            pass
        sys.exit(1)


if __name__ == "__main__":
    main()