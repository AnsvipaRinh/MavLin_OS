#!/usr/bin/env python3
"""mv-mail — Mavericks-like Mail wrapper for Geary.
Adds Mavericks visual theme and integration.
"""
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

class MailWrapper(Gtk.Window):
    def __init__(self):
        super().__init__(title="Mail")
        self.set_default_size(1000, 650)
        
        self.apply_css()
        
        hb = Gtk.HeaderBar(title="Mail", show_close_button=True)
        self.set_titlebar(hb)
        
        search = Gtk.SearchEntry(placeholder_text="Search mail...")
        search.set_hexpand(True)
        hb.pack_start(search)
        
        new_msg = Gtk.Button(label="New Message")
        new_msg.get_style_context().add_class("mavericks-toolbar-btn")
        new_msg.get_style_context().add_class("suggested-action")
        new_msg.connect("clicked", self.new_message)
        hb.pack_end(new_msg)
        
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)
        
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sidebar.set_size_request(220, -1)
        sidebar.get_style_context().add_class("mail-sidebar")
        
        accounts_frame = Gtk.Frame(label="Mailboxes")
        accounts_frame.get_style_context().add_class("mail-sidebar-frame")
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        vbox.set_border_width(8)
        
        mailboxes = ["Inbox", "VIPs", "Flagged", "Sent", "Drafts", "Archive", "Trash"]
        for mb in mailboxes:
            btn = Gtk.Button(label=mb)
            btn.get_style_context().add_class("sidebar-item")
            btn.set_halign(Gtk.Align.START)
            vbox.pack_start(btn, False, False, 0)
        accounts_frame.add(vbox)
        sidebar.pack_start(accounts_frame, False, False, 0)
        
        smart_frame = Gtk.Frame(label="Smart Mailboxes")
        smart_frame.get_style_context().add_class("mail-sidebar-frame")
        vbox2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        vbox2.set_border_width(8)
        for smb in ["Today", "Unread", "Attachments", "Flagged"]:
            btn = Gtk.Button(label=smb)
            btn.get_style_context().add_class("sidebar-item")
            btn.set_halign(Gtk.Align.START)
            vbox2.pack_start(btn, False, False, 0)
        smart_frame.add(vbox2)
        sidebar.pack_start(smart_frame, False, False, 0)
        
        sidebar_sw = Gtk.ScrolledWindow()
        sidebar_sw.add(sidebar)
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.add1(sidebar_sw)
        
        self.content = Gtk.Label(label="Launching Geary...")
        self.content.get_style_context().add_class("mail-content")
        paned.add2(self.content)
        paned.set_position(240)
        
        GLib.timeout_add(100, self.launch_geary)
        self.show_all()

    def apply_css(self):
        css = b"""
        .mail-sidebar {
            background: #f5f0e8;
            background-image: linear-gradient(180deg, #f5f0e8 0%, #e8ddd0 100%);
            border-right: 1px solid #d4c8b8;
        }
        .mail-sidebar > viewport { background: transparent; }
        .mail-sidebar-frame {
            border: none;
            background: transparent;
        }
        .mail-sidebar-frame > label {
            font-weight: bold;
            color: #666;
            font-size: 9pt;
            margin-bottom: 4px;
        }
        .sidebar-item {
            background: transparent;
            border: none;
            border-radius: 4px;
            padding: 6px 12px;
            margin: 2px 8px;
        }
        .sidebar-item:hover {
            background: rgba(0,122,255,0.15);
        }
        .mail-content {
            background: #f5f0e8;
            font-family: "San Francisco", sans-serif;
            font-size: 14pt;
            color: #666;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def new_message(self, _):
        print("New message")

    def launch_geary(self):
        try:
            subprocess.Popen(["geary"])
            self.content.set_markup('<span size="x-large" weight="bold">📧 Mail</span>\n\n<span color="#666">Geary launched in background.\nUse the sidebar to navigate mailboxes.</span>')
        except FileNotFoundError:
            self.content.set_markup('<span color="#ff3b30">Geary not installed</span>\n\n<span color="#666">Install with: sudo pacman -S geary</span>')
        return False

import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

if __name__ == "__main__":
    w = MailWrapper()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()