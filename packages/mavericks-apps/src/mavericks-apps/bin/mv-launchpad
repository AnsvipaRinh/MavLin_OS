#!/usr/bin/env python3
"""mv-launchpad — Paginated, folder-aware Launchpad for rofi script mode.
Features:
- Pagination (Page Up/Down; standard arrow-key item navigation)
- Folders (configurable, stored in ~/.config/mv-launchpad/folders.json)
- Search filtering within Launchpad
- Keyboard navigation
- Persisted custom app positions (configuration-driven; no drag-and-drop UI)
- Default folder presets on first run
- Empty state handling
- Robust .desktop parsing with fallbacks
"""
import os
import sys
import json
import subprocess
import tempfile
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
from pathlib import Path

import mv_desktop_cache

CONFIG_DIR = Path.home() / ".config" / "mv-launchpad"
FOLDERS_FILE = CONFIG_DIR / "folders.json"
POSITIONS_FILE = CONFIG_DIR / "positions.json"
ITEMS_PER_PAGE = 35  # 7 columns x 5 rows
FOLDER_PAGE_CAPACITY = ITEMS_PER_PAGE - 1  # Reserve one cell for the Back item

# Default folder presets (Mavericks-style)
DEFAULT_FOLDERS = {
    "Utilities": {
        "name": "Utilities",
        "apps": []
    },
    "Other": {
        "name": "Other",
        "apps": []
    }
}


def load_desktop_apps():
    """Load all .desktop applications with robust parsing and fallbacks.

    Raw entries come from the shared mv_desktop_cache (mtime+size-keyed,
    airtight invalidation); dedup (user overrides system), icon
    validation, and sorting happen here.
    """
    apps = []
    seen_ids = set()
    for e in mv_desktop_cache.load_desktop_entries():
        desktop_id = Path(e["path"]).stem
        # Skip duplicates (user overrides system)
        if desktop_id in seen_ids:
            continue
        icon = e["icon"]
        # Validate icon exists, fallback if not
        if icon and not _icon_exists(icon):
            icon = "application-x-executable"
        elif not icon:
            icon = "application-x-executable"
        apps.append({
            "id": desktop_id,
            "name": e["name"],
            "exec": e["exec"],
            "icon": icon,
        })
        seen_ids.add(desktop_id)
    # Sort by name
    apps.sort(key=lambda x: x["name"].lower())
    return apps


def _icon_exists(icon_name):
    """Check if an icon exists in the current icon theme."""
    try:
        icon_theme = Gtk.IconTheme.get_default()
        if icon_theme.has_icon(icon_name):
            return True
        # Also check with common extensions
        for ext in [".png", ".svg", ".xpm"]:
            if icon_theme.has_icon(icon_name + ext):
                return True
    except Exception:
        pass
    return False


def load_folders(apps=None):
    """Load and normalize folder configuration without overwriting user edits."""
    config_exists = FOLDERS_FILE.exists()
    config_valid = False
    try:
        with open(FOLDERS_FILE, "r") as fp:
            raw = json.load(fp)
        config_valid = isinstance(raw, dict)
    except (OSError, json.JSONDecodeError, TypeError):
        raw = {}

    if config_exists and not config_valid:
        # Preserve a corrupt/unreadable user file rather than silently replacing it.
        return {folder_id: {
            "name": folder_data["name"],
            "apps": list(folder_data["apps"]),
        } for folder_id, folder_data in DEFAULT_FOLDERS.items()}

    folders = {}
    if isinstance(raw, dict):
        for folder_id, folder_data in raw.items():
            if not isinstance(folder_id, str) or not isinstance(folder_data, dict):
                continue
            name = folder_data.get("name", folder_id)
            app_ids = folder_data.get("apps", [])
            if not isinstance(name, str):
                name = folder_id
            if not isinstance(app_ids, list):
                app_ids = []
            app_ids = [app_id for app_id in app_ids if isinstance(app_id, str)]
            folders[folder_id] = {"name": name, "apps": app_ids}

    # Default folders are created only on first run. Once folders.json
    # exists, missing defaults are intentional user configuration and must not
    # be silently recreated on every Launchpad invocation.
    if not config_exists:
        for folder_id, folder_data in DEFAULT_FOLDERS.items():
            folders.setdefault(folder_id, {
                "name": folder_data["name"],
                "apps": list(folder_data["apps"]),
            })

    # Auto-population is a first-run migration only. Re-running Launchpad must
    # never silently re-add an app that the user removed from folders.json.
    if not config_exists and apps:
        _auto_populate_default_folders(folders, apps)

    save_folders(folders)
    return folders
def _auto_populate_default_folders(folders, apps):
    """Auto-populate default folders with relevant apps on first run."""
    # Map of folder ID to keywords for auto-population
    folder_keywords = {
        "Utilities": ["calculator", "terminal", "disk", "monitor", "activity", "system", "settings", "preferences", "control", "font", "color", "keychain", "password", "certificate"],
        "Other": []
    }
    for app in apps:
        app_name_lower = app["name"].lower()
        app_id_lower = app["id"].lower()
        for folder_id, keywords in folder_keywords.items():
            if folder_id == "Other":
                continue
            for kw in keywords:
                if kw in app_name_lower or kw in app_id_lower:
                    if "apps" not in folders[folder_id]:
                        folders[folder_id]["apps"] = []
                    if app["id"] not in folders[folder_id]["apps"]:
                        folders[folder_id]["apps"].append(app["id"])
                    break


def _atomic_save_json(path, data):
    """Atomically replace a JSON config file after flushing it to disk."""
    import tempfile

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp_path = None
    try:
        fd, tmp_path = tempfile.mkstemp(
            prefix=f".{path.name}.", suffix=".tmp", dir=str(CONFIG_DIR)
        )
        with os.fdopen(fd, "w") as fp:
            json.dump(data, fp, indent=2)
            fp.write("\n")
            fp.flush()
            os.fsync(fp.fileno())
        os.replace(tmp_path, path)
        tmp_path = None
        try:
            dir_fd = os.open(CONFIG_DIR, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError:
            pass
    except Exception:
        pass
    finally:
        if tmp_path:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def save_folders(folders):
    """Save folder configuration atomically."""
    _atomic_save_json(FOLDERS_FILE, folders)


def load_positions():
    """Load custom app positions, rejecting malformed top-level JSON."""
    if not POSITIONS_FILE.exists():
        return {}
    try:
        with open(POSITIONS_FILE, "r") as fp:
            raw = json.load(fp)
    except (OSError, json.JSONDecodeError, TypeError):
        return {}

    if not isinstance(raw, dict):
        return {}

    # JSON object keys are strings; retain values for build_launchpad_structure()
    # to validate as untrusted position data.
    return {app_id: position for app_id, position in raw.items() if isinstance(app_id, str)}


def save_positions(positions):
    """Save custom app positions atomically."""
    _atomic_save_json(POSITIONS_FILE, positions)


def build_launchpad_structure(apps, folders, positions, query="", open_folder=None):
    """Build the launchpad structure with folders and pagination.
    
    Args:
        apps: List of all applications
        folders: Folder configuration
        positions: Custom app positions
        query: Search query string
        open_folder: Folder ID to show (for folder navigation)
    """
    # Apps assigned to a Launchpad folder are represented by the folder on
    # the main page, not duplicated as standalone icons. During search we keep
    # them discoverable so search can still find apps inside folders.
    folder_member_ids = {
        app_id
        for folder_data in folders.values()
        for app_id in folder_data.get("apps", [])
    }
    filtered_apps = []
    for app in apps:
        if not query and app["id"] in folder_member_ids:
            continue
        if not query or query.lower() in app["name"].lower():
            filtered_apps.append(app)

    # Apply custom positions
    positioned = {}
    remaining = []
    for app in filtered_apps:
        app_id = app["id"]
        if app_id in positions:
            pos = positions[app_id]
            # Treat persisted positions as untrusted user configuration.
            # Invalid types and duplicate slots must never drop an app.
            if isinstance(pos, int) and not isinstance(pos, bool) and 0 <= pos < len(filtered_apps) and pos not in positioned:
                positioned[pos] = app
            else:
                remaining.append(app)
        else:
            remaining.append(app)

    # Build ordered list
    ordered = []
    for i in range(len(filtered_apps)):
        if i in positioned:
            ordered.append(positioned[i])
        elif remaining:
            ordered.append(remaining.pop(0))

    # Build folder structure. Folders occupy real grid cells on page 0.
    structure = {
        "folders": [],
        "apps": ordered,
        "total_pages": 1,
        "query": query,
        "open_folder": open_folder,
        "empty": len(filtered_apps) == 0 and not query and not open_folder
    }

    # If a folder is open, show its contents
    if open_folder and open_folder in folders:
        folder_data = folders[open_folder]
        folder_apps = []
        for app_id in folder_data.get("apps", []):
            for app in apps:
                if app["id"] == app_id and (not query or query.lower() in app["name"].lower()):
                    folder_apps.append(app)
                    break
        structure["apps"] = folder_apps
        structure["folders"] = []  # No sub-folders for now
        structure["total_pages"] = max(1, (len(folder_apps) + FOLDER_PAGE_CAPACITY - 1) // FOLDER_PAGE_CAPACITY)
        structure["folder_name"] = folder_data.get("name", open_folder)
        return structure

    # Search results represent applications, not folder containers. Folder
    # icons remain available only in the normal Launchpad grid; apps assigned
    # to folders are deliberately kept searchable above.
    if not query:
        for folder_id, folder_data in folders.items():
            if "apps" in folder_data and folder_data["apps"]:
                folder_apps = []
                for app_id in folder_data["apps"]:
                    for app in apps:
                        if app["id"] == app_id:
                            folder_apps.append(app)
                            break
                if folder_apps:
                    structure["folders"].append({
                        "id": folder_id,
                        "name": folder_data.get("name", folder_id),
                        "apps": folder_apps
                    })

    # Top-level folders are real grid cells. If there are more folders than
    # fit on one page, paginate the folder grid before showing standalone apps.
    folder_pages = max(1, (len(structure["folders"]) + ITEMS_PER_PAGE - 1) // ITEMS_PER_PAGE) if structure["folders"] else 0
    first_app_capacity = ITEMS_PER_PAGE - len(structure["folders"]) if folder_pages == 1 else 0
    if folder_pages:
        remaining_after_first = max(0, len(ordered) - first_app_capacity)
        structure["total_pages"] = folder_pages + (
            (remaining_after_first + ITEMS_PER_PAGE - 1) // ITEMS_PER_PAGE
            if remaining_after_first else 0
        )
    else:
        structure["total_pages"] = max(1, (len(ordered) + ITEMS_PER_PAGE - 1) // ITEMS_PER_PAGE)

    return structure


def get_page(structure, page):
    """Get items for a specific page (0-indexed)."""
    items = []

    # If a folder is open, show its contents with a "back" item
    if structure.get("open_folder"):
        # Add "Back" item as first item
        items.append({
            "type": "back",
            "id": "back",
            "name": "← Back",
            "icon": "go-previous",
            "info": "Return to Launchpad"
        })
        start = page * FOLDER_PAGE_CAPACITY
        end = start + FOLDER_PAGE_CAPACITY
        page_apps = structure["apps"][start:end]
        for app in page_apps:
            items.append({
                "type": "app",
                "id": app["id"],
                "name": app["name"],
                "icon": app["icon"],
                "exec": app["exec"]
            })
        return items

    # Top-level folders occupy the grid before standalone apps. If folders
    # exceed one page, subsequent pages continue the folder grid.
    folder_count = len(structure["folders"])
    folder_pages = max(1, (folder_count + ITEMS_PER_PAGE - 1) // ITEMS_PER_PAGE) if folder_count else 0
    if folder_pages and page < folder_pages:
        start = page * ITEMS_PER_PAGE
        end = start + ITEMS_PER_PAGE
        for folder in structure["folders"][start:end]:
            items.append({
                "type": "folder",
                "id": folder["id"],
                "name": folder["name"],
                "icon": "folder",
                "count": len(folder["apps"])
            })
        if folder_pages == 1:
            app_start = 0
            app_end = ITEMS_PER_PAGE - folder_count
            page_apps = structure["apps"][app_start:app_end]
        else:
            page_apps = []
    else:
        if folder_pages == 1:
            first_capacity = ITEMS_PER_PAGE - folder_count
            start = first_capacity + (page - 1) * ITEMS_PER_PAGE
        else:
            start = (page - folder_pages) * ITEMS_PER_PAGE
        end = start + ITEMS_PER_PAGE
        page_apps = structure["apps"][start:end]

    for app in page_apps:
        items.append({
            "type": "app",
            "id": app["id"],
            "name": app["name"],
            "icon": app["icon"],
            "exec": app["exec"]
        })

    return items


def format_item(item, index):
    """Format item for rofi script mode."""
    if item["type"] == "folder":
        return f"{item['name']} ({item['count']})\0icon\x1f{item['icon']}\0info\x1ffolder:{item['id']}"
    elif item["type"] == "back":
        return f"{item['name']}\0icon\x1f{item['icon']}\0info\x1fback"
    elif item["type"] == "empty":
        return f"{item['name']}\0icon\x1f{item['icon']}\0info\x1fempty"
    else:
        return f"{item['name']}\0icon\x1f{item['icon']}\0info\x1fapp:{item['id']}"


def main():
    rofi_retv = os.environ.get("ROFI_RETV")
    rofi_mode = rofi_retv is not None
    rofi_info = os.environ.get("ROFI_INFO", "")
    rofi_data = os.environ.get("ROFI_DATA", "")

    # Rofi script mode invokes us with the selected row as argv[1]. Use
    # ROFI_INFO as a stable action ID instead of treating the row as a page.
    if rofi_mode and rofi_retv in ("10", "11"):
        try:
            state = json.loads(rofi_data) if rofi_data else {}
        except json.JSONDecodeError:
            state = {}
        try:
            page = int(state.get("page", 0))
        except (ValueError, TypeError):
            page = 0
        page += 1 if rofi_retv == "10" else -1
        state["page"] = max(0, page)
        rofi_data = json.dumps(state, separators=(",", ":"))

    if rofi_mode and rofi_retv == "1":
        if rofi_info.startswith("app:"):
            desktop_id = rofi_info[4:]
            if desktop_id:
                try:
                    subprocess.Popen(
                        ["gtk-launch", desktop_id],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                except OSError as exc:
                    print(f"Launch failed: {exc}", file=sys.stderr)
                    return 1
            return 0
        if rofi_info.startswith("folder:"):
            rofi_data = json.dumps({
                "page": 0,
                "query": "",
                "open_folder": rofi_info[7:],
            }, separators=(",", ":"))
        elif rofi_info == "back":
            rofi_data = json.dumps({
                "page": 0,
                "query": "",
                "open_folder": None,
            }, separators=(",", ":"))
        else:
            return 0

    try:
        state = json.loads(rofi_data) if rofi_data else {}
    except json.JSONDecodeError:
        state = {}

    try:
        page = int(state.get("page", 0))
    except (ValueError, TypeError):
        page = 0
    query = str(state.get("query", "")).strip()
    open_folder = state.get("open_folder")
    if open_folder == "":
        open_folder = None

    # Direct CLI compatibility: mv-launchpad <page> [query] [open_folder]
    if not rofi_mode and len(sys.argv) > 1:
        try:
            page = int(sys.argv[1])
        except ValueError:
            page = 0
        query = sys.argv[2].strip() if len(sys.argv) > 2 else query
        open_folder = sys.argv[3].strip() if len(sys.argv) > 3 else open_folder

    # Rofi script mode passes the current search text as argv[1] on retv=0.
    if rofi_mode and rofi_retv == "0":
        query = sys.argv[1].strip() if len(sys.argv) > 1 else ""
        page = 0

    # Load data
    apps = load_desktop_apps()
    folders = load_folders(apps)
    positions = load_positions()

    # Build structure
    structure = build_launchpad_structure(apps, folders, positions, query, open_folder)

    # Handle empty state
    if structure.get("empty") and page == 0:
        print("No applications found\0icon\x1fdialog-information\0info\x1fNo .desktop files found in standard locations")
        return 0

    # Handle empty search results
    if query and len(structure["apps"]) == 0 and not structure.get("open_folder"):
        if page == 0:
            print(f"No results for \"{query}\"\0icon\x1fdialog-information\0info\x1fTry a different search term")
            return 0

    # Handle empty folder
    if structure.get("open_folder") and len(structure["apps"]) == 0 and page == 0:
        print(f"Folder \"{structure.get('folder_name', 'Unknown')}\" is empty\0icon\x1fdialog-information\0info\x1fAdd apps to this folder in folders.json")
        # Still show the back button
        items = get_page(structure, page)
        for i, item in enumerate(items):
            print(format_item(item, i))
        return 0

    # Handle pagination
    total_pages = structure["total_pages"]
    page = max(0, min(page, total_pages - 1))

    # Get items for page
    items = get_page(structure, page)

    # Persist enough state for the next Rofi script-mode callback.
    print("\0data\x1f" + json.dumps({
        "page": page,
        "query": query,
        "open_folder": open_folder,
    }, separators=(",", ":")))

    # Output for rofi
    for i, item in enumerate(items):
        print(format_item(item, i))

    # Add navigation hints at the end
    if total_pages > 1:
        nav = f"Page {page + 1}/{total_pages} — PgUp/PgDn to navigate"
        print(f"\0icon\x1fgo-previous\0info\x1f{nav}")

    return 0


if __name__ == "__main__":
    sys.exit(main())