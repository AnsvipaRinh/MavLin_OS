#!/usr/bin/env python3
"""mv-close-window — Close the currently focused window (Super+W).

Mavericks-like: closes just the active window (not the whole app).
Sends WM_DELETE_WINDOW to the active window.
"""
import subprocess
import sys

def main():
    try:
        result = subprocess.run(
            ["xdotool", "getactivewindow", "windowclose"],
            capture_output=True, text=True, timeout=2
        )
        return result.returncode
    except Exception:
        return 1

if __name__ == "__main__":
    sys.exit(main())