#!/usr/bin/env python3
"""Mission Control: list windows grouped by workspace (Space) for overview UI.

Outputs JSON:
{
  "workspaces": [
    {
      "id": 1,
      "name": "Space 1",
      "windows": [
        {"wid": 12345, "title": "Finder", "app": "Thunar", "x": 100, "y": 100, "width": 800, "height": 600, "visible": true, "minimized": false},
        ...
      ]
    },
    ...
  ]
}

Union-merge reconciliation: enumeration is delegated to the shared
mission_control module (python-xlib path with wmctrl fallback) instead of
a parallel python3-ewmh dependency (not available in Arch repos).
"""
import sys
import os
import json

LIBDIR = "/usr/share/mavericks-apps"
for candidate in (LIBDIR, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib")):
    if os.path.isdir(candidate) and candidate not in sys.path:
        sys.path.insert(0, candidate)

try:
    import mission_control
except ImportError:
    print(json.dumps({"error": "Missing dependency: mission_control module (mavericks-apps)"}), file=sys.stderr)
    sys.exit(1)


def get_windows_by_workspace():
    windows = mission_control.enumerate_windows()
    workspaces = mission_control.get_workspaces() or {}
    current = int(workspaces.get("current", 0) or 0)
    count = int(workspaces.get("count", 0) or 0)
    names = workspaces.get("names") or []
    if count < 1:
        count = 1

    by_desktop = {}
    for win in windows:
        desktop = win.get("desktop", -1)
        if desktop is None or desktop < 0 or desktop == 0xFFFFFFFF:
            # Sticky/all-desktop windows present on the current Space
            desktop = current
        by_desktop.setdefault(int(desktop), []).append(win)

    result = []
    for ws_id in range(count):
        ws_windows = []
        for win in by_desktop.get(ws_id, []):
            geom = win.get("geometry") or {}
            state = win.get("state") or []
            minimized = "_NET_WM_STATE_HIDDEN" in state or not win.get("mapped", True)
            is_visible = not minimized and int(win.get("desktop", -1) or -1) in (ws_id, current)
            try:
                wid = int(str(win.get("win_id", "0")), 16) if str(win.get("win_id", "")).lower().startswith("0x") \
                    else int(win.get("win_id", 0))
            except (TypeError, ValueError):
                wid = 0
            wm_class = win.get("wm_class") or ""
            ws_windows.append({
                "wid": wid,
                "title": win.get("title") or "",
                "app": wm_class.split(".")[-1] if wm_class else "Unknown",
                "x": int(geom.get("x", 0)),
                "y": int(geom.get("y", 0)),
                "width": int(geom.get("width", 0)),
                "height": int(geom.get("height", 0)),
                "visible": is_visible,
                "minimized": minimized,
            })

        name = names[ws_id] if ws_id < len(names) and names[ws_id] else f"Space {ws_id + 1}"
        result.append({"id": ws_id + 1, "name": name, "windows": ws_windows})

    return {"workspaces": result}


if __name__ == "__main__":
    result = get_windows_by_workspace()
    print(json.dumps(result, indent=2, default=str))
