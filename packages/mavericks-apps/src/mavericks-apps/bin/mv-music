#!/usr/bin/env python3
"""mv-music — Mavericks-like Music wrapper for Lollypop.
Adds Mavericks visual theme and integration.
"""
import os
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

class MusicWrapper(Gtk.Window):
    def __init__(self):
        super().__init__(title="Music")
        self.set_default_size(900, 600)
        
        self.apply_css()
        
        # Header bar with Mavericks styling
        hb = Gtk.HeaderBar(title="Music", show_close_button=True)
        self.set_titlebar(hb)
        
        # Search
        search = Gtk.SearchEntry(placeholder_text="Search your library...")
        search.set_hexpand(True)
        hb.pack_start(search)
        
        # Sidebar toggle
        sidebar_btn = Gtk.ToggleButton()
        sidebar_btn.set_image(Gtk.Image.new_from_icon_name("view-sidebar", Gtk.IconSize.BUTTON))
        sidebar_btn.set_tooltip_text("Toggle Sidebar")
        hb.pack_end(sidebar_btn)
        
        # Main layout
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)
        
        # Sidebar
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sidebar.set_size_request(200, -1)
        sidebar.get_style_context().add_class("music-sidebar")
        
        # Library sections
        sections = [
            ("Library", "🎵", ["Songs", "Albums", "Artists", "Genres", "Downloaded"]),
            ("Playlists", "📋", ["Recently Added", "Top 25 Most Played", "Recently Played"]),
            ("Apple Music", "☁️", ["For You", "Browse", "Radio"]),
        ]
        
        for section_title, icon, items in sections:
            frame = Gtk.Frame(label=section_title)
            frame.get_style_context().add_class("music-sidebar-frame")
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            vbox.set_border_width(8)
            for item in items:
                btn = Gtk.Button(label=item)
                btn.get_style_context().add_class("sidebar-item")
                btn.set_halign(Gtk.Align.START)
                vbox.pack_start(btn, False, False, 0)
            frame.add(vbox)
            sidebar.pack_start(frame, False, False, 0)
        
        sidebar_sw = Gtk.ScrolledWindow()
        sidebar_sw.add(sidebar)
        paned.add1(sidebar_sw)
        
        # Main content - launch lollypop
        self.content = Gtk.Label(label="Launching Lollypop...")
        self.content.get_style_context().add_class("music-content")
        paned.add2(self.content)
        paned.set_position(220)
        
        # Launch lollypop in background
        GLib.timeout_add(100, self.launch_lollypop)
        
        self.show_all()

    def apply_css(self):
        css = b"""
        .music-sidebar {
            background: #f5f0e8;
            background-image: linear-gradient(180deg, #f5f0e8 0%, #e8ddd0 100%);
            border-right: 1px solid #d4c8b8;
        }
        .music-sidebar > viewport { background: transparent; }
        .music-sidebar-frame {
            border: none;
            background: transparent;
        }
        .music-sidebar-frame > label {
            font-weight: bold;
            color: #666;
            font-size: 9pt;
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .sidebar-item {
            background: transparent;
            border: none;
            border-radius: 4px;
            padding: 6px 12px;
            margin: 2px 8px;
            text-align: left;
        }
        .sidebar-item:hover {
            background: rgba(0,122,255,0.15);
        }
        .music-content {
            background: #f5f0e8;
            font-family: "San Francisco", sans-serif;
            font-size: 14pt;
            color: #666;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def launch_lollypop(self):
        try:
            subprocess.Popen(["lollypop"])
            self.content.set_markup('<span size="x-large" weight="bold">🎵 Music</span>\n\n<span color="#666">Lollypop launched in background.\nUse the sidebar to navigate your library.</span>')
        except FileNotFoundError:
            self.content.set_markup('<span color="#ff3b30">Lollypop not installed</span>\n\n<span color="#666">Install with: sudo pacman -S lollypop</span>')
        return False  # Don't repeat

import os
import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

if __name__ == "__main__":
    w = MusicWrapper()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()