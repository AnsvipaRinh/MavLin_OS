import sys
#!/usr/bin/env python3
"""mv-control — Mavericks-like Control Center with proper controls.
Features:
- Wi-Fi: toggle, network list, connect/disconnect
- Bluetooth: toggle, device list, pair/unpair
- Sound: volume slider, output device selection, mute
- Display: brightness slider, night shift toggle, arrangement
- Battery: percentage, power mode, energy settings
- Do Not Disturb: toggle
- Keyboard: brightness, Mission Control shortcuts
- Compact popup UI, exits on focus loss
"""
import os
import subprocess
import time
import json
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gio, GLib

WIFI_FALLBACK_POLL_S = 30
WIFI_REFRESH_DEBOUNCE_S = 1
WIFI_REFRESH_MIN_INTERVAL_S = 2
REFRESH_ALL_INTERVAL_S = 30


def sh(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        return ""


def run_async(cmd):
    try:
        subprocess.Popen(cmd)
    except Exception:
        pass


def pack_row(parent, row):
    if isinstance(parent, Gtk.ListBox):
        parent.add(row)
    else:
        parent.pack_start(row, False, False, 0)


class ControlCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Control Center", type=Gtk.WindowType.POPUP)
        self.set_default_size(340, 560)
        self.set_position(Gtk.WindowPosition.MOUSE)
        self.set_keep_above(True)

        # Main scrollable container
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_min_content_height(520)
        self.add(scrolled)

        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.main_box.set_border_width(16)
        scrolled.add(self.main_box)

        self._nm_bus = None
        self._wifi_signal_subs = []
        self._wifi_fallback_id = None
        self._wifi_pending = None
        self._wifi_last_refresh = 0.0
        self._refresh_all_id = None

        self.build_wifi_section()
        self.build_bluetooth_section()
        self.build_sound_section()
        self.build_display_section()
        self.build_battery_section()
        self.build_dnd_section()
        self.build_notifications_section()

        self.connect("focus-out-event", self.on_focus_out)
        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_destroy)

        # Refresh data periodically (30s: battery, power mode, DND change externally)
        self._refresh_all_id = GLib.timeout_add_seconds(REFRESH_ALL_INTERVAL_S, self.refresh_all)

        self.show_all()

    def build_section(self, title, icon_name):
        """Create a section frame with title."""
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(12)

        # Section header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        header.pack_start(icon, False, False, 0)
        label = Gtk.Label()
        label.set_markup(f"<b>{title}</b>")
        label.set_xalign(0)
        header.pack_start(label, True, True, 0)
        box.pack_start(header, False, False, 0)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        box.pack_start(sep, False, False, 0)

        frame.add(box)
        self.main_box.pack_start(frame, False, False, 0)
        return box

    def add_row(self, parent, label, value_widget, action_widget=None):
        """Add a row to a section."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_margin_top(4)
        row.set_margin_bottom(4)

        lbl = Gtk.Label(label=label)
        lbl.set_xalign(0)
        lbl.set_size_request(100, -1)
        row.pack_start(lbl, False, False, 0)

        row.pack_start(value_widget, True, True, 0)

        if action_widget:
            row.pack_start(action_widget, False, False, 0)

        parent.pack_start(row, False, False, 0)

    def add_info_row(self, parent, text, icon_name="dialog-information"):
        """Add an info row (for empty/error states)."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_margin_top(8)
        row.set_margin_bottom(8)
        row.set_margin_start(8)

        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        row.pack_start(icon, False, False, 0)

        lbl = Gtk.Label(label=text)
        lbl.set_xalign(0)
        lbl.set_line_wrap(True)
        row.pack_start(lbl, True, True, 0)

        pack_row(parent, row)

    # ==================== Wi-Fi ====================

    def build_wifi_section(self):
        box = self.build_section("Wi-Fi", "network-wireless")

        # Wi-Fi toggle
        self.wifi_switch = Gtk.Switch()
        self.wifi_switch.set_active(self.get_wifi_enabled())
        self.wifi_switch.connect("notify::active", self.on_wifi_toggle)
        self.add_row(box, "Wi-Fi", self.wifi_switch)

        # Network list
        self.wifi_listbox = Gtk.ListBox()
        self.wifi_listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.wifi_listbox.connect("row-activated", self.on_wifi_row_activated)
        self.refresh_wifi_list()
        box.pack_start(self.wifi_listbox, False, False, 0)

        refresh_btn = Gtk.Button(label="Refresh")
        refresh_btn.connect("clicked", lambda _: self.refresh_wifi_list(rescan=True))
        box.pack_start(refresh_btn, False, False, 0)

        self._subscribe_nm_wifi_signals()
        self._wifi_fallback_id = GLib.timeout_add_seconds(
            WIFI_FALLBACK_POLL_S, self._wifi_fallback_tick)

    def get_wifi_enabled(self):
        result = sh(["nmcli", "-t", "-f", "WIFI", "radio"])
        return result == "enabled"

    def on_wifi_toggle(self, switch, _):
        run_async(["nmcli", "radio", "wifi", "on" if switch.get_active() else "off"])
        GLib.timeout_add_seconds(2, self.refresh_wifi_list)

    def refresh_wifi_list(self, rescan=False):
        # Clear existing
        for child in self.wifi_listbox.get_children():
            self.wifi_listbox.remove(child)

        # Get networks. Default: use NM's cached AP list (--rescan no) so the 30s
        # fallback poll does not trigger a firmware scan every 30s. nmcli(1):
        # "ensures that the access point list is no older than 30 seconds and
        # triggers a network scan if necessary" -- with a 30s poll interval that
        # means a scan every ~30s while Control Center is open. NM D-Bus signals
        # (subscribed above) already refresh on AP changes; the explicit Refresh
        # button passes rescan=True to force a fresh scan.
        cmd = ["nmcli", "-t", "-f", "SSID,SECURITY,SIGNAL,ACTIVE", "dev", "wifi", "list",
               "--rescan", "yes" if rescan else "no"]
        result = sh(cmd)
        if not result:
            self.add_info_row(self.wifi_listbox, "NetworkManager not available or no networks found", "network-wireless-offline")
            self.wifi_listbox.show_all()
            return

        seen = set()
        has_networks = False
        for line in result.split("\n"):
            if not line:
                continue
            parts = line.split(":")
            if len(parts) >= 4:
                ssid, security, signal, active = parts[0], parts[1], parts[2], parts[3]
                if ssid and ssid not in seen:
                    seen.add(ssid)
                    has_networks = True
                    row = Gtk.ListBoxRow()
                    row.ssid = ssid
                    row.security = security
                    row.active = (active == "yes")
                    hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                    hbox.set_border_width(8)

                    # Signal icon
                    sig = int(signal) if signal.isdigit() else 0
                    if sig > 75:
                        icon_name = "network-wireless-signal-excellent"
                    elif sig > 50:
                        icon_name = "network-wireless-signal-good"
                    elif sig > 25:
                        icon_name = "network-wireless-signal-ok"
                    else:
                        icon_name = "network-wireless-signal-weak"
                    icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
                    hbox.pack_start(icon, False, False, 0)

                    # SSID
                    lbl = Gtk.Label(label=ssid)
                    lbl.set_xalign(0)
                    lbl.set_ellipsize(3)
                    hbox.pack_start(lbl, True, True, 0)

                    # Security
                    if security and security != "--":
                        sec_lbl = Gtk.Label(label="🔒")
                        sec_lbl.set_size_request(20, -1)
                        hbox.pack_start(sec_lbl, False, False, 0)

                    # Active indicator
                    if active == "yes":
                        act_lbl = Gtk.Label(label="●")
                        act_lbl.get_style_context().add_class("success")
                        hbox.pack_start(act_lbl, False, False, 0)

                    row.add(hbox)
                    self.wifi_listbox.add(row)

        if not has_networks:
            self.add_info_row(self.wifi_listbox, "No networks found", "network-wireless-offline")

        self.wifi_listbox.show_all()

    def on_wifi_row_activated(self, listbox, row):
        if not hasattr(row, 'ssid'):
            return
        ssid = row.ssid
        security = row.security
        active = row.active

        if active:
            # Disconnect
            run_async(["nmcli", "device", "disconnect", "wlan0"])
            GLib.timeout_add_seconds(2, self.refresh_wifi_list)
        elif security and security != "--":
            # Secured network - show password dialog
            self.show_wifi_password_dialog(ssid)
        else:
            # Open network - connect directly
            run_async(["nmcli", "device", "wifi", "connect", ssid])
            GLib.timeout_add_seconds(3, self.refresh_wifi_list)

    def show_wifi_password_dialog(self, ssid):
        dialog = Gtk.Dialog(title=f"Connect to {ssid}", parent=self, flags=Gtk.DialogFlags.MODAL)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        dialog.set_default_size(300, 120)

        box = dialog.get_content_area()
        box.set_border_width(16)
        box.set_spacing(12)

        lbl = Gtk.Label(label=f"Password for “{ssid}”:")
        lbl.set_xalign(0)
        box.pack_start(lbl, False, False, 0)

        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_activates_default(True)
        box.pack_start(entry, False, False, 0)

        dialog.show_all()

        response = dialog.run()
        password = entry.get_text()
        dialog.destroy()

        if response == Gtk.ResponseType.OK and password:
            run_async(["nmcli", "device", "wifi", "connect", ssid, "password", password])
            GLib.timeout_add_seconds(3, self.refresh_wifi_list)

    def _subscribe_nm_wifi_signals(self):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except Exception:
            return
        self._nm_bus = bus
        nm = "org.freedesktop.NetworkManager"
        for iface, member in (
            ("org.freedesktop.NetworkManager.Device.Wireless",
             "PropertiesChanged"),
            ("org.freedesktop.NetworkManager.Device.Wireless",
             "AccessPointAdded"),
            ("org.freedesktop.NetworkManager.Device.Wireless",
             "AccessPointRemoved"),
            ("org.freedesktop.NetworkManager.AccessPoint",
             "PropertiesChanged"),
            ("org.freedesktop.NetworkManager", "DeviceAdded"),
            ("org.freedesktop.NetworkManager", "DeviceRemoved"),
        ):
            try:
                self._wifi_signal_subs.append(bus.signal_subscribe(
                    nm, iface, member, None, None,
                    Gio.DBusSignalFlags.NONE, self._on_nm_wifi_signal))
            except Exception:
                pass

    def _on_nm_wifi_signal(self, *_args):
        if self._wifi_pending is not None:
            return
        self._wifi_pending = GLib.timeout_add_seconds(
            WIFI_REFRESH_DEBOUNCE_S, self._wifi_signal_refresh)

    def _wifi_signal_refresh(self):
        self._wifi_pending = None
        now = time.monotonic()
        if now - self._wifi_last_refresh < WIFI_REFRESH_MIN_INTERVAL_S:
            return False
        self._wifi_last_refresh = now
        self.refresh_wifi_list()
        return False

    def _wifi_fallback_tick(self):
        self._wifi_last_refresh = time.monotonic()
        self.refresh_wifi_list()
        return True

    def on_destroy(self, _w):
        for sub_id in self._wifi_signal_subs:
            try:
                if self._nm_bus is not None:
                    self._nm_bus.signal_unsubscribe(sub_id)
            except Exception:
                pass
        self._wifi_signal_subs = []
        if self._wifi_fallback_id is not None:
            GLib.source_remove(self._wifi_fallback_id)
            self._wifi_fallback_id = None
        if self._wifi_pending is not None:
            GLib.source_remove(self._wifi_pending)
            self._wifi_pending = None
        if self._refresh_all_id is not None:
            GLib.source_remove(self._refresh_all_id)
            self._refresh_all_id = None

    # ==================== Bluetooth ====================

    def build_bluetooth_section(self):
        box = self.build_section("Bluetooth", "bluetooth")

        self.bt_switch = Gtk.Switch()
        self.bt_switch.set_active(self.get_bt_enabled())
        self.bt_switch.connect("notify::active", self.on_bt_toggle)
        self.add_row(box, "Bluetooth", self.bt_switch)

        # Device list
        self.bt_listbox = Gtk.ListBox()
        self.bt_listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.refresh_bt_list()
        box.pack_start(self.bt_listbox, False, False, 0)

        # Open Bluetooth Settings button
        btn = Gtk.Button(label="Open Bluetooth Settings")
        btn.connect("clicked", lambda _: run_async(["blueman-manager"]))
        box.pack_start(btn, False, False, 0)

    def _bluez_get_objects(self):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            m = Gio.DBusMessage.new_method_call("org.bluez", "/",
                "org.freedesktop.DBus.ObjectManager", "GetManagedObjects")
            r = bus.send_message_with_reply_sync(m, 0, 500, None)
            if r:
                return r.get_body()
            return None
        except Exception:
            return None

    def get_bt_enabled(self):
        objects = self._bluez_get_objects()
        if objects is None:
            return False
        return any("org.bluez.Adapter1" in interfaces
                   for interfaces in objects.values())

    def on_bt_toggle(self, switch, _):
        run_async(["bluetoothctl", "power", "on" if switch.get_active() else "off"])
        GLib.timeout_add_seconds(2, self.refresh_bt_list)

    def refresh_bt_list(self):
        for child in self.bt_listbox.get_children():
            self.bt_listbox.remove(child)

        objects = self._bluez_get_objects()
        if objects is None:
            self.add_info_row(self.bt_listbox, "BlueZ not available", "bluetooth-disabled")
            self.bt_listbox.show_all()
            return

        devices_found = False
        for path, interfaces in objects.items():
            if "org.bluez.Device1" in interfaces:
                devices_found = True
                props = interfaces["org.bluez.Device1"]
                name = props.get("Name", "Unknown Device")
                connected = props.get("Connected", False)
                paired = props.get("Paired", False)
                icon_name = props.get("Icon", "audio-card")

                row = Gtk.ListBoxRow()
                hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                hbox.set_border_width(8)

                icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
                hbox.pack_start(icon, False, False, 0)

                vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                name_lbl = Gtk.Label(label=name)
                name_lbl.set_xalign(0)
                vbox.pack_start(name_lbl, False, False, 0)

                status_text = "Connected" if connected else ("Paired" if paired else "Available")
                status_lbl = Gtk.Label(label=status_text)
                status_lbl.set_xalign(0)
                status_lbl.get_style_context().add_class("dim-label")
                vbox.pack_start(status_lbl, False, False, 0)

                hbox.pack_start(vbox, True, True, 0)

                if connected:
                    btn = Gtk.Button(label="Disconnect")
                    btn.connect("clicked", lambda _, p=path: self.bt_disconnect(p))
                elif paired:
                    btn = Gtk.Button(label="Connect")
                    btn.connect("clicked", lambda _, p=path: self.bt_connect(p))
                else:
                    btn = Gtk.Button(label="Pair")
                    btn.connect("clicked", lambda _, p=path: self.bt_pair(p))
                btn.set_size_request(80, -1)
                hbox.pack_start(btn, False, False, 0)

                row.add(hbox)
                self.bt_listbox.add(row)

        if not devices_found:
            self.add_info_row(self.bt_listbox, "No Bluetooth devices found", "bluetooth-disabled")

        self.bt_listbox.show_all()

    def bt_connect(self, device_path):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            m = Gio.DBusMessage.new_method_call("org.bluez", device_path,
                "org.bluez.Device1", "Connect")
            bus.send_message_with_reply_sync(m, 0, 5000, None)
            GLib.timeout_add_seconds(2, self.refresh_bt_list)
        except Exception:
            pass

    def bt_disconnect(self, device_path):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            m = Gio.DBusMessage.new_method_call("org.bluez", device_path,
                "org.bluez.Device1", "Disconnect")
            bus.send_message_with_reply_sync(m, 0, 5000, None)
            GLib.timeout_add_seconds(2, self.refresh_bt_list)
        except Exception:
            pass

    def bt_pair(self, device_path):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            m = Gio.DBusMessage.new_method_call("org.bluez", device_path,
                "org.bluez.Device1", "Pair")
            bus.send_message_with_reply_sync(m, 0, 10000, None)
            GLib.timeout_add_seconds(2, self.refresh_bt_list)
        except Exception:
            pass

    # ==================== Sound ====================

    def build_sound_section(self):
        box = self.build_section("Sound", "audio-card")

        # Volume slider
        vol_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl = Gtk.Label(label="Output Volume")
        lbl.set_xalign(0)
        lbl.set_size_request(100, -1)
        vol_box.pack_start(lbl, False, False, 0)

        self.volume_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume_scale.set_value(self.get_volume())
        self.volume_scale.set_digits(0)
        self.volume_scale.set_hexpand(True)
        self.volume_scale.connect("value-changed", self.on_volume_change)
        vol_box.pack_start(self.volume_scale, True, True, 0)

        self.mute_btn = Gtk.ToggleButton()
        self.mute_btn.set_image(Gtk.Image.new_from_icon_name("audio-volume-muted", Gtk.IconSize.BUTTON))
        self.mute_btn.set_active(self.get_mute())
        self.mute_btn.connect("toggled", self.on_mute_toggle)
        vol_box.pack_start(self.mute_btn, False, False, 0)

        box.pack_start(vol_box, False, False, 0)

        # Output device
        self.output_combo = Gtk.ComboBoxText()
        self.output_combo.connect("changed", self.on_output_device_changed)
        self.refresh_output_devices()
        self.add_row(box, "Output Device", self.output_combo)

    def get_volume(self):
        result = sh(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
        import re
        match = re.search(r"(\d+)%", result)
        return int(match.group(1)) if match else 50

    def get_mute(self):
        result = sh(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])
        return "yes" in result.lower()

    def on_volume_change(self, scale):
        val = int(scale.get_value())
        run_async(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{val}%"])

    def on_mute_toggle(self, btn):
        run_async(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle" if btn.get_active() else "false"])

    def refresh_output_devices(self):
        self.output_combo.remove_all()
        self.output_sinks = []

        # Get default sink first
        default_sink = sh(["pactl", "get-default-sink"])

        # Get sinks
        result = sh(["pactl", "list", "short", "sinks"])
        if not result:
            self.output_combo.append_text("PulseAudio not available")
            self.output_combo.set_sensitive(False)
            return

        self.output_combo.set_sensitive(True)
        for line in result.split("\n"):
            if line:
                parts = line.split("\t")
                if len(parts) >= 2:
                    sink_name = parts[1]
                    self.output_sinks.append(sink_name)
                    display_name = sink_name
                    if sink_name == default_sink:
                        display_name += " (default)"
                    self.output_combo.append_text(display_name)

        # Set active to default
        for i, sink in enumerate(self.output_sinks):
            if sink == default_sink:
                self.output_combo.set_active(i)
                break

    def on_output_device_changed(self, combo):
        active = combo.get_active()
        if active >= 0 and active < len(self.output_sinks):
            sink = self.output_sinks[active]
            run_async(["pactl", "set-default-sink", sink])

    # ==================== Display ====================

    def build_display_section(self):
        box = self.build_section("Display", "video-display")

        # Brightness slider
        bright_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl = Gtk.Label(label="Brightness")
        lbl.set_xalign(0)
        lbl.set_size_request(100, -1)
        bright_box.pack_start(lbl, False, False, 0)

        self.brightness_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        val, self.bpath = self.get_brightness()
        self.brightness_scale.set_value(val)
        self.brightness_scale.set_digits(0)
        self.brightness_scale.set_hexpand(True)

        if self.bpath is None:
            self.brightness_scale.set_sensitive(False)
            self.add_info_row(box, "Brightness control not available on this hardware", "video-display")
        else:
            self.brightness_scale.connect("value-changed", self.on_brightness_change)
            bright_box.pack_start(self.brightness_scale, True, True, 0)
            box.pack_start(bright_box, False, False, 0)

        # Night Shift toggle (placeholder - requires redshift/gnome-night-light)
        self.night_shift = Gtk.Switch()
        self.night_shift.set_sensitive(False)
        self.add_row(box, "Night Shift", self.night_shift)
        self.add_info_row(box, "Night Shift requires redshift or GNOME Night Light (not installed)", "dialog-information")

        # Display settings button
        btn = Gtk.Button(label="Display Settings")
        btn.connect("clicked", lambda _: run_async(["xfce4-display-settings"]))
        box.pack_start(btn, False, False, 0)

    def get_brightness(self):
        if not os.path.isdir("/sys/class/backlight"):
            return 50, None
        for d in os.listdir("/sys/class/backlight"):
            base = f"/sys/class/backlight/{d}"
            try:
                with open(base + "/brightness") as f:
                    cur = int(f.read())
                with open(base + "/max_brightness") as f:
                    mx = int(f.read())
                return cur * 100 // max(mx, 1), base
            except OSError:
                continue
        return 50, None

    def on_brightness_change(self, scale):
        if not self.bpath:
            return
        val = int(scale.get_value())
        try:
            with open(self.bpath + "/max_brightness") as f:
                mx = int(f.read())
            target = max(1, val * mx // 100)
            with open(self.bpath + "/brightness", "w") as f:
                f.write(str(target))
        except Exception:
            pass

    # ==================== Battery ====================

    def build_battery_section(self):
        box = self.build_section("Battery", "battery")

        # Battery info
        info = self.get_battery_info()
        if "Status" in info and info["Status"] == "No battery detected":
            self.add_info_row(box, "No battery detected", "battery-missing")
        else:
            for k, v in info.items():
                lbl = Gtk.Label(label=f"{k}: {v}")
                lbl.set_xalign(0)
                box.pack_start(lbl, False, False, 0)

        # Power mode
        self.power_mode = Gtk.ComboBoxText()
        self.power_mode.append_text("Balanced")
        self.power_mode.append_text("Power Saver")
        self.power_mode.append_text("Performance")
        self.refresh_power_mode()
        self.power_mode.connect("changed", self.on_power_mode_changed)
        self.add_row(box, "Power Mode", self.power_mode)

    def get_battery_info(self):
        result = sh(["upower", "-i", "/org/freedesktop/UPower/devices/battery_BAT0"])
        info = {}
        for line in result.split("\n"):
            if "percentage" in line:
                info["Charge"] = line.split(":")[1].strip()
            elif "state" in line:
                info["State"] = line.split(":")[1].strip()
            elif "time to" in line:
                info["Time"] = line.split(":")[1].strip()
        return info if info else {"Status": "No battery detected"}

    def refresh_power_mode(self):
        # Try to get current TLP mode
        current = self.get_tlp_mode()
        mode_map = {"balanced": 0, "powersave": 1, "performance": 2}
        self.power_mode.set_active(mode_map.get(current, 0))

    def get_tlp_mode(self):
        # TLP doesn't have a simple "get mode" command, check tlp-stat or config
        result = sh(["tlp-stat", "-c"])
        for line in result.split("\n"):
            if "CPU_SCALING_GOVERNOR_ON_BAT" in line and "powersave" in line:
                return "powersave"
            elif "CPU_SCALING_GOVERNOR_ON_AC" in line and "performance" in line:
                return "performance"
        return "balanced"

    def on_power_mode_changed(self, combo):
        mode_map = {0: "balanced", 1: "powersave", 2: "performance"}
        mode = mode_map.get(combo.get_active(), "balanced")
        # TLP mode switching requires root, so we can only show current state
        # For actual switching, would need polkit or sudo - show info
        self.show_info_dialog("Power Mode", 
            f"Power mode set to {mode}. Changing TLP mode requires root privileges.\n"
            f"Run: sudo tlp set-mode {mode}")

    def show_info_dialog(self, title, message):
        dialog = Gtk.MessageDialog(parent=self, flags=Gtk.DialogFlags.MODAL,
                                    type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK,
                                    message_format=message)
        dialog.set_title(title)
        dialog.run()
        dialog.destroy()

    # ==================== Do Not Disturb ====================

    def build_dnd_section(self):
        box = self.build_section("Focus", "preferences-system")

        self.dnd_switch = Gtk.Switch()
        self.dnd_switch.set_active(self.get_dnd())
        self.dnd_switch.connect("notify::active", self.on_dnd_toggle)
        self.add_row(box, "Do Not Disturb", self.dnd_switch)

    def get_dnd(self):
        result = sh(["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb"])
        return result == "true"

    def on_dnd_toggle(self, switch, _):
        run_async(["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb", "-s", 
                   "true" if switch.get_active() else "false"])

    # ==================== Notifications ====================

    def build_notifications_section(self):
        box = self.build_section("Notifications", "mail-read")

        # Open Notification Center button
        open_btn = Gtk.Button(label="Open Notification Center")
        open_btn.connect("clicked", self.on_open_notification_center)
        box.pack_start(open_btn, False, False, 0)

        # Recent notifications list (up to 5)
        self.notif_listbox = Gtk.ListBox()
        self.notif_listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.refresh_notifications()
        box.pack_start(self.notif_listbox, False, False, 0)

    def refresh_notifications(self):
        for child in self.notif_listbox.get_children():
            self.notif_listbox.remove(child)

        notifications = self.load_notifications()
        if not notifications:
            self.add_info_row(self.notif_listbox, "No recent notifications", "mail-read")
        else:
            for n in notifications[:5]:
                self.add_notification_row(n)

        self.notif_listbox.show_all()

    def load_notifications(self):
        store_file = os.path.expanduser("~/.local/share/mavericks/notifications.json")
        try:
            with open(store_file) as f:
                data = json.load(f)
                if isinstance(data, list):
                    return data[-10:]  # Last 10, newest first
        except (OSError, ValueError):
            pass
        return []

    def add_notification_row(self, item):
        row = Gtk.ListBoxRow()
        row.set_activatable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_border_width(8)

        # App icon
        icon_name = item.get("icon") or "dialog-information"
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        box.pack_start(icon, False, False, 0)

        # Content
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        content.set_hexpand(True)

        summary = item.get("summary", "")
        body = item.get("body", "")
        timestamp = item.get("timestamp", 0)

        summary_lbl = Gtk.Label()
        summary_lbl.set_markup(f"<b>{GLib.markup_escape_text(summary)}</b>")
        summary_lbl.set_xalign(0)
        summary_lbl.set_ellipsize(3)
        content.pack_start(summary_lbl, False, False, 0)

        if body:
            body_lbl = Gtk.Label(label=body[:80] + ("..." if len(body) > 80 else ""))
            body_lbl.set_xalign(0)
            body_lbl.get_style_context().add_class("dim-label")
            content.pack_start(body_lbl, False, False, 0)

        time_lbl = Gtk.Label(label=self.format_time(timestamp))
        time_lbl.get_style_context().add_class("dim-label")
        time_lbl.set_xalign(0)
        content.pack_start(time_lbl, False, False, 0)

        box.pack_start(content, True, True, 0)
        row.add(box)
        self.notif_listbox.add(row)

    def format_time(self, timestamp):
        import time
        now = int(time.time())
        diff = now - timestamp
        if diff < 60:
            return "Just now"
        elif diff < 3600:
            return f"{diff // 60} min ago"
        elif diff < 86400:
            return f"{diff // 3600} hours ago"
        else:
            return time.strftime("%b %d", time.localtime(timestamp))

    def on_open_notification_center(self, _):
        run_async(["mv-notification-center"])
        self.destroy()

    # ==================== Common ====================

    def refresh_all(self):
        try:
            self.wifi_switch.set_active(self.get_wifi_enabled())
        except Exception:
            pass
        try:
            bt_on = self.get_bt_enabled()
            self.bt_switch.set_active(bt_on)
            if bt_on:
                self.refresh_bt_list()
        except Exception:
            pass
        try:
            self.refresh_power_mode()
        except Exception:
            pass
        try:
            self.dnd_switch.set_active(self.get_dnd())
        except Exception:
            pass
        return True  # Continue timeout

    def on_focus_out(self, widget, event):
        Gtk.main_quit()
        return True

    def on_key_press(self, widget, event):
        if event.keyval == 65307:  # Escape
            Gtk.main_quit()
            return True
        return False


if __name__ == "__main__":
    sys.path.insert(0, "/usr/share/mavericks-apps")
    from mavericks_appmenu import run_application
    sys.exit(run_application(
        "com.mavlinos.ControlCenter", "Control Center", ControlCenter, sys.argv))
