#!/usr/bin/env python3
"""mv-photos — Mavericks-like Photos frontend.
Library engine (pure, headless-testable): native EXIF date parsing,
image dimension header reading, Moments grouping, favorites, albums,
import tracking, search. GUI: GTK3 Mavericks-styled grid with sidebar,
search, slideshow, and gthumb handoff for editing. No daemon, no polling.
License: GPL-2.0-or-later."""
import cairo
import gi
import hashlib
import json
import os
import shutil
import struct
import subprocess
import sys
import time

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk

SUPPORTED_EXTS = (".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".tif",
                  ".webp", ".heic")
IMAGE_MIMES = ("image/jpeg", "image/png", "image/gif", "image/bmp",
               "image/tiff", "image/webp", "image/heic")

STATE_ENV = "MV_PHOTOS_STATE"
LIBRARY_ENV = "MV_PHOTOS_LIBRARY"
DEFAULT_LIBRARY = "~/Pictures"
THUMB_SIZE = 150
SLIDE_INTERVAL = 3000


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def fmt_date(iso):
    if not iso:
        return ""
    return iso[:10]


def fmt_size(n):
    try:
        n = int(n)
    except (TypeError, ValueError):
        return "?"
    if n < 1024:
        return "%d B" % n
    if n < 1024 * 1024:
        return "%.1f KB" % (n / 1024)
    return "%.1f MB" % (n / (1024 * 1024))


# ---------------------------------------------------------------- image info

HEADER_READ_LIMIT = 512 * 1024


def _read_header(path, limit=HEADER_READ_LIMIT):
    """Single open: read first 64 bytes, then up to `limit` total for JPEG
    (EXIF lives past the 64-byte sniff window). Returns blob or None."""
    try:
        with open(path, "rb") as f:
            head = f.read(64)
            if len(head) >= 2 and head[:2] == b"\xff\xd8":
                rest = f.read(limit - 64)
                return head + rest
            return head
    except Exception:
        return None


def _dimensions_from_blob(ext, blob):
    if ext in (".jpg", ".jpeg"):
        return _jpeg_dimensions_blob(blob)
    if ext == ".png":
        if blob[:8] != b"\x89PNG\r\n\x1a\n" or len(blob) < 24:
            return None, None
        if blob[12:16] != b"IHDR":
            return None, None
        w, h = struct.unpack(">II", blob[16:24])
        if w == 0 or h == 0 or w > 100000 or h > 100000:
            return None, None
        return w, h
    if ext == ".gif":
        if blob[:3] not in (b"GIF",) or len(blob) < 10:
            return None, None
        w, h = struct.unpack("<HH", blob[6:10])
        return w, h
    if ext == ".bmp":
        if blob[:2] != b"BM" or len(blob) < 26:
            return None, None
        w, h = struct.unpack("<ii", blob[18:26])
        return abs(w), abs(h)
    if ext in (".tiff", ".tif"):
        return _tiff_dimensions(blob)
    if ext == ".webp":
        return _webp_dimensions(blob)
    return None, None


def read_image_dimensions(path):
    """Read image dimensions from file header. Never raises."""
    try:
        ext = os.path.splitext(path)[1].lower()
        if ext not in SUPPORTED_EXTS:
            return None, None
        blob = _read_header(path)
        if not blob:
            return None, None
        return _dimensions_from_blob(ext, blob)
    except Exception:
        return None, None


def _jpeg_dimensions_blob(blob):
    try:
        if len(blob) < 4 or blob[:2] != b"\xff\xd8":
            return None, None
        pos = 2
        while pos + 4 <= len(blob):
            if blob[pos] != 0xff:
                pos += 1
                continue
            marker = blob[pos + 1]
            if marker == 0xd9:
                break
            if marker == 0xda:
                break
            if pos + 4 > len(blob):
                break
            seglen = struct.unpack(">H", blob[pos + 2:pos + 4])[0]
            if marker in (0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7,
                           0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf):
                if pos + 9 <= len(blob):
                    h, w = struct.unpack(">HH", blob[pos + 5:pos + 9])
                    return w, h
            pos += 2 + seglen
    except Exception:
        pass
    return None, None


def _tiff_dimensions(blob):
    try:
        bo = blob[:2]
        if bo == b"II":
            e = "<"
        elif bo == b"MM":
            e = ">"
        else:
            return None, None
        if struct.unpack(e + "H", blob[2:4])[0] != 42:
            return None, None
        ifd_off = struct.unpack(e + "I", blob[4:8])[0]
        if ifd_off + 2 > len(blob):
            return None, None
        count = struct.unpack(e + "H", blob[ifd_off:ifd_off + 2])[0]
        pos = ifd_off + 2
        w = h = None
        for _ in range(count):
            if pos + 12 > len(blob):
                break
            tag, typ = struct.unpack(e + "HH", blob[pos:pos + 4])
            val = struct.unpack(e + "I", blob[pos + 8:pos + 12])[0]
            if tag == 256:
                w = val
            elif tag == 257:
                h = val
            pos += 12
        if w and h:
            return w, h
    except Exception:
        pass
    return None, None


def _webp_dimensions(blob):
    try:
        if blob[:4] != b"RIFF" or blob[8:12] != b"WEBP":
            return None, None
        fmt = blob[12:16]
        if fmt == b"VP8 ":
            w, h = struct.unpack("<HH", blob[26:30])
            return w & 0x3fff, h & 0x3fff
        if fmt == b"VP8L":
            bits = struct.unpack("<I", blob[21:25])[0]
            w = (bits & 0x3fff) + 1
            h = ((bits >> 14) & 0x3fff) + 1
            return w, h
        if fmt == b"VP8X":
            w = struct.unpack("<I", b"\x00" + blob[24:27])[0] + 1
            h = struct.unpack("<I", b"\x00" + blob[27:30])[0] + 1
            return w, h
    except Exception:
        pass
    return None, None


# ---------------------------------------------------------------------- EXIF


def _exif_from_blob(blob):
    try:
        if len(blob) < 4 or blob[:2] != b"\xff\xd8":
            return None
        pos = 2
        while pos + 4 <= len(blob):
            if blob[pos] != 0xff:
                pos += 1
                continue
            marker = blob[pos + 1]
            if marker == 0xd9:
                break
            if marker == 0xda:
                break
            if pos + 4 > len(blob):
                break
            seglen = struct.unpack(">H", blob[pos + 2:pos + 4])[0]
            if marker == 0xe1 and seglen > 14:
                seg = blob[pos + 4:pos + 2 + seglen]
                if seg[:6] == b"Exif\x00\x00":
                    dt = _exif_datetime(seg[6:])
                    if dt:
                        return dt
            pos += 2 + seglen
    except Exception:
        pass
    return None


def read_exif_date(path):
    """Extract DateTimeOriginal from JPEG EXIF. Returns ISO string or None."""
    try:
        ext = os.path.splitext(path)[1].lower()
        if ext not in (".jpg", ".jpeg"):
            return None
        blob = _read_header(path)
        if not blob:
            return None
        return _exif_from_blob(blob)
    except Exception:
        return None


def read_image_info(path):
    """Single-open combined read: dimensions + EXIF date from one header
    blob. Returns (width, height, date_iso_or_None). Never raises."""
    try:
        ext = os.path.splitext(path)[1].lower()
        if ext not in SUPPORTED_EXTS:
            return None, None, None
        blob = _read_header(path)
        if not blob:
            return None, None, None
        w, h = _dimensions_from_blob(ext, blob)
        date = _exif_from_blob(blob) if ext in (".jpg", ".jpeg") else None
        return w, h, date
    except Exception:
        return None, None, None


def _exif_datetime(tiff_blob):
    try:
        bo = tiff_blob[:2]
        if bo == b"II":
            e = "<"
        elif bo == b"MM":
            e = ">"
        else:
            return None
        if struct.unpack(e + "H", tiff_blob[2:4])[0] != 42:
            return None
        ifd_off = struct.unpack(e + "I", tiff_blob[4:8])[0]
        if ifd_off + 2 > len(tiff_blob):
            return None
        count = struct.unpack(e + "H", tiff_blob[ifd_off:ifd_off + 2])[0]
        pos = ifd_off + 2
        tags_to_find = {0x9003: "dt", 0x0132: "dt2", 0x9004: "dt3"}
        found = {}
        for _ in range(count):
            if pos + 12 > len(tiff_blob):
                break
            tag, typ = struct.unpack(e + "HH", tiff_blob[pos:pos + 4])
            if tag in tags_to_find:
                count_bytes = struct.unpack(e + "I", tiff_blob[pos + 4:pos + 8])[0]
                if typ == 2:
                    if count_bytes <= 4:
                        raw = tiff_blob[pos + 8:pos + 8 + count_bytes]
                    else:
                        off = struct.unpack(e + "I", tiff_blob[pos + 8:pos + 12])[0]
                        raw = tiff_blob[off:off + count_bytes]
                    val = raw.rstrip(b"\x00").decode("ascii", "replace")
                    found[tags_to_find[tag]] = val
            pos += 12
        for key in ("dt", "dt2", "dt3"):
            if key in found:
                v = found[key]
                if len(v) >= 19 and v[4] == ":" and v[7] == ":":
                    return "%s-%s-%sT%s" % (v[0:4], v[5:7], v[8:10], v[11:])
                if len(v) >= 10 and v[4] == "-" and v[7] == "-":
                    return v
    except Exception:
        pass
    return None


# -------------------------------------------------------------- library scan


def scan_library(root):
    """Scan root for image files. Returns (photos, error_count).
    Each photo: path, filename, ext, mtime, size, date (ISO or None),
    width, height. Sorted by mtime descending.
    Uses an mtime+size+count-keyed cache: a hit skips re-reading every
    file header/EXIF (the walk+stat fingerprint is the invalidation
    check). Corrupt cache is quarantined, never silently lost."""
    if not root or not os.path.isdir(root):
        return [], 0
    fp, count = _scan_fingerprint(root)
    cached = load_scan_cache(root, fp, count)
    if cached is not None:
        return cached, 0
    photos = []
    errors = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            ext = os.path.splitext(name)[1].lower()
            if ext not in SUPPORTED_EXTS:
                continue
            try:
                st = os.stat(path)
                w, h, date = read_image_info(path)
                photos.append({
                    "path": path,
                    "filename": name,
                    "ext": ext,
                    "mtime": st.st_mtime,
                    "size": st.st_size,
                    "date": date,
                    "width": w,
                    "height": h,
                })
            except Exception:
                errors += 1
    photos.sort(key=lambda p: p["mtime"], reverse=True)
    save_scan_cache(root, photos, fp, count)
    return photos, errors


# -------------------------------------------------------------- scan cache

def scan_cache_dir():
    d = os.path.expanduser("~/.cache/mv-photos")
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        d = None
    return d


def scan_cache_path():
    d = scan_cache_dir()
    return os.path.join(d, "scan.json") if d else None


def _scan_fingerprint(root):
    """Hash of (path, mtime_ns, size) for supported files + count.
    Add/remove changes the set+count; modify changes mtime_ns."""
    h = hashlib.sha1()
    count = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            if os.path.splitext(name)[1].lower() not in SUPPORTED_EXTS:
                continue
            try:
                st = os.stat(path)
            except OSError:
                continue
            h.update(path.encode("utf-8", "replace"))
            h.update(str(st.st_mtime_ns).encode())
            h.update(str(st.st_size).encode())
            count += 1
    return h.hexdigest(), count


def _read_json_safe(path):
    """Read JSON cache; on any error quarantine the corrupt file (family
    pattern: never silently lost) and return None (cache miss)."""
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        pass
    try:
        os.replace(path, "%s.corrupt-%d" % (path, int(time.time())))
    except OSError:
        pass
    return None


def load_scan_cache(root, fp=None, count=None):
    """Return cached photos for root, or None on miss/corrupt/stale."""
    path = scan_cache_path()
    if not path or not root:
        return None
    if fp is None or count is None:
        fp, count = _scan_fingerprint(root)
    data = _read_json_safe(path)
    if not isinstance(data, dict):
        return None
    entry = data.get("roots", {}).get(root)
    if not isinstance(entry, dict):
        return None
    if entry.get("fp") != fp or entry.get("count") != count:
        return None
    photos = entry.get("photos")
    if not isinstance(photos, list):
        return None
    return photos


def save_scan_cache(root, photos, fp=None, count=None):
    path = scan_cache_path()
    if not path or not root:
        return
    if fp is None or count is None:
        fp, count = _scan_fingerprint(root)
    data = _read_json_safe(path)
    if not isinstance(data, dict):
        data = {}
    roots = data.get("roots")
    if not isinstance(roots, dict):
        roots = {}
    roots[root] = {"fp": fp, "count": count, "photos": photos}
    data["roots"] = roots
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except OSError:
        pass


def group_by_moment(photos):
    """Group photos by date string (YYYY-MM-DD). Returns list of
    {date, count, photos} sorted by date descending."""
    groups = {}
    for p in photos:
        d = fmt_date(p.get("date")) or "Unknown"
        groups.setdefault(d, []).append(p)
    out = [{"date": d, "count": len(ps), "photos": ps}
           for d, ps in groups.items()]
    out.sort(key=lambda g: g["date"], reverse=True)
    return out


def search_photos(photos, query):
    q = (query or "").strip().lower()
    if not q:
        return list(photos)
    out = []
    for p in photos:
        fn = p.get("filename", "").lower()
        dt = fmt_date(p.get("date")).lower()
        if q in fn or q in dt:
            out.append(p)
    return out


# -------------------------------------------------------------- state store


def default_state():
    return {"favorites": [], "albums": [], "imports": [],
            "geometry": {}, "library": None}


def _state_path():
    return os.environ.get(STATE_ENV) or os.path.expanduser(
        "~/.config/mv-photos/state.json")


def _backup_path(path):
    return path + ".bak"


def _quarantine_path(path):
    return "%s.corrupt-%d" % (path, int(time.time()))


def load_state(path=None, on_warn=None):
    path = path or _state_path()

    def warn(msg):
        if on_warn:
            on_warn(msg)

    if not os.path.exists(path):
        return default_state()
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        bak = _backup_path(path)
        if os.path.exists(bak):
            try:
                with open(bak) as f:
                    data = json.load(f)
                warn("Photos state was unreadable (%s); restored from backup." % e)
                return _normalize_state(data)
            except (OSError, ValueError):
                pass
        try:
            os.replace(path, _quarantine_path(path))
        except OSError:
            pass
        warn("Photos state was unreadable (%s); the corrupt file was "
             "quarantined and a fresh state was started." % e)
        return default_state()
    return _normalize_state(data)


def save_state(path=None, data=None):
    path = path or _state_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        try:
            os.replace(path, _backup_path(path))
        except OSError:
            pass
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def _normalize_state(data):
    if not isinstance(data, dict):
        return default_state()
    st = default_state()
    if isinstance(data.get("favorites"), list):
        st["favorites"] = [str(p) for p in data["favorites"]]
    if isinstance(data.get("albums"), list):
        for a in data["albums"]:
            if isinstance(a, dict) and isinstance(a.get("name"), str):
                albums_item = {"name": a["name"], "paths": []}
                if isinstance(a.get("paths"), list):
                    albums_item["paths"] = [str(p) for p in a["paths"]]
                st["albums"].append(albums_item)
    if isinstance(data.get("imports"), list):
        for imp in data["imports"]:
            if isinstance(imp, dict) and isinstance(imp.get("path"), str):
                imp_item = {"path": imp["path"], "at": ""}
                if isinstance(imp.get("at"), str):
                    imp_item["at"] = imp["at"]
                st["imports"].append(imp_item)
    geo = data.get("geometry")
    if isinstance(geo, dict):
        for k in ("w", "h"):
            v = geo.get(k)
            if isinstance(v, (int, float)) and v > 0:
                st["geometry"][k] = v
        if isinstance(geo.get("sidebar"), (int, float)):
            st["geometry"]["sidebar"] = geo["sidebar"]
    if isinstance(data.get("library"), str):
        st["library"] = data["library"]
    return st


def toggle_favorite(state, path):
    st = dict(state)
    favs = list(state.get("favorites") or [])
    if path in favs:
        favs.remove(path)
    else:
        favs.append(path)
    st["favorites"] = favs
    return st


def add_album(state, name):
    st = dict(state)
    albums = list(state.get("albums") or [])
    if not any(a["name"] == name for a in albums):
        albums.append({"name": name, "paths": []})
    st["albums"] = albums
    return st


def remove_album(state, name):
    st = dict(state)
    st["albums"] = [a for a in state.get("albums") or [] if a["name"] != name]
    return st


def album_add_photo(state, album_name, path):
    st = dict(state)
    albums = list(state.get("albums") or [])
    for a in albums:
        if a["name"] == album_name:
            if path not in a["paths"]:
                a["paths"].append(path)
            break
    st["albums"] = albums
    return st


def album_remove_photo(state, album_name, path):
    st = dict(state)
    albums = list(state.get("albums") or [])
    for a in albums:
        if a["name"] == album_name:
            a["paths"] = [p for p in a["paths"] if p != path]
            break
    st["albums"] = albums
    return st


def record_import(state, folder_path):
    st = dict(state)
    imports = list(state.get("imports") or [])
    imports.append({"path": folder_path, "at": now_iso()})
    st["imports"] = imports[-200:]
    return st


def photos_for_album(state, album_name, all_photos):
    for a in state.get("albums") or []:
        if a["name"] == album_name:
            path_set = set(a["paths"])
            return [p for p in all_photos if p["path"] in path_set]
    return []


# ------------------------------------------------------------------- thumbs


def thumbs_dir():
    d = os.path.expanduser("~/.cache/mv-photos/thumbs")
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        d = None
    return d


def thumb_path(photo):
    try:
        st = os.stat(photo["path"])
        import hashlib
        h = hashlib.sha1()
        h.update(photo["path"].encode("utf-8", "replace"))
        h.update(str(st.st_size).encode())
        h.update(str(int(st.st_mtime)).encode())
        return os.path.join(thumbs_dir(), h.hexdigest() + ".png")
    except Exception:
        return None


def ensure_thumb(photo):
    tp = thumb_path(photo)
    if tp and os.path.exists(tp):
        return tp
    try:
        with open(photo["path"], "rb") as f:
            blob = f.read()
        bytes_obj = GLib.Bytes.new(blob)
        stream = Gio.MemoryInputStream.new_from_bytes(bytes_obj)
        pix = GdkPixbuf.Pixbuf.new_from_stream_at_scale(
            stream, THUMB_SIZE, THUMB_SIZE, True, None)
        stream.close(None)
        if tp:
            pix.savev(tp, "png", [], [])
        return tp
    except Exception:
        return None


# -------------------------------------------------------------- image actions


def open_in_editor(path):
    """Open photo in gthumb for editing."""
    try:
        subprocess.Popen(["gthumb", path])
        return True
    except FileNotFoundError:
        return False


def open_in_finder(path):
    """Open containing folder in Thunar."""
    try:
        subprocess.Popen(["thunar", os.path.dirname(path)])
        return True
    except FileNotFoundError:
        return False


def rotate_image(path, direction="right"):
    """Lossless rotation via gthumb CLI or exiftool fallback.
    Returns True on success."""
    try:
        subprocess.run(["gthumb", "--rotate-right", path],
                       capture_output=True, timeout=30)
        return True
    except Exception:
        pass
    try:
        angle = 90 if direction == "right" else 270
        subprocess.run(["exiftool", "-overwrite_original",
                        "-rotation=%d" % angle, path],
                       capture_output=True, timeout=30)
        return True
    except Exception:
        return False


# ----------------------------------------------------------------------- GUI

def run_gui(application=None):
    warnings = []

    def on_warn(msg):
        warnings.append(msg)

    state = load_state(on_warn=on_warn)
    library = (os.environ.get(LIBRARY_ENV)
               or os.path.expanduser(
                   (state.get("library")) or DEFAULT_LIBRARY))
    photos, scan_errors = scan_library(library)

    win = PhotosWindow(photos, state, library)
    if scan_errors:
        win._show_error("Some files could not be read (%d skipped)." % scan_errors)
    for msg in warnings:
        win._show_error(msg)
    win.connect("key-press-event", win.on_key_press)
    if application is not None:
        application.add_window(win)
        return win
    return win


class PhotosWindow(Gtk.Window):
    def __init__(self, photos, state, library):
        super().__init__(title="Photos")
        geo = state.get("geometry", {})
        w = int(geo.get("w", 1000))
        h = int(geo.get("h", 700))
        self.set_default_size(w, h)

        self.all_photos = photos
        self.state = state
        self.library = library
        self.current_view = "all"
        self.current_album = None
        self.search_query = ""
        self.slideshow_active = False
        self.slideshow_index = 0

        self.apply_css()
        self.build_ui()
        self.refresh_content()
        self.connect("destroy", self.on_destroy)
        self.show_all()

    def apply_css(self):
        css = b"""
        .photos-sidebar {
            background: #f5f0e8;
            background-image: linear-gradient(180deg, #f5f0e8 0%, #e8ddd0 100%);
            border-right: 1px solid #d4c8b8;
        }
        .photos-sidebar > viewport { background: transparent; }
        .photos-sidebar-frame {
            border: none;
            background: transparent;
        }
        .photos-sidebar-frame > label {
