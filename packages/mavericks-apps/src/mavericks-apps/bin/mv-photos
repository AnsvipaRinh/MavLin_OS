            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def build_ui(self):
        hb = Gtk.HeaderBar(title="Photos", show_close_button=True)
        self.set_titlebar(hb)

        self.search_entry = Gtk.SearchEntry(placeholder_text="Search photos...")
        self.search_entry.set_hexpand(True)
        self.search_entry.connect("changed", self.on_search_changed)
        hb.pack_start(self.search_entry)

        import_btn = Gtk.Button(label="Import")
        import_btn.get_style_context().add_class("mavericks-toolbar-btn")
        import_btn.connect("clicked", self.on_import)
        hb.pack_end(import_btn)

        slideshow_btn = Gtk.Button.new_from_icon_name(
            "media-playback-start", Gtk.IconSize.BUTTON)
        slideshow_btn.set_tooltip_text("Slideshow (Space)")
        slideshow_btn.get_style_context().add_class("mavericks-toolbar-btn")
        slideshow_btn.connect("clicked", self.on_slideshow_toggle)
        hb.pack_end(slideshow_btn)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        sidebar.set_size_request(220, -1)
        sidebar.get_style_context().add_class("photos-sidebar")

        self.sidebar_items = {}
        sections = [
            ("Library", [
                ("all", "All Photos"),
                ("favorites", "Favorites"),
                ("recent", "Recently Added"),
            ]),
            ("Moments", []),
            ("Albums", []),
        ]
        for section_title, items in sections:
            frame = Gtk.Frame()
            frame.get_style_context().add_class("photos-sidebar-frame")
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            vbox.set_border_width(6)
            for item_id, label in items:
                btn = Gtk.Button(label=label)
                btn.get_style_context().add_class("sidebar-item")
                btn.set_halign(Gtk.Align.START)
                btn.connect("clicked", self.on_sidebar_click, item_id)
                self.sidebar_items[item_id] = btn
                vbox.pack_start(btn, False, False, 0)
            frame.add(vbox)
            sidebar.pack_start(frame, False, False, 0)

        # Moments sidebar - populated dynamically
        self.moments_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.moments_box.set_border_width(6)
        sidebar.add(self.moments_box)

        self.albums_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.albums_box.set_border_width(6)
        sidebar.add(self.albums_box)

        new_album_btn = Gtk.Button(label="+ New Album")
        new_album_btn.get_style_context().add_class("sidebar-item")
        new_album_btn.set_halign(Gtk.Align.START)
        new_album_btn.connect("clicked", self.on_new_album)
        sidebar.pack_start(new_album_btn, False, False, 0)

        sidebar_sw = Gtk.ScrolledWindow()
        sidebar_sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_sw.add(sidebar)
        paned.add1(sidebar_sw)

        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.content_box.get_style_context().add_class("photos-content")

        self.moment_label = Gtk.Label()
        self.moment_label.set_xalign(0)
        self.moment_label.get_style_context().add_class("moment-header")
        self.content_box.pack_start(self.moment_label, False, False, 0)

        self.grid_wrap = Gtk.ScrolledWindow()
        self.grid_wrap.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.content_box.pack_start(self.grid_wrap, True, True, 0)

        self.photos_flow = Gtk.FlowBox()
        self.photos_flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.photos_flow.set_homogeneous(True)
        self.photos_flow.set_max_children_per_line(20)
        self.photos_flow.connect("child-activated", self.on_photo_activate)
        self.grid_wrap.add(self.photos_flow)

        self.empty_label = Gtk.Label(label="No photos")
        self.empty_label.get_style_context().add_class("photos-empty")
        self.content_box.pack_start(self.empty_label, True, True, 0)

        paned.add2(self.content_box)
        sb = int(self.state.get("geometry", {}).get("sidebar", 240))
        paned.set_position(sb)

        self.refresh_sidebar()

    def refresh_sidebar(self):
        for btn in self.sidebar_items.values():
            btn.get_style_context().remove_class("selected")
        if self.current_view in self.sidebar_items:
            self.sidebar_items[self.current_view].get_style_context().add_class("selected")

        # Populate Moments sidebar with date groups
        self._populate_moments_sidebar()

        for child in self.albums_box.get_children():
            self.albums_box.remove(child)
        for album in self.state.get("albums") or []:
            btn = Gtk.Button(label="%s (%d)" % (album["name"], len(album["paths"])))
            btn.get_style_context().add_class("sidebar-item")
            btn.set_halign(Gtk.Align.START)
            btn.connect("clicked", self.on_album_click, album["name"])
            if self.current_view == "album" and self.current_album == album["name"]:
                btn.get_style_context().add_class("selected")
            self.albums_box.pack_start(btn, False, False, 0)
        self.albums_box.show_all()

    def _populate_moments_sidebar(self):
        for child in self.moments_box.get_children():
            self.moments_box.remove(child)

        moments = group_by_moment(self.all_photos)
        if not moments:
            empty = Gtk.Label(label="No moments")
            empty.get_style_context().add_class("photos-empty")
            empty.set_xalign(0)
            self.moments_box.pack_start(empty, False, False, 0)
            return

        self.moment_expanded = getattr(self, 'moment_expanded', {})
        for m in moments:
            date_str = m["date"]
            count = m["count"]
            is_expanded = self.moment_expanded.get(date_str, False)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            row.set_halign(Gtk.Align.START)

            expander = Gtk.Button()
            expander.get_style_context().add_class("moment-expander")
            expander.set_image(Gtk.Image.new_from_icon_name(
                "pan-down" if is_expanded else "pan-end", Gtk.IconSize.MENU))
            expander.connect("clicked", self._on_moment_expand, date_str)
            row.pack_start(expander, False, False, 0)

            label = Gtk.Button()
            label.get_style_context().add_class("moment-sidebar-item")
            label.set_halign(Gtk.Align.START)
            label.set_label("%s (%d)" % (date_str, count))
            label.connect("clicked", self.on_moment_date_click, date_str)
            if self.current_view == "moments" and self.current_moment == date_str:
                label.get_style_context().add_class("selected")
            row.pack_start(label, True, True, 0)

            self.moments_box.pack_start(row, False, False, 0)

            if is_expanded:
                self._populate_moment_photos_in_sidebar(m["photos"])

        self.moments_box.show_all()

    def _populate_moment_photos_in_sidebar(self, photos):
        for p in photos[:5]:
            btn = Gtk.Button()
            btn.get_style_context().add_class("moment-sidebar-item")
            btn.set_halign(Gtk.Align.START)
            tp = ensure_thumb(p)
            if tp:
                try:
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(tp, 32, 32, True)
                    img = Gtk.Image.new_from_pixbuf(pix)
                    btn.set_image(img)
                    btn.set_always_show_image(True)
                except Exception:
                    pass
            btn.set_label(p["filename"][:20])
            btn.connect("clicked", self._open_photo, p["path"])
            self.moments_box.pack_start(btn, False, False, 0)

    def _on_moment_expand(self, btn, date_str):
        self.moment_expanded = getattr(self, 'moment_expanded', {})
        self.moment_expanded[date_str] = not self.moment_expanded.get(date_str, False)
        self._populate_moments_sidebar()

    def on_moment_date_click(self, _btn, date_str):
        self.current_view = "moments"
        self.current_moment = date_str
        self.current_album = None
        self.search_entry.set_text("")
        self.search_query = ""
        self.refresh_sidebar()
        self.refresh_content()

    def refresh_content(self):
        for child in self.photos_flow.get_children():
            self.photos_flow.remove(child)

        if self.current_view == "all":
            items = self.all_photos
        elif self.current_view == "favorites":
            fav_set = set(self.state.get("favorites") or [])
            items = [p for p in self.all_photos if p["path"] in fav_set]
        elif self.current_view == "recent":
            items = self.all_photos[:50]
        elif self.current_view == "album":
            items = photos_for_album(self.state, self.current_album,
                                     self.all_photos)
        elif self.current_view == "moments":
            self._populate_moments()
            return
        else:
            items = self.all_photos

        if self.search_query:
            items = search_photos(items, self.search_query)

        self.moment_label.set_text("")
        self._populate_grid(items)

    def _populate_moments(self):
        moments = group_by_moment(self.all_photos)
        if self.search_query:
            moments = [m for m in moments
                       if search_photos(m["photos"], self.search_query)]
            for m in moments:
                m["photos"] = search_photos(m["photos"], self.search_query)
                m["count"] = len(m["photos"])

        if self.current_moment:
            moments = [m for m in moments if m["date"] == self.current_moment]

        if not moments:
            self.photos_flow.hide()
            self.empty_label.set_text("No moments to show")
            self.empty_label.show()
            return

        self.empty_label.hide()
        self.photos_flow.show()

        for m in moments:
            hdr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            hdr_box.get_style_context().add_class("moment-header-leather")

            date_label = Gtk.Label(label=m["date"])
            date_label.get_style_context().add_class("moment-date-label")
            date_label.set_xalign(0)
            hdr_box.pack_start(date_label, True, True, 0)

            count_label = Gtk.Label(label="%d photos" % m["count"])
            count_label.get_style_context().add_class("moment-count-label")
            hdr_box.pack_end(count_label, False, False, 0)

            self.photos_flow.add(hdr_box)

            for p in m["photos"]:
                self._add_photo_item(p)

    def _populate_grid(self, items):
        if not items:
            self.photos_flow.hide()
            self.empty_label.set_text(
                "No photos" + (" matching search" if self.search_query else ""))
            self.empty_label.show()
            return
        self.empty_label.hide()
        self.photos_flow.show()
        for p in items:
            self._add_photo_item(p)

    def _add_photo_item(self, photo):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.get_style_context().add_class("photos-grid-item")
        box.set_size_request(THUMB_SIZE + 16, THUMB_SIZE + 40)

        tp = ensure_thumb(photo)
        img = Gtk.Image()
        if tp:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    tp, THUMB_SIZE, THUMB_SIZE, True)
                img.set_from_pixbuf(pix)
            except Exception:
                img.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
        else:
            img.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
        box.pack_start(img, False, False, 0)

        lbl = Gtk.Label(label=photo["filename"][:24])
        lbl.get_style_context().add_class("photo-info-label")
        lbl.set_max_width_chars(20)
        lbl.set_ellipsize(3)
        box.pack_start(lbl, False, False, 0)

        date_lbl = Gtk.Label(label=fmt_date(photo.get("date")) or "")
        date_lbl.get_style_context().add_class("photo-info-label")
        date_lbl.set_max_width_chars(20)
        box.pack_start(date_lbl, False, False, 0)

        fav = photo["path"] in (self.state.get("favorites") or [])
        if fav:
            star = Gtk.Image.new_from_icon_name("starred", Gtk.IconSize.MENU)
            box.pack_end(star, False, False, 0)

        box.photo_path = photo["path"]
        self.photos_flow.add(box)

    def on_sidebar_click(self, _btn, item_id):
        self.current_view = item_id
        self.current_album = None
        self.current_moment = None
        self.search_entry.set_text("")
        self.search_query = ""
        self.refresh_sidebar()
        self.refresh_content()

    def on_album_click(self, _btn, album_name):
        self.current_view = "album"
        self.current_album = album_name
        self.refresh_sidebar()
        self.refresh_content()

    def on_search_changed(self, entry):
        self.search_query = entry.get_text().strip()
        self.refresh_content()

    def on_photo_activate(self, _flow, child):
        box = child.get_child()
        path = getattr(box, "photo_path", None)
        if path:
            self._open_photo(path)

    def _open_photo(self, path):
        tp = ensure_thumb(next((p for p in self.all_photos
                                if p["path"] == path), None) or {"path": path})
        self._open_full_view(path)

    def _open_full_view(self, path):
        dlg = Gtk.Dialog(title="Photo", transient_for=self,
                         flags=Gtk.DialogFlags.MODAL)
        dlg.set_default_size(800, 600)
        hb = dlg.get_header_bar() if dlg.get_header_bar() else None

        close_btn = Gtk.Button(label="Close")
        close_btn.get_style_context().add_class("mavericks-toolbar-btn")
        close_btn.connect("clicked", lambda *_: dlg.destroy())
        if hb:
            hb.pack_end(close_btn)
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)

        img = Gtk.Image()
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 780, 560, True)
            img.set_from_pixbuf(pix)
        except Exception:
            img.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)

        sw = Gtk.ScrolledWindow()
        sw.add(img)
        dlg.get_content_area().pack_start(sw, True, True, 0)

        info = Gtk.Label()
        info.get_style_context().add_class("photo-info-label")
        for p in self.all_photos:
            if p["path"] == path:
                dims = ""
                if p.get("width") and p.get("height"):
                    dims = " — %dx%d" % (p["width"], p["height"])
                sz = fmt_size(p.get("size", 0))
                dt = fmt_date(p.get("date")) or "Unknown date"
                info.set_text("%s%s — %s — %s" % (p["filename"], dims, sz, dt))
                break
        dlg.get_content_area().pack_end(info, False, False, 0)

        edit_btn = Gtk.Button(label="Edit in gthumb")
        edit_btn.get_style_context().add_class("mavericks-toolbar-btn")
        edit_btn.connect("clicked", lambda *_: (open_in_editor(path), dlg.destroy()))
        dlg.get_content_area().pack_end(edit_btn, False, False, 0)

        fav_btn = Gtk.Button()
        is_fav = path in (self.state.get("favorites") or [])
        fav_btn.set_label("Unfavorite" if is_fav else "Favorite")
        fav_btn.get_style_context().add_class("mavericks-toolbar-btn")
        fav_btn.connect("clicked", lambda b: self._toggle_fav_ui(b, path))
        dlg.get_content_area().pack_end(fav_btn, False, False, 0)

        dlg.show_all()
        dlg.run()
        dlg.destroy()

    def _toggle_fav_ui(self, btn, path):
        self.state = toggle_favorite(self.state, path)
        save_state(data=self.state)
        is_fav = path in self.state["favorites"]
        btn.set_label("Unfavorite" if is_fav else "Favorite")
        self.refresh_content()

    def on_import(self, _btn):
        dlg = Gtk.FileChooserDialog(
            title="Import Photos", transient_for=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Import", Gtk.ResponseType.OK)
        if dlg.run() == Gtk.ResponseType.OK:
            folder = dlg.get_filename()
            if folder:
                self._do_import(folder)
        dlg.destroy()

    def _do_import(self, folder):
        exts = {".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".tif",
                ".webp", ".heic"}
        count = 0
        lib_dir = os.path.join(self.library, "Imports",
                               time.strftime("%Y-%m-%d_%H%M%S"))
        try:
            os.makedirs(lib_dir, exist_ok=True)
            for name in os.listdir(folder):
                if os.path.splitext(name)[1].lower() not in exts:
                    continue
                src = os.path.join(folder, name)
                dst = os.path.join(lib_dir, name)
                shutil.copy2(src, dst)
                count += 1
            self.state = record_import(self.state, folder)
            save_state(data=self.state)
            self.all_photos, _ = scan_library(self.library)
            self.refresh_content()
            self._show_error("Imported %d photo(s) into %s" % (count, lib_dir))
        except OSError as e:
            self._show_error("Import failed: %s" % e)

    def on_new_album(self, _btn):
        dlg = Gtk.Dialog(title="New Album", transient_for=self,
                         flags=Gtk.DialogFlags.MODAL)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("Create", Gtk.ResponseType.OK)
        entry = Gtk.Entry(placeholder_text="Album name")
        dlg.get_content_area().pack_start(entry, True, True, 8)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            name = entry.get_text().strip()
            if name:
                self.state = add_album(self.state, name)
                save_state(data=self.state)
                self.refresh_sidebar()
        dlg.destroy()

    def on_slideshow_toggle(self, _btn):
        if self.slideshow_active:
            self._stop_slideshow()
        else:
            self._start_slideshow()

    def _start_slideshow(self):
        items = self._current_items()
        if not items:
            return
        self.slideshow_active = True
        self.slideshow_index = 0
        self._show_slide(items[0])
        from gi.repository import GLib
        GLib.timeout_add(SLIDE_INTERVAL, self._next_slide, items)

    def _next_slide(self, items):
        if not self.slideshow_active:
            return False
        self.slideshow_index = (self.slideshow_index + 1) % len(items)
        self._show_slide(items[self.slideshow_index])
        return True

    def _show_slide(self, photo):
        dlg = Gtk.Window(title="Slideshow", type_hint=1)
        dlg.set_default_size(900, 700)
        dlg.set_position(Gtk.WindowPosition.CENTER)
        img = Gtk.Image()
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                photo["path"], 880, 680, True)
            img.set_from_pixbuf(pix)
        except Exception:
            pass
        dlg.add(img)
        lbl = Gtk.Label(label=photo["filename"])
        lbl.set_markup('<span background="black" color="white">%s</span>'
                       % photo["filename"])
        dlg.show_all()

    def _stop_slideshow(self):
        self.slideshow_active = False

    def _current_items(self):
        if self.current_view == "all":
            items = self.all_photos
        elif self.current_view == "favorites":
            fav_set = set(self.state.get("favorites") or [])
            items = [p for p in self.all_photos if p["path"] in fav_set]
        elif self.current_view == "recent":
            items = self.all_photos[:50]
        elif self.current_view == "album":
            items = photos_for_album(self.state, self.current_album,
                                     self.all_photos)
        else:
            items = self.all_photos
        if self.search_query:
            items = search_photos(items, self.search_query)
        return items

    def _show_error(self, msg):
        from gi.repository import GLib
        GLib.idle_add(self._show_error_idle, msg)

    def _show_error_idle(self, msg):
        bar = Gtk.InfoBar()
        bar.set_message_type(Gtk.MessageType.WARNING)
        bar.get_content_area().pack_start(
            Gtk.Label(label=msg), False, False, 0)
        bar.show_all()
        self.content_box.pack_start(bar, False, False, 0)
        self.content_box.reorder_child(bar, 0)
        return False

    def on_key_press(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            if self.slideshow_active:
                self._stop_slideshow()
                return True
            return False
        if event.state & Gdk.ModifierType.CONTROL_MASK:
            if event.keyval == Gdk.KEY_f:
                self.search_entry.grab_focus()
                return True
            if event.keyval == Gdk.KEY_i:
                self.on_import(None)
                return True
        if event.keyval == Gdk.KEY_space and not self.slideshow_active:
            self.on_slideshow_toggle(None)
            return True
        if event.keyval == Gdk.KEY_Delete or event.keyval == Gdk.KEY_BackSpace:
            return True
        return False

    def on_destroy(self, *_):
        geo = dict(self.state.get("geometry", {}))
        geo["w"] = self.get_allocated_width()
        geo["h"] = self.get_allocated_height()
        geo["sidebar"] = 240
        self.state["geometry"] = geo
        save_state(data=self.state)
        return



def build_photos_menu(app, app_name, get_window, add_action):
    def w():
        return get_window()

    add_action("import", lambda: w().on_import(None) if w() else None)
    add_action("new-album", lambda: w().on_new_album(None) if w() else None)
    add_action("slideshow", lambda: w().on_slideshow_toggle(None) if w() else None)
    add_action("all", lambda: w().on_sidebar_click(None, "all") if w() else None)
    add_action("favorites", lambda: w().on_sidebar_click(None, "favorites") if w() else None)
    add_action("recent", lambda: w().on_sidebar_click(None, "recent") if w() else None)
    add_action("search", lambda: w().search_entry.grab_focus() if w() else None)
    add_action("close", lambda: w().destroy() if w() else None)
    add_action("quit", app.quit)

    menu = Gio.Menu()
    app_menu = Gio.Menu()
    app_menu.append("About Photos", "app.about")
    app_menu.append("Quit Photos", "app.quit")
    menu.append_submenu("Photos", app_menu)

    file_menu = Gio.Menu()
    file_menu.append("Import Photos…", "app.import")
    file_menu.append("New Album…", "app.new-album")
    file_menu.append("Close Window", "app.close")
    menu.append_submenu("File", file_menu)

    edit_menu = Gio.Menu()
    edit_menu.append("Search Photos", "app.search")
    menu.append_submenu("Edit", edit_menu)

    view_menu = Gio.Menu()
    view_menu.append("All Photos", "app.all")
    view_menu.append("Favorites", "app.favorites")
    view_menu.append("Recently Added", "app.recent")
    menu.append_submenu("View", view_menu)

    window_menu = Gio.Menu()
    window_menu.append("Start / Stop Slideshow", "app.slideshow")
    window_menu.append("Close Window", "app.close")
    menu.append_submenu("Window", window_menu)
    return menu

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--scan":
        lib = os.path.expanduser(sys.argv[2] if len(sys.argv) > 2
                                else DEFAULT_LIBRARY)
        photos, errors = scan_library(lib)
        print("%d photos, %d errors" % (len(photos), errors))
        for p in photos[:10]:
            print("  %s  %s  %dx%d" % (p["filename"], fmt_date(p["date"]),
                                       p["width"] or 0, p["height"] or 0))
        return 0

    app = Gtk.Application(application_id="com.mavlinos.Photos")
    state = {"window": None}

    def startup(application):
        from mavericks_appmenu import install_application_menu
        install_application_menu(application, "Photos",
                                  lambda: state["window"],
                                  build_photos_menu)

    def activate(application):
        if state["window"] is not None:
            state["window"].present()
            return
        win = run_gui(application)
        state["window"] = win
        win.connect("destroy", lambda *_: state.update(window=None))
        win.show_all()
        win.present()

    app.connect("startup", startup)
    app.connect("activate", activate)
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.path.insert(0, "/usr/share/mavericks-apps")
    sys.exit(main())
