[Desktop Entry]
Type=Application
Name=Preview
Comment=Preview (Mavericks)
Exec=mv-preview %U
Icon=document-viewer
Categories=Graphics;Viewer;
StartupNotify=true
MimeType=application/pdf;image/png;image/jpeg;image/gif;image/bmp;image/webp;image/tiff;image/svg+xml;image/x-icon;image/x-xpixmap;text/plain;
X-Mavericks-Native=true