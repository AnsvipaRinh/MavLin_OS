[Desktop Entry]
Type=Application
Name=Launchpad
Comment=Application Launcher (Mavericks)
Exec=sh -c "rofi -show -modi 'launchpad:/usr/bin/mv-launchpad' -kb-custom-1 'Page_Down' -kb-custom-2 'Page_Up' -theme /usr/share/mavericks-apps/rofi-launchpad.rasi"
Icon=view-app-grid-symbolic
Categories=System;X-ApplicationLauncher;
StartupNotify=false
X-Mavericks-Native=true