[Desktop Entry]
Type=Application
Name=Screenshot
Comment=Take a screenshot (Mavericks screenshot tools)
Exec=mv-shot --toolbar %U
Icon=applets-screenshooter
Categories=Graphics;
StartupNotify=true
X-Mavericks-Native=true
MimeType=image/png;image/jpeg;image/tiff;image/bmp;
Keywords=screenshot;capture;screen;shot;printscreen;
