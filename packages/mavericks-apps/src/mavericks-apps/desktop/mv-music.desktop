[Desktop Entry]
Type=Application
Name=Music
Comment=Music Player (Mavericks)
Exec=mv-music %U
Icon=audio-x-generic
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-m4a;audio/mp4;audio/wav;audio/x-wav;audio/opus;audio/x-vorbis+ogg;application/ogg;
Categories=AudioVideo;Audio;Music;Player;
StartupNotify=true
X-Mavericks-Native=true