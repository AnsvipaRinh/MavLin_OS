/* Mavericks Spotlight — centered, categorized, skeuomorphic accent
 * NOTE: rasi is not web CSS — rgba() alpha is a percentage, unsupported
 * web properties (font-weight, margin) and non-existent widgets
 * (listview-split/icon-current-entry) make rofi abort with a parse-error
 * dialog. Keep this file valid rasi (validated with rofi -dump-theme). */
* {
    font: "Lucida Grande 11";
    background-color: rgba (245, 245, 245, 98%);
    text-color: #2d2d2d;
    accent: #007aff;
    accent-text: #ffffff;
    border-color: #d1d1d1;
    category-bg: rgba (0, 0, 0, 3%);
    category-fg: #888888;
    placeholder: #aaaaaa;
    input-border: #cccccc;
    input-bg: #ffffff;
    separator: #e0e0e0;
    preview-bg: #ffffff;
    preview-fg: #2d2d2d;
}
window {
    width: 680px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: #bababa;
    border-radius: 10px;
    padding: 16px;
    background-color: @background-color;
}
mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}
inputbar {
    children: [ prompt, entry ];
    border: 1px;
    border-color: @input-border;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: @input-bg;
}
prompt {
    enabled: false;
    spacing: 0;
}
entry {
    placeholder: "Spotlight Search";
    placeholder-color: @placeholder;
    text-color: #2d2d2d;
    cursor: text;
    spacing: 0;
}
listview {
    lines: 14;
    columns: 1;
    fixed-height: true;
    dynamic: true;
    scrollbar: true;
    padding: 4px 0px;
    border: 1px;
    border-color: @separator;
    border-radius: 6px;
}
element {
    padding: 10px 14px;
    border-radius: 5px;
    spacing: 12px;
}
element normal.normal {
    background-color: transparent;
    text-color: #2d2d2d;
}
element selected.normal {
    background-color: @accent;
    text-color: @accent-text;
}
element-icon {
    size: 28px;
    background-color: transparent;
}
element-text {
    vertical-align: 0.5;
    text-color: #2d2d2d;
}
scrollbar {
    width: 6px;
    handle-color: #bbbbbb;
    handle-width: 8px;
    border: 0px;
    padding: 4px;
}
num-filtered-rows, num-rows, textbox-num-sep {
    text-color: @category-fg;
    expand: false;
}
case-indicator {
    text-color: @category-fg;
}
/* Preview pane (enabled via -show-preview) */
preview {
    background-color: @preview-bg;
    text-color: @preview-fg;
    border: 1px;
    border-color: @separator;
    border-radius: 6px;
    padding: 12px;
}
