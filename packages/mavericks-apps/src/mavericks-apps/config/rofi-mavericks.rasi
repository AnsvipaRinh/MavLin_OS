/* Mavericks Spotlight — centered, categorized, skeuomorphic accent */
* {
    font: "San Francisco 11";
    background: rgba(245, 245, 245, 0.98);
    foreground: #2d2d2d;
    accent: #007aff;
    accent-text: #ffffff;
    border-color: #d1d1d1;
    category-bg: rgba(0, 0, 0, 0.03);
    category-fg: #888888;
    placeholder: #aaaaaa;
    input-border: #cccccc;
    input-bg: #ffffff;
    separator: #e0e0e0;
    preview-bg: #ffffff;
    preview-fg: #2d2d2d;
}
window {
    width: 680px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: #bababa;
    border-radius: 10px;
    padding: 16px;
    background-color: @background;
}
mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}
inputbar {
    children: [ prompt, entry ];
    border: 1px;
    border-color: @input-border;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: @input-bg;
}
prompt {
    enabled: false;
    spacing: 0;
}
entry {
    placeholder: "Spotlight Search";
    placeholder-color: @placeholder;
    text-color: @foreground;
    cursor: text;
    spacing: 0;
}
listview {
    lines: 14;
    columns: 1;
    fixed-height: true;
    dynamic: true;
    scrollbar: true;
    padding: 4px 0;
    border: 1px;
    border-color: @separator;
    border-radius: 6px;
}
element {
    padding: 10px 14px;
    border-radius: 5px;
    spacing: 12px;
}
element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}
element selected.normal {
    background-color: @accent;
    text-color: @accent-text;
}
element-icon {
    size: 28px;
    background-color: transparent;
}
element-text {
    vertical-align: 0.5;
}
category {
    padding: 8px 14px;
    background: @category-bg;
    font-weight: 600;
    color: @category-fg;
    border-radius: 5px;
    margin: 6px 4px 2px;
}
scrollbar {
    width: 6px;
    handle-color: #bbbbbb;
    handle-width: 8px;
    border: 0;
    padding: 4px;
}
scrollbar handle {
    border-radius: 3px;
}
num-filtered-rows, num-rows, textbox-num-sep {
    text-color: @category-fg;
    expand: false;
}
case-indicator {
    text-color: @category-fg;
}
/* Preview pane (enabled via -show-preview) */
preview {
    background-color: @preview-bg;
    text-color: @preview-fg;
    border: 1px;
    border-color: @separator;
    border-radius: 6px;
    padding: 12px;
}