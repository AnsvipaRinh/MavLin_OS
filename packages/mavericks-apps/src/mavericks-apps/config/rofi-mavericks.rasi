/* Mavericks Spotlight (rofi drun/run/window) — centered, single column */
* {
    font: "San Francisco 11";
    background: rgba(240, 240, 240, 0.96);
    foreground: #333333;
    border: 0;
}
window {
    width: 560px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: #999999;
    border-radius: 8px;
    padding: 12px;
}
mainbox { children: [ inputbar, listview ]; spacing: 8px; }
inputbar { children: [ prompt, entry ]; border: 1px; border-color: #cccccc; border-radius: 4px; padding: 6px; }
entry { placeholder: "Spotlight Search"; }
listview { lines: 9; columns: 1; fixed-height: true; }
element { padding: 6px; border-radius: 4px; }
element selected { background: #2f7cf6; foreground: white; }
