<?xml version="1.0" encoding="UTF-8"?>
<!-- Thunar custom actions — Finder-like surface (installed to ~/.config/Thunar/uca.xml).
     Backend: GIO/GVfs via Thunar + trash-cli + system tools. -->
<actions>
  <action>
    <icon>preview</icon>
    <name>Quick Look</name>
    <submenu></submenu>
    <unique-id>mv-quicklook</unique-id>
    <command>mv-quicklook "%f"</command>
    <description>Press Space equivalent — preview file</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>edit-undo</icon>
    <name>Put Back</name>
    <submenu></submenu>
    <unique-id>mv-putback</unique-id>
    <command>xfce4-terminal --hold -e trash-restore</command>
    <description>Restore trashed item (trash-cli, interactive picker)</description>
    <patterns>*</patterns>
    <other-files/>
  </action>
  <action>
    <icon>document-new</icon>
    <name>New Folder</name>
    <submenu></submenu>
    <unique-id>mv-newfolder</unique-id>
    <command>mv-newfolder "%d"</command>
    <description>Create new folder here (auto-numbered like Finder)</description>
    <patterns>*</patterns>
    <directories/>
  </action>
  <action>
    <icon>dialog-information</icon>
    <name>Get Info</name>
    <submenu></submenu>
    <unique-id>mv-getinfo</unique-id>
    <command>mv-getinfo %F</command>
    <description>Show file/folder information (size, dates, permissions)</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>document-open</icon>
    <name>Open With</name>
    <submenu></submenu>
    <unique-id>mv-openwith</unique-id>
    <command>mv-openwith %F</command>
    <description>Choose application to open file</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>edit-rename</icon>
    <name>Rename</name>
    <submenu></submenu>
    <unique-id>mv-rename</unique-id>
    <command>mv-rename "%f"</command>
    <description>Rename file or folder (Finder-style)</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>user-trash</icon>
    <name>Move to Trash</name>
    <submenu></submenu>
    <unique-id>mv-trash</unique-id>
    <command>mv-trash %F</command>
    <description>Move selected items to Trash (Cmd+Delete)</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>edit-copy</icon>
    <name>Copy Path</name>
    <submenu></submenu>
    <unique-id>mv-copy-path</unique-id>
    <command>mv-copy-path %F</command>
    <description>Copy file/folder path(s) to clipboard</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>document-open-recent</icon>
    <name>Go to Path…</name>
    <submenu></submenu>
    <unique-id>mv-paste-path</unique-id>
    <command>mv-paste-path</command>
    <description>Open a path from clipboard (Finder Cmd+Shift+G)</description>
    <patterns>*</patterns>
    <directories/>
  </action>
  <action>
    <icon>package-x-generic</icon>
    <name>Compress</name>
    <submenu></submenu>
    <unique-id>mv-compress</unique-id>
    <command>xarchiver -a "%d/%n.zip" %F</command>
    <description>Compress selection to zip</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>utilities-terminal</icon>
    <name>Open in Terminal</name>
    <submenu></submenu>
    <unique-id>mv-terminal</unique-id>
    <command>exo-open --working-directory "%f" --launch TerminalEmulator</command>
    <description>Open this folder in Terminal</description>
    <patterns>*</patterns>
    <directories/>
  </action>
  <action>
    <icon>media-eject</icon>
    <name>Eject</name>
    <submenu></submenu>
    <unique-id>mv-eject</unique-id>
    <command>mv-eject "%f"</command>
    <description>Safely eject removable device</description>
    <patterns>*</patterns>
    <directories/>
  </action>
  <action>
    <icon>airdrop</icon>
    <name>Send via AirDrop…</name>
    <submenu></submenu>
    <unique-id>mv-airdrop-send</unique-id>
    <command>mv-airdrop --send %F</command>
    <description>Share selected files with nearby devices (LocalSend backend)</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
  <action>
    <icon>mpv</icon>
    <name>Play video-only</name>
    <submenu></submenu>
    <unique-id>mv-ytplayer</unique-id>
    <command>mv-ytplayer "%f"</command>
    <description>Play video in mpv with yt-dlp (video-only, no browser)</description>
    <patterns>*</patterns>
    <video-files/>
  </action>
  <action>
    <icon>edit-find</icon>
    <name>Search in This Folder…</name>
    <submenu></submenu>
    <unique-id>mv-finder-search</unique-id>
    <command>mv-finder-search "%f"</command>
    <description>Search recursively in this folder (Finder-like results window)</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>format-justify-fill</icon>
    <name>Browse as Columns</name>
    <submenu></submenu>
    <unique-id>mv-finder-columns</unique-id>
    <command>mv-finder-columns "%f"</command>
    <description>Open this folder in a Finder-style column browser</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>user-trash-full</icon>
    <name>Empty Trash</name>
    <submenu></submenu>
    <unique-id>mv-empty-trash</unique-id>
    <command>trash-empty</command>
    <description>Permanently delete all items in Trash</description>
    <patterns>*</patterns>
    <directories/>
  </action>
</actions>