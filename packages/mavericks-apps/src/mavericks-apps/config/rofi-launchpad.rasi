/* Mavericks Launchpad (rofi script mode — paginated grid with folders)
 * NOTE: rasi is not web CSS — colors are `rgba (r, g, b, a%)`, borders are
 * `border: Npx` + `border-color:`, and unsupported properties (box-shadow,
 * transition-duration, margin, font-weight) must not appear: rofi refuses
 * to start the mode and shows a parse-error dialog instead. */
* {
    font: "Helvetica Neue 11";
    text-color: #ffffff;
    background-color: rgba (30, 30, 30, 92%);
    selected-text-color: #ffffff;
    selected-background-color: rgba (255, 255, 255, 15%);
    normal-background-color: transparent;
    normal-text-color: #ffffff;
    urgent-text-color: #ffffff;
    urgent-background-color: rgba (255, 80, 80, 30%);
}

window {
    fullscreen: true;
    background-color: rgba (30, 30, 30, 92%);
    padding: 48px 60px;
    border: 1px;
    border-color: rgba (255, 255, 255, 8%);
    border-radius: 8px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 20px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: rgba (255, 255, 255, 10%);
    border-radius: 16px;
    padding: 8px 14px;
    width: 340px;
    border: 1px;
    border-color: rgba (255, 255, 255, 5%);
}

prompt {
    enabled: false;
    padding: 0;
}

entry {
    placeholder: "Search apps...";
    text-color: #ffffff;
    placeholder-color: rgba (255, 255, 255, 50%);
    padding: 3px 7px;
    background-color: transparent;
    border-radius: 10px;
}

listview {
    lines: 5;
    columns: 7;
    fixed-height: false;
    spacing: 16px;
    padding: 6px;
    dynamic: true;
    scrollbar: true;
    scrollbar-width: 6px;
}

element {
    orientation: vertical;
    padding: 10px 6px;
    border-radius: 10px;
    background-color: transparent;
}

element normal {
    background-color: transparent;
    text-color: #ffffff;
}

element selected {
    background-color: rgba (255, 255, 255, 12%);
    border: 1px;
    border-color: rgba (255, 255, 255, 10%);
    text-color: #ffffff;
}

element alternate {
    background-color: rgba (255, 255, 255, 2%);
    text-color: #ffffff;
}

element urgent {
    background-color: rgba (255, 80, 80, 25%);
    border: 1px;
    border-color: rgba (255, 80, 80, 40%);
    text-color: #ffffff;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.95;
    text-color: #ffffff;
    font: "Helvetica Neue 10";
    text-overflow: ellipsis;
}

element-icon {
    size: 56px;
    horizontal-align: 0.5;
    padding-bottom: 4px;
}

scrollbar {
    background-color: rgba (255, 255, 255, 6%);
    border-radius: 3px;
    handle-color: rgba (255, 255, 255, 25%);
    handle-width: 6px;
}

sidebar {
    enabled: false;
}
