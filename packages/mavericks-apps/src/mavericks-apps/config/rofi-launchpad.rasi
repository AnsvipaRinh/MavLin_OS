/* Mavericks Launchpad (rofi script mode — paginated grid with folders) */
* {
    font: "Helvetica Neue 11";
    foreground: #ffffff;
    background: rgba(30, 30, 30, 0.92);
    selected-foreground: #ffffff;
    selected-background: rgba(255, 255, 255, 0.15);
    normal-foreground: #ffffff;
    normal-background: transparent;
    urgent-foreground: #ffffff;
    urgent-background: rgba(255, 80, 80, 0.3);
}

window {
    fullscreen: true;
    background: rgba(30, 30, 30, 0.92);
    padding: 48px 60px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 20px;
}

inputbar {
    children: [ prompt, entry ];
    background: rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 8px 14px;
    width: 340px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

prompt {
    enabled: false;
    padding: 0;
}

entry {
    placeholder: "Search apps...";
    foreground: #ffffff;
    placeholder-foreground: rgba(255, 255, 255, 0.5);
    padding: 3px 7px;
    background: transparent;
    border-radius: 10px;
}

listview {
    lines: 5;
    columns: 7;
    fixed-height: false;
    spacing: 16px;
    padding: 6px;
    dynamic: true;
    scrollbar: true;
    scrollbar-width: 6px;
}

element {
    orientation: vertical;
    padding: 10px 6px;
    border-radius: 10px;
    background: transparent;
    transition-duration: 150ms;
}

element normal {
    background: transparent;
}

element selected {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}

element alternate {
    background: rgba(255, 255, 255, 0.02);
}

element urgent {
    background: rgba(255, 80, 80, 0.25);
    border: 1px solid rgba(255, 80, 80, 0.4);
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.95;
    foreground: #ffffff;
    font: "Helvetica Neue 10";
    text-overflow: ellipsis;
    max-width: 90px;
}

element-icon {
    size: 56px;
    horizontal-align: 0.5;
    padding-bottom: 4px;
}

scrollbar {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    handle-color: rgba(255, 255, 255, 0.25);
    handle-width: 6px;
    handle-border-radius: 3px;
}

sidebar {
    enabled: false;
}