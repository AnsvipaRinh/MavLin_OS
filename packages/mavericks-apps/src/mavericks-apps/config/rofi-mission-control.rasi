/* Mavericks Mission Control (rofi script mode — window overview)
 * NOTE: keep this file valid rasi — rgba() alpha is a percentage and web-only
 * properties (font-weight, margin) abort rofi with a parse-error dialog. */
* {
    font: "San Francisco 11";
    background-color: rgba (245, 245, 245, 98%);
    text-color: #2d2d2d;
    accent: #007aff;
    accent-text: #ffffff;
    border-color: #d1d1d1;
    category-bg: rgba (0, 0, 0, 3%);
    category-fg: #888888;
    placeholder: #aaaaaa;
    input-border: #cccccc;
    input-bg: #ffffff;
    separator: #e0e0e0;
    workspace-active-bg: rgba (0, 122, 255, 10%);
    workspace-active-fg: #007aff;
}
window {
    width: 900px;
    height: 600px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    padding: 16px;
    background-color: @background-color;
}
mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}
inputbar {
    children: [ prompt, entry ];
    border: 1px;
    border-color: @input-border;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: @input-bg;
}
prompt {
    enabled: false;
    spacing: 0;
}
entry {
    placeholder: "Filter windows...";
    placeholder-color: @placeholder;
    text-color: #2d2d2d;
    cursor: text;
    spacing: 0;
}
listview {
    lines: 20;
    columns: 1;
    fixed-height: true;
    dynamic: true;
    scrollbar: true;
    padding: 4px 0px;
    border: 1px;
    border-color: @separator;
    border-radius: 6px;
}
element {
    padding: 10px 14px;
    border-radius: 5px;
    spacing: 12px;
}
element normal.normal {
    background-color: transparent;
    text-color: #2d2d2d;
}
element selected.normal {
    background-color: @accent;
    text-color: @accent-text;
}
element-icon {
    size: 32px;
    background-color: transparent;
}
element-text {
    vertical-align: 0.5;
    text-color: #2d2d2d;
}
scrollbar {
    width: 6px;
    handle-color: #bbbbbb;
    handle-width: 8px;
    border: 0px;
    padding: 4px;
}
num-filtered-rows, num-rows, textbox-num-sep {
    text-color: @category-fg;
    expand: false;
}
case-indicator {
    text-color: @category-fg;
}
