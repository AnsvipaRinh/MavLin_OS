post_install() {
    # Update icon cache
    gtk-update-icon-cache -q -t -f /usr/share/icons/Mavericks 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/Mavericks-Cursors 2>/dev/null || true

    # Update desktop database
    update-desktop-database -q 2>/dev/null || true

    # Set default theme for new users
    mkdir -p /etc/skel/.config/gtk-3.0
    cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Mavericks
gtk-icon-theme-name=Mavericks
gtk-cursor-theme-name=Mavericks-Cursors
gtk-cursor-theme-size=24
gtk-font-name=San Francisco 11
gtk-enable-animations=1
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
EOF

    # Dock preferences are NOT configured here.
    #
    # This hook used to write a second copy of ~/.config/plank/dock1/settings
    # with values that disagreed with the mirrored skel copy (it pinned
    # Position=0 / Alignment=0, i.e. the TOP edge of the screen).  Neither
    # copy had any effect: plank 0.11 keeps its preferences in GSettings
    # (net.launchpad.plank.dock.settings, path /net/launchpad/plank/docks/dock1),
    # so the Mavericks dock.theme and the zoom were silently dropped.
    #
    # The authority is now mv-dock-config (/usr/bin, from mavericks-apps),
    # which the Dock session autostart entry runs before plank starts.  It
    # seeds only the keys the user has not customised, so changing the theme
    # in plank's own preferences dialog still sticks.
    #
    # Verifying what plank will actually use:
    #   mv-dock-config --verify
    #   mv-dock-config --print
}

post_upgrade() {
    post_install
}

post_remove() {
    # Clean up icon cache
    gtk-update-icon-cache -q -t -f /usr/share/icons/Mavericks 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/Mavericks-Cursors 2>/dev/null || true
}