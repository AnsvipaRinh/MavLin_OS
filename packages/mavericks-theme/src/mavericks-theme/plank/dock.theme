[PlankTheme]
# Mavericks Plank Theme - OS X 10.9 Dock Style (Poppy-inspired values)
# Glassy reflection, zoom effect, subtle shadows

# Dock background - Poppy metallic gradient
BackgroundColor=rgba(255,255,255,0.3)
BackgroundPadding=4

# Item styling
ItemColor=rgba(255,255,255,0.2)
ItemHoverColor=rgba(255,255,255,0.4)
ItemPressedColor=rgba(255,255,255,0.5)
ItemShadowColor=rgba(0,0,0,0.3)
ItemShadowSize=0          # Poppy: 0 - Mavericks had no icon drop shadow
ItemShadowOffset=0,0

# Icon styling
IconSize=48
IconZoom=true
ZoomPercent=150
ZoomDuration=200

# Reflection
ReflectionHeight=32
ReflectionOpacity=0.2
ReflectionFade=true

# Dock shape - Poppy values
TopRoundness=4
BottomRoundness=0
LineWidth=1               # Poppy TopRoundness=4
BorderSize=1              # Poppy LineWidth=1
BorderColor=rgba(0,0,0,0.31)  # Poppy OuterStrokeColor=0;;0;;0;;79 (~0.31)

# Inner stroke (handled via gradient in Plank)
# FillStartColor=#c7c7c7 (a215) - Poppy metallic start
# FillEndColor=#f5f5f5 (a215) - Poppy metallic end

# Indicators
IndicatorColor=rgba(0,122,255,0.8)
IndicatorSize=7           # Poppy IndicatorSize=7 (0.7% of IconSize)
IndicatorShape=circle

# Urgency
UrgentColor=rgba(255,59,48,0.8)
UrgentHueShift=150        # Poppy UrgentHueShift=150

# Hide mode
HideMode=0
ShowDockItem=false
PressureReveal=false
PressureRevealTime=0.5

# Alignment
Alignment=0
Position=0
Offset=0
Monitor=-1

# Animation - Poppy values
FadeTime=200              # Poppy FadeTime=200
SlideTime=200             # Poppy SlideTime=200
ZoomTime=200
ClickTime=300             # Poppy ClickTime=300
UrgentBounceTime=600      # Poppy UrgentBounceTime=600
UrgentBounceHeight=1.67   # Poppy UrgentBounceHeight=1.666...
LaunchBounceHeight=0.625  # Poppy LaunchBounceHeight=0.625
ActiveTime=300            # Poppy ActiveTime=300
FadeOpacity=1             # Poppy FadeOpacity=1 (no fade)
GlowSize=30               # Poppy GlowSize=30
GlowTime=10000            # Poppy GlowTime=10000
GlowPulseTime=2000        # Poppy GlowPulseTime=2000
ItemMoveTime=200          # Poppy ItemMoveTime=200
CascadeHide=true          # Poppy CascadeHide=true

# Padding - Poppy values (tenths of percent of IconSize)
HorizPadding=2            # Poppy HorizPadding=2
TopPadding=-5             # Poppy TopPadding=-5 (negative centers icons in glass)
BottomPadding=3           # Poppy BottomPadding=3
ItemPadding=1             # Poppy ItemPadding=1