# Mavericks xfwm4 theme — OS X 10.9 window decorations
# Button layout: close/minimize/maximize LEFT (traffic lights), title centered
# Full button state support: active, inactive, pressed, prelight, toggled

button_layout=CHM|
title_alignment=center
full_width_title=true
title_font=Lucida Grande 11
title_text_color=#333333
title_text_shadow_color=#ffffff
title_shadow_active=true
title_shadow_inactive=true
active_text_color=#333333
inactive_text_color=#666666
active_text_shadow_color=#ffffff
inactive_text_shadow_color=#ffffff
active_foreground_color=#333333
inactive_foreground_color=#666666
active_background_color=#e8e8e0
inactive_background_color=#d8d8d0
active_border_color=#c0c0b8
inactive_border_color=#c8c8c0

# Button spacing and offset
button_offset=0
button_spacing=4
maximized_offset=0
show_app_icon=false

# Frame dimensions are NOT set here.
#
# frame_border_{top,bottom,left,right} in a themerc are dead keys on xfwm4
# 4.20: with them set to 4 the rendered border is still 5px, because the border
# is taken from the artwork (left/right edges and the corner pieces are 5px
# wide).  Keeping the keys invited someone to "fix" the pixmaps to match them;
# they are removed instead, and scripts/test-window-management-gui.py asserts
# the measured border against the artwork width.

# Title offsets
title_horizontal_offset=0
title_vertical_offset_active=2
title_vertical_offset_inactive=2

# Shadow (xfwm4 compositor shadows; heavy effects stay off)
shadow_delta_height=6
shadow_delta_width=6
shadow_delta_x=0
shadow_delta_y=3
shadow_opacity=45

# Compositing
use_compositing=true
frame_opacity=100
inactive_opacity=100
move_opacity=100
resize_opacity=100