pkgname=vala-panel-appmenu
pkgver=25.04
pkgrel=1
pkgdesc='Global Menu plugin for Xfce panel'
arch=('x86_64')
url='https://gitlab.com/vala-panel-project/vala-panel-appmenu'
license=('LGPL-3.0-or-later')
depends=('appmenu-gtk-module' 'dconf' 'gtk3' 'libdbusmenu-glib' 'libwnck3' 'libxkbcommon' 'xfce4-panel' 'xfconf')
makedepends=('gettext' 'gobject-introspection' 'meson' 'pkgconf' 'vala')
provides=('xfce4-appmenu-plugin')
conflicts=('xfce4-appmenu-plugin')
source=("https://gitlab.com/vala-panel-project/vala-panel-appmenu/-/archive/${pkgver}/vala-panel-appmenu-${pkgver}.tar.gz")
sha256sums=('48d0be87b260056a65a9056a9be7e190b67a508540ebcb1fc18a67349cca0177')

build() {
  cd "vala-panel-appmenu-${pkgver}"
  arch-meson build \
    -Dxfce=enabled \
    -Dmate=disabled \
    -Dbudgie=disabled \
    -Dvalapanel=disabled \
    -Dappmenu-gtk-module=disabled \
    -Dregistrar=enabled \
    -Djayatana=disabled
  meson compile -C build
}

package() {
  cd "vala-panel-appmenu-${pkgver}"
  DESTDIR="$pkgdir" meson install -C build
}
