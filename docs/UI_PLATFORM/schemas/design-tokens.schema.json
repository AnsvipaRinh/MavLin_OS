{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-tokens.schema.json",
  "title": "MavLinOS design tokens",
  "description": "The compiled, renderer-independent output of Layer A. One file, every generator reads it; nothing in the platform hardcodes a colour, a size, a duration or a curve. Values are authored at @1x (1 pt == 1 px); scale is a rendering concern, not a token concern.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_from",
    "appearance",
    "tokens"
  ],
  "properties": {
    "schema": {
      "const": "mavlinos.design-tokens/1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "appearance": {
      "description": "Mavericks shipped two system appearances for accents: Blue and Graphite. They are token dimensions, not two themes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "blue",
          "graphite"
        ]
      }
    },
    "generated_from": {
      "type": "object",
      "required": [
        "inputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generator": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "color",
              "font",
              "metric",
              "duration",
              "easing",
              "shadow",
              "texture",
              "asset"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "object"
            ]
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "pt",
              "px",
              "ms",
              "deg",
              "ratio",
              "none"
            ]
          },
          "variants": {
            "description": "Per-appearance / per-scale variants. Keys are appearance names or '@2x' style scale suffixes.",
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "object"
              ]
            }
          },
          "linux_substitute": {
            "description": "What MavLinOS actually uses on Linux when the original resource is not redistributable (Lucida Grande, Apple artwork). Substitution is recorded, never silent.",
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "object"
                ]
              },
              "reason": {
                "type": "string"
              },
              "package": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "$ref": "common.schema.json#/definitions/evidence"
          },
          "kind": {
            "$ref": "common.schema.json#/definitions/kind"
          },
          "confidence": {
            "$ref": "common.schema.json#/definitions/confidence"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}