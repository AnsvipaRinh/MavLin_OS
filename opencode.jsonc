{
  "$schema": "https://opencode.ai/config.json",
  // Plane split (2026-09-26, see DECISIONS.md):
  // - orchestrator session model: FREE CHOICE via /models (ALL models,
  //   including Muse Spark — user explicitly wants it available);
  // - worker-plane (build Task): fixed pin below, ALWAYS a chain model,
  //   NEVER inherits the orchestrator session model;
  // - background-plane (title/summary/compaction): small_model below,
  //   chain model so auto "cheaper model" pick stays in-chain.
  // Worker pool (2026-09-29+, see DECISIONS.md): build is the
  // primary worker; build-b..build-g are HIDDEN subagent fallbacks pinned to
  // other chain entries (build-d..g EXPERIMENTAL since 2026-10-02). Runtime agent rotation = Task subagent_type switch
  // (no server restart, no config paste). mode=subagent + hidden=true keeps
  // them out of the Tab picker and @-menu; they are invokable ONLY via the
  // Task tool when the orchestrator's task allow-list permits. NEVER pin any
  // worker to a model outside .opencode/model-fallback.json (Muse Spark is
  // banned as a worker). Workers must NEVER delegate (task: deny).
  "small_model": "openrouter/cohere/north-mini-code:free",
  "agent": {
    "build": {
      // PRIMARY since 2026-10-03 (user choice): Ling 3.1 Flash Free
      // (OpenCode Zen / Z.ai) is the default first-priority builder.
      "model": "opencode/ling-3.1-flash-free",
      "description": "Implementation worker: executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        // Workers must NEVER delegate deeper (2026-09-26, see DECISIONS.md):
        // with zero invokable agents the Task tool offers nothing, so no
        // nested-delegation attempts (not even build->orchestrator self-invoke).
        // Orchestrator's own task allow-list (its .md) is unaffected.
        "task": {
          "*": "deny"
        }
      }
    },
    // Fallback workers (protocol v3): hidden subagents, chain #1 and #3.
    // Same description/permissions as build; only the model pin differs.
    "build-b": {
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/cohere/north-mini-code:free",
      "description": "Implementation worker (fallback B): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "build-c": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/longcat-2.5-preview-free",
      "description": "Implementation worker (fallback C): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    // Experimental fallback workers (2026-10-02, user request; chain #6-9).
    // Same shape as build-b/build-c; only the model pin differs. Ranked
    // after all proven workers; live Task use is their real proof.
    "build-d": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/fledge-alpha-free",
      "description": "Implementation worker (fallback D, EXPERIMENTAL): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "build-e": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/ling-3.0-flash-fin-free",
      "description": "Implementation worker (fallback E, EXPERIMENTAL): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "build-f": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/mimo-v2.6-flash-free",
      "description": "Implementation worker (fallback F, EXPERIMENTAL): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "build-g": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/space-bunny-free",
      "description": "Implementation worker (fallback G, EXPERIMENTAL): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    // Re-enabled 2026-10-02 at user request (chain #5): mid-output stops are
    // recoverable via same-session resume, and the user verified live that
    // it currently solves tasks adequately.
    "build-h": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/nemotron-3.5-lightning-free",
      "description": "Implementation worker (fallback H): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    // Former primary (2026-09-26..2026-10-02), demoted when Ling 3.1
    // Flash Free became the first-priority builder. Kept as a proven
    // fallback worker (chain #6).
    "build-i": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/nemotron-3-ultra-free",
      "description": "Implementation worker (fallback I, former primary): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permission": {
    "task": {
      "*": "allow"
    }
  }
}
