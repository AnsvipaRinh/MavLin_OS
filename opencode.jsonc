{
  "$schema": "https://opencode.ai/config.json",
  // Plane split (2026-09-26, see DECISIONS.md):
  // - orchestrator session model: FREE CHOICE via /models (ALL models,
  //   including Muse Spark — user explicitly wants it available);
  // - worker-plane (build Task): fixed pin below, ALWAYS a chain model,
  //   NEVER inherits the orchestrator session model;
  // - background-plane (title/summary/compaction): small_model below,
  //   chain model so auto "cheaper model" pick stays in-chain.
  // Worker pool (2026-09-29, protocol v3, see DECISIONS.md): build is the
  // primary worker; build-b/build-c are HIDDEN subagent fallbacks pinned to
  // other chain entries. Runtime agent rotation = Task subagent_type switch
  // (no server restart, no config paste). mode=subagent + hidden=true keeps
  // them out of the Tab picker and @-menu; they are invokable ONLY via the
  // Task tool when the orchestrator's task allow-list permits. NEVER pin any
  // worker to a model outside .opencode/model-fallback.json (Muse Spark is
  // banned as a worker). Workers must NEVER delegate (task: deny).
  "small_model": "openrouter/cohere/north-mini-code:free",
  "agent": {
    "build": {
      "model": "opencode/nemotron-3-ultra-free",
      "description": "Implementation worker: executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        // Workers must NEVER delegate deeper (2026-09-26, see DECISIONS.md):
        // with zero invokable agents the Task tool offers nothing, so no
        // nested-delegation attempts (not even build->orchestrator self-invoke).
        // Orchestrator's own task allow-list (its .md) is unaffected.
        "task": {
          "*": "deny"
        }
      }
    },
    // Fallback workers (protocol v3): hidden subagents, chain #1 and #3.
    // Same description/permissions as build; only the model pin differs.
    "build-b": {
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/cohere/north-mini-code:free",
      "description": "Implementation worker (fallback B): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "build-c": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/longcat-2.5-preview-free",
      "description": "Implementation worker (fallback C): executes research, decomposition and implementation ITSELF with files and bash. Never delegates, never invokes subagents.",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permission": {
    "task": {
      "*": "allow"
    }
  }
}
