{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    // Two-plane topology (2026-09-26, see DECISIONS.md):
    // orchestrator-plane = OpenRouter (orchestrator.md frontmatter, chain head),
    // worker-plane = Zen (this pin, chain #3). Build NEVER inherits the
    // orchestrator session model, so a stale/off-list session model can never
    // leak into workers. NEVER pin here a model outside
    // .opencode/model-fallback.json (Muse Spark is banned as a worker).
    // Quota-death of this pin needs a one-line rotation to the next chain
    // entry: run `scripts/session-reuse.py models --exclude <dead>` and apply
    // its `rotate:` line, then restart the server. No autonomy beyond that
    // exists on this platform (agents cannot switch models at runtime).
    "build": {
      "model": "opencode/longcat-2.5-preview-free"
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permission": {
    "task": {
      "*": "allow"
    }
  }
}
