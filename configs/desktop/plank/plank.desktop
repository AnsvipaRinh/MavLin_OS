[Desktop Entry]
Type=Application
Name=Dock
Comment=Mavericks-style Dock (Plank)
# Seeding happens before plank starts on purpose: plank reads its
# preferences once at startup and does not follow later gsettings changes,
# so launching it first would show a stock dock for that session.
# mv-dock-config --apply also preserves anything the user changed through
# plank's own preferences dialog.
Exec=mv-dock-config --apply --launch
Icon=preferences-system
Terminal=false
X-GNOME-Autostart-enabled=true
X-Mavericks-Native=true