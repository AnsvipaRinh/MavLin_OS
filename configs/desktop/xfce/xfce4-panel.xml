<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfce4-panel" version="1.0">
  <property name="config-verbose" type="bool" value="false"/>
  <property name="disable-struts" type="bool" value="false"/>
  
  <!-- Custom shortcuts - non-breaking additions -->
  <property name="shortcuts" type="empty">
    <!-- Mission Control GUI overlay -->
    <property name="&lt;Super&gt;F3" type="string" value="mv-mc-gui"/>
    
    <!-- Existing shortcuts preserved -->
    <property name="&lt;Super&gt;space" type="string" value="mv-spotlight"/>
    <property name="&lt;Super&gt;Return" type="string" value="mv-terminal"/>
  </property>
  
  <property name="panels" type="array">
    <value type="int" value="1"/>
  </property>
  
  <property name="panel-1" type="array">
    <value type="int" value="1"/>
    <value type="int" value="2"/>
  </property>
</channel>
